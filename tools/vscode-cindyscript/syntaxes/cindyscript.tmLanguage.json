{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CindyScript",
  "scopeName": "source.cindyscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#definition" },
    { "include": "#control" },
    { "include": "#builtins" },
    { "include": "#call" },
    { "include": "#modifier" },
    { "include": "#iterator" },
    { "include": "#numbers" },
    { "include": "#language-constants" },
    { "include": "#config-variable" },
    { "include": "#modifier-variable" },
    { "include": "#constants" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "Section headings of the framework, e.g. '// C.1 | Atom: ...'",
          "name": "comment.line.double-slash.cindyscript markup.heading.section.cindyscript",
          "match": "^\\s*//\\s*[A-Z](?:\\.\\d+[a-z]?)?\\s*\\|.*$"
        },
        {
          "name": "comment.block.documentation.cindyscript",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [{ "include": "#doc-tags" }, { "include": "#nested-comment" }]
        },
        {
          "name": "comment.block.cindyscript",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#nested-comment" }]
        },
        {
          "name": "comment.line.double-slash.cindyscript",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "nested-comment": {
      "comment": "CindyScript allows block comments inside block comments",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#nested-comment" }]
    },
    "doc-tags": {
      "name": "storage.type.class.doc.cindyscript",
      "match": "@[A-Za-z]+"
    },
    "strings": {
      "comment": "No backslash escapes; a doubled quote stands for a quote. Strings may span lines.",
      "name": "string.quoted.double.cindyscript",
      "begin": "\"",
      "end": "\"(?!\")",
      "patterns": [{ "name": "constant.character.escape.cindyscript", "match": "\"\"" }]
    },
    "definition": {
      "comment": "name(params) := ... ; names may contain spaces ('draw label')",
      "match": "(?<![\\p{L}\\p{N}'])([\\p{L}'](?:[\\p{L}\\p{N}']|[ \\t]+(?=[\\p{L}\\p{N}']))*)\\s*(\\()([^()]*)(\\))\\s*(::=|:=)(?!_)",
      "captures": {
        "1": { "name": "entity.name.function.definition.cindyscript" },
        "2": { "name": "punctuation.definition.parameters.begin.cindyscript" },
        "3": {
          "patterns": [
            { "name": "variable.parameter.cindyscript", "match": "[\\p{L}'#][\\p{L}\\p{N}']*" },
            { "name": "punctuation.separator.comma.cindyscript", "match": "," }
          ]
        },
        "4": { "name": "punctuation.definition.parameters.end.cindyscript" },
        "5": { "name": "keyword.operator.assignment.definition.cindyscript" }
      }
    },
    "control": {
      "comment": "Built-ins that steer the program flow",
      "name": "keyword.control.cindyscript",
      "match": "(?i)(?<![\\p{L}\\p{N}'])(?:if|while|repeat|forall|apply|select|regional|local|release)(?=\\s*\\()"
    },
    "builtins": {
      "comment": "Generated by update_cindyjs.py from the CindyJS sources, do not edit by hand",
      "name": "support.function.builtin.cindyscript",
      "match": "(?i)(?<![\\p{L}\\p{N}'])(?:setsimulationaccuracy|setsimulationquality|setsimulationspeed|continuefromhere|screenresolution|currentlanguage|elementsatmouse|matrixrowcolumn|mincostmatching|compiletowebgl|isnumbermatrix|isnumbervector|pauseanimation|simulationtime|directproduct|generatewebgl|international|perpendicular|playanimation|randominteger|removeelement|stopanimation|clearconsole|columnmatrix|combinations|eigenvectors|playfunction|pointreflect|randomnormal|screenbounds|allelements|allsegments|cameravideo|consecutive|createimage|createpoint|drawpolygon|eigenvalues|fillpolygon|isgeometric|isundefined|linearsolve|linereflect|multiidlist|allcircles|allsprings|clearimage|createtool|crossratio|drawcircle|fillcircle|imageready|incidences|javascript|pausevideo|pointcolor|randombool|readpixels|resetclock|seedrandom|settimeout|zeromatrix|zerovector|algorithm|allconics|allimages|allmasses|allpoints|conjugate|createvar|drawconic|drawimage|drawtable|droppoint|halfplane|imagergba|imagesize|isbouncer|iscomplex|isinteger|linecolor|pixelsize|playvideo|pointsize|randomint|removevar|rowmatrix|stopsound|submatrix|substring|timestamp|translate|transpose|alllines|autodiff|contains|drawpoly|drawtext|fillpoly|grestore|imagergb|iscircle|ismatrix|isspring|isstring|linesize|parallel|parsecsv|playwave|removeat|textsize|tokenize|arctan2|complex|connect|drawall|drawarc|dropped|element|fillarc|flatten|indexof|inverse|isconic|ispoint|keycode|multiid|playsin|polygon|prepend|println|product|repaint|replace|reverse|seconds|tangent|triples|unicode|version|append|arccos|arcsin|arctan|assert|canvas|circle|clrscr|column|common|concat|create|format|greset|import|inputs|isbool|iseven|isjson|isline|islist|ismass|isreal|kernel|length|moveto|random|remove|rotate|screen|values|alpha|color|cross|cycle|floor|gauss|green|gsave|guess|isodd|issun|layer|merge|mouse|mover|pairs|parse|plotx|point|print|roots|round|scale|area|blue|ceil|clip|date|dict|dist|draw|dump|errc|eval|fill|gray|grey|join|keys|line|load|meet|mult|para|perp|plot|rank|self|sort|sqrt|take|text|time|abs|add|and|cos|det|div|eig|err|exp|get|hue|key|log|map|max|min|mod|not|pow|put|red|row|set|sin|sub|sum|tan|use|xor|im|or|re|d)(?=\\s*\\()"
    },
    "call": {
      "name": "entity.name.function.call.cindyscript",
      "match": "(?<![\\p{L}\\p{N}'])[\\p{L}'](?:[\\p{L}\\p{N}']|[ \\t]+(?=[\\p{L}\\p{N}']))*(?=\\s*\\()"
    },
    "modifier": {
      "comment": "Modifiers like color->red or mod'font->f",
      "match": "(?<![\\p{L}\\p{N}'])((?:mod')?\\p{L}[\\p{L}\\p{N}']*)\\s*(->|\u2192)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.modifier.cindyscript" },
        "2": { "name": "keyword.operator.modifier.cindyscript" }
      }
    },
    "iterator": {
      "comment": "# and #1 ... #9",
      "name": "variable.language.iterator.cindyscript",
      "match": "(?<![\\p{L}\\p{N}'])#[1-9]?"
    },
    "numbers": {
      "name": "constant.numeric.cindyscript",
      "match": "(?<![\\p{L}\\p{N}'])(?:\\d+(?:\\.(?!\\.)\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?"
    },
    "language-constants": {
      "name": "constant.language.cindyscript",
      "match": "(?<![\\p{L}\\p{N}'])(?:true|false|pi)(?![\\p{L}\\p{N}'])"
    },
    "config-variable": {
      "comment": "Widget configuration by convention: 'barwidth",
      "match": "(?<![\\p{L}\\p{N}'])(')(\\p{L}[\\p{L}\\p{N}']*)",
      "captures": {
        "1": { "name": "storage.modifier.config.cindyscript" },
        "2": { "name": "variable.other.config.cindyscript" }
      }
    },
    "modifier-variable": {
      "comment": "Modifier parameters by convention: mod'color",
      "match": "(?<![\\p{L}\\p{N}'])(mod')(\\p{L}[\\p{L}\\p{N}']*)",
      "captures": {
        "1": { "name": "storage.modifier.mod.cindyscript" },
        "2": { "name": "variable.parameter.mod.cindyscript" }
      }
    },
    "constants": {
      "comment": "Constants by convention: two or more capitals, e.g. VRTOPLEFT, DIVOMATH'CONFIG",
      "name": "variable.other.constant.cindyscript",
      "match": "(?<![\\p{L}\\p{N}'])\\p{Lu}[\\p{Lu}\\p{N}]+(?:'[\\p{Lu}\\p{N}]+)*(?![\\p{L}\\p{N}'])"
    },
    "variables": {
      "name": "variable.other.readwrite.cindyscript",
      "match": "[\\p{L}'][\\p{L}\\p{N}']*"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.cindyscript", "match": ":=_" },
        { "name": "keyword.operator.assignment.definition.cindyscript", "match": "::=|:=" },
        { "name": "keyword.operator.modifier.cindyscript", "match": "->|\u2192" },
        {
          "name": "keyword.operator.cindyscript",
          "match": "~!=|~<=|~>=|==|!=|<>|<=|>=|~=|~<|~>|\\+\\+|--|~~|<:|:>|\\.\\.|[-+*/^%&!<>:._\u00b0\u221a\u00d7\u00f7\u2208\u2209\u2260\u2264\u2265\u2248\u222a\u2229\u2216\u00ac\u2227\u2228\u00b7\u22c5|]"
        },
        { "name": "keyword.operator.assignment.cindyscript", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.cindyscript", "match": ";" },
        { "name": "punctuation.separator.comma.cindyscript", "match": "," }
      ]
    }
  }
}
