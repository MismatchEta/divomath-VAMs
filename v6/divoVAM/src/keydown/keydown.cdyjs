/** v5 ******************************************************************************************
* Handles key presses (mainly for debugging).
*
* Recent changes:
************************************************************************************************/

if (LOGLEVEL > 5 & !isinteger(LOGLEVEL), println("> KEYPRESS triggered at " + key()));

if(key() == "k" % key() == "K", // Debug print divomath details
	println("=============DIVOMATH SETTINGS=============");
	println("divomath base object: " + divomathConfig);
	println("Screenbounds: " + screenbounds());
	println("Config: " + DIVOMATH'CONFIG);
	println("State: " + DIVOMATH'VARSTATE);
	println("Prev Answer: " + DIVOMATH'PREVANSWER);
	println("bgcolor: " + BGCOLOR);
	println("debuglevel: " + LOGLEVEL);
	println("isVIEWER?: " + DIVOMATH'ISVIEWER);
	println("========================================---");
	println("SetState overwrite: " + divomathSetState());
	println("==========================================="); 
);

if(key() == "s" % key() == "S", 
	divomathUpdateResults();
	divomathSetState();
);

if(key() == "+" % key() == "_", LOGLEVEL = LOGLEVEL + 1; println("LOGLEVEL++: " + LOGLEVEL));
if(key() == "-", LOGLEVEL = LOGLEVEL - 1; println("LOGLEVEL--: " + LOGLEVEL));