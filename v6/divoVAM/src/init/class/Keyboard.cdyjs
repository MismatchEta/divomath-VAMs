/** v3 ******************************************************************************************
* Classes for key and keyboard.
*
* Recent changes:
* 2026-07-13 Add similar fix as in Toggle class for iPad pen issue
************************************************************************************************/
// Global config
'fontsize = 16;
'size = 1;

// Key for Keyboard
new Key(coord, width, height, label) := (
	regional(o);
	o = new Button(coord, width, height, label, 'fontsize); // @TOdo: scale fontsize based on size
	o:"type" = "key";
	o:"target" = target;
	o:"bordercolor" = o:"color" * .8;
	o:"cornerradius" = 0;
	o:"hasshadow" = false;

	o:"script" := my("label"); // Return label

	o; // Return Key;
);

new Key(coord, size, label) := new Key(coord, size, size, label);

// Keyboard
new Keyboard(coord, subtype, keysize, target) := (
	regional(o, subtypes);
	o = new VAMobject("keyboard");
	subtypes = ["full", "numeric"];
	o:"subtype" = if(contains(subtypes,subtype),subtype,"full");
	o:"coord" = coord;
	o:"keysize" = keysize;
	o:"keys" = [];
	o:"margin" = .2;
	o:"ismoveable" = false;

	o:"target" = target;
	o:"value" = "";

	o:"ishot" := length(select(my("keys"),#:"ishot")) > 0;

	// for iPad pen fix
	o:"ipadpentimestampfix" = -1;
	o:"lastkeypressed" = "";

	o:"click" := (
		regional(key, value);
		value = my("value");
		key = select(my("keys"),#:"ishot"); // Get all the hot keys (should be exactly one)
		if(length(key) > 0, key = key_1:"label");

		// fix for iPad pen issue: swallow duplicate fire of the SAME key
    if(key == my("lastkeypressed") & timestamp() - my("ipadpentimestampfix") < 100,
        // duplicate -> ignore
    ,
        self():"ipadpentimestampfix" = timestamp();
        self():"lastkeypressed" = key;

        // Add character if not clicked on an arrow key 
			if(!contains([DOWNARROWTIPLEFT,LEFTARROW], key),
				value = value + key;
			);
	
			// Execute targets onupdate script on Enter press
			if(key == DOWNARROWTIPLEFT & !isundefined(my("target")),
				eval(my("target"):"onupdate", value->my("value"));
			);
	
			// Remove last character if any on leftarrow press
			if(key == LEFTARROW & length(value) > 0,
				// Remove last char
				value = value_(1..(length(value)-1)); // is list now :(
	
				// Rebuild string from list
				regional(temp);
				temp = "";
				forall(value, temp = temp + #);
				value = temp;
			);
	
			// Reassign new value
			self():"value" = value;
			
			// Execute targets onkeypress script
			if(!isundefined(my("target")),
				eval(my("target"):"onkeypress", key->key);
			);
    );

		key; // Return the key label
	);

	o:"draw" := (
		forall(my("keys"), #:"draw");
		
		// debug
		if(LOGLEVEL > 0, draw(my("coord")));
	);

	// Build keyboard
	if(o:"subtype" == "numeric",
		// row 4
		o:"keys" = o:"keys" :> new key(o:"coord" + [o:"margin", o:"margin"], o:"keysize", "0");
		o:"keys" = o:"keys" :> new key(o:"coord" + [2*o:"margin"+o:"keysize", o:"margin"], o:"keysize", ".");
		o:"keys" = o:"keys" :> new key(o:"coord" + [3*o:"margin"+2*o:"keysize", o:"margin"], o:"keysize", LEFTARROW);
		
		// row 3
		o:"keys" = o:"keys" :> new key(o:"coord" + [o:"margin", 2*o:"margin"+o:"keysize"], o:"keysize", "1");
		o:"keys" = o:"keys" :> new key(o:"coord" + [2*o:"margin"+o:"keysize", 2*o:"margin"+o:"keysize"], o:"keysize", "2");
		o:"keys" = o:"keys" :> new key(o:"coord" + [3*o:"margin"+2*o:"keysize", 2*o:"margin"+o:"keysize"], o:"keysize", "3");

		// row 2
		o:"keys" = o:"keys" :> new key(o:"coord" + [o:"margin", 3*o:"margin"+2*o:"keysize"], o:"keysize", "4");
		o:"keys" = o:"keys" :> new key(o:"coord" + [2*o:"margin"+o:"keysize", 3*o:"margin"+2*o:"keysize"], o:"keysize", "5");
		o:"keys" = o:"keys" :> new key(o:"coord" + [3*o:"margin"+2*o:"keysize", 3*o:"margin"+2*o:"keysize"], o:"keysize", "6");

		// row 1
		o:"keys" = o:"keys" :> new key(o:"coord" + [o:"margin", 4*o:"margin"+3*o:"keysize"], o:"keysize", "7");
		o:"keys" = o:"keys" :> new key(o:"coord" + [2*o:"margin"+o:"keysize", 4*o:"margin"+3*o:"keysize"], o:"keysize", "8");
		o:"keys" = o:"keys" :> new key(o:"coord" + [3*o:"margin"+2*o:"keysize", 4*o:"margin"+3*o:"keysize"], o:"keysize", "9");

		// Return key
		o:"keys" = o:"keys" :> new key(o:"coord" + [4*o:"margin"+3*o:"keysize", o:"margin"], o:"keysize", 2*o:"keysize" + o:"margin", DOWNARROWTIPLEFT);
	);

	o; // Return Keyboard
);
