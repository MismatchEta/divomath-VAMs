/** v2 *****************************************************************************************
* Interactable to explore thales theorem and its inverse
*
* Recent changes:
* - 2026-07-29: Refactor configuration settings
* - 2026-07-29: Invert softc so true actually provides a soft construction
* - 2026-07-29: Completely redo DisplayHandler Class for a scrollable one column interface
* - 2026-07-30: Add highlighting when Point C is selected
* - 2026-07-30: Change how reset button and toggles initially get their position
* - 2026-07-30: Rework tracing behavior
* - 2026-07-30: Change scaling of angle labels
************************************************************************************************/

// Satz des Thales und Umkehrung
if(VAM == "thales",


// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

// --- Geometry: Starting positions ---
A											= default to(ENVIRONMENTALPARAMS:"A", [7,5], true);
B											= default to(ENVIRONMENTALPARAMS:"B", [18,10], true);
C											= default to(ENVIRONMENTALPARAMS:"C", [12,12], true);

// --- Moveability and Snapping ---
amoveable							= default to(ENVIRONMENTALPARAMS:"amoveable", false, true);
bmoveable							= default to(ENVIRONMENTALPARAMS:"bmoveable", false, true);
snap									= default to(ENVIRONMENTALPARAMS:"snap", true, true); // When moving C, snap to circle(M, AB)
snappingdifference		= default to(ENVIRONMENTALPARAMS:"snappingdifference", 5, true); // Distance to right angle in deg
generalsnapsize				= default to(ENVIRONMENTALPARAMS:"generalsnapsize", 5, true); // Snap to every multiple of that angle in deg
generalsnapdifference	= default to(ENVIRONMENTALPARAMS:"generalsnapdifference", .5, true); // Snap to generalsnapsize if difference is less than this
softc									= default to(ENVIRONMENTALPARAMS:"softc", true, true); // Soft construction if TRUE

// --- Visibility: Geometry ---
drawcenter						= default to(ENVIRONMENTALPARAMS:"drawcenter", true, true);
drawcircle						= default to(ENVIRONMENTALPARAMS:"drawcircle", true, true);

// --- Visibility: UI elements ---
showstampbutton				= default to(ENVIRONMENTALPARAMS:"showstampbutton", true, true);
showundobutton				= default to(ENVIRONMENTALPARAMS:"showundobutton", true, true);
showresetbutton				= default to(ENVIRONMENTALPARAMS:"showresetbutton", true, true);
showconstructionbutton= default to(ENVIRONMENTALPARAMS:"showconstructionbutton", true, true);
showhelpbutton				= default to(ENVIRONMENTALPARAMS:"showhelpbutton", true, true);

// --- Visibility: Toggles ---
drawtogglealpha				= default to(ENVIRONMENTALPARAMS:"drawtogglealpha", true, true);
drawtogglebeta				= default to(ENVIRONMENTALPARAMS:"drawtogglebeta", true, true);
drawtogglegamma				= default to(ENVIRONMENTALPARAMS:"drawtogglegamma", true, true);
drawtogglegamma1			= default to(ENVIRONMENTALPARAMS:"drawtogglegamma1", true, true);
drawtogglegamma2			= default to(ENVIRONMENTALPARAMS:"drawtogglegamma2", true, true);
drawtogglevalues			= default to(ENVIRONMENTALPARAMS:"drawtogglevalues", true, true);
drawtoggleCM					= default to(ENVIRONMENTALPARAMS:"drawtoggleCM", false, true); //  @deprecated, never true (see toggle init)

// --- Initial toggle states (also triggers, when hidden) ---
showalpha							= default to(ENVIRONMENTALPARAMS:"showalpha", false, true);
showbeta							= default to(ENVIRONMENTALPARAMS:"showbeta", false, true);
showgamma							= default to(ENVIRONMENTALPARAMS:"showgamma", true, true);
showgamma1						= default to(ENVIRONMENTALPARAMS:"showgamma1", false, true);
showgamma2						= default to(ENVIRONMENTALPARAMS:"showgamma2", false, true);
showanglevalues				= default to(ENVIRONMENTALPARAMS:"showanglevalues", false, true);
showhelp							= default to(ENVIRONMENTALPARAMS:"showhelp", true, true);
showCM								= default to(ENVIRONMENTALPARAMS:"showCM", true, true); // @deprecated, always true

// --- Stamps / Trace ---
stampmode							= default to(ENVIRONMENTALPARAMS:"stampmode", "trace", false); // "stamp" or "trace"
stampbuttonimage			= default to(ENVIRONMENTALPARAMS:"stampbuttonimage", "stamp", false); // "stamp" or "measure-angle"
stickstampbuttontopoint= default to(ENVIRONMENTALPARAMS:"stickstampbuttontopoint", false, true);
showstampedpoints			= default to(ENVIRONMENTALPARAMS:"showstampedpoints", true, true);
showstampedvalues			= default to(ENVIRONMENTALPARAMS:"showstampedvalues", true, true);
drawtrace							= default to(ENVIRONMENTALPARAMS:"drawtrace", false, true);
tracesize							= default to(ENVIRONMENTALPARAMS:"tracesize", 4, true); // line size of trace
tracecolor						= default to(ENVIRONMENTALPARAMS:"tracecolor", DIVOBLUE, true);
traceminstep					= default to(ENVIRONMENTALPARAMS:"traceminstep", .1, true); // min difference between trace points

// --- Angle display ---
showcurrentanglevalue	= default to(ENVIRONMENTALPARAMS:"showcurrentanglevalue", true, true);
anglevaluesinline			= default to(ENVIRONMENTALPARAMS:"anglevaluesinline", true, true);
displayanglefontsize	= default to(ENVIRONMENTALPARAMS:"displayanglefontsize", 24, true); // Fontsize for list of measured angles
displayanglefully			= default to(ENVIRONMENTALPARAMS:"displayanglefully", false, true); // Show "gamma =" or not when showing stamped angles
defaultanglesizes			= default to(ENVIRONMENTALPARAMS:"defaultanglesizes", [3,3,2,3,3], true); // Default radii of the five arcs in order [a,b,g,g1,g2]
anglelabelsize				= default to(ENVIRONMENTALPARAMS:"anglelabelsize", 18, true); // Base size for alpha/beta/gamma1/gamma2
anglelabelgammafactor	= default to(ENVIRONMENTALPARAMS:"anglelabelgammafactor", 1.3, true); // gamma slightly bigger
anglelabelminscale		= default to(ENVIRONMENTALPARAMS:"anglelabelminscale", .65, true); // lower bound (1 = no shrinking at all)

// --- Look and feel ---
pointlabelsize				= default to(ENVIRONMENTALPARAMS:"pointlabelsize", 24, true);
linelabelsize					= default to(ENVIRONMENTALPARAMS:"linelabelsize", 18, true);
linesize							= default to(ENVIRONMENTALPARAMS:"linesize", 1.5, true);
circlelinesize				= default to(ENVIRONMENTALPARAMS:"circlelinesize", 1.5, true);
circlelinecolor				= default to(ENVIRONMENTALPARAMS:"circlelinecolor", .3*[1,1,1], true);
imgoffset							= default to(ENVIRONMENTALPARAMS:"imgoffset", [0,.65], true);
jumptostamp 					= default to(ENVIRONMENTALPARAMS:"jumptostamp", false, true);
stampgradient					= default to(ENVIRONMENTALPARAMS:"stampgradient", true, true); // color gradient of stamps with regards to the distance to M
stampgradientstrength	= default to(ENVIRONMENTALPARAMS:"stampgradientstrength", .8, true); // 0 = no gradient, 1 = full gradient
stampcolor						= default to(ENVIRONMENTALPARAMS:"stampcolor", [.8,.2,.2], true); // color if no gradient
 
// --- Positions (NADA = auto align) ---
toolbarmargin					= default to(ENVIRONMENTALPARAMS:"toolbarmargin", .3, true);
backbuttoncoord				= default to(ENVIRONMENTALPARAMS:"backbuttoncoord", NADA, true);
resetbuttoncoord			= default to(ENVIRONMENTALPARAMS:"resetbuttoncoord", NADA, true);
stampbuttoncoord			= default to(ENVIRONMENTALPARAMS:"stampbuttoncoord", NADA, true);
constructionbuttoncoord= default to(ENVIRONMENTALPARAMS:"constructionbuttoncoord", NADA, true);
helpbuttoncoord				= default to(ENVIRONMENTALPARAMS:"helpbuttoncoord", NADA, true);
togglerefcoord				= default to(ENVIRONMENTALPARAMS:"togglerefcoord", NADA, true);
gammadisplaycoord			= default to(ENVIRONMENTALPARAMS:"gammadisplaycoord", NADA, true);
gammalistcoord				= default to(ENVIRONMENTALPARAMS:"gammalistcoord", NADA, true);


// ===================== //
// C | Class Definitions //
// ===================== //

/**
* Base thales construction based on the diameter AB and point C on circle
*/
new ThalesTrig(A,B,C) := (
	regional(trig);
	trig = new VAMobject("Thales");
	trig:"A" = A; trig:"B" = B; trig:"C" = C;
	trig:"M" := centroid([my("A"),my("B")]);
	trig:"coord" := my("A");
	trig:"/BAC" := angle(my("B"),my("A"),my("C")); // Angle BAC
	trig:"alpha" := if(my("/BAC")>PI, 2*PI-(my("/BAC")), (my("/BAC")));
	trig:"/CBA" := angle(my("C"),my("B"),my("A")); // Angle CBA
	trig:"beta" := if(my("/CBA")>PI, 2*PI-(my("/CBA")), (my("/CBA")));
	trig:"/ACB" := angle(my("A"),my("C"),my("B")); // Angle ACB
	trig:"gamma" := if(my("/ACB")>PI, 2*PI-(my("/ACB")), (my("/ACB")));
	trig:"/ACM" := angle(my("A"),my("C"),my("M")); // Angle ACM
	trig:"gamma1" := if(my("/ACM")>PI, 2*PI-(my("/ACM")), (my("/ACM")));
	trig:"/MCB" := angle(my("M"),my("C"),my("B")); // Angle MCB
	trig:"gamma2" := my("gamma") - my("gamma1");

	trig:"stamps" = []; // stamps of C

	trig:"firstmove" = true; // Flag to execute movestart once when starting to move a thing
	trig:"ismoveable" = true;
	trig:"softc" = false;
	trig:"font" = NADA;
	trig:"thresh" = 1;

	trig:"history" = []; // history of actions
	trig:"anglecolor" = [DZLMCOLORGOLD,DIVOBLUE,DZLMCOLORDARK,DIVORED,DIVOVIOLET];
	trig:"pointcolor" = [DIVOBLUE, DIVOBLUE, DIVOBLUE];
	trig:"displaycolor" = DZLMCOLORDARK;
	trig:"opacity" = .15; // ...of angle fill
	trig:"defaultanglesize" = defaultanglesizes;
	trig:"anglescaling" = .4;
	trig:"anglesize" := [
		min(min(my("anglescaling")*dist(my("A"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_1), // alpha
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("B"),my("A"))), my("defaultanglesize")_2), // beta
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_3), // gamma
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_4), // gamma1 (facing alpha)
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_5), // gamma2 (facing beta)
	];

	trig:"anglelabelsize" = anglelabelsize;
	trig:"anglelabelgammafactor" = anglelabelgammafactor;
	trig:"anglelabelminscale" = anglelabelminscale;
 
	// One shared scale factor for all angle labels, so they stay consistent
	// with each other. Uses the SMALLEST of the five ratios, damped by sqrt
	// and clamped from below.
	trig:"anglelabelscale" := (
		regional(ratios, s);
		ratios = apply(1..5, my("anglesize")_# / my("defaultanglesize")_#);
		s = min(ratios);
		s = sqrt(max(s, 0));								// damp: shrink less aggressively
		max(s, my("anglelabelminscale"));		// never smaller than this
	);
	
	trig:"snap" = snap;
	trig:"snapdifference" = snappingdifference;
	trig:"amoveable" = amoveable;
	trig:"bmoveable" = bmoveable;

	trig:"gammavalueposition" = NADA;
	trig:"gammavaluedisplaywidth" = 7;
	trig:"gammavaluedisplayheight" = 2;

	trig:"showstampedpoints" = true;
	trig:"showstampedvalues" = false;
	trig:"showstampbutton" = true;
	trig:"showconstructionbutton" = false;
	trig:"showhelpbutton" = false;
	trig:"showcurrentanglevalue" = true;
	trig:"anglevaluesinline" = anglevaluesinline;

	trig:"drawalpha" = true;
	trig:"drawbeta" = true;
	trig:"drawgamma" = true;
	trig:"drawgamma1" = true;
	trig:"drawgamma2" = true;
	trig:"drawradius" = true;
	trig:"drawcenter" = false;
	trig:"drawcircle" = false;

	trig:"pointlabelsize" = pointlabelsize;
	trig:"linelabelsize" = linelabelsize;
	trig:"linesize" = linesize;
	trig:"circlelinesize" = circlelinesize;
	trig:"circlelinecolor" = circlelinecolor;
	trig:"stampmode" = stampmode;
	trig:"drawtrace" = drawtrace;

	trig:"stampgradient" = stampgradient;
	trig:"stampgradientstrength" = stampgradientstrength;
	trig:"stampcolor" = stampcolor;

	trig:"traces" = [];					// list of segments, each a list of points
	trig:"recordingtrace" = drawtrace;	// is the trace currently being recorded?
	trig:"tracesize" = tracesize;
	trig:"tracecolor" = tracecolor;
 
	// Starts a new segment. Called when recording is switched on.
	trig:"starttracesegment" := (
		self():"traces" = my("traces") :> [];
	);
 
	// Appends the current position to the active segment, but only if it moved
	// far enough - otherwise the list grows by hundreds of points per second.
	trig:"appendtrace" := (
		if(length(my("traces")) == 0, my("starttracesegment"));
		if(length(my("traces")_(-1)) == 0,
			self():"traces"_(-1) = [my("C")];
		,
			if(dist(my("traces")_(-1)_(-1), my("C")) >= traceminstep,
				self():"traces"_(-1) = my("traces")_(-1) :> my("C");
			);
		);
	);

	trig:"ishot" := (
		regional(ishot);
		ishot = NADA;
		if(dist(mouse().xy, my("A")) <= my("thresh"), ishot = "A");
		if(dist(mouse().xy, my("B")) <= my("thresh"), ishot = "B");
		if(dist(mouse().xy, my("C")) <= my("thresh"), ishot = "C");
		self():"lasthot" = ishot;

		!isundefined(ishot);
	);
	trig:"lasthot" = NADA;
	
	trig:"draw" := (
		// Draw circle
		if(my("drawcircle"),drawcircle(centroid([my("A"),my("B")]), .5*dist(my("A"),my("B")), size->my("circlelinesize"), color->my("circlelinecolor")));

		// Draw stamps / trace
		if(my("stampmode") == "stamp",
			if(my("showstampedpoints"),
				forall(my("stamps"),
					regional(col, distance, refdistance, ratio);
					if(my("stampgradient"),
						distance = dist(#, my("M"));
						// Reference: half the diagonal of the visible rect (bottom left to top right)
						refdistance = dist(VISIBLERECT_1, VISIBLERECT_3) / 2;
						ratio = min(distance / refdistance, 1);
						col = [
							.8,
							.1 + (1 - ratio) * my("stampgradientstrength"),
							.1 + ratio * my("stampgradientstrength")
						];
					,
						col = my("stampcolor");
					);
					draw(#, size->my("size"), color->col);
				);
			);
		, 
			if(my("stampmode") == "trace",
				forall(my("traces"),
					if(length(#) > 1,
						connect(#, size->my("tracesize"), color->my("tracecolor"));
					);
				);
			);
		);

		// Draw gamma value background
		if(my("showcurrentanglevalue"),
			regional(w, h, bgbox, textbox);
			w=my("gammavaluedisplaywidth"); h=my("gammavaluedisplayheight");
			bgbox = rectangle(my("gammavalueposition"), w, h);
			fill(roundedrectangle(my("gammavalueposition"), w, h, .2), color->my("displaycolor"), alpha->.2);

			// Draw gamma value
			regional(anglevalue, hascomma, pos);
			anglevalue = my("gamma")+0; // always rad
			anglevalue = anglevalue / PI * 180; // Convert to deg
			anglevalue = replace(format(anglevalue,2),".",","); // format correctly
			hascomma = indexof(anglevalue,",") == 0;
			if(hascomma, anglevalue = anglevalue + ",00"); // add 2 zeros if no decimal
			if(anglevalue_(-2) == ",", anglevalue = anglevalue + "0"); // add 1 zero if only one decimal
			anglevalue = anglevalue + "°"; // add degree symbol

			pos = centroid(bgbox);
			textbox = getboundingbox(anglevalue,pos,24, my("font"), bold->true);
			pos = pos + .5*(textbox_1 - textbox_3);	

			drawtextbox(pos + [-.4,.15], GREEK:"g" + " = " + anglevalue, 20, my("font"), NADA, color->my("displaycolor"), bold->true);
		);

		// Draw angle values if not drawn inline with angles
		if(my("drawanglevalues") & !my("anglevaluesinline"),
			regional(refcoord, yoffset, fontsize, label);
			yoffset = 1.3;
			refcoord = drawanglevalues:"coord" - [-1,1.5];
			fontsize = 20;
			// Alpha
			label = GREEK:"a" + " = " + replace(format(todeg(my("alpha")),2),".",",") + "°";
			drawtextbox(refcoord, label, fontsize, my("font"), NADA, color->my("anglecolor")_1);
			// Beta
			refcoord = refcoord - [0,yoffset];
			label = GREEK:"b" + " = " + replace(format(todeg(my("beta")),2),".",",") + "°";
			drawtextbox(refcoord, label, fontsize, my("font"), NADA, color->my("anglecolor")_2);
			// Gamma1
			refcoord = refcoord - [0,yoffset];
			label = GREEK:"g"+SUB:"1" + " = " + replace(format(todeg(my("gamma1")),2),".",",") + "°";
			drawtextbox(refcoord, label, fontsize, my("font"), NADA, color->my("anglecolor")_4);
			// Gamma2
			refcoord = refcoord - [0,yoffset];
			label = GREEK:"g"+SUB:"2" + " = " + replace(format(todeg(my("gamma2")),2),".",",") + "°";
			drawtextbox(refcoord, label, fontsize, my("font"), NADA, color->my("anglecolor")_5);
		);

		// DRAW ANGLES
		regional(mc, ma, mb, a,b,c, bisectorpoint, offset, customoffset, anglelabel);
		a = vectorlength(my("B")-my("C"));
		b = vectorlength(my("A")-my("C"));
		c = vectorlength(my("A")-my("B"));
		ma = vectorlength(my("A")-my("M"));
		mb = vectorlength(my("B")-my("M"));
		mc = vectorlength(my("C")-my("M"));

		// Draw and fill alpha
		if(my("drawalpha"),
		
			// Draw
			if(my("/ACB") < PI,
				drawangle(my("B"),my("A"),my("C"),my("anglesize")_1, color->my("anglecolor")_1),
				drawangle(my("C"),my("A"),my("B"),my("anglesize")_1, color->my("anglecolor")_1)
			);
			
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("B"),my("A"),my("C"),my("anglesize")_1, color->my("anglecolor")_1, alpha->my("opacity")),
				fillangle(my("C"),my("A"),my("B"),my("anglesize")_1, color->my("anglecolor")_1, alpha->my("opacity"))
			);
			
			// Draw label
			anglelabel = GREEK:"a" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("alpha")+0)*180/PI,2),".",",") + "°", "");
			eval(label angle(
					my("B"), my("A"), my("C"),
					my("anglesize")_1,
					anglelabel,
					my("anglelabelsize")*my("anglelabelscale"),
					my("font")
				),
				color->my("anglecolor")_1
			);
		);

		// Draw and fill beta
		if(my("drawbeta"),
		
			// Draw
			if(my("/ACB") < PI,
				drawangle(my("C"),my("B"),my("A"),my("anglesize")_2, color->my("anglecolor")_2),
				drawangle(my("A"),my("B"),my("C"),my("anglesize")_2, color->my("anglecolor")_2)
			);
			
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("C"),my("B"),my("A"),my("anglesize")_2, color->my("anglecolor")_2, alpha->my("opacity")),
				fillangle(my("A"),my("B"),my("C"),my("anglesize")_2, color->my("anglecolor")_2, alpha->my("opacity"))
			);
			
			// Draw label
			anglelabel = GREEK:"b" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("beta")+0)*180/PI,2),".",",") + "°", "");
			eval(label angle(
					my("C"), my("B"), my("A"),
					my("anglesize")_2,
					anglelabel,
					my("anglelabelsize")*my("anglelabelscale"),
					my("font")
				),
				color->my("anglecolor")_2
			);
		);

		// Draw and fill gamma1
		if(my("drawgamma1"),
		
			// Set color based on help button and position of C on circle
			regional(currentcolor);
			currentcolor = if(my("showhelp") & my("gamma")~=PI/2, my("anglecolor")_1, my("anglecolor")_4);

			// Draw arc
			if(my("/ACB") < PI,
				drawarc(my("A"),my("C"),my("M"),my("anglesize")_4, color->currentcolor),
				drawarc(my("M"),my("C"),my("A"),my("anglesize")_4, color->currentcolor)
			);

			// Draw sides of angle
			connect([my("C")+my("anglesize")_4*normalize(my("A")-my("C")), my("C")+my("anglesize")_3*normalize(my("A")-my("C"))], color->currentcolor);
			connect([my("C")+my("anglesize")_4*normalize(my("M")-my("C")), my("C")+if(my("drawgamma"),my("anglesize")_3*normalize(my("M")-my("C")),[0,0])], color->currentcolor);
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("A"),my("C"),my("M"),my("anglesize")_4,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity")),
				fillangle(my("M"),my("C"),my("A"),my("anglesize")_4,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity"))
			);

			// Draw label
			anglelabel = GREEK:"g"+SUB:"1" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("gamma1")+0)*180/PI,2),".",",") + "°", "");
			eval(label angle(
					my("A"), my("C"), my("M"),
					my("anglesize")_4,
					anglelabel,
					my("anglelabelsize")*my("anglelabelscale"),
					my("font")
				),
				color->currentcolor
			);
		);

		// Draw and fill gamma2
		if(my("drawgamma2"),
		
			// Set color based on help button and position of C on circle
			regional(currentcolor);
			currentcolor = if(my("showhelp") & my("gamma")~=PI/2, my("anglecolor")_2, my("anglecolor")_5);

			// Draw arc
			if(my("/ACB") < PI,
				drawarc(my("M"),my("C"),my("B"),my("anglesize")_5, color->currentcolor),
				drawarc(my("B"),my("C"),my("M"),my("anglesize")_5, color->currentcolor)
			);
			
			// Draw sides of angle
			connect([my("C")+my("anglesize")_5*normalize(my("B")-my("C")), my("C")+my("anglesize")_3*normalize(my("B")-my("C"))], color->currentcolor);
			connect([my("C")+my("anglesize")_5*normalize(my("M")-my("C")), my("C")+if(my("drawgamma"),my("anglesize")_3*normalize(my("M")-my("C")),[0,0])], color->currentcolor);

			// Fill
			if(my("/ACB") < PI,
				fillangle(my("M"),my("C"),my("B"),my("anglesize")_5,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity")),
				fillangle(my("B"),my("C"),my("M"),my("anglesize")_5,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity"))
			);
			
			// Draw label
			anglelabel = GREEK:"g"+SUB:"2" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("gamma2")+0)*180/PI,2),".",",") + "°", "");
			eval(label angle(
					my("M"), my("C"), my("B"),
					my("anglesize")_5,
					anglelabel,
					my("anglelabelsize")*my("anglelabelscale"),
					my("font")
				),
				color->currentcolor
			);
		);

		// Draw and fill gamma
		if(my("drawgamma"),
		
			// Draw
			if(my("/ACB") < PI,
				drawangle(my("A"),my("C"),my("B"),my("anglesize")_3, color->my("anglecolor")_3),
				drawangle(my("B"),my("C"),my("A"),my("anglesize")_3, color->my("anglecolor")_3)
			);
			
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("A"),my("C"),my("B"),my("anglesize")_3, color->my("anglecolor")_3, alpha->my("opacity")),
				fillangle(my("B"),my("C"),my("A"),my("anglesize")_3, color->my("anglecolor")_3, alpha->my("opacity"))
			);
			
			// Draw label
			eval(label angle(
					my("A"), my("C"), my("B"),
					my("anglesize")_3,
					GREEK:"g",
					my("anglelabelsize")*my("anglelabelgammafactor")*my("anglelabelscale"),
					my("font")
				),
				color->my("anglecolor")_3
			);
		);

		// Draw edges
		forall(pairs([trig:"A",trig:"B",trig:"C"]), connect(#, size->my("linesize"), color->grey(0))); // ~ of trig
		if(my("drawradius") & (my("drawgamma1") % my("drawgamma2")), connect([my("C"), centroid([my("A"),my("B")])], color->grey(0)));

		// Draw edge labels
		eval(label segment(my("A"), my("B"), my("C"), "c", my("linelabelsize"), my("font")),
			'labelposition->.6);
		eval(label segment(my("B"), my("C"), my("A"), "a", my("linelabelsize"), my("font")));
		eval(label segment(my("A"), my("C"), my("B"), "b", my("linelabelsize"), my("font")));

		// Draw points
		draw(trig:"A", color->my("pointcolor")_1, size->my("size"));
		draw(trig:"B", color->my("pointcolor")_2, size->my("size"));
		draw(trig:"C", color->my("pointcolor")_3, size->my("size"));
		if(my("drawcenter"), draw(centroid([my("A"),my("B")]), color->grey(.6), size->my("size")-1));

		// Draw Point Labels
		offsetA = -[.8,.6] * my("pointlabelsize") / 24;
		offsetB = [.4,-.5];
		offsetC = [.2,.1];
		drawtextbox(my("A") + offsetA, "A", my("pointlabelsize"), my("font"), NADA, bold->false);
		drawtextbox(my("B") + offsetB, "B", my("pointlabelsize"), my("font"), NADA, bold->false);
		drawtextbox(my("C") + offsetC, "C", my("pointlabelsize"), my("font"), NADA, bold->false);
		if(my("drawcenter"),
			regional(offsetM);
			offsetM = [-1,0] * my("pointlabelsize") / 24;
			drawtextbox(my("M") + offsetM, "M", my("pointlabelsize"), my("font"), NADA, bold->false);
		);
		//regional(centre);
		//centre = centroid([my("A"), my("B"), my("C")]);
		//eval(label point(my("A"), centre, "A", my("pointlabelsize"), my("font")));
		//eval(label point(my("B"), centre, "B", my("pointlabelsize"), my("font")));
		//eval(label point(my("C"), centre, "C", my("pointlabelsize"), my("font")));
		//if(my("drawcenter"),
		//	eval(label point(my("M"), my("C"), "M", my("pointlabelsize"), my("font")));
		//);

		// Highlight the point currently being dragged
		if(MOUSEDOWN & my("lasthot") == "C", 
			drawcircle(my("C"), my("thresh"), color->my("pointcolor")_3, size->2, alpha->.5);
		);

		// Highlight the stamp belonging to the selected list entry
		if(!isundefined(my("anglelist")),
			regional(hi);
			hi = my("anglelist"):"hotboxindex";
			if(!isundefined(hi) & hi <= length(my("stamps")),
				drawcircle(my("stamps")_hi, .5, color->DZLMCOLORGOLD, size->3);
			);
		);
	);

	trig:"move" := if(my("ismoveable"),
		// Trigger movestart event once per drag event
		if(my("firstmove"),
			my("movestart");
			self():"firstmove" = !my("firstmove");
		);

		// Handle moving of points
		if(my("amoveable") & my("lasthot")=="A", self():"A" = my("A") + mousedelta); // Move A with mouse
		if(my("bmoveable") & my("lasthot")=="B", self():"B" = my("B") + mousedelta); // Move B with mouse
		if(my("lasthot")=="C", self():"C" = my("C") + mousedelta); // Move C with mouse

		// Handle clamping at frame edges
		regional(screen, margin);
		screen = reverse(apply(screenbounds(), #.xy));
		margin = 1;
		self():"C" = [
				min(max(my("C")_1,screen_1_1+margin),screen_2_1-margin),
				min(max(my("C")_2,screen_1_2+margin),screen_4_2-margin)
			];

		// Handle snapping to 90°
		if((my("snap") & dist(my("gamma"), PI/2) < my("snapdifference")° & my("lasthot") == "C") % !my("softc"),
			self():"C" = my("M") + .5*dist(my("B"),my("A"))*normalize(my("C") - my("M"));			
		);

		// Handle general snapping to multiple of fixed angle
		regional(step, target);
		step = generalsnapsize / 180 * PI; // step size in rad
		target = round(my("gamma")/step)*step; // target angle to snap to

		if(dist(my("gamma"),target) < generalsnapdifference*PI/180, // Start snap handling
			regional(ab,ac);
			ab = my("B") - my("A");
			ac = my("C") - my("A");

			// --- edge case when gamma =~ PI ---
			if(dist(PI,target) < 10^(-6),
				regional(t);
				t = (ac*ab) / (ab*ab); // Calc projection parameter (vec*vec is scalar product, t=0 projection to A, t=1 projection to B)
				self():"C" = my("A") + t * ab;		
			,
				// ELSE
				// --- default case: Circle with viewing angle target with cord AB ---
				if(sin(target) > 10^(-6), // don't divide by zero later
					regional(L, normalvec, radius, h);
					L = vectorlength(ab);
					normalvec = [-ab_2, ab_1] / L; // normalized normal vector to ab

					radius = L / (2*sin(target)); // radius
					h = L / (2*tan(target)); // distance between midpoint of AB and midpoint of viewing angle circle (just draw a picture)

					// Choose side: same side as C relative to AB
					regional(sign, midpoint);
					sign = if(det([[ab_1,ab_2],[ac_1,ac_2]]) >= 0, 1, -1); // get orientation for correct circle
					O = my("M") +  sign * h * normalvec; // Midpoint (works, DRAW A PICTURE);	

					// Get next point on the circle (through radial projection)
					w = my("C") - O;
					if(vectorlength(w) > 10^(-9),	// failsafe, for when length of w =~ 0, so not to divide by 0
						self():"C" = O + radius * w / vectorlength(w);
					);
				);
			);
		);

		// Handle tracing
		if(my("stampmode") == "trace" & my("recordingtrace"), my("appendtrace"));
	);

	trig:"movestart" := (
		// Update history
		self():"history" = my("history") ++ [{"action" : "move", "object": "C", "oldcoord" : my("C"), "newcoord" : NADA}];
	);
	
	trig:"moveend" := if(my("ismoveable"),
		log point moved("C", my("C").xy);
		
		// Update history and reset firstmove flag
		self():"history"_(-1):"newcoord" = my("C");
		self():"firstmove" = !my("firstmove");
	);

	self():"lasthot" = NADA; // Reset last hot element

	trig; // Return ThalesTrig
);

/**
* Handler for tablelike displaying of stamped values.
* Always single column, right aligned, scrollable if the list does not fit.
*/ 
new DisplayHandler(coord) := (
	regional(display);
	display = new VAMobject("DisplayHandler");
	display:"coord" = coord; // bottom left corner of the TOPMOST box
	display:"labels" = NADA; // (list) set after init
	display:"rows" := length(my("labels"));

	// --- Scrolling state ---
	display:"scrolloffset" = 0;  // number of entries hidden above the visible area
	display:"lastrowcount" = 0;  // to detect newly added entries (auto follow)

	// --- Look and feel ---
	display:"boxcolors" = [grey(.83), grey(.93)];
	display:"highlightcolor" = DZLMCOLORGOLD;

	display:"fontcolor" = grey(0);
	display:"fontsize" = displayanglefontsize;
	display:"font" = NADA;
	display:"bold" = false;

	display:"boxradius" = .2;
	display:"boxpadding" = .2;

	// --- Buttons ---
	display:"removebutton" = (
		regional(button);
		button = new Button([0,0],.7,.7, CROSSMARK, NADA);
		button:"cornerradius" = .35;
		button:"color" = [.9,.2,.2];
		button:"bordercolor" := my("color");
		button:"fontcolor" = grey(1);
		button:"customlabeloffset" = [.013,.07];

		button; // Return
	);

	display:"scrollupbutton" = (
		regional(button);
		button = new Button([0,0], .9, .7, UPARROW, NADA);
		button:"parent" = display;
		button:"cornerradius" = .2;
		button:"color" = grey(.85);
		button:"bordercolor" = grey(.55);
		button:"fontcolor" = grey(.1);
		button:"hasshadow" = false;
		button:"show" := my("parent"):"needsscrolling";
		button:"script" := (
			my("parent"):"scrolloffset" = max(0, my("parent"):"scrolloffset" - 1);
		);

		button; // Return
	);

	display:"scrolldownbutton" = (
		regional(button);
		button = new Button([0,0], .9, .7, DOWNARROW, NADA);
		button:"parent" = display;
		button:"cornerradius" = .2;
		button:"color" = grey(.85);
		button:"bordercolor" = grey(.55);
		button:"fontcolor" = grey(.1);
		button:"hasshadow" = false;
		button:"show" := my("parent"):"needsscrolling";
		button:"script" := (
			my("parent"):"scrolloffset" = min(
				my("parent"):"maxscrolloffset",
				my("parent"):"scrolloffset" + 1
			);
		);

		button; // Return
	);

	// --- Box dimensions ---
	// Constant at runtime (depend only on fontsize/font/displayanglefully),
	// therefore computed ONCE as values, not as methods. Recomputing them on
	// every access made drawing quadratic in the number of entries.
	display:"boxheight" = (
		regional(h);
		h = getboundingbox("000,00°", [0,0], displayanglefontsize, NADA);
		(h_3 - h_1)_2 + 2 * toolbarmargin;
	);
	display:"boxwidth" = (
		regional(label, w);
		label = "000,00°";
		if(displayanglefully, label = GREEK:"g" + " = " + label);
		w = getboundingbox(label, [0,0], displayanglefontsize, NADA);
		(w_2 - w_1)_1 + display:"removebutton":"width" + 2 * toolbarmargin + .2;
	);

	// --- Capacity and scrolling maths ---
	// Number of boxes that fit between coord and the bottom of the visible area
	display:"rawcapacity" := (
		regional(bottom);
		bottom = VISIBLERECT_1_2; // bottom edge of visible rect
		max(1, floor((my("coord")_2 - bottom + my("boxpadding")) / (my("boxheight") + my("boxpadding"))));
	);

	display:"needsscrolling" := my("rows") > my("rawcapacity");

	// Reserve one row for the scroll buttons when scrolling is needed
	display:"maxdisplayablerows" := if(my("needsscrolling"),
		max(1, my("rawcapacity") - 1),
		my("rawcapacity")
	);

	display:"maxscrolloffset" := max(0, my("rows") - my("maxdisplayablerows"));
	display:"visiblerows" := min(my("rows"), my("maxdisplayablerows"));
	display:"lastvisible" := min(my("rows"), my("scrolloffset") + my("maxdisplayablerows"));

	// True if entry with (1 based) index i is currently on screen. Eval with 'entryindex.
	display:"isvisible" := ('entryindex > my("scrolloffset")) & ('entryindex <= my("lastvisible"));

	/**
	* Keeps the scroll position sane. Called from "draw".
	* - jumps to the end whenever a new entry was added
	* - clamps the offset when entries were removed or the box got bigger
	*/
	display:"updatescroll" := (
		if(my("rows") > my("lastrowcount"), self():"scrolloffset" = my("maxscrolloffset"));
		self():"lastrowcount" = my("rows");
		self():"scrolloffset" = max(0, min(my("scrolloffset"), my("maxscrolloffset")));
	);

	// Aligns both scroll buttons side by side below the list. Called from "draw".
	display:"setscrollbuttoncoords" := (
		regional(xright, ybottom, gap);
		gap = .15;
		xright = my("coord")_1 + my("boxwidth"); // right edge of the list

		ybottom = my("coord")_2
			- (my("visiblerows") - 1) * (my("boxheight") + my("boxpadding"))
			- my("boxpadding")
			- my("scrolldownbutton"):"height";

		// down on the right, up to its left
		my("scrolldownbutton"):"coord" = [xright - my("scrolldownbutton"):"width", ybottom];
		my("scrollupbutton"):"coord"   = [
			xright - my("scrolldownbutton"):"width" - gap - my("scrollupbutton"):"width",
			ybottom
		];
	);

	// --- Shapes ---
	// Built for ALL entries so that indices stay absolute. Entries scrolled out
	// of view simply end up outside the visible area and are filtered on draw.
	display:"boxshapes" := (
		apply(1..my("rows"),
			regional(row, bottomleftcoord);
			row = (# - 1) - my("scrolloffset");
			bottomleftcoord = my("coord") - row * [0, my("boxpadding") + my("boxheight")];

			roundedrectangle(bottomleftcoord, my("boxwidth"), my("boxheight"), my("boxradius"))
		);
	);
	display:"boxhitboxes" := (
		apply(1..my("rows"),
			regional(row, bottomleftcoord);
			row = (# - 1) - my("scrolloffset");
			bottomleftcoord = my("coord") - row * [0, my("boxpadding") + my("boxheight")];

			rectangle(bottomleftcoord, my("boxwidth"), my("boxheight"))
		);
	);

	// --- Interaction ---
	display:"hotboxindex" = NADA;
	display:"ishot" := (
		regional(hotbox, hitboxes, ishot);

		hitboxes = my("boxhitboxes"); // fetch ONCE, see performance note above

		repeat(my("rows"), // find hot box, but only among the visible ones
			if(isundefined(hotbox)
				& eval(my("isvisible"), 'entryindex->#)
				& inrectangle(hitboxes_#, mouse().xy),
				hotbox = #;
				self():"hotboxindex" = hotbox;
			);
		);

		if(isundefined(hotbox), self():"hotboxindex" = NADA);

		// Hot if a box is hit. Scroll buttons only count when they exist:
		// a hidden Button returns ___ from its "ishot", which would poison
		// the whole expression and stop "click" from ever firing.
		ishot = !isundefined(hotbox);
		if(my("needsscrolling"),
			ishot = ishot
				% tobool(my("scrollupbutton"):"ishot")
				% tobool(my("scrolldownbutton"):"ishot");
		);

		ishot; // Return
	);

	display:"setbuttoncoord" := if(!isundefined(my("hotboxindex")),
		regional(coord);
		coord = my("boxhitboxes")_(my("hotboxindex"))_3; // top right corner of selected box
		coord = coord - [my("removebutton"):"width", my("removebutton"):"height"]; // move down left
		coord = coord - my("boxpadding")*[1,1]; // move further down by DisplayHandlers padding
		my("removebutton"):"coord" = coord;
	);

	display:"draw" := (
		regional(shapes, hitboxes, labels, currentlabel, pos, boundingbox, textheight, textwidth);

		my("updatescroll");
		my("setscrollbuttoncoords");
		my("setbuttoncoord"); // keep remove button in place even without dragging

		// Fetch ONCE. These are ":=" methods that rebuild the complete list on
		// every access; reading them inside the loop made drawing quadratic.
		shapes   = my("boxshapes");
		hitboxes = my("boxhitboxes");
		labels   = my("labels");

		repeat(my("rows"),
			if(eval(my("isvisible"), 'entryindex->#),
				// Draw box
				fill(shapes_#, 
					color->if(#==my("hotboxindex"), my("highlightcolor"), if(isodd(#), my("boxcolors")_1, my("boxcolors")_2))
				);

				// Draw value label
				currentlabel = labels_#;
				if(displayanglefully, currentlabel = GREEK:"g" + " = " + currentlabel);

				boundingbox = getboundingbox(currentlabel, hitboxes_#_1, my("fontsize"), my("font"));
				textheight = boundingbox_4_2 - boundingbox_1_2;
				textwidth  = boundingbox_2_1 - boundingbox_1_1;

				pos = hitboxes_#_2;
				pos_1 = pos_1 - textwidth - toolbarmargin; // align to the right of the box
				if(#==my("hotboxindex"), pos_1 = pos_1 - my("removebutton"):"width" - toolbarmargin); // room for button
				pos_2 = pos_2 + toolbarmargin/2; // offset up by half the heights padding
				pos_2 = pos_2 + pixelsize(currentlabel, size->my("fontsize"), font->my("font"))_3 / screenresolution() / 2;
				drawtextbox(pos, currentlabel, my("fontsize"), my("font"), NADA, color->my("fontcolor"), bold->#==my("hotboxindex"));

				// Draw numbering in front of box (absolute index, independent of scrolling)
				currentlabel = # + ":";
				boundingbox = getboundingbox(currentlabel, hitboxes_#_1, my("fontsize"), my("font"));
				textwidth = boundingbox_2_1 - boundingbox_1_1;
				pos_1 = hitboxes_#_1_1 - textwidth - toolbarmargin;
				drawtextbox(pos, currentlabel, my("fontsize"), my("font"), NADA, color->if(isodd(#), my("boxcolors")_1, my("boxcolors")_2));

				// Draw remove button on the highlighted box
				if(#==my("hotboxindex"), my("removebutton"):"draw");
			);
		);

		// Draw scroll buttons
		if(my("needsscrolling"),
			my("scrollupbutton"):"draw";
			my("scrolldownbutton"):"draw";
		);
	);

	display:"move" := (
		my("ishot"); // highlight gets updated when dragging
		my("setbuttoncoord");
	);

	display:"moveend" := ();

	display:"click" := (
		// Scroll buttons first, they never overlap a box
		if(my("needsscrolling") & tobool(my("scrollupbutton"):"ishot"),
			my("scrollupbutton"):"script";
		,
			if(my("needsscrolling") & tobool(my("scrolldownbutton"):"ishot"),
				my("scrolldownbutton"):"script";
			,
				if(!isundefined(my("hotboxindex")) & tobool(my("removebutton"):"ishot"),
					my("removebutton"):"script";
				,
					if(!isundefined(my("hotboxindex")), my("onselect"));
				);
			);
		);
	);

	display:"onselect" := ();
	
	display; // Return DisplayHandler
);

// ================== //
// C | Initialization //
// ================== //

//  === Init Thales Trig ===

trig = new ThalesTrig(A,B,C);
trig:"drawcircle" = drawcircle;
trig:"drawcenter" = drawcenter;
trig:"showstampedpoints" = showstampedpoints;
trig:"showstampedvalues" = showstampedvalues;
trig:"showstampbutton" = showstampbutton;
trig:"showconstructionbutton" = showconstructionbutton;
trig:"showhelpbutton" = showhelpbutton;
trig:"showcurrentanglevalue" = showcurrentanglevalue;
trig:"softc" = softc; // soft construction if this is true
trig:"showhelp" = showhelp;
trig:"move"; // Trigger C to stick to circle if softc is false

//  === Init back button ===

backbutton = new ImageButton([0,0], 2, 2, ICONS:"undo");
backbutton:"imgscale" = .3;
backbutton:"coord" = if(isundefined(backbuttoncoord), (screenbounds()_1).xy + toolbarmargin*[1,-1] + [0, -backbutton:"height"], 	backbuttoncoord);

backbutton:"script" := (
	log button clicked(my("name"));
	
	if(length(trig:"history") > 1,

		regional(last);
		last = trig:"history"_(-1);
	
		// Handle move events
		while(last:"action" == "move",
			trig:(last:"object") = last:"oldcoord"; // Reset coord
			trig:"history" = trig:"history"_(1..(length(trig:"history")-1));
			last = trig:"history"_(-1);
		);
	
		// Handle stamp events
		if(last:"action" == "stamp",
			trig:"stamps" = trig:"stamps"_(1..(length(trig:"stamps")-1));
		);

		// Handle trace events
		if(last:"action" == "tracesegment",
			if(length(trig:"traces") > 0,
				trig:"traces" = trig:"traces"_(1..(length(trig:"traces")-1));
			);
			trig:"recordingtrace" = false;
		);
	
		// Handle remove events
		if(last:"action" == "removestamp",
			regional(i);
			i = last:"index";
			if(i==1, // Put at head
				trig:"stamps" = last:"coord" <: trig:"stamps"
			,
				if(i > length(trig:"stamps"), // Put at tail
					trig:"stamps" = trig:"stamps" :> last:"coord";
				, // Put in between
					trig:"stamps" = trig:"stamps"_(1..i-1) ++ [last:"coord"] ++ trig:"stamps"_(i..length(trig:"stamps"));
				);
			);
		);
		// Update history (i.e. remove handled entry)
		if(length(trig:"history") > 0,
			trig:"history" = trig:"history"_(1..(length(trig:"history")-1));
		);
	);
);


// === Init reset button ===

resetbutton = new ImageButton([0,0], 2, 2, ICONS:"reset2");
resetbutton:"imgscale" = .3;
resetbutton:"coord" = if(isundefined(resetbuttoncoord),
	if(showundobutton,
		backbutton:"coord" + toolbarmargin*[1,0] + [backbutton:"width",0],
		backbutton:"coord"   // rutscht auf die erste Position
	),
	resetbuttoncoord
);
resetbutton:"script" := (
	log button clicked(my("name"));
	
	trig:"C" = C;	// Reset C
	trig:"history" = []; // Clear history array
	trig:"stamps" = []; // Clear stamps
	trig:"traces" = []; // Clear trace
	trig:"recordingtrace" = drawtrace;	// back to configured initial state
);


// === Init stamp button ===

stampbutton = new ImageButton([0,0], 2, 2, ICONS:stampbuttonimage);
stampbutton:"imgscale" = .3;

// Set coord for stamp button
if(stickstampbuttontopoint,
	stampbutton:"coord" := (
		regional(labelwidth, buttoncoord);
		labelwidth = getboundingbox("C", [0,0], trig:"pointlabelsize", trig:"font");
		labelwidth = labelwidth_2 - labelwidth_1;
		buttoncoord = trig:"C" + [.2,.1]; // same offset like in trigs draw function when drawing label "C"
		buttoncoord = buttoncoord + labelwidth; // offset to the right by labelwidth
		buttoncoord = buttoncoord + [toolbarmargin,0]; // offset to the right some more
		buttoncoord;
	);
,
	stampbutton:"coord" = if(isundefined(stampbuttoncoord), (screenbounds()_2).xy - toolbarmargin*[1,1] - [stampbutton:"width",stampbutton:"height"], 	stampbuttoncoord);
);

stampbutton:"script" := (
	log button clicked(my("name"));
	log stamped point("C", trig:"C".xy, trig:"gamma");
 
	if(stampmode == "stamp" % !isundefined(triggerstamp),
		trig:"stamps" = trig:"stamps" :> trig:"C";
		trig:"history" = trig:"history" ++ [{"action" : "stamp", "object": "C", "coord" : trig:"C"}];
	, if(stampmode == "trace",
		trig:"recordingtrace" = !trig:"recordingtrace";
		if(trig:"recordingtrace",
			// switching ON: begin a new segment
			trig:"starttracesegment";
			trig:"history" = trig:"history" ++ [{"action" : "tracesegment"}];
		);
	));
);

// Change icon with state
stampbutton:"label" := if(stampmode == "trace",
	if(trig:"recordingtrace", ICONS:"traceon", ICONS:"traceoff"),
	ICONS:stampbuttonimage
);


// === Config placement of gamma value display ===

trig:"gammavalueposition" = if(isundefined(gammadisplaycoord), 
	if(trig:"showstampbutton" & !stickstampbuttontopoint,
		stampbutton:"coord" - [trig:"gammavaluedisplaywidth"+toolbarmargin,0],
		(screenbounds()_2).xy - toolbarmargin*[1,1] - [trig:"gammavaluedisplaywidth", trig:"gammavaluedisplayheight"]
	);
,
	gammadisplaycoord;
);


// === Init robust/soft construction button ===

if(!ISCINDYJS, imgoffset=[0,0]); // only use imgoffset if in CindyJS, since it does not care about "ref"

softrobustbutton = new Toggle([0,0], 1.5, !softc, "", NADA);
softrobustbutton:"coord" = if(showcurrentanglevalue, trig:"gammavalueposition", stampbuttoncoord) - [softrobustbutton:"width" + toolbarmargin, 0];
if(!isundefined(constructionbuttoncoord), softrobustbutton:"coord" = constructionbuttoncoord);
softrobustbutton:"imgscale" = .2;
softrobustbutton:"highlightcolor" = DZLMCOLORDARK;
softrobustbutton:"script" := (
	log button clicked(my("name"));
	
	trig:"softc" = !trig:"softc";
	trig:"pointcolor"_3 = trig:"pointcolor"_3 + if(trig:"softc", [.2,.2,.2], -[.2,.2,.2]); // change color of C to represent state change
	trig:"move";
);
softrobustbutton:"drawafter" := (
	drawimage(my("coord")+ [my("width")/2,my("height")+.1]+imgoffset, ICONS:"pointoncircle", scale->my("imgscale"), ref->["50%","0%"]);
);


// === Init visual help toggle button ===

helpbutton = new Toggle([0,0], 1.5, showhelp, "", NADA);
helpbutton:"coord" = if(showconstructionbutton, softrobustbutton:"coord", trig:"gammavalueposition") - [softrobustbutton:"width" + 2*toolbarmargin, 0];
if(!isundefined(helpbuttoncoord), helpbutton:"coord" = helpbuttoncoord);
helpbutton:"imgscale" = .2;
helpbutton:"highlightcolor" = DZLMCOLORDARK;
helpbutton:"script" := (
	log button clicked(my("name"));
	
	trig:"showhelp" = !trig:"showhelp";
);
helpbutton:"drawafter" := (
	drawimage(my("coord")+ [my("width")/2,my("height")+.1]+imgoffset, ICONS:"bucket2", scale->my("imgscale"), ref->"cb");
);


// === Init DisplayHandler ===

display = new DisplayHandler([0,0]);
display:"coord" := [
	VISIBLERECT_2_1 - toolbarmargin - my("boxwidth"),
	trig:"gammavalueposition"_2 - my("boxheight") - toolbarmargin
];
if(!isundefined(gammalistcoord), display:"coord" = gammalistcoord);

// display:"boxwidth" = trig:"gammavaluedisplaywidth"; // set by display instead
display:"labels" := (
	regional(labels);
	labels = apply(trig:"stamps", # = angle(trig:"A", #, trig:"B")+0); // Get angle in rad
	labels = apply(labels, # = if(# > PI, 2*PI-#, #)); // normalize angle
	labels = apply(labels, 
		# = replace(format(# / PI * 180,2),".",",");
		if(!contains(list(#),","), # = # + ",00"); // add 2 zeros if no decimal
		if(#_(-2) == ",", # = # + "0"); // add 1 zero if only one decimal
		# = # + "°"; // add degree symbol
	);
);

display:"removebutton":"script" := (
	log button clicked(my("name"));
	
	regional(hotboxindex);
	hotboxindex = display:"hotboxindex";

	// Add event to history
	trig:"history" = trig:"history" ++ [{"action" : "removestamp", "index": hotboxindex, "coord" : trig:"stamps"_hotboxindex}];

	// Remove object from stamps
	trig:"stamps" = trig:"stamps"_(1..hotboxindex-1)
		++ trig:"stamps"_(hotboxindex+1..length(trig:"stamps"));

	// Reset hotboxindex, if last element has been removed
	display:"hotboxindex" = min(hotboxindex, display:"rows");
	if(display:"hotboxindex"==0, display:"hotboxindex" = NADA, display:"setbuttoncoord");
);

// === Wire trig up against display ===
trig:"anglelist" = display;
display:"handle" = trig;
if(jumptostamp,
	display:"onselect" := (
		my("handle"):"C" = my("handle"):"stamps"_(my("hotboxindex"));
	);
);

// === Init draw helper toggles ===

regional(yoffset, fontsize, refcoord);

refcoord = if(isundefined(backbuttoncoord), backbutton:"coord", [-1,18]);
if(!isundefined(togglerefcoord), refcoord = togglerefcoord);
yoffset = 1.8;
fontsize = 20;

drawalpha = new Toggle(refcoord-[0,2],1.5,showalpha,GREEK:"a",fontsize);
drawalpha:"highlightcolor" = trig:"anglecolor"_1;
trig:"drawalpha" := drawalpha:"state";
drawalpha:"script" := log button clicked(my("name"));

drawbeta = new Toggle(drawalpha:"coord"-[0,yoffset],1.5,showbeta,GREEK:"b",fontsize);
drawbeta:"highlightcolor" = trig:"anglecolor"_2;
trig:"drawbeta" := drawbeta:"state";
drawbeta:"script" := log button clicked(my("name"));

drawgamma = new Toggle(drawbeta:"coord"-[0,yoffset],1.5,showgamma,GREEK:"g",fontsize);
drawgamma:"highlightcolor" = trig:"anglecolor"_3;
trig:"drawgamma" := drawgamma:"state";
drawgamma:"script" := log button clicked(my("name"));

// dont use CM toggle, should be drawn iff gamma1 or gamma2 are drawn
drawCM = new Toggle(drawgamma:"coord"-[0,yoffset],1.5,showCM,"$\overline{CM}$",fontsize-3);
drawCM:"highlightcolor" = DIVOBLACK;
trig:"drawradius" := drawCM:"state";
drawCM:"script" := log button clicked(my("name"));

drawgamma1 = new Toggle(drawgamma:"coord"-[0,yoffset],1.5,showgamma1,GREEK:"g"+SUB:"1",fontsize);
drawgamma1:"highlightcolor" = trig:"anglecolor"_4;
drawgamma1:"highlightcolor" := if(helpbutton:"state" & trig:"gamma"~=PI/2, trig:"anglecolor"_1, trig:"anglecolor"_4);
trig:"drawgamma1" := drawgamma1:"state";
drawgamma1:"script" := log button clicked(my("name"));

drawgamma2 = new Toggle(drawgamma1:"coord"-[0,yoffset],1.5,showgamma2,GREEK:"g"+SUB:"2",fontsize);
drawgamma2:"highlightcolor" := if(helpbutton:"state" & trig:"gamma"~=PI/2, trig:"anglecolor"_2, trig:"anglecolor"_5);
trig:"drawgamma2" := drawgamma2:"state";
drawgamma2:"script" := log button clicked(my("name"));

drawanglevalues = new Toggle(drawgamma2:"coord"-[0,yoffset],1.5,showanglevalues,"Winkel messen",fontsize);
drawanglevalues:"highlightcolor" = DIVOBLACK;
trig:"drawanglevalues" := drawanglevalues:"state";
drawanglevalues:"script" := log button clicked(my("name"));

obj = obj :> trig;
if(showundobutton, obj = obj :> backbutton);
if(showresetbutton, obj = obj :> resetbutton);

if(trig:"showstampbutton", obj = obj :> stampbutton);
if(trig:"showconstructionbutton", obj = obj :> softrobustbutton);
if(trig:"showhelpbutton", obj = obj :> helpbutton);
if(trig:"showstampedvalues", obj = obj :> display);
if(drawtogglealpha, obj = obj :> drawalpha);
if(drawtogglebeta, obj = obj :> drawbeta);
if(drawtogglegamma, obj = obj :> drawgamma);
//if(drawtoggleCM, obj = obj :> drawCM);
if(drawtogglegamma1, obj = obj :> drawgamma1);
if(drawtogglegamma2, obj = obj :> drawgamma2);
if(drawtogglevalues, obj = obj :> drawanglevalues);
);