// v1
// Dummy VAM
if(VAM == "default",

// A | Documentation
DOCTEXT = "
Ein Platzhalter VAM ohne bestimmte Funktionalität.
";


// ================= //
// Divomath settings //
// ================= //

/**
* @override
**/
divomathSetState() := (
	regional(state);

	debug at("divomath set state() in VAM: default", "Calling divomathSetState from default VAM.");

	state = DIVOMATH'VARSTATE; // original state (should be preserved)
	state.color = [0,1,0]; // change to green on next reload
	state.coord = [42,69]; // put "coord" value with some value in state for reasons
	state.astring = wrap quote("defaultVAM"); // strings need to be enclosed in quotion marks, otherwise VAM breaks in divomath platform
	NADA; // Return state;
);

o = new VAMobject("Default");
o:"coord" = [4,12];
o:"ismoveable" = true;
o:"isclickable"  = true;
o:"color" = DARKRED;

o:"draw" := (
	fill(
		circle(my("coord"), 1),
		color -> my("color")
	);
	
	draw(
		my("coord"),
		color -> [1,1,1]
	);
	
	drawtext(my("coord")+[.1,.1],my("coord"));
);

o:"click" := (
	set my("color", [random(),random(),random()]);
	divomath push results();
);

obj = obj :> o;
LOGLEVEL = 10;
);
