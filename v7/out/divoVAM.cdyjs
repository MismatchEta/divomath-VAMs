    "icon-undo-DZLMDARK.png": "https://abako.dzlm.de/cindy/divomath/img/icon-undo-DZLMDARK.png",
    "legs.png": "https://abako.dzlm.de/cindy/divomath/img/legs.png",
    "snap.png": "https://abako.dzlm.de/cindy/divomath/img/snap.png",
    "tracebuttonimageoff.png": "https://abako.dzlm.de/cindy/divomath/img/tracebuttonimageoff.png",
    "tracebuttonimageon.png": "https://abako.dzlm.de/cindy/divomath/img/tracebuttonimageon.png"
  },
cinderella: {build: 2131, version: [3, 0, 2131]}
});