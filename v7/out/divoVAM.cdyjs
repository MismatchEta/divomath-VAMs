//[FW] Config
/** v1 ******************************************************************************************
* Vars for configuring general VAM behavior. 
* Most of them can get overwritten by ENVIRONMENTALPARAMATERS at Init.
*
* Recent changes:
************************************************************************************************/

// ========== //
// Vam choice //
// ========== //

VAM = "doublenumberline";


// ============ //
// Screen stuff //
// ============ //

BORDERSIZE = .05; // default border size (equals 0.5 mm fineliner)
PINCHSENSITIVITY = 1; // default pinch sensitivity
BGCOLOR = grey(1);


// ================ //
// VAM doc defaults //
// ================ //

DOCTEXTPOS = VRTOPLEFT + [1,-0.5];
DOCTEXT = "No docstring for VAM.";


// ========================================= //
//             Debug Level					 				 //
// - LOGNONE  (0)	= no debugging,			 			 //
// - LOGERROR (1)	= Errors only,			 			 //
// - LOGWARN  (2)	= Errors + Warnings,	 		 //
// - LOGDEBUG (3)	= Errors + Warning + Debug //
// ========================================= //

LOGLEVEL = LOGNONE; 			// Local overwrite for debuglevel set by environment
MAXLOGMESSAGES = 50;			// Number of last messages stored in LOGMESSAGES
MSGTOKEN = "sl_cjs_v1";		// Security feature for "post value(3)"


// ============= //
// Event logging //
// ============= //

LOGGINGENABLED = false;

PROGRAMID = version() + "";
SCENARIOID = NADA; 										// Gets set in var init with VAM choice. Overwrite in VAM if needed.
USERID = "user-" + random(1000000);		// Gets overwritten by ENVIRONMENTALPARAMS

// Local event log
EVENTLOG = [];
EVENTID = 0;		// Auto incrementing
//[FW] Init start
/** v4 ******************************************************************************************
* Init of general variables for use in the framework.
*
* Recent changes:
* 2026-06-11: Remove objpreview, history and preview flag (potentially breaks older VAMs).
* 2026-07-25: Add divomath configuration items "vam", "debuglevel" and "bgcolor" to ENVIRONMENTALPARAMS
* 2026-07-27: Fix parsing issues for LOGLEVEL and MAXLOGMESSAGES
* 2026-07-29: Add access to LOGGINGENABLED via ENVIRONMENTALPARAMS
************************************************************************************************/

// =========================== //
// Get Environmental Paramters //
// =========================== //

ENVIRONMENTALPARAMS = {};

// Get parameters from URL get requests.
if(ISCINDYJS, ENVIRONMENTALPARAMS = get url params());

// Get/overwrite parameters for divomath environments.
if(ISDIVOMATH, ENVIRONMENTALPARAMS = divomath get params());

// Get/overwrite specific additional parameters from divomaths "configuration"
if(ISDIVOMATH,
	add property(ENVIRONMENTALPARAMS, "vam", DIVOMATH'CONFIG:"vam");
	add property(ENVIRONMENTALPARAMS, "bgcolor", DIVOMATH'CONFIG:"bgcolor");
	add property(ENVIRONMENTALPARAMS, "debuglevel", DIVOMATH'CONFIG:"debuglevel");
);

if(!isundefined(ENVIRONMENTALPARAMS:"vam"), VAM = ENVIRONMENTALPARAMS:"vam");
if(!isundefined(ENVIRONMENTALPARAMS:"bgcolor"), BGCOLOR = parse(ENVIRONMENTALPARAMS:"bgcolor"+""));
if(!isundefined(ENVIRONMENTALPARAMS:"loggingenabled"), LOGGINGENABLED = parse(ENVIRONMENTALPARAMS:"loggingenabled"+""));

get screen params(); // Sets bordersize and pinchsensitivity


// ===== //
// Flags //
// ===== //

FIRSTDRAW					= true;		// For handling stuff that should only happen on first call of draw script
MOUSEDOWN					= false;	// Toggles in relevant mouse scripts
MOUSEPRESSEDTIME	= false;
INITDONE					= false;	// Signal when init script is done


// ========== //
// Debug Logs //
// ========== //

LOGONCEKEYS = []; // Keys for stuff that should only be logged once (see "log once(2)" in [FUN] Logging)
LOGMESSAGES = [];	// Storage for the last n logs (n configurable with MAXLOGMESSAGES)

if(!isundefined(ENVIRONMENTALPARAMS:"debuglevel"), LOGLEVEL = parse(ENVIRONMENTALPARAMS:"debuglevel"+""));
if(!isundefined(ENVIRONMENTALPARAMS:"maxlogmessages"), MAXLOGMESSAGES = parse(ENVIRONMENTALPARAMS:"maxlogmessages"+""));


// ============= //
// Event logging //
// ============= //

SCENARIOID = "Cindy VAM: " + VAM;

if(!isundefined(ENVIRONMENTALPARAMS:"userid"), USERID = ENVIRONMENTALPARAMS:"userid");

log started();


// ========== //
// Main lists //
// ========== //

obj = []; 				// All relevant VAM objects (sort of god object).
typeorder = [];		// Order in which objects should be drawn by their "type" attribute.
animations = [];	// Handles animation object.
//[C] Button
/** v9 ******************************************************************************************
* Classes for Button, ImageButton.
*
* Recent changes:
* 2026-07-24: Added "hasbody" property to control drawing of button
************************************************************************************************/

new Button(coord,width,height,label,fontsize) := (
	regional(obj);
	obj = new VAMobject("Button");

	obj:"coord"  = coord;
	obj:"width"  = width;
	obj:"height" = height;
	obj:"cornerradius" = (width+height) / 50;
	obj:"color"	 = DZLMCOLORLIGHT;
	obj:"bordercolor" = DZLMCOLORDARK;
	obj:"fontcolor" = DZLMCOLORDARK;
	obj:"label"	 = label;
	obj:"fontsize" = defaultto(fontsize, 12) * FONTSCALE;
	obj:"fontfamily" = NADA;
	obj:"labelheight" = (
		regional(box);
		box = getboundingbox(label,[0,0],obj:"fontsize",obj:"fontfamily");
		box_4_2 - box_1_2;
	);

	obj:"ismoveable" = false;
	obj:"isfloating" = false;
	obj:"hasbody" = true;
	obj:"hasshadow" = true;
	obj:"hasborder" = true;
	obj:"show" = true;
	obj:"customlabeloffset" = [0,0];
	obj:"shadowoffset" = [0.03,-.05];

	obj:"symbolsize" = .22;   // half length of the symbol, relative to button width
	obj:"symbolweight" = 3;   // line width
	obj:"symbolcentre" := my("hitbox")_1 + .5 * (my("hitbox")_3 - my("hitbox")_1); // centre of button, used by drawn symbols
	obj:"symbolradius" := my("symbolsize") * min(my("width"), my("height")); // radius of drawn symbols in world units
	
	obj:"hitbox" := rectangle(
		my("coord"),
		my("width"),
		my("height")
	);
	obj:"shape" := roundedrectangle(
		my("coord"),
		my("width"),
		my("height"),
		my("cornerradius")
	);
	obj:"draw" := if(my("show"),
		// Draw shadow
		if(my("hasshadow") & (my("hasbody") % my("hasborder")),
			fill(roundedrectangle(
				my("coord")+my("shadowoffset"),
				my("width"),
				my("height"),
				my("cornerradius")
				),
				color->[0,0,0],
				alpha->0.2
			);
		);

		// Fill box
		if(my("hasbody"),
			fill(
				my("shape"),
				color->if(MOUSEDOWN & my("ishot"),0.95*my("color"),my("color")),
				alpha->1
			);
		);

		// Draw border
		if(my("hasborder"), draw(my("shape"), color->my("bordercolor")));
		
		// Draw Label
		regional(centre, px);

		centre = my("hitbox")_1 + .5 * (my("hitbox")_3 - my("hitbox")_1);
		px = pixelsize(my("label"), size->my("fontsize"), font->my("fontfamily")) / screenresolution();

		drawtext(
			centre - [px_1/2, (px_2 - px_3)/2] + my("customlabeloffset"),
			my("label"),
			size->my("fontsize"), font->my("fontfamily"),
			color->my("fontcolor"), bold->false
		);

		// Draw something after the button
		my("drawafter");

		// Debug draw
		if(LOGLEVEL > 2,
			connect([my("hitbox")_1,my("hitbox")_3], color->[0,1,0]);
			connect([my("hitbox")_2,my("hitbox")_4], color->[0,1,0]);
			drawpoly(getboundingbox(my("label"), offset+my("customlabeloffset"), my("fontsize"), my("fontfamily")));
		);
	);
	obj:"drawafter" := NADA;
	obj:"ishot" := if(my("show"),inrectangle(my("hitbox"),mouse().xy));
  obj:"click"	:= my("script");
  obj:"script" := println("Implement obj:script");

	obj:"move" := if(my("isfloating"),
		self():"coord" = my("coord") + mousedelta;
	);

	// --- Drawing methods for special buttons ---
	obj:"drawplus" := (
		regional(c, r);
		c = my("symbolcentre");
		r = my("symbolradius");
 
		draw(c - [r,0], c + [r,0], size->my("symbolweight"), color->my("fontcolor"));
		draw(c - [0,r], c + [0,r], size->my("symbolweight"), color->my("fontcolor"));
	);
 
	obj:"drawminus" := (
		regional(c, r);
		c = my("symbolcentre");
		r = my("symbolradius");
 
		draw(c - [r,0], c + [r,0], size->my("symbolweight"), color->my("fontcolor"));
	);
 
	obj:"drawcross" := (
		regional(c, r);
		c = my("symbolcentre");
		// A diagonal cross looks bigger than a plus of the same radius,
		// so shrink it a little to match visually.
		r = my("symbolradius") * .8;
 
		draw(c + [-r,-r], c + [r, r], size->my("symbolweight"), color->my("fontcolor"));
		draw(c + [-r, r], c + [r,-r], size->my("symbolweight"), color->my("fontcolor"));
	);

	obj; // Return the button.
);


new ImageButton(coord,width,height,imgpath) := (
	regional(imgbtn);
	imgbtn = new Button(coord, width, height, imgpath, NADA);

	imgbtn:"imgscale" := (
		// scale-> is relative to the image's PIXEL size, so the resulting world
		// size depends on screenresolution() - the same icon comes out larger
		// in divomath than in the plain HTML. Therefore we derive the factor from
		// the button instead.
		regional(px);
		px = imagesize(my("label"));
		my("imgfill") * min(my("width"), my("height")) * screenresolution() / max(px_1, px_2);
	);
	imgbtn:"imgfill" = .9; // how much of the button the image should fill

	imgbtn:"draw" := if(my("show"),
		// Draw shadow
		if(my("hasshadow"),
			fill(roundedrectangle(
				my("coord")+[0.03,-0.05],
				my("width"),
				my("height"),
				my("cornerradius")
				),
				color->[0,0,0],
				alpha->0.2
			);
		);

		// Draw box and border
		fill(
			my("shape"),
			color->if(MOUSEDOWN&my("ishot"),0.95*my("color"),my("color")),
			alpha->1
		);
		if(my("hasborder"), draw(
			my("shape"),
			color->my("bordercolor");
		));

		// Draw image
		drawimage(my("coord") + .5*[my("width"), my("height")], my("label"),
			scale->my("imgscale"), rendering->"nice");

		// Draw something after the button has been drawn
		my("drawafter");
	);

	imgbtn; // Return the button.
);
//[C] CoordinateSystem
/** v1 ******************************************************************************************
* Class for Coordinate System.
*
* Recent changes:
************************************************************************************************/

new CoordinateSystem(coord) := (
	regional(system);
	system = new VAMobject("CoordinateSystem");

	system:"coord" = if(isundefined(coord),
		.5*(VRTOPLEFT + VRBOTTOMRIGHT);
	, // else
		coord
	);
	
	system:"leftborder" = VRTOPLEFT_1;
	system:"rightborder" = VRTOPRIGHT_1;
	system:"upperborder" = VRTOPLEFT_2;
	system:"lowerborder" = VRBOTTOMLEFT_2;
	system:"leftborder-point" := [my("leftborder"),my("coord")_2];
	system:"rightborder-point" := [my("rightborder"),my("coord")_2];
	system:"upperborder-point" := [my("coord")_1,my("upperborder")];
	system:"lowerborder-point" := [my("coord")_1,my("lowerborder")];
	system:"boundingbox" := [
		[my("leftborder"), my("lowerborder")],
		[my("rightborder"), my("lowerborder")],
		[my("rightborder"), my("upperborder")],
		[my("leftborder"), my("upperborder")]
	];

	system:"functions" = [];

	// Look and feel fields
	system:"color" = grey(.3);
	system:"drawboundingbox" = true;
	system:"drawxaxis" = true;
	system:"drawyaxis" = true;
	system:"drawxticks" = true;
	system:"drawyticks" = true;
	system:"ticklength" = .25;
	system:"xtickdistance" = 1;
	system:"ytickdistance" = 1;
	system:"drawwhicharrows" = ["R", "U", "L", "D"]; // use to indicate arrow in directions *L*eft, *R*ight, *U*p or *D*down
	system:"arrowsize" = 1;

	system:"ishot" := inrectangle(my("boundingbox"), mouse().xy);
	
	system:"draw" := (
		regional(xinframe, yinframe);
		xinframe = my("upperborder") > my("coord")_2 & my("lowerborder") < my("coord")_2;
		yinframe = my("rightborder") > my("coord")_1 & my("leftborder") < my("coord")_1;
	
		// Draw bounding box
		if(my("drawboundingbox"), drawpoly(my("boundingbox"), color->my("color")));
		
		// Draw x- and y-axis
		if(my("drawxaxis") & xinframe, connect([my("leftborder-point"),my("rightborder-point")], color->my("color")));
		if(my("drawyaxis") & yinframe, connect([my("lowerborder-point"),my("upperborder-point")], color->my("color")));

		// Draw ticks
		if(my("drawxticks") & xinframe,
			eval(my("__drawticks"), direction->"right");
			eval(my("__drawticks"), direction->"left");
		);
		if(my("drawyticks") & yinframe,
			eval(my("__drawticks"), direction->"up");
			eval(my("__drawticks"), direction->"down");
		);

		// Draw arrow heads
		if(contains(my("drawwhicharrows"), "L") & xinframe, eval(my("__drawarrowhead", direction->"left")));
		if(contains(my("drawwhicharrows"), "R") & xinframe, eval(my("__drawarrowhead", direction->"right")));
		if(contains(my("drawwhicharrows"), "U") & yinframe, eval(my("__drawarrowhead", direction->"up")));
		if(contains(my("drawwhicharrows"), "D") & yinframe, eval(my("__drawarrowhead", direction->"down")));

		// Plot any functions
		my("drawplots");

		// Sophisticated y-clipping
		fillpoly([
			[my("leftborder"), my("upperborder")],
			[my("rightborder"), my("upperborder")],
			[my("rightborder"), VRTOPLEFT_2],
			[my("leftborder"), VRTOPLEFT_2],
		], color->grey(1));
		fillpoly([
			[my("leftborder"), my("lowerborder")],
			[my("rightborder"), my("lowerborder")],
			[my("rightborder"), VRBOTTOMLEFT_2],
			[my("leftborder"), VRBOTTOMLEFT_2],
		], color->grey(1));
	);
	
	system:"__drawticks" := ( // eval with "direction" from ["up", "down", "left", "right"]
		regional(numberofticks, refpoint);
		if(direction == "up",
			numberofticks = floor(abs(my("upperborder")-my("coord")_2)/my("ytickdistance"));
			refpoint = my("coord") - [my("ticklength")/2, 0];
			repeat(numberofticks + 1,
				connect([refpoint,refpoint + [my("ticklength"), 0]], color->my("color"));
				refpoint = refpoint + [0, my("ytickdistance")];
			);
		, if(direction == "down",
			numberofticks = floor(abs(my("lowerborder")-my("coord")_2)/my("ytickdistance"));
			refpoint = my("coord") - [my("ticklength")/2, 0];
			repeat(numberofticks + 1,
				connect([refpoint,refpoint + [my("ticklength"), 0]], color->my("color"));
				refpoint = refpoint - [0, my("ytickdistance")];
			);
		, if(direction == "left",
			numberofticks = floor(abs(my("leftborder")-my("coord")_1)/my("xtickdistance"));
			refpoint = my("coord") - [0, my("ticklength")/2];
			repeat(numberofticks + 1,
				connect([refpoint,refpoint + [0, my("ticklength")]], color->my("color"));
				refpoint = refpoint - [my("xtickdistance"), 0];
			);
		, if(direction == "right",
			numberofticks = floor(abs(my("rightborder")-my("coord")_1)/my("xtickdistance"));
			refpoint = my("coord") - [0, my("ticklength")/2];
			repeat(numberofticks + 1,
				connect([refpoint,refpoint + [0, my("ticklength")]], color->my("color"));
				refpoint = refpoint + [my("xtickdistance"), 0];
			);
		, // else:
			err("__drawticks:: Eval with correct direction from [up, down, left, right], not " + QUOTE + direction + QUOTE);
		))));
	);

	system:"__drawarrowhead" := ( // eval with "direction" from ["up", "down", "left", "right"]
		regional(lengthscale, arrow);

		//lengthscale = 1/(2*tan(7.5°)); // produces arrow heads with an opening angle of 15°
		lengthscale = 2;
		
		if(direction == "up",
			arrow = [
				my("upperborder-point"),
				my("upperborder-point") - my("arrowsize")*[my("ticklength")/2, lengthscale*my("ticklength")],
				my("upperborder-point") - my("arrowsize")*[-my("ticklength")/2, lengthscale*my("ticklength")],
			];
		, if(direction == "down",
			arrow = [
				my("lowerborder-point"),
				my("lowerborder-point") + my("arrowsize")*[my("ticklength")/2, lengthscale*my("ticklength")],
				my("lowerborder-point") + my("arrowsize")*[-my("ticklength")/2, lengthscale*my("ticklength")],
			];
		, if(direction == "left",
			arrow = [
				my("leftborder-point"),
				my("leftborder-point") + my("arrowsize")*[lengthscale*my("ticklength"), my("ticklength")/2],
				my("leftborder-point") + my("arrowsize")*[lengthscale*my("ticklength"), -my("ticklength")/2],
			];
		, if(direction == "right",
			arrow = [
				my("rightborder-point"),
				my("rightborder-point") - my("arrowsize")*[lengthscale*my("ticklength"), my("ticklength")/2],
				my("rightborder-point") - my("arrowsize")*[lengthscale*my("ticklength"), -my("ticklength")/2],
			];
		, // else:
			err("__drawarrowhead:: Eval with correct direction from [up, down, left, right], not " + QUOTE + direction + QUOTE);
		))));

		drawpoly(arrow, color->my("color"));
		fillpoly(arrow, color->my("color"));
	);

	system:"move" := self():"coord" = my("coord") + mousedelta;

	// Stuff for function plotting
	system:"__T" := my("coord") + 1 * p; // eval with point "p", @todo: 1 should be scaling parameter, when scaling is implemented
	system:"__T'" := (p - my("coord")) / 1; // eval with point "p"
	system:"functionkeys" := select(keys(self()), substring(#,0,4) == "@fn:");
	system:"drawplots" := (
		forall(my("functionkeys"), key,
			plot(
				eval(my("__T"), p->[#,eval(my(key),x->#)]),
				start -> eval(my("__T'"), p->[my("leftborder"),0])_1,
				stop -> eval(my("__T'"), p->[my("rightborder"),0])_1,
				color -> [1,0,0],
				size -> 2,
				connect -> false
			);
		);
	);

	system:"@fn:f" := sin(x); // Add new functions with keys starting with "@fn:" so they geht recognized by "functionskeys"
	system:"@fn:g" := 1/(x+2);
	system:"@fn:test" := x - floor(x);
	
	system; // Return
);

//[C] Keyboard
/** v4 ******************************************************************************************
* Classes for key and keyboard.
*
* Recent changes:
* 2026-07-13 Add similar fix as in Toggle class for iPad pen issue
* 2026-08-15 Add "full" layout (QWERTZ with shift), taken over from divoVAM 3.1.0 for the
*            doublenumberline VAM. The numeric layout is untouched, so existing VAMs keep
*            working exactly as before.
************************************************************************************************/
// Global config
'fontsize = 16 * FONTSCALE;
'size = 1;

// Special keys. They carry a marker label instead of the character they insert,
// so the click handler can tell them apart from ordinary keys.
'keyshift = unicode("21E7"); // shift
'keyspace = unicode("2423"); // space

// Key for Keyboard
new Key(coord, width, height, label) := (
	regional(key);
	key = new Button(coord, width, height, label, 'fontsize);
	key:"type" = "key";
	key:"target" = target;
	key:"bordercolor" = key:"color" * .8;
	key:"cornerradius" = 0;
	key:"hasshadow" = false;

	key:"script" := my("label"); // Return label

	key; // Return Key;
);

new Key(coord, size, label) := new Key(coord, size, size, label);

// Keyboard
new Keyboard(coord, subtype, keysize, target) := (
	regional(board, subtypes);
	board = new VAMobject("keyboard");
	subtypes = ["full", "numeric"];
	board:"subtype" = if(contains(subtypes,subtype),subtype,"full");
	board:"coord" = coord;
	board:"keysize" = keysize;
	board:"keys" = [];
	board:"margin" = .2;
	board:"ismoveable" = false;

	board:"target" = target;
	board:"value" = "";

	// Only used by the "full" layout: whether the shift key is engaged.
	board:"shift" = false;

	board:"ishot" := length(select(my("keys"),#:"ishot")) > 0;

	// for iPad pen fix
	board:"ipadpentimestampfix" = -1;
	board:"lastkeypressed" = "";

	/**
	* Rows of the "full" layout, top to bottom.
	*   "indent" shifts the whole row to the right, in key widths
	*   "keys"   is a list of labels or [label, widthfactor] pairs
	* Both layouts must have the same shape.
	*/
	board:"fulllayout" = [
		{"indent": 0, "keys": ["1","2","3","4","5","6","7","8","9","0","ß",[LEFTARROW, 2]]}, // for keyboard layout use indent 0
		{"indent": 0, "keys": ["q","w","e","r","t","z","u","i","o","p","ü"]}, // for keyboard layout use indent .5
		{"indent": 0, "keys": ["a","s","d","f","g","h","j","k","l","ö","ä"]}, // for keyboard layout use indent .75
		{"indent": 0, "keys": [['keyshift, 2], "y","x","c","v","b","n","m"]}, // for keyboard layout use indent .25
		{"indent": 3,  "keys": [['keyspace, 5]]}
	];
	board:"fulllayoutshift" = [
		{"indent": 0, "keys": ["!",QUOTE,"§","$","%","&","/","(",")","=","?",[LEFTARROW, 2]]},
		{"indent": 0, "keys": ["Q","W","E","R","T","Z","U","I","O","P","Ü"]},
		{"indent": 0, "keys": ["A","S","D","F","G","H","J","K","L","Ö","Ä"]},
		{"indent": 0, "keys": [['keyshift, 2], "Y","X","C","V","B","N","M"]},
		{"indent": 3, "keys": [['keyspace, 5]]}
	];

	/**
	* (Re)build the keys. Called once at construction and again whenever shift
	* is toggled - the labels change, so the keys have to be recreated.
	*/
	board:"buildkeyboard" := (
		regional(rows, keys, y, x, rowindex, entry, label, factor, ksize, margin);

		ksize = my("keysize");
		margin = my("margin");
		keys = [];

		if(my("subtype") == "numeric",
			// --- numeric: unchanged from v3, positions must stay identical ---
			// row 4 (bottom)
			keys = keys :> new key(my("coord") + [margin, margin], ksize, "0");
			keys = keys :> new key(my("coord") + [2*margin+ksize, margin], ksize, ".");
			keys = keys :> new key(my("coord") + [3*margin+2*ksize, margin], ksize, LEFTARROW);

			// row 3
			keys = keys :> new key(my("coord") + [margin, 2*margin+ksize], ksize, "1");
			keys = keys :> new key(my("coord") + [2*margin+ksize, 2*margin+ksize], ksize, "2");
			keys = keys :> new key(my("coord") + [3*margin+2*ksize, 2*margin+ksize], ksize, "3");

			// row 2
			keys = keys :> new key(my("coord") + [margin, 3*margin+2*ksize], ksize, "4");
			keys = keys :> new key(my("coord") + [2*margin+ksize, 3*margin+2*ksize], ksize, "5");
			keys = keys :> new key(my("coord") + [3*margin+2*ksize, 3*margin+2*ksize], ksize, "6");

			// row 1 (top)
			keys = keys :> new key(my("coord") + [margin, 4*margin+3*ksize], ksize, "7");
			keys = keys :> new key(my("coord") + [2*margin+ksize, 4*margin+3*ksize], ksize, "8");
			keys = keys :> new key(my("coord") + [3*margin+2*ksize, 4*margin+3*ksize], ksize, "9");

			// Return key, two rows high
			keys = keys :> new key(my("coord") + [4*margin+3*ksize, margin],
				ksize, 2*ksize + margin, DOWNARROWTIPLEFT);
		,
			// --- full: built from the layout table, bottom row first ---
			rows = if(my("shift"), my("fulllayoutshift"), my("fulllayout"));

			forall(1..length(rows), rowindex,
				regional(row);
				row = rows_rowindex;
				y = margin + (length(rows) - rowindex) * (ksize + margin);
				x = margin + row:"indent" * (ksize + margin);

				forall(row:"keys", entry,
					if(islist(entry), label = entry_1; factor = entry_2;
					,                 label = entry;   factor = 1;);

					// a blank label is a spacer, not a key
					if(label != " ",
						keys = keys :> new key(my("coord") + [x, y],
							factor*ksize + (factor-1)*margin, ksize, label);
					);

					x = x + factor*ksize + factor*margin;
				);
			);

			// Return key, spanning the two middle rows on the right
			keys = keys :> new key(
				my("coord") + [margin + 11*(ksize+margin), margin + 2*(ksize+margin)],
				2*ksize+margin, 2*ksize + margin, DOWNARROWTIPLEFT);
		);

		self():"keys" = keys;
	);

	board:"click" := (
		regional(key, value);
		value = my("value");
		key = select(my("keys"),#:"ishot"); // Get all the hot keys (should be exactly one)
		if(length(key) > 0, key = key_1:"label");

		// fix for iPad pen issue: swallow duplicate fire of the SAME key
		if(key == my("lastkeypressed") & timestamp() - my("ipadpentimestampfix") < 100,
			// duplicate -> ignore
		,
			self():"ipadpentimestampfix" = timestamp();
			self():"lastkeypressed" = key;

			// Shift: flip the state and rebuild with the other labels.
			// Handled first, it must not end up in the value.
			if(key == 'keyshift,
				self():"shift" = !my("shift");
				my("buildkeyboard");
			,
				// Add character if not clicked on an arrow key
				if(!contains([DOWNARROWTIPLEFT, LEFTARROW], key),
					// the space key carries a marker label, insert a real space
					value = value + if(key == 'keyspace, " ", key);
				);

				// Execute targets onupdate script on Enter press
				if(key == DOWNARROWTIPLEFT & !isundefined(my("target")),
					eval(my("target"):"onupdate", value->my("value"));
				);

				// Remove last character if any on leftarrow press
				if(key == LEFTARROW & length(value) > 0,
					// Remove last char
					value = value_(1..(length(value)-1)); // is list now :(

					// Rebuild string from list
					regional(temp);
					temp = "";
					forall(value, temp = temp + #);
					value = temp;
				);

				// Reassign new value
				self():"value" = value;

				// Execute targets onkeypress script
				if(!isundefined(my("target")),
					eval(my("target"):"onkeypress", key->key);
				);
			);
		);

		key; // Return the key label
	);

	board:"draw" := (
		forall(my("keys"), #:"draw");

		// debug
		if(LOGLEVEL > 0, draw(my("coord")));
	);

	// Build keyboard
	board:"buildkeyboard";

	board; // Return Keyboard
);
//[C] ProgressCircle
/** v1 ******************************************************************************************
* Class for a circular progress bar.
*
* Recent changes:
************************************************************************************************/

new ProgressCircle(center, innersize, outersize, value, maxvalue) := (
	regional(obj);
	obj = new VAMobject("ProgressCircle");
	
	// Basic fields
	obj:"coord" = center;
	obj:"innerradius" = if(innersize==NADA, 2, innersize)/2;
	obj:"outerradius" = if(outersize==NADA, 3, outersize)/2;
	obj:"value" = if(value==NADA, 42, value);
	obj:"maxvalue" = if(maxvalue==NADA, 100, maxvalue);
	
	// Text toggles for direct access
	obj:"fontfamily" = NADA;
	obj:"fontsize" = 24;
	obj:"textoffset" = 3.6;

	// Shape of the outer circular sector
	obj:"shape" := (
		regional(center, radius, circle, boundingpoly, refpoint, angle);
		
		// Build base circle
		center = my("coord");
		radius = my("outerradius");
		circle = circle(center, radius);

		// Get point on the circle with respect to current value
		angle = -2 * PI * my("value") / my("maxvalue");
		refpoint = rotate(
			center+[0,radius],
			angle, 
			center
		);
		
		// Build bounding poly to subtract from circle
		angle = abs(angle);
		boundingpoly = [
			center, // start at center of ProgressCircle
			center + [0, radius], // go up to edge
			center + [-radius, radius], // go to top left corner
			if(angle < 3/2 * PI,
				// also go to lower left corner if refpoint in Q3
				center + [-radius, -radius]
			),
			if(angle < PI,
				// also go to lower right corner if refpoint in Q4
				center + [radius, -radius]
			),
			if(angle < 1/2 * PI,
				// also go to top right corner if refpoint in Q1
				center + [radius, radius]
			),
			refpoint // go to refpoint
		];

		// Fix for CindyJS not ignoring NADA Points
		boundingpoly = select(boundingpoly,!isundefined(#)); 

		circle -- polygon(boundingpoly); // Return shape.
	);

	// Look of the outer circle
	obj:"outercolor" := [
		min(0.8, 1 - my("value") / my("maxvalue")),
		min(0.9, my("value") / my("maxvalue")),
		0
	];
	obj:"outerborder" := [0,0,0];
	obj:"outerstroke" := 0;
	// Look of the inner circle
	obj:"innercolor" := [0.94,0.94,0.94];
	obj:"innerborder" := [0,0,0];
	obj:"innerstroke" := 0;

	obj:"draw" := (
		// Draw outer circluar sector
		fill(
			my("shape"),
			color -> my("outercolor")
		);
		draw(
			my("shape"),
			color -> my("outerborder"),
			size -> my("outerstroke")
		);

		// Draw inner circle
		drawcircle(
			my("coord"), 
			my("innerradius"),
			color -> my("innerborder"),
			size -> my("innerstroke")
		);
		fillcircle(
			my("coord"), 
			my("innerradius"),
			color -> my("innercolor")
		
		);
		
		// Draw text
		drawtext(
			my("coord") + [0,-my("innerradius")/my("textoffset")], 
			my("value"),
			size -> my("fontsize"),
			family -> my("fontfamily"), 
			align -> "center"
		);
	);

	obj; // Return ProgressCircle
);

//[C] Plottable
/* v1 ******************************************************************************************
* Class for Plottable things.
*
* Recent changes:
************************************************************************************************/

new Plottable() := (
	regional(plottable);
	plottable:"definition" := NADA;
	plottable:"color" = DZLMCOLORBLUE;
	plottable:"size" = 1;
	plottable:"connect" = false;

	plottable; // Return
);
//[C] ScrollBar
/** v5 ******************************************************************************************
* Class for a HorizontalScrollbar.
*
* Recent changes:
************************************************************************************************/

new HorizontalScrollbar(coord, width) := (
	regional(obj);
	obj = new VAMobject("Scrollbar");

	obj:"coord" = coord;
	obj:"width" = width;
	obj:"height" = 1;
	obj:"padding" = .15;
	obj:"ismoveable" = true;
	obj:"isclickable" = true;
	obj:"hasbuttons" = true;
	obj:"callonmove" = true; // Call Scrollbars script continously on move (true) or once at moveend?
	obj:"moveonclick" = true; // Move bar when clicking on background of Scrollbar
	obj:"precision" = .05; // amount that bar gets moved by, if button is pressed

	obj:"min" = 0; // Value, if bar is furthest to the left
	obj:"max" = 1; // Value, if bar is furthest to the right
	obj:"value" := ( // current value of Scrollbar depending on position
		regional(currX, minX, maxX);
		currX = my("bar"):"coord"_1;
		minX = my("coord")_1 + my("padding") + if(my("hasbuttons"), my("height"), 0);
		maxX = my("coord")_1 + my("width") - my("padding") - if(my("hasbuttons"), my("height"), 0);
		maxX = maxX - my("bar"):"width";
		my("min") + (my("max")-my("min")) * (currX-minX) / (maxX-minX);
	);

	obj:"shape" := rectangle(my("coord"), my("width"), my("height"));
	obj:"hitbox" := my("shape");

	// Button for moving the bar to the left
	obj:"left" = (
		regional(btn);
		btn = new Button(obj:"coord",obj:"height",obj:"height","◀",18*obj:"height");
		btn:"parent" = obj;
		btn:"fontcolor" = grey(1);
		btn:"color" = grey(0.8);
		btn:"cornerradius" = 0;
		btn:"ishot" := inrectangle(my("hitbox"),mouse().xy);
		btn:"script" := ( // Moves button to the left
			regional(sb,minX, maxX, barX);
			sb = my("parent"); // Scrollbar parent

			barX = sb:"bar":"coord"_1; // bars (as in the rectangle of the ScrollBar object) current coord

			minX = sb:"coord"_1 + sb:"padding" + if(sb:"hasbuttons", sb:"height", 0); // leftmost point where to put the bar
			maxX = sb:"coord"_1 + sb:"width" - sb:"padding" - if(sb:"hasbuttons", sb:"height", 0); // rightmost point
			maxX = maxX - sb:"bar":"width"; // subtract bar with to get bottom left corner

			barX = sb:"bar":"coord"_1 - sb:"precision" * (maxX-minX); // Decrement coord by multiple of length of space
			barX = max(barX,minX); // Recognize left border

			sb:"bar":"coord"_1 = barX; // Set value
		);		

		btn;
	);

	// Button for moving the bar to the right
	obj:"right" = (
		regional(btn, pos);
		pos = obj:"coord" + [obj:"width"-obj:"height",0];
		btn = new Button(pos,obj:"height",obj:"height"," ▶",18*obj:"height");
		btn:"parent" = obj;
		btn:"fontcolor" = grey(1);
		btn:"color" = grey(0.8);
		btn:"cornerradius" = 0;
		btn:"ishot" := inrectangle(my("hitbox"),mouse().xy);
		btn:"script" := ( // Moves button to the right
			regional(sb,minX, maxX, barX);
			sb = my("parent"); // Scrollbar parent

			barX = sb:"bar":"coord"_1; // bars (as in the rectangle of the ScrollBar object) current coord

			minX = sb:"coord"_1 + sb:"padding" + if(sb:"hasbuttons", sb:"height", 0); // leftmost point where to put the bar
			maxX = sb:"coord"_1 + sb:"width" - sb:"padding" - if(sb:"hasbuttons", sb:"height", 0); // rightmost point
			maxX = maxX - sb:"bar":"width"; // subtract bar with to get bottom left corner

			barX = sb:"bar":"coord"_1 + sb:"precision" * (maxX-minX); // Decrement coord by multiple of length of space
			barX = min(barX,maxX); // Recognize left border

			sb:"bar":"coord"_1 = barX; // Set value
		);	

		btn;
	);
	obj:"bar" = (
		regional(bar);
		bar = new VAMobject("bar");
		bar:"parent" = obj;
		bar:"ismoveable" := my("parent"):"ismoveable";
		bar:"padding" := my("parent"):"padding";
		bar:"height" := my("parent"):"height" - 2 * my("padding");
		bar:"width" := .5 * (my("parent"):"width" - 2 * my("parent"):"height");
		bar:"coord" = bar:"parent":"coord" + 
			if(bar:"parent":"hasbuttons",[bar:"parent":"height", 0], [0,0]) +
			[bar:"padding", bar:"padding"];

		bar:"shape" := rectangle(my("coord"),my("width"),my("height"));
		bar:"hitbox" := my("shape");
		bar:"ishot" := inrectangle(my("hitbox"),mouse().xy);

		bar:"draw" := fillpoly(my("shape"), color->grey(.8));

		bar;
	);

	obj:"draw" := (
		fillpoly(my("shape"), color->grey(.95));
		if(my("hasbuttons"),
			my("left"):"draw";
			my("right"):"draw";
		);
		my("bar"):"draw";

		// Debug draw
		if(LOGLEVEL > 0, draw(my("coord")));
		if(LOGLEVEL > 0, drawtext(my("bar"):"coord"+[.1,.1],my("value")));
		if(LOGLEVEL > 1, draw(my("bar"):"coord",color->[0,0,1]));
		if(LOGLEVEL > 1, drawpoly(my("bar"):"hitbox",color->[1,0,0]));
		if(LOGLEVEL > 1, drawpoly(my("hitbox"),color->[0,0,0]));
	);

	obj:"ishot" := inrectangle(my("hitbox"),mouse().xy);
	obj:"move" := if(my("ismoveable") & my("bar"):"ishot",
		// Move bar
		my("bar"):"coord" = my("bar"):"coord" + [mousedelta_1,0];

		// Constrain movement to the left
		regional(borderX);
		borderX =	my("coord")_1 + my("padding") + if(my("hasbuttons"), my("height"), 0);
		if(my("bar"):"coord"_1 < borderX,
				my("bar"):"coord"_1 = borderX;
		);

		// Constrain movement to the right
		borderX =  my("coord")_1 + my("width") - my("padding") - if(my("hasbuttons"), my("height"), 0);
		borderX = borderX - my("bar"):"width";
		if(my("bar"):"coord"_1 > borderX,
				my("bar"):"coord"_1 = borderX;
		);

		// Call Scrollbar script
		if(my("callonmove"), my("script"));
	);

//	obj:"moveend" := my("script"); // calls "script" with old value. Why?

	obj:"click" := (
		// Trigger left button action
		if(my("left"):"ishot" & my("hasbuttons"),
			my("left"):"click";
		);
		
		// Trigger right button action
		if(my("right"):"ishot" & my("hasbuttons"),
			my("right"):"click"
		);

		if(!my("left"):"ishot" & !my("right"):"ishot" & !my("bar"):"ishot" & my("moveonclick"),
			regional(minX, maxX);
			minX =	my("coord")_1 + my("padding") + if(my("hasbuttons"), my("height"), 0);
			maxX =  my("coord")_1 + my("width") - my("padding") - if(my("hasbuttons"), my("height"), 0);
			maxX = maxX - my("bar"):"width";
			my("bar"):"coord"_1 = mouse().xy_1;
			my("bar"):"coord"_1 = max(my("bar"):"coord"_1, minX);
			my("bar"):"coord"_1 = min(my("bar"):"coord"_1, maxX);
		);

		// Run script
		my("script");
	);

	obj:"script" := println("Implement obj:script || my(value) = " + my("value"));

	obj; // Return Scrollbar;
);

//[C] TextInput
/** v7 ******************************************************************************************
* Class for a TextInput UI element and a TextInputFactory for more convenient handling.
*
* Recent changes:
* 2026-07-13 Apply iPad fix from Toggle
* 2026-08-26 Adjust to be able to get a full keyboard
						 Add "keysize" attribute depending on "keyboardtype"
************************************************************************************************/

new TextInput(coord, label, keyboardtype) := (
	regional(o);
	o = new VAMobject("textinput");
	o:"coord" = coord;
	o:"label" = label;
	o:"width" = 2;
	o:"height" = .6;
	o:"value" = "";

	o:"fill-color" = DZLMCOLORGOLD;
	o:"fill-alpha" = .5;
	o:"border-color" = DZLMCOLORGOLD * .2;
	o:"drawborder" = false;
	o:"text-color" = DZLMCOLORGOLD * .2;

	o:"keyboardcoord" = coord;
	o:"keyboardbehavior" = "clear"; // ["clear"]
	o:"keysize" := if(my("keyboardtype") == "full", .6, 1);
	o:"keyboardtype" = keyboardtype; // see Keyboard class
	o:"keyboard" = nada;
	o:"keyboardoffset" = [5,0];
	o:"keysize" = 1;
	o:"fontsize" = 14 * FONTSCALE;
	o:"fontfamily" = nada;
	o:"labelpadding" = .2;

	o:"isclickable" = true;
	o:"ismoveable" = false;
	
	o:"hitbox" := rectangle(my("coord"), my("width"), my("height"));
	o:"shape" := o:"hitbox";

	o:"ishot" := inrectangle(my("hitbox"),mouse().xy);

	o:"ipadpentimestampfix" = -1;

	o:"draw" := (
		// Draw TextInput box
		fillpoly(my("shape"), alpha -> my("fill-alpha"), color->my("fill-color"));
		drawtext(
			my("coord") + [0.15, 0.07],
			my("value"),
			color->my("text-color"),
			size->my("fontsize")
		);

		// Draw optional border
		if(my("drawborder"), drawpoly(my("shape"), size-> 1, color->my("border-color")));

		// Draw label
		regional(box, boxwidth, boxheight);
		box = getboundingbox(my("label"), [0,0], my("fontsize"), my("fontfamily"));
		boxwidth = box_2_1 - box_1_1;
		boxheight = box_4_2 - box_1_2;

		drawtextbox(
			my("coord") - [boxwidth+my("labelpadding"), -.12],
			my("label"),
			my("fontsize"),
			my("fontfamily"),
			grey(1)
		);
	);

	o:"setValue":= self():"value" = my("keyboard"):"value";

	o:"click" := if(my("isclickable"),
    if(timestamp() - my("ipadpentimestampfix") > 200,  // fix for iPad pen issue
        self():"ipadpentimestampfix" = timestamp();

        if(!isundefined(my("keyboard")),
            obj = obj -- [my("keyboard")];
            self():"keyboard" = NADA;
        ,
            self():"keyboard" = new Keyboard(my("keyboardcoord") + my("keyboardoffset"), my("keyboardtype"), my("keysize"), self());
            my("keyboard"):"value" = 
                if(my("keyboardbehavior") == "append", my("value"), 
                if(my("keyboardbehavior") == "clear", "";
                ));
            obj = obj :> my("keyboard");
        );

        my("customclickscript");
    );
	);

	// Hooks from Keyboard class
	// gets evaled with "key"
	o:"onkeypress" := ( // set own value
		self():"value" = value;
	);

	// gets evaled with "value"
	o:"onupdate" := (	// Destroy keyboard
		self():"keyboard" = nada;
	);

	o:"customclickscript" := (
		// executed at the end of "click"
	);

	o;
);

new TextInputFactory() := (
	regional(textinputfactory);
	textinputfactory = {
		"id" : 1,
		"children" : []
	};

	textinputfactory:"__addchild" := (
		// eval with coord, label, keyboardtype
		regional(child);
		if(isundefined(coord) % isundefined(label) % isundefined(keyboardtype),
			err(">> __addchild: eval with 'coord', 'label' and 'keyboardtype' parameters");
		,
			child = new TextInput(coord, label, keyboardtype);
			child:"id" = my("id");
			self():"id" = my("id") + 1;
			self():"children" = my("children") :> child;
		);
	);

	textinputfactory; // Return
);
//[C] Toggle
/** v5 ******************************************************************************************
* Class for a Toggle switch.
*
* Recent changes:
* 2027-07-27: Add idempotent setstate() method
************************************************************************************************/

/**
* A simple toggle switch
* @param coord - bottom left coordinate
* @param width - width in world coords
* @param stae - state (true/false) of Toggle
* @param label - label to be printed next to toggle
* @param fontsize - size of the label
*/
new Toggle(coord,width,state,label,fontsize) := (
	regional(o);
	o = new Button(coord,width,width/2,label,fontsize);
	o:"type" = "Toggle";

	o:"circleoffset" = if(state,.5*[o:"width",0], [0,0]);
	o:"animationtiming" = .05;

	o:"cornerradius" = width;
	o:"state" = if(!isundefined(state),state,false);
	o:"highlightcolor" = DARKBLUE;

	o:"ipadpentimestampfix" = -1;

	o:"draw" := (
		// Draw box and border
		fill(
			my("shape"),
			color->if(my("state"),my("highlightcolor"),grey(0.98)),
			alpha->1
		);
		draw(
			my("shape"),
			color->.7*my("highlightcolor"),
			alpha->1
		);

		// Draw circle
		regional(center);
		center = my("coord")+[my("height"),my("height")] / 2 + my("circleoffset"),

		fillcircle(
			center,
			1.2 * my("height") / 2,
			color->my("color");
		);

		// Draw label
		drawtext(
			my("coord")+[my("width")*1.2,.5*my("height")/3],
			my("label"),
			align->"left",
			color->dzlmcolordark,
			size->my("fontsize")
		);

		// Draw something after the button
		my("drawafter");

		// Debug stuff
		if(LOGLEVEL > 2,
			drawpoly(my("hitbox"), color->[1,0,0]);
		);
	);
	
	o:"click"	:= (
		// Change state while fixing iPad Stylus triggering twice
		if(timestamp() - my("ipadpentimestampfix") > 200,
			self():"ipadpentimestampfix" = timestamp(); // fix for iPad pen issue
			set my("state", !my("state"));
		);

		// Animate position to match state
		new animationobject(
			self(),
			"circleoffset",
			my("circleoffset"),
			if(my("state"), .5*[my("width"),0],[0,0]), 
			my("animationtiming"),
			"accel"
		);

		// Execute custom script
		my("script");
	);

	o:"setstate" := if(!isundefined('newstate) & my("state") != 'newstate, // eval mit 'newstate -> true/false
		set my("state", 'newstate);
		new animationobject(
			self(), 
			"circleoffset",
			my("circleoffset"),
			if(my("state"),
			.5*[my("width"),0], [0,0]),
			my("animationtiming"),
			"accel"
		);
		my("script");
	);

	o:"script" := (); // Can have script in the same way as Button has

	o; // Return the toggle.
);

//[C] VAMobject
/** v2 ******************************************************************************************
* Class for default VAMobject from which most VAM classes are derived.
*
* Recent changes:
* - 2026-06-22: Added "id" field and added it to naming scheme.
************************************************************************************************/

new VAMobject(type) := (
	regional(obj);
	
	obj = {
		"coord" 			: [0,0],
		"type"  		  : type,
		"ismoveable"  : false,
		"copyonmove"	: false,
		"isclickable" : false,
		"getaction" 	: "move",
		"color" 			: VAMPALETTE_1
	};

	obj:"id"				:= random(1000);
	obj:"name" 			:= my("type") + ":" + my("coord") + ":" + my("id");
	obj:"ishot" 		:= dist(my("coord"), mouse().xy) < 1;
	
	obj:"move"  		:= if(am i moveable(), set my("coord", coord));
	obj:"moveend"		:= NADA;
	
	obj:"clickcopy" := if(my("copyonmove"), my("copy"));
	
	obj:"copy"  		:= (
		new VAMobject(my("type"));
	);
	
	obj:"draw"			:= fill(
		circle(my("coord"), 1),
		color->my("color")
	);
	
	obj:"click"			:= if(am i clickable(), 
		self():"color" = apply(self():"color", |1-#|)
	);
	
	obj; // Return the VAMobject.
);

//[C] Workbench
/** v1 ******************************************************************************************
* Class for a Workbench that contains WorkbenchElements to work as a Container for copyable stuff.
*
* Recent changes:
************************************************************************************************/

new Workbench(coords, width, height, color) := (
	regional(obj);
	obj = new VAMobject("Workbench");
	obj:"color"  	 = color;
	obj:"coord"    = coords;
	obj:"width"    = width;
	obj:"height"   = height;
	obj:"children" = []; // Fill with VAM objects.
	obj:"sizeofchildren" = 0; // sum of sizes of all children.
	obj:"align"		 = "right";
	obj:"shape"  	:= rectangle(self():"coord",self():"width",self():"height");
	obj:"ishot"	 	:= inrectangle(self():"shape", mouse());
	obj:"draw"  	:= (
		drawpoly(
			self():"shape",
			size->bordersize, 
			color->self():"color"
		);
		fillpoly(
			self():"shape", 
			color->self():"color", 
			alpha->if(self():"ishot",0.2,0.1)
		);
	);

	obj:"drawchild" := (
		regional(child);
		child = currentchild; // Use with 'eval(..., currentchild->self())'.

		if(self():"align" = "right",
			println("TO DRAW: " + child);
		, // else
		err("Only right align is implemented right now.");
		);
	);

	obj:"dropevent" := (
			if(dropobject:"type"=="WorkbenchElement" & !dropobject:"copyonmove",
 			  new animation(dropobject,"scale",dropobject:"scale",0.3,0.05,"linear", 0, true);
				//obj = obj -- [dropobject];
			);
	 );

	obj; // Return Workbench.
);

/**Class Workbench:
* Workbench with fixed position on the left side of the screen and fixed size or size relative to screen width/height.
* @param 		 type: "fixed" or "relative" depending if a fixed size or a relative size (in relation to the screen height/width) is preferred.
* @param 		 size: Size of the Workbench (if type="fixed" in absolute terms, if type=" relative" in percent of screen width/size)
* @param position: one of "left", "right", "top", "bottom"
**/
new Workbench(wbtype, size, position) := (
	if(!contains(["fixed","relative"],wbtype),
		// Raise error, if type is wrong
		err("wbtype has to be 'fixed' or 'relative'");
	, // else
		if (!contains(["left", "right", "top", "bottom"],position),
			// Raise error, if position is wrong
			err("position has to be 'left', 'right', 'top', 'bottom'");
		, //else
			// Create Workbench
				regional(obj);
				obj = new Workbench(0,0,0,DZLMCOLORDARK);
				obj:"position"	= position;
				obj:"wbtype" 		= wbtype;
				obj:"size" 			= size;

				obj:"coord" := (
					regional(coords);
					// LEFT and BOTTOM is independet of choice of 'type'
					if(contains(["left","bottom"],self():"position"),
						coords = (screenbounds()_4).xy;
					);
					
					// FIXED for RIGHT and TOP
					if(self():"wbtype" == "fixed",
						if(self():"position" == "right",
							// FIXED size on the RIGHT side
							coords = (screenbounds()_3).xy - [self():"size",0];
						);
						if(self():"position" == "top",
							// FIXED size on TOP
							coords = (screenbounds()_1).xy - [0,self():"size"];
						);
					);

					// RELATIVE for RIGHT and TOP
					if(self():"wbtype" == "relative",
						if(self():"position" == "right",
							// RELATIVE size on the RIGHT side
							coords = (screenbounds()_3).xy - [self():"size" * |screenbounds()_4_1 - screenbounds()_2_1|,0];
						);
						if(self():"position" == "top",
							// RELATIVE size on TOP
							coords = (screenbounds()_1).xy - [0,self():"size" * |screenbounds()_4_2 - screenbounds()_2_2|];
						);
					);
					coords; // Return result.
				);

				obj:"width"		:= (
					regional(width);
					if(contains(["top","bottom"],self():"position"),
						// If TOP or BOTTOM use width of entire canvas
						width = |screenbounds()_4_1 - screenbounds()_2_1|;
					, // else (LEFT or RIGHT)
						if(self():"wbtype" == "fixed",
							// If FIXED, width is equal to size field.
							width = self():"size";
						, // else (RELATIVE)
							width = self():"size" * |screenbounds()_4_1 - screenbounds()_2_1|;
						);
					);
					width; // Return result.
				);

				obj:"height"	:= (
					regional(height);
					if(contains(["left","right"],self():"position"),
						// If LEFT or RIGHT use width of entire canvas
						height = |screenbounds()_4_2 - screenbounds()_2_2|;
					, // else (TOP or BOTTOM)
						if(self():"wbtype" == "fixed",
							// If FIXED, width is equal to size field.
							height = self():"size";
						, // else (RELATIVE)
							height = self():"size" * |screenbounds()_4_2 - screenbounds()_2_2|;
						);
					);
					height; // Return result.
				);

				obj; // Return Workbench.
		);
	);
);

/**
* Class Workbench:
* Basic workbench with relative layout, positioned on the left, taking 15% of the canvas.
**/
new Workbench() := new Workbench("relative", 0.15, "left");

/**
* Class WorkbenchElement:
* 
**/
new WorkbenchElement(center, size, color, copyonmove, label) := (
	regional(obj);
	obj = new VAMobject("WorkbenchElement");
	obj:"coord"		 		= center;
	obj:"size"		 		= size;
	obj:"label"				= label;
	obj:"img"					= nada;
	obj:"cornerradius"= size/10;
	obj:"color"				= color;
	obj:"ismoveable"	= true;
	obj:"copyonmove"	= copyonmove;
	obj:"scale"				= 1;
	obj:"parent"			= nada; // Should be a Workbench object

	obj:"shape" := (
		// Shape consists of 2 rectangles and 4 circles for rounded corners
		rectangle(
			apply(self():"coord", (#-self():"scale"*self():"size"/2)),
			self():"scale"*self():"size",
			self():"scale"*self():"size"
		);
	);
	obj:"ishot" := inrectangle(self():"shape", mouse());
	obj:"draw" := (
		drawpoly(self():"shape", size->bordersize, color->self():"color");
		fillpoly(
			self():"shape", 
			color->self():"color", 
			alpha->if(self():"ishot",1,0.8)
		);
		drawimage(
			self():"coord",
			self():"img",
			scale->self():"scale"
		);
		drawtext(
			apply(self():"coord",
				#-self():"scale"*self():"size"/2+BORDERSIZE
			),
			self():"label",
			size->self():"size"*7*self():"scale"
		);
	);
	obj:"clickcopy" := if(self():"copyonmove", self():"copy");
	obj:"copy"  		:= (
		regional(r);
		r = new WorkbenchElement(
			self():"coord",
			self():"size",
			self():"color",
			false,
			self():"label"
		)
	);

	obj; // Return WorkbenchElement.
);

//[VAM] default
/** v2 *****************************************************************************************
* Example VAM usage.
*
* Recent changes:
* 2026-08-06: Some adjustments because of new framework structure
************************************************************************************************/

// Beispiel VAM
if(VAM == "default",

// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "Ein Platzhalter VAM ohne bestimmte Funktionalität.";


// ================= //
// B | Configuration //
// ================= //

'someParameter = default to(ENVIRONMENTALPARAMS:"someParameter", "default value", false); // TRUE parses the value. Try, if not a string.


// ================= //
// Divomath settings //
// ================= //

divomath update results() := if(ISDIVOMATH, // @overwrite
	warn at("default, divomath update results()", "No function, just an example.");

	divomath clear results(); // Clear last results.

	divomath put result(#, dmstate:#); // Put some results in.

	divomath post results(); // Submit results to divomath.
);

divomath set state() := if(ISDIVOMATH, // @overwrite	
	// Build state object.
	state = {
		"size" : size, // Size of Blobs
		"blobmargin" : padding, // Padding between blobs in a strip
		"stripmargin" : stripmargin, // Margin between strips
		"timing" : timing, // Animation timing
		"blobs" : world:"#allblobs", // Initial Blob count
		"maxblobs" : maxblobs, // Maximum Blob count
		"divisor" : world:"#divisors", // Initial number of divisors
		"maxcols" : maxcols, // Max number of divisors
		"sequentialorder" : sequentialorder, // Reording strategy on divisor change
		"drawblobbuttons" : drawblobbuttons,
		"drawdivbuttons" : drawdivbuttons,
		"displaycalc" : displaycalc,
		"drawbar" : drawbar,
		"displayresult" : displayresult,
		"displaydescription" : displaydescription,
		"displayblobcount" : displayblobcount,
		"displaydivisorcount" : displaydivisorcount
	};

	state; // Return state.
);


// ===================== //
// C | Class Definitions //
// ===================== //

new DummyObject(coord) := (
	regional(o);

	o = new VAMobject("Dummy"); // Set some defaults.

	o:"coord" = coord;
	o:"ismoveable" = true;
	o:"isclickable"  = true;
	o:"color" = DARKRED; // See [FW] Constants

	o:"draw" := ( // called whenever draw event is triggered if object is in "obj"
		fill(
			circle(my("coord"), 1),
			color -> my("color")
		);
		
		draw(
			my("coord"),
			color -> [1,1,1]
		);
		
		drawtext(my("coord")+[.1,.1],my("coord"));
	);

	o:"click" := ( // triggered on mousedown, if elements "ishot" is true
		set my("color", [random(),random(),random()]);
		divomath push results();
	);

	o; // Return the object.
);


// ================== //
// D | Initialization //
// ================== //

// --- Instantiate dummy object ---
adummy = new DummyObject(.5*VRBOTTOMLEFT + .5*VRTOPRIGHT);
adifferentdummy = new DummyObject([0,0]);

// Change some stuff on init.
adummy:"color" = DARKBLUE;
adifferentdummy:"coord" := adummy:"coord" + [3,1];

// Add stuff to obj to make in known to the framework.
obj = obj :> adummy;
obj = obj :> adifferentdummy;

);

//[VAM] distributive
/** v20 *****************************************************************************************
* Rectangle of blobs to explore distributive properties.
*
* Recent changes:
* 2026-06-20: Fixed breaking ifs from CindyJS 0.8.45 update.
* 2026-07-30: Unify VAM configuration
* 2026-07-30: Fix divomath state setting for coloredcolindex
* 2026-07-30: Relate VAM to VISIBLERECT instead of screenbounds()
* 2026-07-30: Change cuthorizontally and cutvertically
* 2026-07-30: Change updateexpression
* 2026-08-05: Change rounded rectangles to be approximated by polygons to increase performance
* 2026-08-05: Introduce base rounded rectangle poly which all Atoms just translate for EVEN MOAR PERFORMANCE
* 2026-08-09: Adjust divomath functions to new json serialization pipeline
************************************************************************************************/

// Rechteckfeld
if(VAM == "distributive",

// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

// --- Grid: structure ---
'gridposition					= default to(ENVIRONMENTALPARAMS:"gridposition", [10,8], true); // Grid position at init
'rows									= default to(ENVIRONMENTALPARAMS:"rows", 5, true); // Initial number of rows in grid
'cols									= default to(ENVIRONMENTALPARAMS:"cols", 7, true); // Initial number of cols in grid
'gridmoveable					= default to(ENVIRONMENTALPARAMS:"gridmoveable", true, true); // Determines if grid is moveable
 
// --- Atoms: Size and spacing ---
'atomsize							= default to(ENVIRONMENTALPARAMS:"size", 1, true); // General size of atoms
'atomradius						= default to(ENVIRONMENTALPARAMS:"cornerradius", .5, true); // Corner radius of Atoms
'atomverticalpadding	= default to(ENVIRONMENTALPARAMS:"verticalpadding", .1, true); // Vertical padding between Atoms
'atomhorizontalpadding= default to(ENVIRONMENTALPARAMS:"horizontalpadding", .1, true); // Horizontal padding between Atoms
'groupspacing					= default to(ENVIRONMENTALPARAMS:"groupspacing", .2, true); // Spacing for grouping on click
'cutwidth							= default to(ENVIRONMENTALPARAMS:"cutwidth", .3, true); // Spacing when cutting
'animationspeed				= default to(ENVIRONMENTALPARAMS:"animationspeed", .15, true); // Speed modifier for animations
 
// --- Initial state: grouping, coloring, cutting ---
'groupingtype					= default to(ENVIRONMENTALPARAMS:"groupingtype", "ROWCOL", false); // "NONE", "ROW", "COL" or "ROWCOL" - determines what groupings are possible
'groupby							= default to(ENVIRONMENTALPARAMS:"groupby", "NONE", false); // "NONE", "ROW", "COL"/"COLUMN" - Grouping at init
'coloredrowindex			= default to(ENVIRONMENTALPARAMS:"coloredrowindex", NADA, true);
'coloredcolindex			= default to(ENVIRONMENTALPARAMS:"coloredcolindex", NADA, true);
'cuthorizontally			= default to(ENVIRONMENTALPARAMS:"cuthorizontally", false, true);
'cutvertically				= default to(ENVIRONMENTALPARAMS:"cutvertically", false, true);
'requiregrouping			= default to(ENVIRONMENTALPARAMS:"requiregrouping", true, true); // Allow coloring and cutting only after grouping
 
// --- Tool-Button ---
'tool									= default to(ENVIRONMENTALPARAMS:"tool", "hand", false); // "hand", "bucket" or "scissors"
'drawtoolbutton				= default to(ENVIRONMENTALPARAMS:"drawtoolbutton", true, true);
'buttonsize						= default to(ENVIRONMENTALPARAMS:"buttonsize", 2, true);
'buttonpadding				= default to(ENVIRONMENTALPARAMS:"buttonpadding", .4, true);
'toolbuttonx					= default to(ENVIRONMENTALPARAMS:"toolbuttonx", NADA, true); // NADA = right edge
'toolbuttony					= default to(ENVIRONMENTALPARAMS:"toolbuttony", NADA, true); // NADA = upper edge
 
// --- Text output (verbal and expression) ---
'fontsize							= default to(ENVIRONMENTALPARAMS:"fontsize", 18, true);
'lblpadding						= default to(ENVIRONMENTALPARAMS:"labelpadding", 10.3, true);
'drawexpression				= default to(ENVIRONMENTALPARAMS:"drawexpression", true, true); // Show expression
'expressionposition		= default to(ENVIRONMENTALPARAMS:"expressionposition", NADA, true);
'expressionmoveable		= default to(ENVIRONMENTALPARAMS:"expressionmoveable", false, true);
'drawverbal						= default to(ENVIRONMENTALPARAMS:"drawverbal", true, true); // Show verbal description
'verbalposition				= default to(ENVIRONMENTALPARAMS:"verbalposition", NADA, true);
'verbalmoveable				= default to(ENVIRONMENTALPARAMS:"verbalmoveable", false, true);
'showexpressiontoggle	= default to(ENVIRONMENTALPARAMS:"showexpressiontoggle", false, true);
'expressiontogglestate= default to(ENVIRONMENTALPARAMS:"expressiontogglestate", true, true);
 
// --- Other ---
'picturemode					= default to(ENVIRONMENTALPARAMS:"picturemode", false, true); // Removes interactivity from VAM

// Handle empty Strings from divomath (is "" instead of NADA)
if(isstring('coloredrowindex), 'coloredrowindex = NADA);
if(isstring('coloredcolindex), 'coloredcolindex = NADA);
if(isstring('toolbuttonx), 'toolbuttonx = NADA);
if(isstring('toolbuttony), 'toolbuttony = NADA);

// Normalize booleans (divomath returns "" instead of false maybe probably)
'gridmoveable 					= tobool('gridmoveable);
'cuthorizontally 				= tobool('cuthorizontally);
'cutvertically 					= tobool('cutvertically);
'drawtoolbutton 				= tobool('drawtoolbutton);
'drawexpression 				= tobool('drawexpression);
'drawverbal 						= tobool('drawverbal);
'expressionmoveable 		= tobool('expressionmoveable);
'verbalmoveable 				= tobool('verbalmoveable);
'showexpressiontoggle 	= tobool('showexpressiontoggle);
'expressiontogglestate 	= tobool('expressiontogglestate);
'picturemode 						= tobool('picturemode);
'requiregrouping 				= tobool('requiregrouping);

// Normalize other values
if('groupby == "COL", 'groupby = "COLUMN"); // Tolerate the groupingtype spelling
if(!contains(["NONE","ROW","COLUMN"], 'groupby),
	err("groupby must be one of 'NONE', 'ROW', 'COLUMN'. Set to 'NONE'.");
	'groupby = "NONE";
);


// Some constants
'ROUNDEDPOLYRESOLUTION = 10; // Number of points for rounded rectangles (since there polys now)
'ATOMSHAPE = rounded rectangle poly([0,0], 'atomsize, 'atomsize, 'atomradius, 4); // One shape for all atoms, translated on draw (size is identical anyway)
'ATOMCOLORS = {
	"blue" : (40,111,255)/255,
	"green" : (50,202,48)/255,
	"orange" : (255,129,29)/255,
	"purple" : (165,57,255)/255
};



// ================= //
// Divomath settings //
// ================= //

// Overwrite divomath result updating function.
divomath update results() := if(ISDIVOMATH,
	divomath clear results();

	divomath put result("rows", grid:"rows"); // Report number of rows
	divomath put result("columns", grid:"cols"); // Report number of cols
	divomath put result("coloredrows", if(isundefined(grid:"flags":"color-row"), 0, grid:"flags":"color-row")); // Report number of colored rows
	divomath put result("coloredcolumns", if(isundefined(grid:"flags":"color-col"), 0, grid:"cols" - grid:"flags":"color-col" + 1)); // Report number of colored cols
	divomath put result("cuthorizontally", grid:"flags":"cut-row"); // Report wether grid is horiontally cut
	divomath put result("cutvertically", grid:"flags":"cut-col"); // Report wether grid is vertically cut
	divomath put result("groupby", grid:"flags":"group-by"); // Report grouping state

	divomath post results()
);

// Overwrite divomath setState()
divomath set state() := (
	regional(state);

	// Build state object with current values
	state = {
		"gridposition" : grid:"coord",
		"rows" : grid:"rows",
		"cols" : grid:"cols",
		"atomsize" : 'atomsize,
		"atomradius" : 'atomradius,
		"atomverticalpadding" : 'atomverticalpadding,
		"atomhorizontalpadding" : 'atomhorizontalpadding,
		"groupspacing" : 'groupspacing,
		"cutwidth" : 'cutwidth,
		"gridmoveable" : 'gridmoveable,
		"buttonsize" : 'buttonsize,
		"buttonpadding" : 'buttonpadding,
		"animationspeed" : 'animationspeed,
		"lblpadding" : 'lblpadding,
		"fontsize" : 'fontsize,
		"drawexpression" : 'drawexpression,
		"drawverbal" : 'drawverbal,
		"drawtoolbutton" : 'drawtoolbutton,
		"tool" : grid:"tool",
		"toolbuttonx" : if(!isundefined('toolbuttonx), grid:"toolbutton":"coord"_1, NADA),
		"toolbuttony" : if(!isundefined('toolbuttony), grid:"toolbutton":"coord"_2, NADA),
		"groupingtype" : 'groupingtype,
		"coloredrowindex" : if(!isundefined(grid:"flags":"color-row"),
			grid:"flags":"color-row", NADA),
		"coloredcolindex" : if(!isundefined(grid:"flags":"color-col"),
			grid:"cols" - grid:"flags":"color-col" + 1, NADA),
		"groupby" : grid:"flags":"group-by",
		"expressionposition" : grid:"expression":"coord",
		"expressionmoveable" : grid:"expression":"ismoveable",
		"verbalposition" :  grid:"verbal":"coord",
		"verbalmoveable" : grid:"verbal":"ismoveable"
	};

	state; // Return
);

// ===================== //
// C | Class Definitions //
// ===================== //

// C.1 | Atom: Thing that gets arranged into a rectangle
new Atom(c, parent) := (
	regional(atom);
	atom = new VAMobject("Atom");
	atom:"coord" = if(isundefined(c),[0,0],c);
	atom:"size" = 'atomsize;
	atom:"color" = 'ATOMCOLORS:"blue";
	atom:"radius" = 'atomradius;
	atom:"parent" = parent;
	atom:"left" = NADA;
	atom:"right" = NADA;
	atom:"up" = NADA;
	atom:"down" = NADA;
	atom:"neighbors" := {
		"up": my("up"),
		"down": my("down"),
		"left": my("left"),
		"right": my("right")
	};

	atom:"shape" := apply('ATOMSHAPE, # + my("coord"));
	atom:"hitbox" := my("shape");

	atom:"ishot" := if('picturemode, false, inroundedrectangle(my("coord"),my("size"),my("size"),my("radius"),mouse().xy));

	atom:"draw" := ( // can be evaled with 'atomalpha
		regional(alph);
		alph = default to('atomalpha, 1);
		fillpoly(my("shape"), color->my("color"), alpha->alph);

		if(LOGLEVEL>0, draw(my("coord")));
	);

	atom:"click" := println("beep " + random());

	atom; // Return Atom
);

// C.2 | Grid: ...of Atoms
new Grid(c, rows, cols) := (
	regional(grid);
	grid = new VAMobject("Grid");
	grid:"coord" = c;
	grid:"rows" = max(1,rows);
	grid:"cols" = max(1,cols);
	grid:"verticalpadding" = 'atomverticalpadding;
	grid:"horizontalpadding" = 'atomhorizontalpadding;
	grid:"width" := (
		my("grid")_1_(-1):"coord"_1 + 'atomsize - my("coord")_1;
	);
	grid:"height" := my("grid")_(-1)_1:"coord"_2 + 'atomsize - my("coord")_2;
	grid:"ismoveable" := 'gridmoveable % my("tool") != "hand";
	grid:"drawexpression" = 'drawexpression;
	grid:"drawverbal" = 'drawverbal;
	
	// group, paintbucket and scissors controls
	grid:"cutwidth" = 'cutwidth;
	grid:"flags" = {
		"group-by": "NONE", // "NONE", "ROW" or "COLUMN" depending on how atoms should be visually grouped by increasing the padding
		"color-row": NADA, // MAX index of colored row
		"color-col": NADA, // MIN index of colored col
		"cut-row": false, // flag, if row is cut (bigger gap)
		"cut-col": false // flag, if column is cut (bigger gap)
	};

	// Scissors controls
	grid:"linetreshold" = 'atomsize; // treshold, at which line is either VERTICAL or HORIZONTAL
	grid:"linedirection" = NADA; // "VERTICAL" or "HORIZONTAL" depending on linetreshold
	grid:"linestart" = NADA; // point
	grid:"lineend" = NADA; // point

	grid:"toolsallowed" := !'requiregrouping % (my("flags"):"group-by" != "NONE");

	grid:"grid" = (
		regional(atoms, newatom);
		atoms = []; // stores grid of Atoms

		repeat(rows, rowindex,
			atoms = atoms :> [];
			repeat(cols, colindex,
				newatom = new Atom(c + 'atomsize*[colindex-1,rowindex-1] + [(colindex-1)*'atomverticalpadding,(rowindex-1)*'atomhorizontalpadding], grid);
				newatom:"color" = 'ATOMCOLORS:"blue";
				atoms_rowindex = atoms_rowindex :> newatom;
			);
		);
		atoms; // Assign array of Atoms
	);

	grid:"hitbox" := rectangle(my("coord"), my("width"), my("height")); // Rounded rectangle just fitting around all Atoms
	grid:"shape" := rounded rectangle poly(my("coord"), my("width"), my("height"), 'atomradius, 'ROUNDEDPOLYRESOLUTION); // Rounded rectangle just fitting around all Atoms
	
	grid:"ishot" := if('picturemode, false,
		if(my("tool") == "hand",
			inroundedrectangle(my("coord"), my("width"), my("height"), 'atomradius, mouse().xy);
		,
			true; // always true, so whole canvas can be drawn on
		);
	);
	grid:"draw" := (
		regional(m, rowindex, colindex);
		m = mouse().xy;		

		// Draw all Atoms
		forall(my("grid"), row,
			forall(row, atom,	atom:"draw");
		);

		// Draw line, when tool is scissors
		if(my("tool") != "hand",
			draw(my("linestart"), my("lineend"),
				color->if(my("tool") == "bucket", DZLMCOLORGOLD, grey(.5)),
				size->if(my("tool") == "bucket", 20, 4),
				dashtype->if(my("tool") == "bucket", 0, 2);
			);
		);

		// Draw persistent cutting line (HORIZONTAL)
		if(my("flags"):"cut-row",
			regional(refrow, point1, point2);
			refrow = my("flags"):"color-row" + 1; // line above the cut
			point1 = centroid([my("grid")_refrow_1:"coord",my("grid")_(refrow-1)_1:"coord"+[0,'atomsize]]);
			point2 = centroid([my("grid")_refrow_(-1):"coord" + ['atomsize,0], my("grid")_(refrow-1)_(-1):"coord" + ['atomsize,'atomsize]]);
			connect([point1, point2], color->grey(.5), size->1);
		);

		// Draw persistent cutting line (VERTICAL)
		if(my("flags"):"cut-col",
			regional(refcol, point1, point2);
			refcol = my("flags"):"color-col"; // line to the right of cut
			point1 = centroid([my("grid")_1_refcol:"coord",my("grid")_1_(refcol-1):"coord"+['atomsize,0]]);
			point2 = centroid([my("grid")_(-1)_refcol:"coord"+[0,'atomsize],my("grid")_(-1)_(refcol-1):"coord"+['atomsize,'atomsize]]);
			connect([point1, point2], color->grey(.5), size->1);
		);

		// Debug Draw
		if(LOGLEVEL > 0,
			draw(my("shape"), size->3, dashtype->1);
			draw(my("coord"), size->4, color->[0,0,1]);
		);
	);

// === Interaction with Grid
	grid:"move" := if(my("ismoveable"),
		if(my("tool") == "hand",
			// Move Atoms
			forall(my("grid"), row,
				forall(row, atom,
					atom:"coord" = atom:"coord" + mousedelta;
				);
			);
		
			// Move grid itself (i.e. own coord and hitbox)
			self():"coord" = my("coord") + mousedelta;
		);
		
		if(my("tool") != "hand",
			regional(m);
			m = mouse().xy;

			// Set starting point of cut
			if(isundefined(my("linestart")), self():"linestart" = m);

			// Set direction and end point of cut
			// -1- direction not set yet
			if(isundefined(my("linedirection")),
				self():"lineend" = m;
				if(dist(my("lineend"), my("linestart")) > 'atomsize,
					regional(distxy);
					distxy = apply(my("lineend") - my("linestart"), abs(#));
					self():"linedirection" = if(distxy_1 > distxy_2, "HORIZONTAL", "VERTICAL");
				);
			);

			// -2- direction is "horizontal"
			if(my("linedirection") == "HORIZONTAL",
				self():"lineend" = [m_1, my("linestart")_2];
			);

			// -3- direction is "vertical"
			if(my("linedirection") == "VERTICAL",
				self():"lineend" = [my("linestart")_1, m_2];
			);
		);

	);

	grid:"moveend" := if(my("tool") != "hand",
		// Get index of active row/col
		regional(activeindex, ref);
		ref = my("linestart"); // Reference point for getting active index

		// Get Index of Atoms at linestart and lineend
		activeindex = [] :> eval(my("getactiveindex"), 'point->ref);
		activeindex = activeindex :> eval(my("getactiveindex"), 'point->mouse().xy);

		// Bucket logic ((un-)drawing stuff)
		if(my("tool") == "bucket" & my("toolsallowed") & !isundefined(activeindex_1) & !isundefined(activeindex_2),
			if(my("linedirection") == "VERTICAL",
				// Set/Reset flag for painting column, depending on if col is drawn over a second time
				self():"flags":"color-row" = if(my("flags"):"color-row" == activeindex_1_1, NADA, activeindex_1_1);
			);
			if(my("linedirection") == "HORIZONTAL",
				// Set/Unset flag for painting row, depending on if row is drawn over a second time
				self():"flags":"color-col" = if(my("flags"):"color-col" == activeindex_1_2, NADA, activeindex_1_2);
			);
			my("repaint"),
		);
		
		// Scissors logic ((un-)cutting stuff)
		if(my("tool") == "scissors" & my("toolsallowed"),
			if(my("linedirection") == "VERTICAL", activeindex = activeindex_1_2);
			if(my("linedirection") == "HORIZONTAL", activeindex = activeindex_1_1);
			eval(my("cutgrid"), 'activeindex->activeindex, 'direction->my("linedirection"));
		);

		// Reset scissors vars
		self():"linestart" = NADA;
		self():"lineend" = NADA;
		self():"linedirection" = NADA;

		// Update expression text
		my("updateexpression");

		divomath update results();
	);

	grid:"click" := if(my("tool") == "hand", // handles grouping of rows or cols
		regional(state);
		state = my("flags"):"group-by";

		// 1. Set new state
		if(state == "NONE",
			if('groupingtype == "ROWCOL" % 'groupingtype == "ROW", state = "ROW"
			,
				if('groupingtype == "COL", state = "COLUMN");
			);
		, // else if
		if(state == "ROW",
			if('groupingtype == "ROWCOL" % 'groupingtype == "COL", state = "COLUMN"
			,
				state = "NONE";
			);
		, // else if
		if(state == "COLUMN", state = "NONE";
		)));
		
		// Update global state var and move atoms into place
		self():"flags":"group-by" = state;
		my("groupatoms");

		// Update expression text
		my("updateexpression");

		divomath update results();
	);

// === Add/remove a column/row
	grid:"addcol" := (
		regional(newcoord);
		self():"cols" = my("cols") + 1; // Increment column count

		// Loop over every row and add an Atom to the right
		repeat(my("rows"), row,
			newcoord = self():"grid"_row_(-1):"coord" + ['atomsize+my("verticalpadding"),0];
			if(my("flags"):"group-by" == "COLUMN", newcoord = newcoord + ['groupspacing,0]); // Adjust for spacing

			// Add new Atom in row
			self():"grid"_row = my("grid")_row :> new Atom(newcoord, self());
		);
		my("repaint");
	);
	
	grid:"removecol" := if(my("cols")>1,
		// Set flag for coloring rows and cutting status to undefined and false if not enough rows left
		if(my("flags"):"color-col" >= my("cols"),
			self():"flags":"color-col" = NADA;
			self():"flags":"cut-col" = false;
		);

		self():"cols" = my("cols") - 1; // Decrement column count

		// Loop over every row and remove rightmost Atom
		repeat(my("rows"), row,
			self():"grid"_row = my("grid")_row -- [my("grid")_row_(-1)];
		);
		my("repaint");
	);

	grid:"addrow" := (
		regional(newcoord, offset);
		offset = [0, 'atomsize+my("horizontalpadding")]; // offset to move down by for new row
		if(my("flags"):"group-by" == "ROW", offset = offset + [0,'groupspacing]); // Adjust for spacing
		
		self():"grid" = [] <: my("grid"); // Prepend empty row to grid

		self():"coord" = my("coord") - offset;

		self():"rows" = my("rows") + 1; // Increment row count

		// Loop over reference row and fill new first row with Atoms
		forall(my("grid")_2, atom,
			self():"grid"_1 = my("grid")_1 :> new Atom(atom:"coord" - offset, self());
		);
		
		// Inrease flag for coloring rows an repaint
		if(!isundefined(my("flags"):"color-row"), self():"flags":"color-row" = my("flags"):"color-row" + 1);
		my("repaint");
	);

	grid:"removerow" := if(my("rows")>1,
		// Set flag for coloring rows and cutting status to undefined and false if not enough rows left
		if(my("flags"):"color-row" <= 1,
			self():"flags":"color-row" = NADA;
			self():"flags":"cut-row" = false;
		);

		self():"grid" = my("grid")_(2..length(my("grid")));
		self():"coord" = my("grid")_1_1:"coord";
		self():"rows" = my("rows") - 1;

		// Decrease flag for coloring rows and repaint
		if(!isundefined(my("flags"):"color-row"), self():"flags":"color-row" = my("flags"):"color-row" - 1);
		my("repaint");
	);

// === Convenience and Eval Methods
	grid:"groupatoms" := (
		regional(state);
		state = my("flags"):"group-by";

		// 1. Animate Atoms accordingly
		regional(refatom, atom, newcoord); 
		refatom = my("grid")_1_1;
		apply(1..my("rows"), rowindex, apply(1..my("cols"), colindex,
			atom = my("grid")_rowindex_colindex;

			// Calculate basis for new coordinate without groupspacing (ROW or COLUMN)
			newcoord = refatom:"coord" + [(colindex-1)*('atomsize+'atomhorizontalpadding),0]; // x-offset normally;
			newcoord = newcoord + [0,(rowindex-1)*('atomsize+'atomhorizontalpadding)]; // x-offset with groupspacing;

			if(to bool(my("flags"):"cut-row" & my("flags"):"color-row" < rowindex), newcoord = newcoord + [0,'cutwidth]); // add row cutting offset
			if(to bool(my("flags"):"cut-col" & my("flags"):"color-col" < colindex + 1), newcoord = newcoord + ['cutwidth,0]); // add row cutting offset

			// Adjust for row and column grouping
			if(state == "ROW", newcoord = newcoord + [0,(rowindex-1)*'groupspacing]);
			if(state == "COLUMN",newcoord = newcoord + [(colindex-1)*'groupspacing,0]);
			
			// Animate Atom
			new animationobject(atom, "coord", atom:"coord", newcoord, 'animationspeed, "accel");
		)); // END applys
	);

	grid:"repaint" := ( // Repaints all atoms in a grid based on color-flags
		regional(rowthresh, colthresh, topleft, topright, bottomleft, bottomright);
		
		// Threshold indexes for color change
		rowthresh = my("flags"):"color-row";
		if(isundefined(rowthresh), rowthresh = 0); // default, if no threshhold exists
		colthresh = my("flags"):"color-col";
		if(isundefined(colthresh), colthresh = my("cols")+1); // default, if no threshhold exists

		// Select topleft and topright subgrid (BLUE, ORANGE)
		topleft = if(rowthresh < my("rows"), my("grid")_((rowthresh+1)..my("rows")), []); // select complete rows
		topright = if(colthresh <= my("cols"), apply(topleft, row, row = row_(colthresh..my("cols"))), []); // select cols of topright subgrid
		topleft = apply(topleft, row, row = row_(1..(colthresh-1))); // cut off columns to the right for final topleft

		// Select bottomleft and bottomright subgrid (GREEN, PURPLE)
		bottomleft = if(rowthresh > 0, my("grid")_(1..rowthresh), []); // select complete rows
		bottomright = if(colthresh <= my("cols"), apply(bottomleft, row, row = row_(colthresh..my("cols"))), []); // select cols of bottomright subgrid
		bottomleft = apply(bottomleft, row, row = row_(1..(colthresh-1))); // cut off columns to the right for final bottomleft

		// Paint everything
		apply(topleft, row, apply(row, atom, atom:"color" = 'ATOMCOLORS:"blue"));
		apply(topright, row, apply(row, atom, atom:"color" = 'ATOMCOLORS:"orange"));
		apply(bottomleft, row, apply(row, atom, atom:"color" = 'ATOMCOLORS:"green"));
		apply(bottomright, row, apply(row, atom, atom:"color" = 'ATOMCOLORS:"purple"));

		// Update expression text
		my("updateexpression");

	);
	
	grid:"updateexpression" := (
		// Get state of grid
		regional(groupstate, rowcol, colcol, rowcut, colcut, expr, verbal, r, c, rci, cci);
		groupstate = my("flags"):"group-by";
		rowcol = !isundefined(my("flags"):"color-row");
		colcol = !isundefined(my("flags"):"color-col");
		rowcut = my("flags"):"cut-row";
		colcut = my("flags"):"cut-col";
		
		// Relevant numbers to display
		r = my("rows"); // Total rows
		c = my("cols"); // Total columns
		rci = my("flags"):"color-row"; // Index of colored row (row color index)
		cci = my("flags"):"color-col"; // Index of colored columns (column color index)

		// Handle different states in order: GROUPING > ROW COLOR > COL COLOR > ROW CUT > COL CUT
		// 1 no grouping
		if(groupstate == "NONE",
			if(rowcol, // 2 row colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = (r-rci)*(cci-1) + " + " + (r-rci)*(c-cci+1) + " + " + rci*(cci-1) + " + " + rci*(c-cci+1);
							verbal = (r-rci)*(cci-1) + " und " + (r-rci)*(c-cci+1) + " und " + rci*(cci-1) + " und " + rci*(c-cci+1) + " Punkte/Quadrate.";
						, // 5 col not cut
							value = (r-rci)*c + " + " + rci*c;
							verbal = (r-rci)*c + " und " + rci*c + " Punkte/Quadrate.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = r*(cci-1) + " + " + r*(c-cci+1);
							verbal = r*(cci-1) + " und " + r*(c-cci+1) + " Punkte/Quadrate.";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = (r-rci)*c + " + " + rci*c;
							verbal = (r-rci)*c + " und " + rci*c + " Punkte/Quadrate.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + c;
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + c + " Punkten/Quadraten.";
						);
					);
				);
			, // 2 row not colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = r*(cci-1) + " + " + r*(c-cci+1);
							verbal = r*(cci-1) + " und " + r*(c-cci+1) + " Punkte/Quadrate.";
						, // 5 col not cut
							value = r + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = r * c;
							verbal = value + " Punkte/Quadrate.";
						);
					);
				);
			);
		);

		// 1 grouping by row
		if(groupstate == "ROW",
			if(rowcol, // 2 row colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = (r-rci) + CDOT + (cci-1) + " + " +
											(r-rci) + CDOT + (c-cci+1) + " + " +
											rci + CDOT + (cci-1) + " + " +
											rci + CDOT + (c-cci+1);
							verbal = numeral(r-rci) + " " + (cci-1) + "er und " +
												numeral(r-rci) + " " + (c-cci+1) + "er und " +
												numeral(rci) + " " + (cci-1) + "er und " +
												numeral(rci) + " " + (c-cci+1) + "er.";
						, // 5 col not cut
							value = (r-rci) + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ") + " + rci + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten und 
" + numeral(rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + (cci-1) + " + (" + (r-rci) + "+" + rci + ")" + CDOT + (c-cci+1);
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (cci-1) + " Punkten/Quadraten und
" + numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (c-cci+1) + " Punkten/Quadraten.";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						)
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = (r-rci) + CDOT + c + " + " + rci + CDOT + c;
							verbal = numeral(r-rci) + " " + c + "er und " + numeral(rci) + " " + c + "er.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + c;
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + c + " Punkten/Quadraten.";
						);
					);
				);
			, // 2 row not colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = r + CDOT + (cci-1) + " + " + r + CDOT + (c-cci+1);
							verbal = numeral(r) + " " + (cci-1) + "er und " + numeral(r) + " " + (c-cci+1) + "er.";
						, // 5 col not cut
							value = r + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = r  + CDOT + c;
							verbal = numeral(r)  + " " + c + "er.";
						);
					);
				);
			);
		);

		// 1 grouping by column
		if(groupstate == "COLUMN",
			if(rowcol, // 2 row colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = (cci-1) + CDOT + (r-rci) + " + " +
											(cci-1) + CDOT + rci + " + " +
											(c-cci+1) + CDOT + (r-rci) + " + " +
											(c-cci+1) + CDOT + rci;
							verbal = numeral(cci-1) + " " + (r-rci) + "er und " +
												numeral(cci-1) + " " + (rci) + "er und " +
												numeral(c-cci+1) + " " + (r-rci) + "er und " +
												numeral(c-cci+1) + " " + (rci) + "er.";
						, // 5 col not cut
							value = "(" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + (r-rci) + " + (" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + rci;
							verbal = numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + (r-rci) + " Punkten/Quadraten und
" + numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + rci + " Punkten/Quadraten.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = (cci-1) + CDOT + "(" + (r-rci) + "+" + rci + ") + " + (c-cci+1) + CDOT + "(" + (r-rci) + "+" + rci + ")";
							verbal = numeral(cci-1) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten und 
" + numeral(c-cci+1) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten.";
						, // 5 col not cut
							value = "(" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + "(" + (r-rci) + "+" + (rci) + ")";
							verbal = numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten.";
						)
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = c + CDOT + (r-rci) + " + " + c + CDOT + rci;
							verbal = numeral(c) + " " + (r-rci) + "er und " + numeral(c) + " " + rci + "er.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = c + CDOT + "(" + (r-rci) + "+" + rci + ")";
							verbal = numeral(c) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten.";
						);
					);
				);
			, // 2 row not colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = (cci-1) + CDOT + r + " + " + (c-cci+1) + CDOT + r;
							verbal = numeral(cci-1) + " " + r + "er und " + numeral(c-cci+1) + " " + r + "er.";
						, // 5 col not cut
							value = "(" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + r;
							verbal = numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + r + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = c + CDOT + r;
							verbal = numeral(c) + " " + r + "er.";
						);
					);
				);
			);
		);

		// Set expression handlers value and verbalvalue to built expressions
		self():"expression":"value" = value + ""; // force string for value, might be int
		self():"verbal":"value" = "Ich sehe " + verbal;
	);
	
	grid:"cutgrid" := ( //de-/increases atom distance at coloring edges... eval with 'activeindex for cut position and 'direction of cut from linedirection
	// example usage: eval(my("cutgrid"), 'activeindex->activeindex, 'direction->my("linedirection"));

		// ROW (un-)cutting
		if('direction == "HORIZONTAL" & ('activeindex == my("flags"):"color-row" % 'activeindex == my("flags"):"color-row" + 1) & 'activeindex < my("rows"),
			regional(rows);
			rows = my("grid")_((my("flags"):"color-row"+1)..my("rows")); // Select rows to alter
			if(my("flags"):"cut-row",
				// Uncut row, i.e. move all rows above the index down a little
				apply(rows, row, apply(row, atom, atom:"coord" = atom:"coord" - [0, my("cutwidth")]));
			,
				// Cut row, i.e. move all rows above the index up a little
				apply(rows, row, apply(row, atom, atom:"coord" = atom:"coord" + [0, my("cutwidth")]));
			);
			self():"flags":"cut-row" = !self():"flags":"cut-row"; // change flag state
		);

		// COLUMN (un-)cutting
		if('direction == "VERTICAL" & ('activeindex == my("flags"):"color-col" % 'activeindex == my("flags"):"color-col" - 1) & 'activeindex > 1,
			regional(col);
			cols = apply(my("grid"), row, row_(my("flags"):"color-col"..my("cols"))); // Select cols to alter
			if(my("flags"):"cut-col",
				// Uncut col, i.e. move all cols right of the index left a little
				apply(cols, row, apply(row, atom, atom:"coord" = atom:"coord" - [my("cutwidth"), 0]));
			,
				// Cut col, i.e. move all cols right of the index right a little
				apply(cols, row, apply(row, atom, atom:"coord" = atom:"coord" + [my("cutwidth"), 0]));
			);
			self():"flags":"cut-col" = !self():"flags":"cut-col"; // change flag state
		);
	);

	grid:"getactiveindex" := ( // for clicking a single atom ... eval with 'point (usually as mouse().xy))
		regional(hotrow, hotcol, c);
		hotrow = hotcol = NADA;
		c = my("coord");

		if(	'point_2 >= c_2 & 'point_2 <= c_2 + my("height") &
				'point_1 >= c_1 & 'point_1 <= c_1 + my("width"), // only calculate, if 'point inside grid

			// Calc index of hot row
			hotrow = 'point_2 - c_2;
			forall(1..my("rows"), rowindex,
				if('point_2 >= my("grid")_rowindex_1:"coord"_2, hotrow = rowindex);
			);

			// Calc index of hot column
			hotcol = 'point_1 - c_1;
			forall(1..my("cols"), colindex,
				if('point_1 >= my("grid")_1_colindex:"coord"_1, hotcol = colindex);
			);
		);

		[hotrow, hotcol]; // Return hot row and column
	);

	// Inner objects: UI elements
	// ==========================
	// === UI: Vertical bar
	grid:"vbar" = ( 
		regional(vbar);
		vbar = new VAMobject("Bar");
		vbar:"subtype" = "vertical";
		vbar:"parent" = grid;
		vbar:"ismoveable" = true;
		vbar:"width" = .1;
		vbar:"height" := my("parent"):"height";
		vbar:"color" = DIVODARKBLUE;
		vbar:"padleft" := 'atomsize/10 + if(my("parent"):"flags":"cut-col",my("parent"):"cutwidth",0);

		vbar:"coord" := nada; // Gets assigned by my("alignbar")
		vbar:"alignbar" := ( // (Re-)sets bar position
			self():"coord" := my("parent"):"coord" + [my("parent"):"width" + my("padleft"), 0];
			divomath update results();
		);
		vbar:"alignbar"; // Initially set coord

		vbar:"shape" := (
			regional(parts);
			parts = {};

			// Create vertical bar that is as tall as all strips combined
			parts:"bar" = rectangle(my("coord"), my("width"), my("height"));

			// Create circle
			regional(center, radius);
			radius = .7;
			center = my("coord") + [my("width"),0] + [radius+.2,my("height")/2];
			parts:"circle" = {"M": center, "r": radius};

			// Create vertical line through center of the circle
			parts:"circleline" = {"A": center - [0,1.1*radius], "B": center + [0,1.1*radius]};

			// Create triangles pointing left and right (scaling numbers are chosen by eye)
			trigoffset = [radius/2.3,0];
			parts:"lefttrig" = regularpolygon(center-trigoffset, radius/3, 3, PI/6);
			parts:"righttrig" = regularpolygon(center+1.05*trigoffset, radius/3, 3,-PI/6);

			parts; // Return shape object
		);

		vbar:"hitbox" := my("shape"):"circle";
		vbar:"ishot" := if(my("parent"):"tool" == "hand" & !'picturemode,
			dist(my("hitbox"):"M",mouse().xy) < my("hitbox"):"r",
			false
		);

		vbar:"draw" := if(my("parent"):"tool" == "hand",
			// Draw vertical bar
			fillpoly(my("shape"):"bar", color -> my("color"));

			// Draw base circle (hitbox)
			fill(circle(my("shape"):"circle":"M", my("shape"):"circle":"r"), color -> my("color"));		

			// Draw line through circle
			draw(my("shape"):"circleline":"A", my("shape"):"circleline":"B", size -> 3, color -> grey(1)
			);

			// Draw triangles
			fillpoly(my("shape"):"lefttrig", color -> grey(1));
			fillpoly(my("shape"):"righttrig", color -> grey(1));
		);

		vbar:"move" := if(my("ismoveable"),
			// Set position based on mouse coords
			self():"coord" = [
				max(coord_1,my("parent"):"coord"_1),
				my("parent"):"coord"_2
			];

			// Remove column if above 1 AND bar touches column
			if(my("coord")_1 < my("parent"):"coord"_1 + my("parent"):"width" - my("padleft"),
				my("parent"):"removecol";
			);

			// Add column if gap is big enough
			regional(space);
			space = 'atomsize + my("parent"):"verticalpadding" + my("padleft");
			if(my("coord")_1 - (my("parent"):"coord"_1 + my("parent"):"width") > space ,
				my("parent"):"addcol";
			);
		);

		vbar:"moveend" := my("alignbar");

		vbar; // Return bar
	);

	// === UI: Horizontal bar
	grid:"hbar" = ( 
		regional(hbar);
		hbar = new VAMobject("Bar");
		hbar:"subtype" = "horizontal";
		hbar:"parent" = grid;
		hbar:"ismoveable" = true;
		hbar:"width" := my("parent"):"width";
		hbar:"height" = .1;
		hbar:"color" = DIVODARKBLUE;
		hbar:"padup" := 2*'atomsize/10 + if(my("parent"):"flags":"cut-row",my("parent"):"cutwidth",0);

		hbar:"coord" := nada; // Gets assigned by my("alignbar")
		hbar:"alignbar" := ( // (Re-)sets bar position
			self():"coord" := my("parent"):"coord" - [0, my("padup")];
			divomath update results();
		);
		hbar:"alignbar"; // Initially set coord

		hbar:"shape" := (
			regional(parts);
			parts = {};

			// Create vertical bar that is as tall as all strips combined
			parts:"bar" = rectangle(my("coord"), my("width"), my("height"));

			// Create circle
			regional(center, radius);
			radius = .7;
			center = my("coord") + [my("width")/2,-radius-.2];
			parts:"circle" = {"M": center, "r": radius};

			// Create vertical line through center of the circle
			parts:"circleline" = {"A": center - [1.1*radius,0], "B": center + [1.1*radius,0]};

			// Create triangles pointing left and right (scaling numbers are chosen by eye)
			trigoffset = [0,radius/2.3];
			parts:"uptrig" = regularpolygon(center+1.05*trigoffset, radius/3, 3, 2*PI/3);
			parts:"downtrig" = regularpolygon(center-trigoffset, radius/3, 3,-PI/3);

			parts; // Return shape object
		);

		hbar:"hitbox" := my("shape"):"circle";
		hbar:"ishot" := if(my("parent"):"tool" == "hand" & !'picturemode, // Only hottable, when hand tool is selected
			dist(my("hitbox"):"M",mouse().xy) < my("hitbox"):"r",
			false
		);

		hbar:"draw" := if(my("parent"):"tool" == "hand",
			// Draw vertical bar
			fillpoly(my("shape"):"bar", color -> my("color"));

			// Draw base circle (hitbox)
			fill(circle(my("shape"):"circle":"M", my("shape"):"circle":"r"), color -> my("color"));		

			// Draw line through circle
			draw(my("shape"):"circleline":"A", my("shape"):"circleline":"B", size -> 3, color -> grey(1)
			);

			// Draw triangles
			fillpoly(my("shape"):"uptrig", color -> grey(1));
			fillpoly(my("shape"):"downtrig", color -> grey(1));
		);

		hbar:"move" := if(my("ismoveable"),
			// Set position based on mouse coords
			self():"coord" = [
				my("parent"):"coord"_1,
				min(coord_2,my("parent"):"coord"_2+my("parent"):"height")
			];

			// Remove row if above 1 AND bar touches row
			if(my("coord")_2 > my("parent"):"coord"_2 + my("padup"),
				my("parent"):"removerow";
			);

			// Add row if gap is big enough
			regional(space);
			space = 'atomsize + my("parent"):"horizontalpadding" + my("padup");
			if(my("parent"):"coord"_2 - my("coord")_2 > space,
				my("parent"):"addrow";
			);
		);

		hbar:"moveend" := my("alignbar");

		hbar; // Return bar
	);

	// === UI: Tool button
	grid:"tool" = 'tool; // Initial tools name
	grid:"toolbutton" := (
		regional(btn, c);

		c = VRTOPRIGHT - ('buttonsize+'buttonpadding) * [1,1];
		if(!isundefined('toolbuttonx), c_1 = 'toolbuttonx);
		if(!isundefined('toolbuttony), c_2 = 'toolbuttony);
		btn = new Button(c, 'buttonsize, 'buttonsize, "", 14);

		btn:"parent" = self();
		btn:"center" := my("coord") + .5*[my("width"),my("height")];
		btn:"imgfill" = 2;
		btn:"imgscale" := ( // scale relative to images pixelsize
			regional(px);
			px = imagesize(ICONS:(my("tool")));
			my("imgfill") * min(my("width"), my("height")) * screenresolution() / max(px_1, px_2);
		);
		btn:"value" = {"hand":1,"bucket":2,"scissors":3}:'tool;
		btn:"tool" := ["hand", "bucket", "scissors"]_(my("value"));
		btn:"ishot" := if('picturemode, false, if(my("show"),inrectangle(my("hitbox"),mouse().xy))); 

		btn:"color" := if(my("parent"):"toolsallowed", DZLMCOLORLIGHT, grey(.93));
		btn:"bordercolor" := if(my("parent"):"toolsallowed", DZLMCOLORDARK, grey(.75));

		btn:"drawafter" := (
			drawimage(my("center"), ICONS:(my("tool")), scale->my("imgscale"));
		);
	
		btn:"script" := (
			if(my("parent"):"toolsallowed",
				self():"value" = 1 + mod(my("value"),3);
			,
				self():"value" = 1; // stay on "hand" as long as nothing is grouped
			);
			self():"parent":"tool" = my("tool");
			divomath update results();
		);

		btn; // Return toolbutton
	);

	// === UI: Expression handler
	grid:"expression" = (
		regional(expr); expr = {};
		expr:"type" = "Expression";
		expr:"parent" = grid;
		expr:"coord" = [3,4];
		expr:"fontsize" = 'fontsize;
		expr:"font" = NADA;
		expr:"width" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_2_1 - box_1_1;
		);
		expr:"height" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_4_2 - box_1_2;
		);
		expr:"baseline" := (
			regional(size);
			size = pixelsize(my("value"), size->my("fontsize"), font->my("font"));
			size_3 / screenresolution();
		);

		expr:"value" = NADA; // gets set by grid:"updateexpression";

		expr:"bgcolor" = DZLMCOLORLIGHT;
		expr:"padding" = .3;
		expr:"hitbox" := getboundingbox(my("value"), my("coord")-[0,my("baseline")/2], my("fontsize"), my("font"));
		expr:"shape" := rounded rectangle(
			my("coord")-[0,my("baseline")/2]-my("padding")*[1,1],
			my("width")+2*my("padding"),
			my("height")+2*my("padding"),
			my("padding")
		);
		expr:"ishot" := if('picturemode, false, inrectangle(my("hitbox"), mouse().xy));
		expr:"ismoveable" = 'expressionmoveable;
		expr:"getaction" = "move";

		expr:"draw" := (
			// Draw box
			fill(my("shape"), color->my("bgcolor"));

			// Draw expression	
			drawtext(my("coord"), my("value"), font->my("font"), size->my("fontsize"));

			// Debug draw
			if(LOGLEVEL > 0,
				drawpoly(my("shape"), color->[1,0,0]);
				draw(my("coord"), color->[1,0,0]);
			);
		);

		expr:"move" := if(my("ismoveable"), self():"coord" = my("coord") + mousedelta);

		expr; // Return expression
	);

	grid:"verbal" = (
		regional(expr); expr = {};
		expr:"type" = "Expression";
		expr:"parent" = grid;
		expr:"coord" = [3,6];
		expr:"fontsize" = 'fontsize;
		expr:"font" = NADA;
		expr:"width" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_2_1 - box_1_1;
		);
		expr:"height" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_4_2 - box_1_2;
		);
		expr:"baseline" := (
			regional(size);
			size = pixelsize(my("value"), size->my("fontsize"), font->my("font"));
			size_3 / screenresolution();
		);

		expr:"value" = NADA; // gets set by grid:"updateexpression";

		expr:"bgcolor" = DZLMCOLORLIGHT;
		expr:"padding" = .3;
		expr:"hitbox" := getboundingbox(my("value"), my("coord")-[0,my("baseline")/2], my("fontsize"), my("font"));
		expr:"shape" := rounded rectangle(
			my("coord")-[0,my("baseline")/2]-my("padding")*[1,1],
			my("width")+2*my("padding"),
			my("height")+2*my("padding"),
			my("padding")
		);
		expr:"ishot" := if('picturemode, false, inrectangle(my("hitbox"), mouse().xy));
		expr:"ismoveable" = 'verbalmoveable;
		expr:"getaction" = "move";

		expr:"draw" :=	(
			// Draw box
			fill(my("shape"), color->my("bgcolor"));

			// Draw expression	
			drawtext(my("coord"), my("value"), font->my("font"), size->my("fontsize"));

			// Debug draw
			if(LOGLEVEL > 0,
				drawpoly(my("shape"), color->[1,0,0]);
				draw(my("coord"), color->[1,0,0]);
			);
		);

		expr:"move" := if(my("ismoveable"), self():"coord" = my("coord") + mousedelta);

		expr; // Return expression
	);

	grid:"updateexpression"; // Update value and verbalvalue for init

	grid; // Return Grid
);

// ================== //
// D | Initialization //
// ================== //

// === Build grid ===
grid = new Grid('gridposition,'rows,'cols);

// === Set initial coloring ===
if(tobool('coloredrowindex > 0), grid:"flags":"color-row" = 'coloredrowindex);
if(tobool('coloredcolindex > 0), grid:"flags":"color-col" = grid:"cols" - 'coloredcolindex + 1);
grid:"repaint";

// === Set initial cutting ===
if('cuthorizontally & !grid:"flags":"cut-row" & tobool('coloredrowindex > 0),
	eval(
		grid:"cutgrid",
		'activeindex->grid:"flags":"color-row",
		'direction->"HORIZONTAL"
	)
);
if('cutvertically & !grid:"flags":"cut-col" & tobool('coloredcolindex > 0),
	eval(
		grid:"cutgrid",
		'activeindex->grid:"flags":"color-col",
		'direction->"VERTICAL"
	)
);

// === Set initial grouping ===
grid:"flags":"group-by" = 'groupby;
grid:"groupatoms";

// === Reevaluate Expressions ===
grid:"updateexpression";

// === Set up Toggle for hiding/showing expressions ===
regional(togglepadding, togglesize, togglepos);
togglepadding = .3;
togglesize = 1;
togglepos = VRTOPLEFT - [0,.5*togglesize];
togglepos = togglepos + [togglepadding, -togglepadding];
toggle = new Toggle(togglepos, togglesize, 'expressiontogglestate, "Sprache/Term anzeigen", 12*togglesize);
toggle:"script" := (
	if(my("state"),
		if(grid:"drawexpression", obj = obj :> obj_1:"expression");
		if(grid:"drawverbal", obj = obj :> obj_1:"verbal");
	,
		obj = obj -- [grid:"expression"];
		obj = obj -- [grid:"verbal"];
	);
);

// === Set up expressions ===
if(!isundefined('expressionposition), grid:"expression":"coord" = 'expressionposition);
if(!isundefined('verbalposition), grid:"verbal":"coord" = 'verbalposition);

// === Build ===
obj = obj :> grid;
obj = obj :> obj_1:"vbar";
obj = obj :> obj_1:"hbar";
if('showexpressiontoggle, obj = obj :> toggle);
if('drawtoolbutton, obj = obj :> obj_1:"toolbutton");
if('expressiontogglestate & 'drawexpression, obj = obj :> obj_1:"expression");
if('expressiontogglestate & 'drawverbal, obj = obj :> obj_1:"verbal");
); // End VAM if

//[VAM] divisors
/** v16 *****************************************************************************************
* Widget for exploring divisibility and remainder.
*
* Recent changes:
* 2026-08-06 Adjusted VAM to new framework structure.
* 2026-08-10 Change text output.
************************************************************************************************/


// Teilbarkeit
if(VAM == "divisors",


// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

// --- Blobs and strips ---
blobs									= default to(ENVIRONMENTALPARAMS:"blobs", 0, true); // Initial blob count
maxblobs							= default to(ENVIRONMENTALPARAMS:"maxblobs", 100, true); // Maximum blob count
divisor								= default to(ENVIRONMENTALPARAMS:"divisor", 1, true); // Initial divisor
maxcols								= default to(ENVIRONMENTALPARAMS:"maxcols", 10, true); // Maximum number of divisors (columns)
sequentialorder				= default to(ENVIRONMENTALPARAMS:"sequentialorder", false, true); // Reordering strategy when divisor changes

// --- Look and feel ---
size									= default to(ENVIRONMENTALPARAMS:"size", .7, true); // Size of Blobs
padding								= default to(ENVIRONMENTALPARAMS:"blobmargin", .2, true); // Padding between blobs in a strip
stripmargin						= default to(ENVIRONMENTALPARAMS:"stripmargin", .5, true); // Vertical margin between strips
timing								= default to(ENVIRONMENTALPARAMS:"timing", .5, true); // Timing of animations
fontsize							= default to(ENVIRONMENTALPARAMS:"fontsize", 16, true); // Size of the text below the strips

// --- UI elements ---
drawblobbuttons				= default to(ENVIRONMENTALPARAMS:"drawblobbuttons", true, true); // Buttons for blob count
drawdivbuttons				= default to(ENVIRONMENTALPARAMS:"drawdivbuttons", true, true); // Buttons for divisor
drawbar								= default to(ENVIRONMENTALPARAMS:"drawbar", true, true); // Vertical bar for changing divisor
displaycalc						= default to(ENVIRONMENTALPARAMS:"displaycalc", true, true); // "a : b"
displayresult					= default to(ENVIRONMENTALPARAMS:"displayresult", true, true); // "= c Rest d"
displaydescription		= default to(ENVIRONMENTALPARAMS:"displaydescription", true, true); // verbal description
displayblobcount			= default to(ENVIRONMENTALPARAMS:"displayblobcount", true, true); // total number of blobs
displaydivisorcount		= default to(ENVIRONMENTALPARAMS:"displaydivisorcount", true, true); // group size

// Normalize booleans (divomath reports back "" instead of false)
sequentialorder				= tobool(sequentialorder);
drawblobbuttons				= tobool(drawblobbuttons);
drawdivbuttons				= tobool(drawdivbuttons);
drawbar								= tobool(drawbar);
displaycalc						= tobool(displaycalc);
displayresult					= tobool(displayresult);
displaydescription		= tobool(displaydescription);
displayblobcount			= tobool(displayblobcount);
displaydivisorcount		= tobool(displaydivisorcount);

// --- Colors of Blobs and Strips ---
// Special case: configured as a list of two colour NAMES (see COLORMAP), not
// as rgb values - e.g. ["DIVORED", "DIVOGREY"].
blobcolors = default to(ENVIRONMENTALPARAMS:"color", NADA, true);
blobcolors = if(isundefined(blobcolors),
	[DIVORED, DIVOGREY]
,
	apply(blobcolors, if(isstring(#), COLORMAP:#, #))
);

// Global variables
'globalscaling = 1; // Adjusts size of stuff, gets set by world:"updateglobalscaling"


divomath update results() := if(ISDIVOMATH, // @overwrite
	divomath clear results();

	warn at("divisors, divomath update results()", "No validation implemented.");

	// Export state as results as well for forward referencing
	regional(dmstate);
	dmstate = divomath set state();
	forall(keys(dmstate), #,
		divomath put result(#, dmstate:#);
	);

	// Post results
	divomath post results();
);

divomath set state() := if(ISDIVOMATH, // @overwrite
	regional(cards, state);
	cards = select(obj, #:"type"=="numbercard"); // all the cards
	
	// Return current state
	state = {
		"size" : size, // Size of Blobs
		"blobmargin" : padding, // Padding between blobs in a strip
		"stripmargin" : stripmargin, // Margin between strips
		"timing" : timing, // Animation timing
		"blobs" : world:"#allblobs", // Initial Blob count
		"maxblobs" : maxblobs, // Maximum Blob count
		"divisor" : world:"#divisors", // Initial number of divisors
		"maxcols" : maxcols, // Max number of divisors
		"sequentialorder" : sequentialorder, // Reording strategy on divisor change
		"drawblobbuttons" : drawblobbuttons,
		"drawdivbuttons" : drawdivbuttons,
		"displaycalc" : displaycalc,
		"drawbar" : drawbar,
		"displayresult" : displayresult,
		"displaydescription" : displaydescription,
		"displayblobcount" : displayblobcount,
		"displaydivisorcount" : displaydivisorcount
	};

	state;
);


// ===================== //
// C | Class Definitions //
// ===================== //

// C.1 | Handler for positioning and drawing
new World() := (
	regional(o, btncolors);
	o = new VAMobject("World");

	// Fields
	o:"coord" = NADA;
	o:"font" = "Be Vietnam";
	o:"blobs" = [];
	o:"#blobs" := length(my("blobs"));
	o:"#allblobs" := (
		regional(numofblobs);
		numofblobs = my("#blobs");
		forall(my("strips"), numofblobs = numofblobs + #:"size");
		numofblobs;
	);
	o:"strips" = [];
	o:"#strips" := length(my("strips"));
	o:"#divisors" = 0;
	
	// --- Anchors for the bottom UI band -------------------------------------
	o:"uiheight" = 3.5;                               // height of the UI band
	o:"uimargin" = .5;                                // distance to left/right edge

	o:"uileft"   := VRBOTTOMLEFT_1  + my("uimargin"); // left edge of the UI band
	o:"uiright"  := VRBOTTOMRIGHT_1 - my("uimargin"); // right edge
	o:"uibottom" := VRBOTTOMLEFT_2;                   // bottom of the visible area
	o:"uitop"    := my("uibottom") + my("uiheight");  // where the strips area starts

	// Baselines inside the UI band, measured from the bottom
	o:"uirow1"      := my("uibottom") + 2.1;          // calculation / counts
	o:"uirow2"      := my("uibottom") + 1.4;          // description
	o:"uirow3"      := my("uibottom") + .7;           // remainder
	o:"uibuttonrow" := my("uibottom") + .9;           // buttons
	
	o:"shape" := (
		regional(shape, margin);
		shape = apply(VISIBLERECT, #.xy);

		// Remove bottom UI
		shape_1 = shape_1 + [0, my("uiheight")];
		shape_2 = shape_2 + [0, my("uiheight")];

		// Add some margins to each side
		margin = .5;
		shape_1 = shape_1 + margin*[1,1];
		shape_2 = shape_2 + margin*[-1,1] - [2, 0];  // also add room for bar
		shape_3 = shape_3 + margin*[-1,-1] - [2, 0];  // also add room for bar
		shape_4 = shape_4 + margin*[1,-1];
		
		shape;
	);

	o:"center" := my("shape")_1 + 0.5 * (my("shape")_3 - my("shape")_1);
	o:"width"  := my("shape")_2_1 - my("shape")_1_1;
	o:"height" := my("shape")_4_2 - my("shape")_1_2;
	
	// Helper fields for proper scaling
	o:"contentwidth" := if(length(my("strips")) > 0, // height of all strips combined		
		my("strips")_1:"shape"_2_1 - my("strips")_1:"shape"_1_1; // right corner - left corner
	,
		0 // 0, if no strips
	);
	o:"contentheight" := if(length(my("strips")) > 0, // height of all strips combined
		length(my("strips")) * my("strips")_1:"height" + (length(my("strips"))-1) * my("stripmargin");
	,
		0 // if no strips
	);

	o:"padding" = padding / 2 * 'globalscaling;
	o:"stripmargin" := stripmargin * 'globalscaling;
	
	o:"updateglobalscaling" := ( // update scaling based on available height/width, call accordingly

		'globalscaling = 1; // reset scaling for proper recalculation of scaling factor
		
		if(my("contentheight") > 0 & my("contentwidth") > 0, // only if strips exist
			'globalscaling = min([1, my("height") / my("contentheight"), my("width") / my("contentwidth")]);
		,
			'globalscaling = 1 // else set to 1
		);
	);

	// Inner objects: UI elements
	// ==========================
	// === UI: Bar to change divisors
	o:"bar" = ( 
		regional(bar);
		bar = new VAMobject("Bar");
		bar:"parent" = o;
		bar:"ismoveable" = true;
		bar:"width" = .1;
		bar:"color" = DIVODARKBLUE;
		bar:"height" := my("parent"):"contentheight";
		bar:"padleft" = 2*o:"padding";

		bar:"coord" := NADA; // Gets assigned by my("alignbar")
		bar:"alignbar" := ( // (Re-)sets bar position
			self():"coord" := my("parent"):"center" + .5 * [my("parent"):"contentwidth", -my("parent"):"contentheight"] + [my("padleft"), 0];
		);
		bar:"alignbar"; // Initially set coord
		
		bar:"shape" := (
			regional(parts);
			parts = {};

			// Create vertical bar that is as tall as all strips combined
			parts:"bar" = rectangle(my("coord"), my("width"), my("height"));

			// Create circle
			regional(center, radius);
			radius = .7;
			center = my("coord") + [my("width"),0] + [radius+.2,my("height")/2];
			parts:"circle" = {"M": center, "r": radius};

			// Create vertical line through center of the circle
			parts:"circleline" = {"A": center - [0,1.1*radius], "B": center + [0,1.1*radius]};

			// Create triangles pointing left and right
			// (scaling numbers are chosen by eye)
			trigoffset = [radius/2.3,0];
			parts:"lefttrig" = regularpolygon(center-trigoffset, radius/3, 3, PI/6);
			parts:"righttrig" = regularpolygon(center+1.05*trigoffset, radius/3, 3,-PI/6);

			parts; // Return shape object
		);

		bar:"hitbox" := my("shape"):"circle";
		bar:"ishot" := dist(my("hitbox"):"M",mouse().xy) < my("hitbox"):"r" & my("parent"):"#strips" > 0;

		bar:"move" := if(my("ismoveable"),
			// Set position based on mouse coords
			set my("coord", [
				max(coord_1,my("parent"):"strips"_1:"coord"_1),
				my("parent"):"strips"_(-1):"shape"_1_2
			]);

			// Decrease divisor count if above 1 AND bar touches strips
			regional(stripedge);
			stripedgeX = my("parent"):"strips"_1:"coord" + [my("parent"):"strips"_1:"width",0];
			stripedgeX = stripedgeX_1;
			if(my("parent"):"#divisors" > 1 & stripedgeX > my("shape"):"bar"_1_1,
				my("parent"):"divisor-":"script";
			);

			// Calculate gap for triggering increasing divisor count
			regional(gap, requiredwidth);
			gap = my("shape"):"bar"_1_1;
			gap = gap - my("parent"):"strips"_1:"shape"_2_1;
			requiredwidth = new Blob():"size";

			// Increase divisor count if gap is big enough AND there is still more than one strip
			if(gap > requiredwidth & my("parent"):"#strips" > 1 & my("parent"):"#divisors" < maxcols,
				my("parent"):"divisor+":"script";
			);
		);

		bar:"moveend" := set my("coord", [ // Reset coord of bar
				my("parent"):"strips"_1:"shape"_2_1 + my("padleft"), 
				my("parent"):"strips"_(-1):"shape"_1_2
			]);

		bar:"draw" := if(my("parent"):"#strips" > 0,
			// Draw vertical bar
			fillpoly(my("shape"):"bar", color -> my("color"));

			// Draw base circle (hitbox)
			fill(circle(my("shape"):"circle":"M", my("shape"):"circle":"r"), color -> my("color"));		

			// Draw line through circle
			draw(my("shape"):"circleline":"A", my("shape"):"circleline":"B", size -> 3, color -> grey(1)
			);

			// Draw triangles
			fillpoly(my("shape"):"lefttrig", color -> grey(1));
			fillpoly(my("shape"):"righttrig", color -> grey(1));
		);

		bar; // Return bar
	);
	
	// === UI: Button for adding a blob
	o:"blob+" = (
		regional(btn);
		btn = new Button([o:"uileft" + 1.5, o:"uibuttonrow"], 1, 1, "", 22*FONTSCALE);
		btn:"handle" = o;
		btn:"show" := my("handle"):"#allblobs" < maxblobs;
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"drawafter" := my("drawplus");
		btn:"script" := (
			regional(blob);
			my("handle"):"makeblob";
			blob = my("handle"):"blobs"_(-1);
			if(my("handle"):"#divisors" > 0,
				my("handle"):"moveblobstostrips"
			);
			my("handle"):"bar":"alignbar";
		);

		btn; // Return Button
	);

	// === UI: Button for removing a blob
	o:"blob-" = (
		regional(btn);
		btn = new Button([o:"uileft", o:"uibuttonrow"], 1, 1, "", 22*FONTSCALE);
		btn:"handle" = o;
		btn:"show" := if(my("handle"):"#allblobs" > 0,true,false);
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"drawafter" := my("drawminus");
		btn:"script" := ( 
			// Remove last blob from last strip and reconfigure
			eval(my("handle"):"removeblob",numofblocks->1);
			if(my("handle"):"#strips" > 0,
				my("handle"):"strips"_(-1):"drawstrip" = false;
			);
			my("handle"):"removeemptystrips";
			my("handle"):"bar":"alignbar";
		);
		btn; // Return Button
	);

	// === UI: Button for increasing strip size
	o:"divisor+" = (
		regional(btn);
		btn = new Button([o:"uiright" - 1, o:"uibuttonrow"], 1, 1, "", 22*FONTSCALE);
		btn:"handle" = o;
		btn:"show" := my("handle"):"#divisors" < maxcols;
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"drawafter" := my("drawplus");
		btn:"script" := (
			my("handle"):"#divisors" = my("handle"):"#divisors" + 1;
			my("handle"):"refillstrips";
			my("handle"):"bar":"alignbar";
		);
		btn; // Return Button
	);

	// === UI: Button for decreasing strip size
	o:"divisor-" = (
		regional(btn);
		btn = new Button([o:"uiright" - 2.5, o:"uibuttonrow"], 1, 1, "", 22*FONTSCALE);
		btn:"handle" = o;
		btn:"show" := my("handle"):"#divisors" > 1;
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"drawafter" := my("drawminus");
		btn:"script" := (
			my("handle"):"#divisors" = max(1, my("handle"):"#divisors" - 1);
			my("handle"):"refillstrips";
			my("handle"):"bar":"alignbar";
		);
		btn; // Return Button
	);

	o:"uielements" := [
		my("bar"),
		my("blob+"), my("blob-"),
		my("divisor+"), my("divisor-")
	];
	
	// Methods
	o:"makeblob" := (
		set my("blobs", my("blobs") :> new Blob());
		my("blobs")_(-1):"parent" = self();
	);
	o:"makestrip" := (
		set my("strips", my("strips") :> new Strip(NADA));
		my("strips")_(-1):"parent" = self();
	);
	o:"removeemptystrips" := (
		set my("strips", select(my("strips"),#:"size" > 0));
		my("positionstrips"); // Redraw
	);
	
	// Draw strips and (free) blobs
	o:"draw" := (	
		forall(my("blobs"),#:"draw");
		forall(my("strips"),#:"draw");
		
		// Draw line to visually separate bottom UI elements
		regional(moveupby);
		moveby = 0;
		draw([VRBOTTOMLEFT_1, my("uitop") + moveby], [VRBOTTOMRIGHT_1, my("uitop") + moveby], color->grey(0));
 
		// Draw total blob count
		if(displayblobcount,
			drawtext([my("uileft") + .3, my("uirow1")], "Gesamtanzahl: " + my("#allblobs"),
				size->16*FONTSCALE, family->my("font"));
		);
 
		// Draw divisor count
		if(displaydivisorcount,
			regional(numofdivisors);
			numofdivisors = "Gruppengröße";
			numofdivisors = numofdivisors + if(my("#divisors") > 0, ": " + my("#divisors"), "");
			drawtext([my("uiright") - 6.5, my("uirow1")], numofdivisors,
				size->16*FONTSCALE, family->my("font"));
		);
 
		// Draw calculation texts
		if(my("#divisors") > 0,
			regional(b, d, m, maintext, resttext);

			b = my("#blobs");
			forall(my("strips"), b = b + #:"size");
			d = my("#divisors");
			m = mod(b, d);

			maintext = "";
			if(displaycalc,   maintext = b + "  :  " + d);
			if(displayresult, maintext = maintext + "   =  " + floor(b/d));

			resttext = if(displayresult & m != 0, "   R " + m, "");

			if(length(maintext) > 0,
				drawtext([my("uileft") + 8.5, my("uirow1")], maintext,
					size->16*FONTSCALE, bold->true, family->my("font"));
			);

			if(length(resttext) > 0,
				drawtext([my("uileft") + 8.5
					+ pixelsize(maintext, size->16*FONTSCALE)_1/screenresolution() + .2,
					my("uirow1")], resttext,
					color->DIVOBLUE, size->16*FONTSCALE, family->my("font"));
			);

			// Draw description
			if(displaydescription,
				regional(text);

				// "c <b-er> passen in a."
				text = floor(b/d) + " " + VALUEMAP:d;
				text = text + if(floor(b/d) == 1, " passt ", " passen ");
				text = text + " in " + b + ".";
				drawtext([my("uileft") + 8.5, my("uirow2")], text,
					size->16*FONTSCALE, family->my("font"));

				// "Es bleiben d übrig."
				if(m != 0,
					text = "Es bleib" + if(m == 1, "t ", "en ") + m + " übrig.";
					drawtext([my("uileft") + 8.5, my("uirow3")], text,
						color->DIVOBLUE, size->16*FONTSCALE, family->my("font"));
				);
			);
		);
		
		// Debug draw
		if(LOGLEVEL > 0,
			drawpoly(my("shape"), color->grey(.7));
			draw([my("shape")_1, my("shape")_3], color->grey(.7));
			draw([my("shape")_2, my("shape")_4], color->grey(.7));
			draw(my("center"), color->[.8,0,0]);
		);
	);

	o:"refillstrips" := ( // Refill Strips, when divisor count changes
		regional(div);
		div = my("#divisors");	

		if(sequentialorder, // Move Blobs along sequentially
			regional(tostrip);

			// Return blobs from all Strips to World
			forall(reverse(my("strips")),
				set my("blobs", #:"children" ++ my("blobs"));
			);

			// Remove all Strips
			set my("strips", []);

			// Refill strips
			repeat(ceil(my("#blobs")/div), // Create Strips rounding up.
				tostrip = []; // blobs that go into each Strip
				repeat(div, d, if(my("#blobs") >= d, // fill list and catch it's end
					tostrip = tostrip :> my("blobs")_d;
				));
				my("makestrip"); // make a new Strip
				eval( // put blobs in Strip
					my("putblob"),
					strip->my("strips")_(-1),
					blobs->tostrip
				);
			);
		, // Move Blobs "naturally"
			regional(spareblobs, diff);
			spareblobs = [];
			
			// Calculate if Strips shrink or grow
			if(my("#strips") != 0,
				diff = my("strips")_1:"size" - div,
				diff = -div
			);

			// Handle shrinking Strips
			if(diff > 0,
				// In all full Strips...
				forall(my("strips"), 
					if(#:"size" > div,
						// ..return overflowing Blobs to World
						set my("blobs", my("blobs") ++ #:"children"_(div+1..#:"size"));	
				
						// ...remove overflowing Blobs from Strip
						#:"children" = #:"children"_(1..div);
					);
				);

				// Fill last strip or create new one
				forall(my("blobs"),
					// Create new Strip if last one is full
					if(my("strips")_(-1):"size" >= div,
						my("makestrip");
					);
					// Put Blob in last strip
					eval(my("putblob"),strip->my("strips")_(-1),blobs->#);
				);
			);

			// Handle growing strips
			if(diff < 0,
				// Point to first and last Strip for iterating
				regional(current, last, i);
				i = 1;

				// Create a Strip if none exists
				if(my("#strips") == 0, my("makestrip"));

				// Move free Blobs to current Strips
				my("moveblobstostrips");

				current = my("strips")_i;
				last = my("strips")_(-1);

				// Move Blobs from first to current Strip until full
				while(current != last,
					diff = current:"size" - div;

					// Move to next Strip, if already full
					if(diff == 0 & my("strips")_(i+1):"size" > 0,
						i = i + 1;
						current = my("strips")_i;
						diff = current:"size" - div;
					);

					// Move one strip "up", if last one is empty
					if(last:"size" == 0, 
						my("removeemptystrips");
						last = my("strips")_(-1);
					);

					// Move Blob to current strip to fill it up
					if(diff < 0,
						eval(my("popblob"),strip->last, index->-1);
						eval(my("putblob"),strip->current,blobs->my("blobs")_(-1));
					);
				);
			);
		);

		// Toggle strip drawing for all Strips depending on if it is full or not
		forall(my("strips"),
			#:"drawstrip" = if(#:"size" == div, true, false)
		);

		// Redraw	
		my("positionstrips");
	);

	o:"moveblobstostrips" := ( // Move free Blobs to Strips
		regional(div, strip, n);
		div = max(1, my("#divisors"));

		if(my("#strips") == 0, my("makestrip"));

		// Number of blobs is known up front - no need for a while loop that
		// depends on the count actually going down.
		n = my("#blobs");
		repeat(n,
			strip = my("strips")_(-1);
			if(strip:"size" >= div, my("makestrip"); strip = my("strips")_(-1));
			eval(my("putblob"), strip->strip, blobs->my("blobs")_1);
		);

		forall(my("strips"), #:"drawstrip" = (#:"size" == div));

		my("positionstrips");
	);

	o:"positionstrips" := ( // Align Strips in World
		my("updateglobalscaling");
 
		regional(n, strip, diagonal, yposition);
		n = my("#strips");
 
		if(n > 0,
			repeat(n,
				strip = my("strips")_#;
				diagonal = strip:"shape"_3 - strip:"shape"_1; // bottom left to top right
				yposition = n/2 - # + .25 * my("stripmargin");
 
				strip:"coord" = my("center") - 0.5 * diagonal;
				strip:"coord"_2 = my("center")_2 + (diagonal_2 + my("stripmargin")) * yposition;
 
				strip:"positionchildren";
			);
 
			// Re-align last strip to be left aligned
			if(n > 1,
				my("strips")_(-1):"coord" = my("strips")_(-2):"coord" - [0, diagonal_2 + my("stripmargin")];
				my("strips")_(-1):"positionchildren";
			);
		);
 
		divomath update results();
	);

	// Use with eval()
	o:"putblob" := (
		// Handles putting blobs in strips.
		// eval with a "strip" and a blob or a list of "blobs".
		regional(bloblist, toput);

		// NOTE: do NOT use list() here - it does not wrap a single VAM object
		// into a one element list but takes it apart.
		bloblist = if(islist(blobs), blobs, [blobs]);

		// Only blobs that are not already children of the target strip get
		// moved, otherwise they would be dropped from the world list without
		// ever arriving in the strip.
		toput = select(bloblist, !contains(strip:"children", #));

		eval(strip:"put", children->toput);
		set my("blobs", my("blobs") -- toput);

		length(toput); // Return how many were actually moved
	);
	
	o:"popblob" := (
		// Handles returning Blobs back to World from Strip.
		// eval with a "strip" to pop from and optional "index"
		index = if(isundefined(index),1,index);
		set my("blobs", my("blobs") :> strip:"children"_index);
		eval(strip:"remove", children->[strip:"children"_index]);
		
		my("blobs")_(-1); // Return popped Blob
	);

	o:"removeblob" := (
		// Handles deletion of Blobs.
		// eval with a number of blobs ("numofblobs") to remove.
		
		// Remove free blobs first (starting at the end of the list)
		while(numofblocks > 0 & my("#blobs") > 0,
			set my("blobs", my("blobs") -- [my("blobs")_(-1)]);
			numofblocks = numofblocks - 1;
		);

		// Continue removing from strips, starting from the last one
		forall(reverse(my("strips")), strip,
			if(numofblocks > 0,
				forall(reverse(strip:"children"),
					if(numofblocks > 0,
						strip:"children" = strip:"children" -- [#];
						numofblocks = numofblocks - 1;
					);
				);
				my("positionstrips");
			);
		);
	);	

	o; // Return World;
);

// C.2 | Blob container representing sets of divisor-many or remainder-many Blobs
new Strip(coord) := (
	regional(o);
	o = new VAMobject("Strip");
	
	o:"coord" = if(!isundefined(coord),coord,[6,6]); // bottom left corner
	o:"color" = blobcolors_1; // color of strip
	o:"drawstrip" = true; // draw connecting strip between children
	o:"children" = []; // contains Blobs
	o:"size" := length(my("children"));
	o:"padding" := padding * 'globalscaling; // horizontal distance between adjacent Blobs
	o:"width" := if(my("size")>0,
		my("size") * (my("children")_1):"size" * 2 + (my("size")-1) * my("padding");
	,
		0
	);
	o:"height" := if(my("size")>0,(my("children")_1):"size" * 2, 0);
	o:"shape" := rectangle(my("coord"),my("width"),my("height"));

	// Use with eval()
	o:"put" := (
		// Put list of elements in the strip.
		// eval children with a list of blobs or single blob
		children = if(islist(children), children, [children]);
		forall(children,
			// add new parent
			#:"parent" = self();
			// add as child if not already a child of self
			if(!contains(my("children"), #),
				set my("children",my("children") :> #);
			);
			// Align children inside strip
			my("positionchildren");
		);
	);

	o:"remove" := ( 
		// Remove child or list of children from list of children of the strip.
		// eval children with a list of blobs or single blob.
		children = if(islist(children), children, [children]);		
		// Reset parent of Blob to own parent (should be World) 
		forall(children, #:"parent" = my("parent"));
		// remove children from childeren-list
		set my("children", my("children") -- children);
		// recalculate new blob positions
		my("positionchildren");
	);

	o:"positionchildren" := (
		regional(children);
		children = my("children");

		// animation
		repeat(my("size"),
			new animationobject(
				children_#, //object
				"coord", // property
				children_#:"coord", // startvalue
				my("coord") + [
					(2*#-1)*children_#:"size" + (#-1)*my("padding"),
					children_#:"size"
				];, // endvalue
				timing, // duration
				"accel" // timeflow
			);
		);

		// w/o animation
//		repeat(my("size"),
//			children_#:"coord" = my("coord") + [
//					(2*#-1)*children_#:"size" +
//						(#-1)*my("padding"),
//					children_#:"size"
//				];
//		);
	);

	o:"draw" := (
		// Debug: Draw bounding box
		if(LOGLEVEL > 0, 
			drawpoly(my("shape"));
			draw(my("coord"));
		);

		// Draw strip between children
		if(my("drawstrip") & my("size") > 0,
			regional(strip, radius, delta);
			strip = my("shape");
			radius = my("children")_1:"size";
			delta = radius / 8;

			strip_1 = strip_1 + [radius,delta];
			strip_2 = strip_2 - [radius,-delta];
			strip_3 = strip_3 - [radius,delta];
			strip_4 = strip_4 + [radius,-delta];
			fillpoly(strip,alpha->0.3,color->my("color"));
		);

		// Draw children
		forall(my("children"),#:"draw");
	);
	
	o; // Return o;
);

// C.3 | Displayable element
new Blob() := (
	regional(o);
	o = new VAMobject("Blob");
	
	o:"ismoveable" = false;
	o:"size" := size * 'globalscaling;
	o:"parent" = NADA;
	o:"color" := if(!isundefined(my("parent"):"drawstrip"),
			if(my("parent"):"drawstrip",blobcolors_1, blobcolors_2),
			blobcolors_2;
		);
	o:"ishot" := mouse().xy_1 - my("coord")_1 < my("size");
	o:"coord" = ( // Set coordinate randomly inside viewport
		regional(screen);

		screen = world:"shape";
		[
			screen_1_1+o:"size" + randominteger(screen_3_1 - screen_1_1),
			screen_1_2+o:"size" + randominteger(screen_3_2 - screen_1_2)
		];
	);

	o:"draw" := (
		// Draw to be used by parent
		fill(
			circle(my("coord"),my("size")),
			color->my("color")
		);
	);

	o; // Return blob.
);


// ================== //
// D | Initialization //
// ================== //

// Create World
world = new World();
obj = obj :> world;

// Remove animation, if there are blobs and strips at the beginning.
if(blobs > 0 & divisor > 0,
	help = timing;
	timing = .00001;
);

// Template behavior
world:"#divisors" = divisor;
repeat(blobs, world:"makeblob");
if(divisor != 0,
	repeat(ceil(blobs/divisor), // Create strips rounding up.
		tostrip = []; // blobs that go into each strip
		repeat(divisor, d, if(world:"#blobs" >= d, // fill list and catch it's end
			tostrip = tostrip :> world:"blobs"_d
		));
		world:"makestrip"; // make a new strip
		eval(world:"putblob",strip->world:"strips"_(-1),blobs->tostrip); // put in blobs
	);
);

// toggle strip drawing for last blob depending on if it is full or not
if(mod(blobs,divisor) != 0,world:"strips"_(-1):"drawstrip" = false);

world:"positionstrips";

// Reset animation speed
if(!isundefined(help), timing = help);

// Draw UI Elements
if(drawbar,
	obj = obj :> world:"bar";
);
if(drawblobbuttons,
	obj = obj :> world:"blob+";
	obj = obj :> world:"blob-";
);
if(drawdivbuttons,
	obj = obj :> world:"divisor+";
	obj = obj :> world:"divisor-";
);

); // end vam-if

//[VAM] doublenumberline
/** v2 *******************************************************************************************
* Double number line for proportional reasoning.
*
* Recent changes:
* 2026-08-14 Adopted from divoVAM 3.1.0 into the v7 framework: configuration via "default to",
*            dropped parseURLParameters/urlparameter (ENVIRONMENTALPARAMS covers both), renamed
*            the helper calls, layout anchored at VISIBLERECT.
************************************************************************************************/

// Doppelter Zahlenstrahl
if(VAM == "doublenumberline",

// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

// --- Bar ---
'barposition					= default to(ENVIRONMENTALPARAMS:"barposition", [1,15], true);
'barwidth							= default to(ENVIRONMENTALPARAMS:"barwidth", 16, true); // initial width of bar
'barheight						= default to(ENVIRONMENTALPARAMS:"barheight", 2, true); // height of bar
'barvalue							= default to(ENVIRONMENTALPARAMS:"barvalue", 0, true); // initial bar value in [0,1]
'basevalue						= default to(ENVIRONMENTALPARAMS:"basevalue", 1000, true); // bars initial base value
'subdivisions					= default to(ENVIRONMENTALPARAMS:"subdivisions", 3, true); // initial number of subdivisions
'isbardraggable				= default to(ENVIRONMENTALPARAMS:"isbardraggable", true, true);
'barprecision					= default to(ENVIRONMENTALPARAMS:"barprecision", 1, true) / 100; // Precision of the bar's drag action, given in percent, used as a fraction.

// --- Units ---
'unit									= default to(ENVIRONMENTALPARAMS:"unit", "", false); // displayed unit for values
'upperunit						= default to(ENVIRONMENTALPARAMS:"upperUnit", "", false); // unit on the upper number line
'lowerunit						= default to(ENVIRONMENTALPARAMS:"lowerUnit", "", false); // unit on the lower number line

// --- Increasing mode ("Hochrechnen") ---
'incuppersizesteps		= default to(ENVIRONMENTALPARAMS:"incUpperSizeSteps", NADA, true);
'inclowersizesteps		= default to(ENVIRONMENTALPARAMS:"incLowerSizeSteps", NADA, true);
'incgivenvalue				= default to(ENVIRONMENTALPARAMS:"incGivenValue", NADA, true);
 
// --- Decreasing mode ("Runterrechnen") ---
'decuppertargetvalue	= default to(ENVIRONMENTALPARAMS:"decUpperTargetValue", NADA, true);
'declowertargetvalue	= default to(ENVIRONMENTALPARAMS:"decLowerTargetValue", NADA, true);
'decnumbersteps				= default to(ENVIRONMENTALPARAMS:"decNumberSteps", NADA, true);
'decuppersizesteps		= default to(ENVIRONMENTALPARAMS:"decUpperSizeSteps", NADA, true);
'declowersizesteps		= default to(ENVIRONMENTALPARAMS:"decLowerSizeSteps", NADA, true);

// --- Value marks ---
// Five marks per number line and per mode. Read as a list first; the old build had 20 single parameters (incUpperValueMark1 ... decLowerValueMark5), 
// which are still accepted for compatibility and fill the list entry by entry.
'incuppervaluemarks		= default to(ENVIRONMENTALPARAMS:"incUpperValueMarks", apply(1..5, NADA), true);
'inclowervaluemarks		= default to(ENVIRONMENTALPARAMS:"incLowerValueMarks", apply(1..5, NADA), true);
'decuppervaluemarks		= default to(ENVIRONMENTALPARAMS:"decUpperValueMarks", apply(1..5, NADA), true);
'declowervaluemarks		= default to(ENVIRONMENTALPARAMS:"decLowerValueMarks", apply(1..5, NADA), true);

forall(1..5, i,
	regional(single);
 
	single = default to(ENVIRONMENTALPARAMS:("incUpperValueMark" + i), NADA, true);
	if(!isundefined(single), 'incuppervaluemarks_i = single);
 
	single = default to(ENVIRONMENTALPARAMS:("incLowerValueMark" + i), NADA, true);
	if(!isundefined(single), 'inclowervaluemarks_i = single);
 
	single = default to(ENVIRONMENTALPARAMS:("decUpperValueMark" + i), NADA, true);
	if(!isundefined(single), 'decuppervaluemarks_i = single);
 
	single = default to(ENVIRONMENTALPARAMS:("decLowerValueMark" + i), NADA, true);
	if(!isundefined(single), 'declowervaluemarks_i = single);
);

// WARNING: upperValueMarks and lowerValueMarks are being abused slightly in the
// implementation of the dual number line - adding numbers to these lists may result in undesired behaviour.
'uppervaluemarks			= default to(ENVIRONMENTALPARAMS:"upperValueMarks", apply(1..5, NADA), true);
'lowervaluemarks			= default to(ENVIRONMENTALPARAMS:"lowerValueMarks", apply(1..5, NADA), true);

// --- Labels ---
// NOTE: the key is misspelled ("percenteges") in the original build. Both are accepted so existing links keep working.
'leftoutpercentages		= default to(ENVIRONMENTALPARAMS:"leftoutpercentages", default to(ENVIRONMENTALPARAMS:"leftoutpercenteges", [], true), false);
'leftoutvalues				= default to(ENVIRONMENTALPARAMS:"leftoutvalues", [], true); // as percentage of the base value

// --- Look and feel ---
'barcolor							= default to(ENVIRONMENTALPARAMS:"barcolor", DZLMCOLORBLUE, true);
'archcolor						= default to(ENVIRONMENTALPARAMS:"archcolor", DZLMCOLORGOLD, true);
'fontfamily						= default to(ENVIRONMENTALPARAMS:"fontfamily", NADA, false);
 
// --- Scaffolds ---
'scaffoldvalue				= default to(ENVIRONMENTALPARAMS:"scaffoldvalue", false, true);
'scaffoldpercentage		= default to(ENVIRONMENTALPARAMS:"scaffoldpercentage", false, true);
'scaffoldbasevalue		= default to(ENVIRONMENTALPARAMS:"scaffoldbasevalue", false, true);
 
// Normalize booleans (divomath reports back "" instead of false)
'isbardraggable = tobool('isbardraggable);
'scaffoldvalue = tobool('scaffoldvalue);
'scaffoldpercentage = tobool('scaffoldpercentage);
'scaffoldbasevalue = tobool('scaffoldbasevalue);
 
// Colors of the value marks
'valuemarkcolors = [
	COLORSPLASMA16_3,
	COLORSPLASMA16_5,
	COLORSPLASMA16_8,
	COLORSPLASMA16_11,
	COLORSPLASMA16_13
];


// ================= //
// Divomath settings //
// ================= //

divomath update results() := if(ISDIVOMATH, // @overwrite
	warn at("doublenumberline, divomath update results()", "Not implemented.");

	//divomath clear results(); // Clear last results.
	//divomath put result(#, dmstate:#); // Put some results in.
	//divomath post results(); // Submit results to divomath.
);

divomath set state() := if(ISDIVOMATH, // @overwrite
	warn at("doublenumberline, divomath update results()", "Not implemented.");
	
	// Build state object.
	state = {
		"thing": 42;
	};

	state; // Return state.
);


// ===================== //
// C | Class Definitions //
// ===================== //

/**
* Double number line for proportional reasoning.
*
* Two number lines share one bar. One of them carries the value the task gives
* ("given"), the other one is derived from it ("dependent"). Which is which is
* decided by the user via the unit toggles.
*
* Modes:
*   "increasing" ("Hochrechnen")  - a given value and a step size determine how
*                                   far the bar reaches
*   "decreasing" ("Runterrechnen")- a target value is fixed at the end of the bar
*                                   and gets divided, either by a number of steps
*                                   ("submode" = "number") or by a step size
*                                   ("submode" = "size")
*/
new Doublenumberline(coord, width, height, value, precision, divisions, baseval, unit) := (
	regional(line);
	line = new VAMobject("Dualnumberline");

	// --- Look and feel ---
	line:"coord"						= coord;
	line:"color"						= 'barcolor;
	line:"width"						= width;
	line:"height"						= height;
	line:"margin"						= 0; // margin of bar shape to surrounding box
	line:"precision"				= precision; // precision of movement of bar (in [0,1])
	line:"fontsize"					= 14 * FONTSCALE;
	line:"fontfamily"				= 'fontfamily; // set globally
	line:"labelpadding"			= .55;
	line:"isclickable"			= 'isbardraggable;
	line:"ismoveable"				= 'isbardraggable;

	// --- Mode ---
	line:"mode"				= NADA; // "increasing", "decreasing" or "none"
	line:"submode"		= NADA; // for decreasing: "number" or "size"

	// --- Visibility, set from the toggles after init ---
	line:"drawupperticks"							= false;
	line:"drawlowerticks"							= false;
	line:"drawuppernumberlinelabels"	= false;
	line:"drawlowernumberlinelabels"	= false;
	line:"drawbasevaluelabel"					= false;
	line:"drawcurrentpercentage"			= false;
	line:"drawcurrentvalue"						= false;
	line:"drawarches"									= false;
	line:"drawtotalarc"								= false;
	line:"canoverflow"								= false;
	line:"arcslabels"									= NADA;
	line:"totalarclabel"							= NADA;

	line:"scaffoldvalue"							= 'scaffoldvalue;
	line:"scaffoldpercentage"					= 'scaffoldpercentage;
	line:"scaffoldbasevalue"					= 'scaffoldbasevalue;

	// --- Handles for the interface, set at init ---
	line:"toggles"			= NADA;
	line:"textfields"		= NADA;
	line:"buttons"			= NADA;
 
	// --- Values ---
	line:"unit"				= unit;
	line:"value"			= value; // between 0 and 1
	line:"basevalue"	= baseval;
	line:"units"			= {"lower": NADA, "upper": NADA};
 
	// The value the task gives, entered by the user
	line:"givenvalue"						= NADA;
	line:"inputdependentvalue"	= NADA;
	line:"inputdivisions"				= NADA;
	line:"sizesteps"						= {"lower": NADA, "upper": NADA};
	line:"dependentunit"				= NADA;

	/**
	* Which number line carries the given value.
	* In "increasing" mode the user picks it via the unit toggles, so it stays
	* undefined until then. In "decreasing" mode the maximum is set by the user
	* anyway, so either line will do and "upper" is picked.
	*/
	line:"givenunit" := if(my("mode") == "increasing", NADA, "upper");

	/**
	* The given value rounded up to the next integer multiple of the step size,
	* plus two extra steps so there is room to drag beyond it.
	* In "decreasing" mode the given value sits at the very end of the bar.
	*/
	line:"maxgivenvalue" := if(my("mode") == "increasing",
		(floor(my("givenvalue") / my("sizesteps"):(my("givenunit"))) + 2)	* my("sizesteps"):(my("givenunit"));
	, // decreasing
		my("givenvalue");
	);

	/**
	* Number of subdivisions of the bar. Derived differently per mode.
	*/
	line:"divisions" := if(my("mode") == "increasing",
		my("maxgivenvalue") / my("sizesteps"):(my("givenunit"));
	, // decreasing
		if(my("submode") == "number",
			my("inputdivisions");
		,
			if(my("submode") == "size",
				if(my("checksizestepsconsistency"),
					if(!isundefined(my("sizesteps"):"upper"),
						my("maxgivenvalue") / my("sizesteps"):"upper";
					,
						my("maxdependentvalue") / my("sizesteps"):"lower";
					);
				);
			);
		);
	);

	/**
	* Tick positions as fractions of the bar width.
	* Guarded: divisions can be undefined or 0 while the user is still entering values, and apply(1..___) would fail.
	*/
	line:"ticks" := (
		regional(n);
		n = my("divisions");
		if(isundefined(n) % (n < 1), [], apply(1..n, #/n));
	);

	/**
	* The value on the other number line. Both fields are defined identically in "increasing" mode
	* - kept separate because "decreasing" uses them differently.
	*/
	line:"dependentvalue" := if(my("mode") == "increasing",
		my("divisions") * my("sizesteps"):(my("dependentunit"));
	, // decreasing
		my("inputdependentvalue");
	);

	line:"maxdependentvalue" := if(my("mode") == "increasing",
		my("divisions") * my("sizesteps"):(my("dependentunit"));
	, // decreasing
		my("dependentvalue");
	);

	// --- Consistency checks for the user's input ---
 
	/**
	* True unless BOTH step sizes are given and they disagree about how many
	* steps fit on the bar.
	*/
	line:"checksizestepsconsistency" := (
		regional(bothpresent, result);
		result = true;
 
		bothpresent = list and([
			!isundefined(my("sizesteps"):"lower"),
			!isundefined(my("sizesteps"):"upper")
		]);
 
		if(bothpresent,
			// @refactor: comparison with == might be error prone on floats
			result = (my("maxgivenvalue") / my("sizesteps"):"upper"
				== my("maxdependentvalue") / my("sizesteps"):"lower");
		);
 
		result;
	);
 
	/**
	* True if the number of steps the user entered divides both number lines
	* into whole numbers. Eval with 'inputvalue.
	*/
	line:"checknumberstepsconsistency" := (
		regional(result, uppersize, lowersize);
		result = true;
 
		if(!isundefined('inputvalue),
			uppersize = my("maxgivenvalue") / 'inputvalue;
			lowersize = my("maxdependentvalue") / 'inputvalue;
			result = list and([isinteger(uppersize), isinteger(lowersize)]);
		);
 
		result;
	);

	// --- Label metrics ---
 
	line:"standardticks" = [0];
 
	/**
	* Smallest distance between two adjacent ticks, in world units. Used to
	* decide whether the labels still fit next to each other.
	*/
	line:"ticksdistance" := (
		regional(allticks, customupper, customlower, mindistances);
 
		if(my("givenunit") == "upper",
			customupper = ('uppervaluemarks ++ [my("givenvalue")]) / my("maxgivenvalue");
			customlower = 'lowervaluemarks / my("maxdependentvalue");
		,
			customupper = 'uppervaluemarks / my("maxdependentvalue");
			customlower = ('lowervaluemarks ++ [my("givenvalue")]) / my("maxgivenvalue");
		);
 
		// The regular ticks are the same on both number lines, so they are
		// simply doubled up and the custom marks added per line.
		allticks = [my("ticks"), my("ticks")];
		allticks_1 = sort(allticks_1 ++ select defined(customupper));
		allticks_2 = sort(allticks_2 ++ select defined(customlower));
 
		mindistances = apply(allticks, ticks,
			regional(gaps);
			gaps = select(apply(consecutive(ticks), |#_2 - #_1|), # > 0);
			if(length(gaps) == 0, 1, min(gaps));
		);
 
		min(mindistances) * my("width");
	);
 
	/**
	* Smallest and largest label size that occurs, as {"min": {...}, "max": {...}}.
	*
	* NOTE: the original read bar:"..." (the global) instead of my("..."), and
	* passed the arguments to textBoxSize in the wrong order - the signature is
	* (text, fontsize, fontfamily), it was called with (text, family, size).
	*/
	line:"ticklabelsizelimits" := (
		regional(alllabels, widths, heights);
 
		alllabels = my("ticks") * my("maxgivenvalue") ++ my("ticks") * my("maxdependentvalue");
		alllabels = alllabels ++ select defined('lowervaluemarks) ++ select defined('uppervaluemarks);
 
		widths  = apply(alllabels, text box size(# + "", my("fontsize"), my("fontfamily")):"w");
		heights = apply(alllabels, text box size(# + "", my("fontsize"), my("fontfamily")):"h");
 
		if(length(alllabels) == 0,
			{"min": {"w": 0, "h": 0}, "max": {"w": 0, "h": 0}};
		,
			{
				"min": {"w": min(widths), "h": min(heights)},
				"max": {"w": max(widths), "h": max(heights)}
			};
		);
	);
 
	/**
	* Width of a single digit. All digits are assumed to be equally wide, which
	* holds for the fonts in use; a warning is issued if they are not.
	*
	* NOTE: the original had a typo here - it assigned "labelDigitsWidths" but
	* read "labelDigitWidths" (without the s), so the check never ran.
	*/
	line:"labeldigitwidths" = apply(0..9, text box size(# + "", line:"fontsize", line:"fontfamily"):"w");
	if(!list and(apply(line:"labeldigitwidths", # == line:"labeldigitwidths"_1)),
		warn at("doublenumberline", "The digits of the chosen font are not equally wide. "
			+ "The width of '0' is used for all of them.");
	);
	line:"labeldigitwidth" = line:"labeldigitwidths"_1;
 
	/**
	* True if labels can be drawn horizontally without overlapping.
	*/
	line:"isticksdistanceenough" :=
		(my("ticksdistance") - my("ticklabelsizelimits"):"max":"w") > 1.25 * my("labeldigitwidth");
 
	/**
	* Index of and distance to the tick closest to a given position.
	* Eval with 'tick (position as a fraction of the bar width) and
	* 'maxvaluekey ("maxgivenvalue" or "maxdependentvalue").
	*
	* Returns [index, distance in world units]; the value of that neighbour is
	* available as 'closestneighbourvalue afterwards.
	*/
	line:"closestneighbourtickindexanddistance" := (
		regional(otherticks, best, distance, index);

		if(isundefined('tick),
			err("closestneighbourtickindexanddistance(): eval with 'tick->...");
			'tick = 0;
		);

		otherticks = my("ticks");
		if(length(my("standardticks")) > 1, otherticks = otherticks ++ [my("standardticks")_2]);

		// NOTE: CindyScript has no destructuring assignment - "[a,b] = list"
		// silently leaves both undefined, which is what the original did.
		best = min with index(apply(otherticks, othertick, |othertick - 'tick|));
		distance = best_1 * my("width");
		index = best_2;

		'closestneighbourvalue = otherticks_index * my('maxvaluekey);

		[index, distance];
	);

	// --- Shape and hitbox ---------------------------------------------------
	line:"box" = rectangle(
		coord - [line:"margin", line:"margin"],
		width + 2*line:"margin",
		height + 2*line:"margin"
	);
 
	line:"shapeupper" := rounded rectangle(
		[my("coord").x, my("coord").y + my("height")*0.9],
		my("value")*my("width"), my("height")*0.1, .1
	);
	line:"shapelower" := rounded rectangle(
		my("coord"),
		my("value")*my("width"), my("height")*0.1, .1
	);
 
	/**
	* The vertical edge at the current value. Drawn on top of the ticks, so it
	* is a separate shape rather than part of the bar.
	*
	* NOTE: the original forgot to add my("coord")_1 to the x component, so the
	* edge sat at the wrong place whenever the bar was not at x = 0.
	*/
	line:"shapefrontedge" := [
		[my("coord")_1 + my("value")*my("width"), my("coord")_2 - 0.25],
		[my("coord")_1 + my("value")*my("width"), my("coord")_2 + my("height") + 0.25]
	];
 
	// NOTE: three times the width on purpose - the bar can be dragged beyond
	// its own end, see "canoverflow".
	line:"hitbox" := rectangle(my("coord"), 3*my("width"), my("height"));
	line:"ishot" := inrectangle(my("hitbox"), mouse().xy);
 
	/**
	* Whether a tick is drawn at the far right end of the bar.
	* In "decreasing" mode the given value always sits there, in "increasing"
	* mode only once a unit has been chosen.
	*/
	line:"handlegivenvaluetick" := (
		if(my("mode") == "increasing",
			if(list and([
					!isundefined(my("maxgivenvalue")),
					contains(["lower", "upper"], my("givenunit"))
				]),
				self():"standardticks" = [0,1];
			,
				self():"standardticks" = [0];
			);
		, // decreasing ... in this mode my("givenvalue")/my("maxgivenvalue") == 1
			self():"standardticks" = [0,1];
		);
	);
 
	// --- Drawing ------------------------------------------------------------
	line:"tickovershoot" = 0.25;  // how far the ticks stick out beyond the bar
	line:"markovershoot" = 0.4;   // same for standard ticks and value marks

	line:"draw" := (
		regional(p1, upperend, lowerend, overshoot, maxvaluekey, maxvaluekeyother, counter);
 
		// Background box
		fillpoly(my("box"), color->grey(1));
 
		// --- The two number lines with arrow heads ---
		gsave();
		linesize(2);
 
		upperend = [my("coord").x + my("width") + 0.5, my("coord").y + my("height")];
		draw([my("coord").x - 0.25, my("coord").y + my("height")], upperend, color->grey(0));
		draw(upperend, upperend + c2v(0.25*exp(i*PI*155/180)), color->grey(0));
		draw(upperend, upperend + c2v(0.25*exp(i*PI*205/180)), color->grey(0));
 
		lowerend = [my("coord").x + my("width") + 0.5, my("coord").y];
		draw([my("coord").x - 0.25, my("coord").y], lowerend, color->grey(0));
		draw(lowerend, lowerend + c2v(0.25*exp(i*PI*155/180)), color->grey(0));
		draw(lowerend, lowerend + c2v(0.25*exp(i*PI*205/180)), color->grey(0));
 
		grestore();
 
		// --- The draggable bar ---
		// The front edge is drawn later so it sits on top of the ticks.
		fill(my("shapeupper"), color->my("color"));
		fill(my("shapelower"), color->my("color"));
 
		// --- Ticks between the number lines ---
		overshoot = my("tickovershoot");
 
		forall(1..length(my("ticks")), idx,
			regional(tick, islast);
			tick = my("ticks")_idx;
 
			if(tick < my("value") + 0.001,
				p1 = my("coord") + [tick,0]*my("width") - [0, overshoot];
 
				if(my("mode") == "increasing",
					if(list or([my("drawarches"),
							list and([my("drawlowerticks"), !my("drawtotalarc")])]),
						draw(p1, p1 + [0, my("height") + 2*overshoot], size->2, color->grey(0));
					,
						// With a total arc only the outermost ticks are drawn.
						if(my("drawtotalarc"),
							islast = (tick == max(select(my("ticks"), # < my("value") + 0.001)));
							if(islast % list and([my("drawlowerticks"), idx == 1]),
								draw(p1, p1 + [0, my("height") + 2*overshoot], size->2, color->grey(0));
							);
						);
					);
				,
					draw(p1, p1 + [0, my("height") + 2*overshoot], size->2, color->grey(0));
				);
			);
		);
 
		// --- Standard ticks (left and right end) ---
		my("handlegivenvaluetick");
		overshoot = my("markovershoot");
 
		forall(my("standardticks"),
			p1 = my("coord") + [#,0]*my("width") - [0, overshoot];
			draw(p1, p1 + [0, my("height") + 2*overshoot], size->2, color->grey(.3));
		);
 
		// --- Value marks ---
		// A mark that coincides with one on the other number line is drawn only half as long, so both stay visible.
		if(my("givenunit") == "upper",
			maxvaluekey = "maxgivenvalue";      maxvaluekeyother = "maxdependentvalue";
		,
			maxvaluekey = "maxdependentvalue";  maxvaluekeyother = "maxgivenvalue";
		);
 
		counter = 0;
		forall('uppervaluemarks,
			regional(deltay);
			counter = counter + 1;
			deltay = 2*overshoot;
 
			if(length('lowervaluemarks) >= counter,
				if(|#/my(maxvaluekey) - ('lowervaluemarks_counter)/my(maxvaluekeyother)| < 0.0001,
					deltay = overshoot + my("height")/2;
				);
			);
 
			p1 = my("coord") + [#/my(maxvaluekey)*my("width"), my("height")] + [0, overshoot];
			draw(p1, p1 - [0, deltay], size->2, color->'valuemarkcolors_counter);
		);
 
		// The keys swap for the lower marks.
		if(my("givenunit") == "lower",
			maxvaluekey = "maxgivenvalue";      maxvaluekeyother = "maxdependentvalue";
		,
			maxvaluekey = "maxdependentvalue";  maxvaluekeyother = "maxgivenvalue";
		);
 
		counter = 0;
		forall('lowervaluemarks,
			regional(deltay);
			counter = counter + 1;
			deltay = 2*overshoot;
 
			if(length('uppervaluemarks) >= counter,
				if(|#/my(maxvaluekey) - ('uppervaluemarks_counter)/my(maxvaluekeyother)| < 0.0001,
					deltay = overshoot + my("height")/2;
				);
			);
 
			p1 = my("coord") + [#/my(maxvaluekey),0]*my("width") - [0, overshoot];
			draw(p1, p1 + [0, deltay], size->2, color->'valuemarkcolors_counter);
		);
 
		// --- Front edge of the bar, on top of the ticks ---
		gsave();
		linesize(2);
		draw(my("shapefrontedge")_1, my("shapefrontedge")_2, color->my("color"), size->1.4);
		grestore();
 
		// @improvement: rotate the labels if they get too close to each other -
		// use text box size to get the width of two centre labels and calculate
		// whether they overlap.
 
		if(my("givenunit") == "upper",
			maxvaluekey = "maxgivenvalue";
		,
			maxvaluekey = "maxdependentvalue";
		);
 
		yoffset = my("height") + my("labelpadding"); // move up by the height of the bar
 
		// --- Standard ticks (0 and, depending on the mode, the far end) ---
		my("handlegivenvaluetick");
 
		regional(currentstandardticks);
		currentstandardticks = if(contains(["increasing", "none"], my("mode")),
			my("standardticks") -- [1];
		,
			my("standardticks");
		);
 
		forall(currentstandardticks, tick,
			regional(labelsize, angle, alignment, currentsize, dolabel);
 
			dolabel = list or([
				my("mode") == "increasing",
				list and([
					my("mode") == "decreasing",
					list or([my("drawuppernumberlinelabels"), tick == 1])
				])
			]);
 
			currentsize = size;
			alignment = "center";
 
			// @refactor: copy-paste, move to a function
			text = if(tick == 0,
				"0";
			,
				if(maxvaluekey == "maxgivenvalue",
					tick * my(maxvaluekey);
				,
					// the dependent value is not labelled in "increasing" mode
					if(my("mode") == "increasing", "", tick * my(maxvaluekey));
				);
			);
			if(isundefined(text), text = "");
 
			box = get boundingbox(text, [0,0], size, family); // only the size is used
			xoffset = tick * my("width");
			position = my("coord") + [xoffset, yoffset];
 
			// Arches
				if(list or([
						my("drawarches"),
						list and([
							my("mode") == "increasing",
							my("drawtotalarc"),
							my("drawuppernumberlinelabels")
						])
					]),
					eval(my("drawupperarches"), 'yoffset->yoffset + box_4_2 - box_1_2);
				);
	 
				if(my("drawtotalarc"),
					eval(my("drawupperarches"), 'yoffset->yoffset + box_4_2 - box_1_2, 'istotalarc->true);
				);
 
			// Rotate the label if the ticks are too close together
			labelsize = text box size(text, size, family);
			if(my("isticksdistanceenough"),
				angle = 0°;
				alignment = "center";
			,
				angle = 90°;
				// @refactor: this magic formula works-for-now but is not perfect
				if(my("ticklabelsizelimits"):"max":"h" > my("ticksdistance") - 0.25,
					currentsize = floor(size * 0.9);
				);
				position = position + [labelsize:"h"/2, my("ticklabelsizelimits"):"min":"w" + 0.35];
				alignment = "right";
			);
 
			if(dolabel,
				drawtext(position, text, size->currentsize, family->family,
					color->grey(.5), angle->angle, align->alignment);
			);
		);
 
		// --- Labels of the regular ticks ---
		if(my("drawuppernumberlinelabels"),
			forall(1..length(my("ticks") -- [1]), idx,
				regional(tick, labelsize, angle, alignment, currentsize, isstandardtick);
				tick = (my("ticks") -- [1])_idx;
				currentsize = size;
 
				// NOTE: the original read bar:"standardticks" here, i.e. the global
				// instead of the object's own field.
				isstandardtick = list or(
					apply(my("standardticks"), stdtick, |stdtick - tick| < 0.0001));
 
				if(list and([
						tick < my("value") + 0.001,
						// do not draw the tick if it is the given value tick -
						// unless the lower unit is the given one
						list or([!isstandardtick, my("givenunit") == "lower"])
					]),
 
					// @improvement: if the step size is missing, "___" shows up as a label
					text = tick * my(maxvaluekey);
					box = get boundingbox(text, [0,0], size, family);
					xoffset = tick * my("width");
					position = my("coord") + [xoffset, yoffset];
 
					labelsize = text box size(text, size, family);
					if(my("isticksdistanceenough"),
						angle = 0°;
						currentsize = size;
						alignment = "center";
					,
						angle = 90°;
						// @refactor: this magic formula works-for-now but is not perfect
						if(my("ticklabelsizelimits"):"max":"h" > my("ticksdistance") - 0.25,
							currentsize = floor(size * 0.9);
						);
						position = position + [labelsize:"h"/2, my("ticklabelsizelimits"):"max":"w"];
						alignment = "right";
					);
 
					// With a total arc and no arches only the outermost labels are drawn.
					if(my("mode") == "increasing",
						if(my("drawtotalarc"),
							if(!my("drawarches"),
								if(tick == max(select(my("ticks"), # < my("value") + 0.001)),
									drawtext(position, text, size->currentsize, family->family,
										color->grey(.5), angle->angle, align->alignment);
								);
								if(idx == 1,
									drawtext(position, text, size->currentsize, family->family,
										color->grey(.5), angle->angle, align->alignment);
								);
							,
								drawtext(position, text, size->currentsize, family->family,
									color->grey(.5), angle->angle, align->alignment);
							);
						,
							drawtext(position, text, size->currentsize, family->family,
								color->grey(.5), angle->angle, align->alignment);
						);
					,
						drawtext(position, text, size->currentsize, family->family,
							color->grey(.5), angle->angle, align->alignment);
					);
				);
			);
		);
 
		// --- Labels for the custom marks on the UPPER line -------------------
		// @refactor: 'percentages' suffix should be 'upper'
		yoffset = my("height") + my("labelpadding");
		counter = 0;
 
		forall('uppervaluemarks, mark,
			regional(labelsize, angle, alignment, currentsize, neighbour, shrunksize);
			currentsize = size;
			counter = counter + 1;
 
			// NOTE: undefined marks used to fall through and draw "___".
			if(!isundefined(mark),
				text = mark + "";
				box = get boundingbox(text, [0,0], size, family);
				xoffset = mark/my(maxvaluekey) * my("width");
				position = my("coord") + [xoffset, yoffset];
 
				labelsize = text box size(text, size, family);
 
				if(tobool(my("isticksdistanceenough")),
					angle = 0°;
					alignment = "center";
				,
					angle = 90°;
					// @refactor: this magic formula works-for-now but is not perfect
					if(my("ticklabelsizelimits"):"max":"h" > my("ticksdistance") - 0.25,
						currentsize = floor(size * 0.9);
 
						// NOTE: CindyScript has no destructuring assignment, the original
						// "[a, b] = eval(...)" silently left both undefined.
						neighbour = eval(my("closestneighbourtickindexanddistance"),
							'tick->mark/my(maxvaluekey), 'maxvaluekey->maxvaluekey);
						shrunksize = text box size('closestneighbourvalue + "", currentsize, family);
 
						if(list and([
								neighbour_2 != 0,
								neighbour_2 < shrunksize:"h"
							]),
							position = position + [0, 1.075 * shrunksize:"w"];
						);
					);
 
					position = position + [labelsize:"h"/2, my("ticklabelsizelimits"):"min":"w" + 0.35];
					alignment = "right";
				);
 
				drawtext(position, text, size->currentsize, family->family,
					color->'valuemarkcolors_counter, align->alignment, angle->angle);
			);
		);
 
		// --- Labels for the LOWER number line --------------------------------
		if(my("givenunit") == "lower",
			maxvaluekey = "maxgivenvalue";
		,
			maxvaluekey = "maxdependentvalue";
		);
 
		my("handlegivenvaluetick");
 
		currentstandardticks = if(contains(["increasing", "none"], my("mode")),
			my("standardticks") -- [1];
		,
			my("standardticks");
		);
 
		forall(currentstandardticks, tick,
			regional(labelsize, angle, alignment, currentsize, dolabel);
			currentsize = size;
			alignment = "center";
 
			dolabel = list or([
				my("mode") == "increasing",
				list and([
					my("mode") == "decreasing",
					list or([my("drawlowernumberlinelabels"), tick == 1])
				])
			]);
 
			// @refactor: copy-paste, move to a function
			text = if(tick == 0,
				"0";
			,
				if(maxvaluekey == "maxgivenvalue",
					tick * my(maxvaluekey);
				,
					if(my("mode") == "increasing", "", tick * my(maxvaluekey));
				);
			);
			if(isundefined(text), text = "");
 
			box = get boundingbox(text, [0,0], size, family);
			xoffset = tick * my("width");
			yoffset = -(box_3_2 - box_2_2) - my("labelpadding"); // move down by the text height
			position = my("coord") + [xoffset, yoffset];
 
			labelsize = text box size(text, size, family);
			if(tobool(my("isticksdistanceenough")),
				angle = 0°;
			,
				angle = 90°;
				if(my("ticklabelsizelimits"):"max":"h" > my("ticksdistance") - 0.25,
					currentsize = floor(size * 0.9);
				);
				position = position + [labelsize:"h"/2, 1 - 1.5*my("labeldigitwidth")];
				alignment = "right";
			);
 
			if(dolabel,
				drawtext(position, text, size->currentsize, family->family,
					color->grey(.5), angle->angle, align->alignment);
			);
		);
 
		// --- Arches below the bar ---
		if(!isundefined(my("drawvaluearches")),
			if(list or([
					my("drawarches"),
					list and([
						my("mode") == "increasing",
						my("drawtotalarc"),
						my("drawlowernumberlinelabels")
					])
				]),
				eval(my("drawvaluearches"), 'yoffset->yoffset);
			);
 
			if(tobool(my("drawtotalarc")),
				eval(my("drawvaluearches"), 'yoffset->yoffset, 'istotalarc->true);
			);
		);
 
		// --- Labels of the regular ticks on the LOWER line ---
		if(my("drawlowernumberlinelabels"),
			forall(1..length(my("ticks") -- [1]), idx,
				regional(tick, labelsize, angle, alignment, currentsize, isstandardtick);
				tick = (my("ticks") -- [1])_idx;
				currentsize = size;
 
				// NOTE: the original read bar:"standardticks", i.e. the global.
				isstandardtick = list or(
					apply(my("standardticks"), stdtick, |stdtick - tick| < 0.0001));
 
				if(list and([
						tick < my("value") + 0.001,
						// do not draw the given value tick - unless the upper unit is given
						list or([!isstandardtick, my("givenunit") == "upper"])
					]),
 
					// @improvement: if the step size is missing, "___" shows up as a label
					text = tick * my(maxvaluekey) + "";
					box = get boundingbox(text, [0,0], size, family);
					xoffset = tick * my("width");
					yoffset = -(box_3_2 - box_2_2) - my("labelpadding");
					position = my("coord") + [xoffset, yoffset];
 
					labelsize = text box size(text, size, family);
					if(tobool(my("isticksdistanceenough")),
						angle = 0°;
						alignment = "center";
					,
						angle = 90°;
						if(my("ticklabelsizelimits"):"max":"h" > my("ticksdistance") - 0.25,
							currentsize = floor(size * 0.9);
						);
						position = position + [labelsize:"h"/2, 1 - 1.5*my("labeldigitwidth")];
						alignment = "right";
					);
 
					// exclude the base value label
					if(tick != 1,
						if(my("mode") == "increasing",
							if(tobool(my("drawtotalarc")),
								if(!tobool(my("drawarches")),
									if(tick == max(select(my("ticks"), # < my("value") + 0.001)),
										drawtext(position, text, size->currentsize, family->family,
											color->grey(.5), angle->angle, align->alignment);
									);
									if(idx == 1,
										drawtext(position, text, size->currentsize, family->family,
											color->grey(.5), angle->angle, align->alignment);
									);
								,
									drawtext(position, text, size->currentsize, family->family,
										color->grey(.5), angle->angle, align->alignment);
								);
							,
								drawtext(position, text, size->currentsize, family->family,
									color->grey(.5), angle->angle, align->alignment);
							);
						,
							drawtext(position, text, size->currentsize, family->family,
								color->grey(.5), angle->angle, align->alignment);
						);
					);
				);
			);
		);
 
		// --- Labels for the custom marks on the LOWER line -------------------
		// @refactor: 'values' suffix should be 'lower'
		counter = 0;
 
		forall('lowervaluemarks, mark,
			regional(labelsize, angle, alignment, currentsize, neighbour, shrunksize);
			currentsize = size;
 
			// NOTE: the original used "continue;" here, which does not exist in
			// CindyScript - the body is wrapped in a guard instead.
			if(!isundefined(mark),
				counter = counter + 1;
 
				text = mark + "";
				box = get boundingbox(text, [0,0], size, family);
				xoffset = mark/my(maxvaluekey) * my("width");
				yoffset = -(box_3_2 - box_2_2) - my("labelpadding");
				position = my("coord") + [xoffset, yoffset];
 
				labelsize = text box size(text, size, family);
				if(tobool(my("isticksdistanceenough")),
					angle = 0°;
					alignment = "center";
				,
					angle = 90°;
					if(my("ticklabelsizelimits"):"max":"h" > my("ticksdistance") - 0.25,
						currentsize = floor(size * 0.9);
 
						neighbour = eval(my("closestneighbourtickindexanddistance"),
							'tick->mark/my(maxvaluekey), 'maxvaluekey->maxvaluekey);
						shrunksize = text box size('closestneighbourvalue + "", currentsize, family);
 
						if(list and([
								neighbour_2 != 0,
								neighbour_2 < shrunksize:"h"
							]),
							position = position + [0, -1.075 * shrunksize:"w"];
						);
					);
 
					position = position + [labelsize:"h"/2, 1 - 1.5*my("labeldigitwidth")];
					alignment = "right";
				);
 
				drawtext(position, text, size->currentsize, family->family,
					color->'valuemarkcolors_counter, angle->angle, align->alignment);
			);
		);
 
		// --- Current percentage ----------------------------------------------
		if(my("drawcurrentpercentage"),
			text = round(my("value")*1000)/10 + " %";
			box = get boundingbox(text, [0,0], size, family);
			position = my("coord") + [
				my("value")*my("width") - .5*(box_2_1 - box_1_1),
				my("height") + my("labelpadding")
			];
 
			draw label(position, text, size, mod'font->family, mod'bold->true);
 
			if(my("scaffoldpercentage"),
				regional(scaffoldbox);
				scaffoldbox = roundedrectangle(position, box_2_1 - box_1_1, box_4_2 - box_1_2, .05);
				draw(scaffoldbox, color->grey(.5));
				fill(scaffoldbox, color->grey(.9));
			);
		);
 
		// --- Current value ----------------------------------------------------
		if(my("drawcurrentvalue"),
			text = round(my("value")*my("basevalue")*100)/100 + " " + my("unit");
			box = get boundingbox(text, [0,0], size, family);
			position = my("coord") + [
				my("value")*my("width") - .5*(box_2_1 - box_1_1),
				-(box_3_2 - box_2_2) - my("labelpadding")
			];
 
			draw label(position, text, size, mod'font->family, mod'bold->true);
 
			if(my("scaffoldvalue"),
				regional(scaffoldbox);
				scaffoldbox = roundedrectangle(position, box_2_1 - box_1_1, box_4_2 - box_1_2, .05);
				draw(scaffoldbox, color->grey(.5));
				fill(scaffoldbox, color->grey(.9));
			);
		);
 
		// --- Debug draw --------------------------------------------------------
		if(LOGLEVEL > 0,
			drawtext(my("coord") + [0.3, 0], my("value"));
			draw(my("coord"));
		);
		if(LOGLEVEL > 1, drawpoly(my("hitbox"), color->[0,1,0]));
	);

	/**
	* Arches above the bar. Eval with 'yoffset and optionally 'istotalarc.
	* @refactor: rename to "upper" instead of "percentage" everywhere
	*/
	line:"drawupperarches" := (
		regional(ticks, archwidth, archheight, todraw, position, deltay, angle,
			labeltext, labelsize, size, family, arccolor, ticksundervalue, maxtick);
 
		if(isundefined('yoffset), 'yoffset = 0);
		if(isundefined('istotalarc), 'istotalarc = false);
 
		// NOTE: size and family used to be read from the surrounding "draw" scope.
		size = my("fontsize");
		family = my("fontfamily");
 
		ticks = 0 <: my("ticks"); // ticks with start (0) and end value (1) added
 
		if(!'istotalarc,
			archwidth = my("width") / my("divisions"); // ellipse major axis
			archheight = archwidth / PHI;             // ellipse minor axis
 
			forall(2..length(ticks), idx,
				todraw = false;
 
				// Special case: draw the first small arc even with drawarches = false,
				// as long as labels and the total arc are switched on.
				if(list and([tobool(my("drawtotalarc")), tobool(my("drawuppernumberlinelabels"))]),
					if(list and([idx == 2, ticks_idx < my("value") + 0.001]),
						todraw = true;
					,
						if(tobool(my("drawarches")),
							todraw = (my("value") >= ticks_idx - 0.001);
						);
					);
				,
					todraw = (my("value") >= ticks_idx - 0.001);
				);
 
				position = my("coord") + [(idx - 1.5)*archwidth, 'yoffset];
				deltay = [0,0];
				if(list and([tobool(my("drawupperticks")), !tobool(my("isticksdistanceenough"))]),
					deltay = [0, my("ticklabelsizelimits"):"max":"w" - 1.25*my("labeldigitwidth")];
				);
 
				if(todraw,
					connect(ellipse(position + deltay, archwidth/2, archheight/2, 0, PI),
						color->my("color"));
 
					if(tobool(my("arcslabels")),
						// NOTE: the original assigned "angel" (typo) and then read "angle",
						// so the rotation never took effect.
						angle = 0°;
						labeltext = my("sizesteps"):"upper" + "er";
						labelsize = text box size(labeltext, size, family);
						position = my("coord") + [(idx - 1.5)*archwidth, 'yoffset + archheight/2 + 0.1] + deltay;
 
						if(!tobool(my("isticksdistanceenough")),
							angle = 90°;
							position = position + [labelsize:"h"/2, labelsize:"w"/2];
						);
 
						drawtext(position, labeltext, align->"center", color->my("color"), angle->angle);
					);
				);
			);
		,
			// @incomplete: height should scale with width and start higher than a single arc
			arccolor = my("color") + [100,0,0]/255;
			ticksundervalue = select(ticks, # < my("value") + 0.005);
			maxtick = max(ticksundervalue);
 
			archwidth = my("width") * maxtick;
			archheight = 0.5 * archwidth / PHI;
			position = my("coord") + [0.5*archwidth, 'yoffset];
			deltay = [0,0];
 
			if(!tobool(my("isticksdistanceenough")), archheight = archheight * 1.5);
			if(list and([tobool(my("drawupperticks")), !tobool(my("isticksdistanceenough"))]),
				deltay = [0, my("ticklabelsizelimits"):"max":"w" - 1.25*my("labeldigitwidth")];
			);
 
			connect(ellipse(position + deltay, archwidth/2, archheight/2, 0, PI), color->arccolor);
 
			if(list and([tobool(my("totalarclabel")), length(ticksundervalue) > 1]),
				labeltext = numeral(length(ticksundervalue) - 1) + " " + my("sizesteps"):"upper" + "er";
				drawtext(my("coord") + [0.5*archwidth, 'yoffset + archheight/2 + 0.1] + deltay,
					labeltext, align->"center", color->arccolor);
			);
		);
	);
 
	/**
	* Arches below the bar. Mirror image of "drawupperarches".
	*/
	line:"drawvaluearches" := (
		regional(ticks, archwidth, archheight, todraw, position, deltay, angle,
			labeltext, labelsize, size, family, arccolor, ticksundervalue, maxtick);
 
		if(isundefined('yoffset), 'yoffset = 0);
		if(isundefined('istotalarc), 'istotalarc = false);
 
		size = my("fontsize");
		family = my("fontfamily");
 
		ticks = 0 <: my("ticks");
 
		if(!'istotalarc,
			archwidth = my("width") / my("divisions");
			archheight = archwidth / PHI;
 
			forall(2..length(ticks), idx,
				todraw = false;
 
				if(list and([tobool(my("drawtotalarc")), tobool(my("drawuppernumberlinelabels"))]),
					if(list and([idx == 2, ticks_idx < my("value") + 0.001]),
						todraw = true;
					,
						if(tobool(my("drawarches")),
							todraw = (my("value") >= ticks_idx - 0.001);
						);
					);
				,
					todraw = (my("value") >= ticks_idx - 0.001);
				);
 
				position = my("coord") + [(idx - 1.5)*archwidth, 'yoffset];
				deltay = [0,0];
				if(list and([tobool(my("drawupperticks")), !tobool(my("isticksdistanceenough"))]),
					deltay = [0, my("ticklabelsizelimits"):"max":"w" - 1.25*my("labeldigitwidth")];
				);
 
				if(todraw,
					connect(ellipse(position - deltay, archwidth/2, archheight/2, PI, 2*PI),
						color->my("color"));
 
					if(tobool(my("arcslabels")),
						angle = 0°;
						labeltext = my("sizesteps"):"lower" + "er";
						labelsize = text box size(labeltext, size, family);
						position = my("coord") + [(idx - 1.5)*archwidth, 'yoffset - archheight/2 - 0.55];
 
						if(!tobool(my("isticksdistanceenough")),
							angle = 90°;
							position = position + [labelsize:"h"/2, -labelsize:"w"*0.6];
						);
 
						drawtext(position, labeltext, align->"center", color->my("color"), angle->angle);
					);
				);
			);
		,
			arccolor = my("color") + [100,0,0]/255;
			ticksundervalue = select(ticks, # < my("value") + 0.005);
			maxtick = max(ticksundervalue);
 
			archwidth = my("width") * maxtick;
			archheight = 0.5 * archwidth / PHI;
			position = my("coord") + [0.5*archwidth, 'yoffset];
			deltay = [0,0];
 
			if(!tobool(my("isticksdistanceenough")), archheight = archheight * 1.5);
			if(list and([tobool(my("drawupperticks")), !tobool(my("isticksdistanceenough"))]),
				deltay = -[0, my("ticklabelsizelimits"):"max":"w" - 1.25*my("labeldigitwidth")];
			);
 
			connect(ellipse(position + deltay, archwidth/2, archheight/2, PI, 2*PI), color->arccolor);
 
			if(list and([tobool(my("totalarclabel")), length(ticksundervalue) > 1]),
				labeltext = numeral(length(ticksundervalue) - 1) + " " + my("sizesteps"):"lower" + "er";
				drawtext(my("coord") + [0.5*archwidth, 'yoffset - archheight/2 - 0.55] + deltay,
					labeltext, align->"center", color->arccolor);
			);
		);
	);
 
	// --- Interaction ---------------------------------------------------------
 
	line:"move" := if(my("ismoveable"), my("setvalue"));
	line:"click" := if(my("isclickable"), my("setvalue"));
 
	line:"moveend" := if(my("ismoveable"),
		// Keep the text fields in sync. Guarded: they only exist after init.
		if(!isundefined(my("textfields")),
			my("textfields"):"value":"value" = 100 * my("value") + "";
			my("textfields"):"percentage":"value" = my("value") + "";
		);
	);
 
	/**
	* Set the value from the mouse position, snapping to a nearby tick.
	*/
	line:"setvalue" := (
		regional(newvalue, nearest, mindistance, argmin);
 
		newvalue = (mouse().xy - my("coord"))_1 / my("width");
 
		// NOTE: CindyScript has no destructuring assignment - the original
		// "[a, b] = minargmin(...)" left both undefined, so the snapping never
		// worked and the first branch was always taken.
		if(length(my("ticks")) > 0,
			nearest = min with index(apply(my("ticks"), |# - newvalue|));
			mindistance = nearest_1;
			argmin = nearest_2;
		,
			mindistance = 999;
		);
 
		// @incomplete: find the right threshold
		if(mindistance > 0.005,
			self():"value" = newvalue;
		,
			self():"value" = my("ticks")_argmin;
		);
 
		// For the double number line: never cut at the upper end, always cut at 0.
		self():"value" = max(my("value"), 0);
 
		// Round according to the given precision
		self():"value" = my("precision") * round(my("value")/my("precision"));
	);

	line; // Return Doublenumberline object
);


// ================== //
// D | Initialization //
// ================== //

/**
* Position relative to the bar, in bar widths and heights.
* Anchored at 'barposition, so moving the bar moves the whole interface with it.
*/
barcoord(x, y) := 'barposition + [x * 'barwidth, y * 'barheight];


// D.1 | Toggle switches
// new Toggle(coord, width, state, label, fontsize)
// =====================================================================
regional(toggles);

toggles = {
	// --- increasing ("Hochrechnen") ---
	"increasing"          : new Toggle(barcoord(0.125,1) + [0,5],   1, false, "Hochrechnen", 14*FONTSCALE),
	"incNumberlineLabels" : new Toggle(barcoord(0,0) + [1,-11],     1, false, "Zahlenstrahl-Beschriftung", 14*FONTSCALE),
	"incArcs"             : new Toggle(barcoord(0,0) + [14,-7],     1, false, "Bögen", 14*FONTSCALE),
	"incArcsLabels"       : new Toggle(barcoord(0,0) + [15,-8],     1, false, "Bögen-Beschriftung", 14*FONTSCALE),
	"incTotalArc"         : new Toggle(barcoord(0,0) + [14,-9],     1, false, "Gesamtbogen", 14*FONTSCALE),
	"incTotalArcLabel"    : new Toggle(barcoord(0,0) + [15,-10],    1, false, "Gesamtbogen-Beschriftung", 14*FONTSCALE),
	"incValuesInput"      : new Toggle(barcoord(0,0) + [14,-11],    1, false, "Werte eingeben", 14*FONTSCALE),
	"incUpperGivenUnit"   : new Toggle(barcoord(0,0) + [8.5,-9],    1, false, "", 14*FONTSCALE),
	"incLowerGivenUnit"   : new Toggle(barcoord(0,0) + [8.5,-10],   1, false, "", 14*FONTSCALE),

	// --- decreasing ("Runterrechnen") ---
	"decreasing"          : new Toggle(barcoord(0.6,1) + [0,5],     1, false, "Runterrechnen", 14*FONTSCALE),
	"decUseNumberSteps"   : new Toggle(barcoord(0,0) + [2,-9],      1, false, "Anzahl Schritte", 14*FONTSCALE),
	"decUseSizeSteps"     : new Toggle(barcoord(0,0) + [2,-10],     1, false, "Größe der Schritte", 14*FONTSCALE),
	"decNumberlineLabels" : new Toggle(barcoord(0,0) + [15.5,-7],   1, false, "Zahlenstrahl-Beschriftung", 14*FONTSCALE),
	"decArcs"             : new Toggle(barcoord(0,0) + [15.5,-8],   1, false, "Bögen", 14*FONTSCALE),
	"decArcsLabels"       : new Toggle(barcoord(0,0) + [16.5,-9],   1, false, "Bögen-Beschriftung", 14*FONTSCALE),
	"decValuesInput"      : new Toggle(barcoord(0,0) + [15.5,-10],  1, false, "Werte eingeben", 14*FONTSCALE)
};

// NOTE: the label of "incTotalArcLabel" was "Bögen-Beschriftung" in the
// original, same as "incArcsLabels" - almost certainly a copy-paste slip,
// renamed to "Gesamtbogen-Beschriftung".


// D.2 | The bar itself
// new Doublenumberline(coord, width, height, value, precision, divisions, baseval, unit)
// =====================================================================
bar = new Doublenumberline('barposition, 'barwidth, 'barheight, 'barvalue, 'barprecision, 'subdivisions, 'basevalue, 'unit);

/**
* Which mode is active. Derived from the two main toggles, so the bar does not
* have to be told about mode changes.
*/
bar:"mode" := if(toggles:"increasing":"state",
	"increasing";
,
	if(toggles:"decreasing":"state", "decreasing", "none");
);

// --- Visibility, all derived from the toggles ---
// NOTE: upper and lower ticks share one toggle, they are listed separately
// so they can be split later without touching the draw code.
bar:"drawupperticks" := if(my("mode") == "increasing",
	toggles:"incNumberlineLabels":"state";
,
	toggles:"decNumberlineLabels":"state";
);
bar:"drawlowerticks" := if(my("mode") == "increasing",
	toggles:"incNumberlineLabels":"state";
,
	toggles:"decNumberlineLabels":"state";
);

/**
* In "decreasing" mode the labels only appear once the step size is actually
* known - either because the number of steps was given, or because the size
* was entered.
*/
bar:"drawuppernumberlinelabels" := if(my("mode") == "increasing",
	toggles:"incNumberlineLabels":"state";
,
	list and([
		toggles:"decNumberlineLabels":"state",
		list or([
			my("submode") == "number",
			list and([
				!isundefined(textfields:"decUpperSizeSteps":"value"),
				textfields:"decUpperSizeSteps":"value" != ""
			])
		])
	]);
);

bar:"drawlowernumberlinelabels" := if(my("mode") == "increasing",
	toggles:"incNumberlineLabels":"state";
,
	list and([
		toggles:"decNumberlineLabels":"state",
		list or([
			my("submode") == "number",
			list and([
				!isundefined(textfields:"decLowerSizeSteps":"value"),
				textfields:"decLowerSizeSteps":"value" != ""
			])
		])
	]);
);

bar:"drawarches" := if(my("mode") == "increasing",
	toggles:"incArcs":"state", toggles:"decArcs":"state");

bar:"arcslabels" := if(my("mode") == "increasing",
	toggles:"incArcsLabels":"state", toggles:"decArcsLabels":"state");

// Only available in "increasing" mode.
bar:"drawtotalarc"  := if(my("mode") == "increasing", toggles:"incTotalArc":"state", false);
bar:"totalarclabel" := if(my("mode") == "increasing", toggles:"incTotalArcLabel":"state", false);


// D.3 | Wiring
// The handles could not be set earlier, the bar did not exist yet.
// =====================================================================

// Text fields: point them at the bar and apply any preset value.
forall(textfields, textfield,
	textfield:"handle" = bar;
	if(textfield:"value" != "", textfield:"onupdate");
);

// Toggles: point them at the bar and switch on the ones that are configured.
//
// NOTE: the original read the state from urlparameter(name). The values now
// come from ENVIRONMENTALPARAMS under the toggle's own name, so a link like
// "?increasing=true&incArcs=true" still works - and so does the same setting
// coming from divomath.
forall(keys(toggles), name,
	regional(togglestate);
	toggles:name:"handle" = bar;

	togglestate = tobool(default to(ENVIRONMENTALPARAMS:name, false, true));

	// Only click if it is not already in that state - in "decreasing" mode some
	// toggles default to true.
	if(list and([togglestate, !toggles:name:"state"]),
		toggles:name:"click";
	);
);

// Give the bar access to the interface
bar:"toggles" = toggles;
bar:"textfields" = textfields;

obj = obj :> bar;

// D.4 | Text inputs
// =====================================================================
regional(textfields, refToggle);
 
textfields = {};
 
/**
* Every field does the same three things when it is done: drop the keyboard,
* forget it and go back to the inactive colour. Kept in one place so the
* individual "onupdate" scripts only carry what is specific to them.
*
* NOTE: this used to be copy-pasted into all 31 fields.
*/
closeKeyboard(field) := (
	obj = obj -- [field:"keyboard"];
	field:"keyboard" = NADA;
	field:"color" = field:"inactiveColor";
);
 
 
// --- Units (the only fields with a letter keyboard) -------------------------
textfields:"upperUnit" = new TextInput(barcoord(1,1) + [0.75,-0.25], "", "full");
textfields:"upperUnit":"width" = 3;
textfields:"upperUnit":"handle" = bar;
textfields:"upperUnit":"selectionToggle" = toggles:"incUpperGivenUnit";
textfields:"upperUnit":"value" = 'upperunit;
textfields:"upperUnit":"onupdate" := (
	my("handle"):"units":"upper" = my("value");
	my("selectionToggle"):"label" = my("value");
	closeKeyboard(self());
);
 
textfields:"lowerUnit" = new TextInput(barcoord(1,0) + [0.75,-0.25], "", "full");
textfields:"lowerUnit":"width" = 3;
textfields:"lowerUnit":"handle" = bar;
textfields:"lowerUnit":"selectionToggle" = toggles:"incLowerGivenUnit";
textfields:"lowerUnit":"value" = 'lowerunit;
textfields:"lowerUnit":"onupdate" := (
	my("handle"):"units":"lower" = my("value");
	my("selectionToggle"):"label" = my("value");
	closeKeyboard(self());
);
 
 
// --- Increasing mode --------------------------------------------------------
textfields:"incUpperSizeSteps" = new TextInput(barcoord(0,0) + [6,-7],
	["Schrittgröße oben", "er-Schritte"], "numeric");
textfields:"incUpperSizeSteps":"handle" = bar;
textfields:"incUpperSizeSteps":"value" = 'incuppersizesteps;
textfields:"incUpperSizeSteps":"onupdate" := (
	my("handle"):"sizesteps":"upper" = parse(my("value"));
	closeKeyboard(self());
);
 
// NOTE: the original placed this one at a plain [6,-8] instead of relative to
// the bar, unlike its counterpart above.
textfields:"incLowerSizeSteps" = new TextInput(barcoord(0,0) + [6,-8],
	["Schrittgröße unten", "er-Schritte"], "numeric");
textfields:"incLowerSizeSteps":"handle" = bar;
textfields:"incLowerSizeSteps":"value" = 'inclowersizesteps;
textfields:"incLowerSizeSteps":"onupdate" := (
	my("handle"):"sizesteps":"lower" = parse(my("value"));
	closeKeyboard(self());
);
 
textfields:"incGivenValue" = new TextInput(barcoord(0,0) + [6,-9.5], "Gegeben", "numeric");
textfields:"incGivenValue":"handle" = bar;
textfields:"incGivenValue":"value" = 'incgivenvalue;
textfields:"incGivenValue":"onupdate" := (
	my("handle"):"givenvalue" = parse(my("value"));
	closeKeyboard(self());
);
 
 
// --- Decreasing mode --------------------------------------------------------
textfields:"decUpperTargetValue" = new TextInput(barcoord(0,0) + [6,-7],
	"Zielwert oben", "numeric");
textfields:"decUpperTargetValue":"handle" = bar;
textfields:"decUpperTargetValue":"value" = 'decuppertargetvalue;
textfields:"decUpperTargetValue":"onupdate" := (
	my("handle"):"givenvalue" = parse(my("value"));
	my("handle"):"value" = 1.0; // the target sits at the far end of the bar
	closeKeyboard(self());
);
 
textfields:"decLowerTargetValue" = new TextInput(barcoord(0,0) + [6,-8],
	"Zielwert unten", "numeric");
textfields:"decLowerTargetValue":"handle" = bar;
textfields:"decLowerTargetValue":"value" = 'declowertargetvalue;
textfields:"decLowerTargetValue":"onupdate" := (
	my("handle"):"inputdependentvalue" = parse(my("value"));
	my("handle"):"value" = 1.0;
	closeKeyboard(self());
);
 
/**
* Position right of a toggle, past its label.
* @refactor: this was spelled out at every call site in the original.
*/
rightOfToggle(toggle, dy) := toggle:"coord"
	+ [0.5 + toggle:"width" + text box size(toggle:"label", toggle:"fontsize", NADA):"w", dy];
 
refToggle = toggles:"decUseNumberSteps";
textfields:"decNumberSteps" = new TextInput(rightOfToggle(refToggle, 0), "", "numeric");
textfields:"decNumberSteps":"handle" = bar;
textfields:"decNumberSteps":"value" = 'decnumbersteps;
textfields:"decNumberSteps":"onupdate" := (
	regional(newColor, value);
	newColor = my("inactiveColor");
	value = parse(my("value"));
 
	// Only accept a number of steps that divides both number lines evenly.
	if(eval(my("handle"):"checknumberstepsconsistency", 'inputvalue->value),
		my("handle"):"sizesteps":"lower" = my("handle"):"maxdependentvalue"/value;
		my("handle"):"sizesteps":"upper" = my("handle"):"maxgivenvalue"/value;
		my("handle"):"inputdivisions" = value;
	,
		my("handle"):"inputdivisions" = NADA;
		newColor = my("warningColor");
	);
 
	closeKeyboard(self());
	self():"color" = newColor; // after closeKeyboard, it resets the colour
);
 
refToggle = toggles:"decUseSizeSteps";
 
textfields:"decUpperSizeSteps" = new TextInput(rightOfToggle(refToggle, -1),
	["Schrittgröße oben", "er-Schritte"], "numeric");
textfields:"decUpperSizeSteps":"handle" = bar;
textfields:"decUpperSizeSteps":"value" = 'decuppersizesteps;
textfields:"decUpperSizeSteps":"onupdate" := (
	my("handle"):"sizesteps":"upper" = parse(my("value"));
	closeKeyboard(self());
 
	// Both step sizes have to agree on the number of steps.
	if(!my("handle"):"checksizestepsconsistency",
		self():"color" = my("warningColor");
		textfields:"decLowerSizeSteps":"color" = my("warningColor");
	,
		textfields:"decLowerSizeSteps":"color" = textfields:"decLowerSizeSteps":"inactiveColor";
	);
);
 
textfields:"decLowerSizeSteps" = new TextInput(rightOfToggle(refToggle, -2),
	["Schrittgröße unten", "er-Schritte"], "numeric");
textfields:"decLowerSizeSteps":"handle" = bar;
textfields:"decLowerSizeSteps":"value" = 'declowersizesteps;
textfields:"decLowerSizeSteps":"onupdate" := (
	my("handle"):"sizesteps":"lower" = parse(my("value"));
	closeKeyboard(self());
 
	if(!my("handle"):"checksizestepsconsistency",
		self():"color" = my("warningColor");
		textfields:"decUpperSizeSteps":"color" = my("warningColor");
	,
		textfields:"decUpperSizeSteps":"color" = textfields:"decUpperSizeSteps":"inactiveColor";
	);
);
 
 
// --- Value marks ------------------------------------------------------------
// Ten pairs of fields (five per mode), all identical except for their index
// and position. The original spelled every one of them out.
//
// The upper field of each pair draws a coloured dot next to its label so it can
// be matched to the mark on the number line.
 
'markpositions = {
	"inc": [[18,-12], [24,-12], [30,-12], [18,-14.5], [24,-14.5]],
	"dec": [[19.5,-11], [25.5,-11], [31.5,-11], [19.5,-13.5], [25.5,-13.5]]
};
'markconfig = {
	"incUpper": 'incuppervaluemarks, "incLower": 'inclowervaluemarks,
	"decUpper": 'decuppervaluemarks, "decLower": 'declowervaluemarks
};
 
forall(["inc", "dec"], mode,
	forall(1..5, i,
		regional(uppername, lowername, uppercoord);
		uppername = mode + "UpperValueMark" + i;
		lowername = mode + "LowerValueMark" + i;
		uppercoord = ('markpositions:mode)_i;
 
		// --- upper field ---
		textfields:uppername = new TextInput(uppercoord, "Wert oben", "numeric");
		textfields:uppername:"index" = i;
		textfields:uppername:"handle" = bar;
		textfields:uppername:"value" = ('markconfig:(mode + "Upper"))_i;
		textfields:uppername:"drawBackground" := (
			regional(labelsize);
			labelsize = text box size(my("label"), my("fontsize"), my("fontfamily"));
			fillcircle(my("coord") + [-labelsize:"w"/2, -0.2], 0.25,
				color->'valuemarkcolors_(my("index")));
		);
		textfields:uppername:"onupdate" := (
			'uppervaluemarks_(my("index")) = parse(my("value"));
			closeKeyboard(self());
		);
 
		// --- lower field, one line below ---
		textfields:lowername = new TextInput(uppercoord + [0,-1], "Wert unten", "numeric");
		textfields:lowername:"index" = i;
		textfields:lowername:"handle" = bar;
		textfields:lowername:"value" = ('markconfig:(mode + "Lower"))_i;
		textfields:lowername:"onupdate" := (
			'lowervaluemarks_(my("index")) = parse(my("value"));
			closeKeyboard(self());
		);
	);
);

// D.5 | Buttons
// new Button(coord, width, height, label, fontsize)
// =====================================================================
regional(buttons);
buttons = {};

/**
* The plus/minus pairs next to the step size fields. All ten used to be spelled
* out, they only differ in their target field and position.
*
* Symbols are drawn rather than typeset - HEAVYPLUS/HEAVYMINUS are emoji and
* cannot be centred reliably, see the Button class.
*/
makeStepButton(name, coord, target, delta) := (
	regional(btn);

	btn = new Button(coord, .6, .6, "", NADA);
	btn:"handle" = target;
	btn:"cornerradius" = .35;
	btn:"delta" = delta;
	btn:"imgfill" = .5;
	btn:"drawafter" := if(my("delta") > 0, my("drawplus"), my("drawminus"));

	btn:"script" := (
		regional(newvalue);

		newvalue = parse(my("handle"):"value");
		if(isundefined(newvalue), newvalue = 0);

		// never below 1 - a step size or step count of 0 makes no sense
		newvalue = max(1, newvalue + my("delta"));

		my("handle"):"value" = newvalue + "";
		my("handle"):"onupdate";
	);

	buttons:name = btn;
	btn;
);

// --- increasing: fixed positions --------------------------------------------
makeStepButton("incUpperSizeStepsMinus", barcoord(0,0) + [11.5,-7],
	textfields:"incUpperSizeSteps", -1);
makeStepButton("incUpperSizeStepsPlus", barcoord(0,0) + [12.125,-7],
	textfields:"incUpperSizeSteps", 1);
makeStepButton("incLowerSizeStepsMinus", barcoord(0,0) + [11.5,-8],
	textfields:"incLowerSizeSteps", -1);
makeStepButton("incLowerSizeStepsPlus", barcoord(0,0) + [12.125,-8],
	textfields:"incLowerSizeSteps", 1);

// --- decreasing: positioned relative to their text field --------------------
makeStepButton("decNumberStepsMinus", textfields:"decNumberSteps":"coord" + [2.5, 0],
	textfields:"decNumberSteps", -1);
makeStepButton("decNumberStepsPlus", textfields:"decNumberSteps":"coord" + [3.25, 0],
	textfields:"decNumberSteps", 1);
makeStepButton("decUpperSizeStepsMinus", textfields:"decUpperSizeSteps":"coord" + [5.25, 0],
	textfields:"decUpperSizeSteps", -1);
makeStepButton("decUpperSizeStepsPlus", textfields:"decUpperSizeSteps":"coord" + [6.0, 0],
	textfields:"decUpperSizeSteps", 1);
makeStepButton("decLowerSizeStepsMinus", textfields:"decLowerSizeSteps":"coord" + [5.25, 0],
	textfields:"decLowerSizeSteps", -1);
makeStepButton("decLowerSizeStepsPlus", textfields:"decLowerSizeSteps":"coord" + [6.0, 0],
	textfields:"decLowerSizeSteps", 1);


/**
* "Add more values" - reveals the next pair of value mark fields.
* One per mode; they only differ in the prefix of the fields they reveal.
*/
makeAddMarkButton(name, coord, prefix, presetupper) := (
	regional(btn, i);

	btn = new Button(coord, 7, .7, " weitere Werte hinzufügen", 12*FONTSCALE);
	btn:"cornerradius" = .35;
	btn:"prefix" = prefix;
	btn:"imgfill" = .5;
	btn:"drawafter" := my("drawplus");

	// Start with as many pairs visible as were preset in the configuration.
	// NOTE: the original tested the SAME parameter twice (upper both times),
	// so a preset lower value alone did not reveal its field.
	btn:"markValueCounter" = 1;
	forall(1..5, i,
		if(!isundefined(presetupper_i), btn:"markValueCounter" = i);
	);

	btn:"script" := (
		if(my("markValueCounter") < 5,
			self():"markValueCounter" = my("markValueCounter") + 1;
			obj = obj ++ [
				textfields:(my("prefix") + "UpperValueMark" + my("markValueCounter")),
				textfields:(my("prefix") + "LowerValueMark" + my("markValueCounter"))
			];
		);

		// all five pairs shown - the button has done its job
		if(my("markValueCounter") == 5, obj = obj -- [self()]);
	);

	buttons:name = btn;
	btn;
);

makeAddMarkButton("incAddValueMarkInputs", barcoord(0,0) + [20,-11], "inc", 'incuppervaluemarks);
makeAddMarkButton("decAddValueMarkInputs", barcoord(0,0) + [21.5,-10], "dec", 'decuppervaluemarks);

// NOTE: "selectUpperUnit" and "selectLowerUnit" were listed but never built -
// the code was commented out in the original and is left out here.

// Give the bar access to the buttons as well
bar:"buttons" = buttons;

// D.4 | Toggle scripts - which widgets are visible when
// =====================================================================

/**
* Show or hide a list of widgets.
* @refactor: the original repeated "obj = obj ++ [...]" per widget.
*/
setVisible(widgets, visible) := if(visible,
	obj = obj ++ widgets;
,
	obj = obj -- widgets;
);

/**
* Switch off a list of toggles, running their scripts so their own sub widgets
* disappear too.
*/
switchOffAll(toggleList) := forall(toggleList, toggle,
	if(toggle:"state", toggle:"click");
);

/**
* Back to a blank state. Called when the mode changes, because the marks and
* units of one mode should not carry over into the other.
*
* @refactor: this is copy-pasted from the constructor in the original; a proper
* reset method on the bar would be better.
*/
resetBar() := (
	// The values stay in the text fields, so they can be restored by hand.
	'uppervaluemarks = apply(1..5, NADA);
	'lowervaluemarks = apply(1..5, NADA);

	bar:"units" = {"lower": NADA, "upper": NADA};
	bar:"givenvalue" = NADA;
	bar:"sizesteps" = {"lower": NADA, "upper": NADA};

	// In "decreasing" mode the maximum is set by the user, so either line will
	// do and "upper" is picked; in "increasing" mode the user has to choose.
	bar:"givenunit" := if(my("mode") == "increasing", NADA, "upper");
	bar:"dependentunit" = NADA;
);


// --- Mode toggles, mutually exclusive ---------------------------------------

toggles:"increasing":"script" := (
	regional(widgets);
	widgets = [
		textfields:"incUpperSizeSteps", textfields:"incLowerSizeSteps",
		textfields:"incGivenValue",
		toggles:"incNumberlineLabels", toggles:"incArcs", toggles:"incTotalArc",
		toggles:"incValuesInput",
		toggles:"incUpperGivenUnit", toggles:"incLowerGivenUnit",
		buttons:"incUpperSizeStepsPlus", buttons:"incUpperSizeStepsMinus",
		buttons:"incLowerSizeStepsPlus", buttons:"incLowerSizeStepsMinus"
	];

	if(my("state"),
		if(toggles:"decreasing":"state", toggles:"decreasing":"click");
		setVisible(widgets, true);
	,
		switchOffAll([
			toggles:"incNumberlineLabels", toggles:"incArcs", toggles:"incTotalArc",
			toggles:"incValuesInput",
			toggles:"incUpperGivenUnit", toggles:"incLowerGivenUnit"
		]);
		setVisible(widgets, false);
		resetBar();
	);
);

toggles:"decreasing":"script" := (
	regional(widgets);
	widgets = [
		textfields:"decUpperTargetValue", textfields:"decLowerTargetValue",
		toggles:"decUseSizeSteps", toggles:"decUseNumberSteps",
		toggles:"decNumberlineLabels", toggles:"decArcs", toggles:"decValuesInput"
	];

	if(my("state"),
		if(toggles:"increasing":"state", toggles:"increasing":"click");
		setVisible(widgets, true);
	,
		switchOffAll([
			toggles:"decUseSizeSteps", toggles:"decUseNumberSteps",
			toggles:"decNumberlineLabels", toggles:"decArcs", toggles:"decValuesInput"
		]);
		setVisible(widgets, false);
		resetBar();
	);
);


// --- Unit selection, mutually exclusive but both may be off -----------------
// Which number line carries the given value.

toggles:"incUpperGivenUnit":"handle" = bar;
toggles:"incUpperGivenUnit":"script" := if(my("state"),
	if(toggles:"incLowerGivenUnit":"state", toggles:"incLowerGivenUnit":"click");

	my("handle"):"givenunit" = "upper";
	my("handle"):"dependentunit" = "lower";
,
	// Only reset if the other one is off as well.
	if(!toggles:"incLowerGivenUnit":"state",
		my("handle"):"givenunit" = NADA;
		my("handle"):"dependentunit" = NADA;
	);
);

toggles:"incLowerGivenUnit":"handle" = bar;
toggles:"incLowerGivenUnit":"script" := if(my("state"),
	if(toggles:"incUpperGivenUnit":"state", toggles:"incUpperGivenUnit":"click");

	my("handle"):"givenunit" = "lower";
	my("handle"):"dependentunit" = "upper";
,
	if(!toggles:"incUpperGivenUnit":"state",
		my("handle"):"givenunit" = NADA;
		my("handle"):"dependentunit" = NADA;
	);
);


// --- Arch labels follow their arches ----------------------------------------

toggles:"incArcs":"script" := setVisible([toggles:"incArcsLabels"], my("state"));
toggles:"incTotalArc":"script" := setVisible([toggles:"incTotalArcLabel"], my("state"));
toggles:"decArcs":"script" := setVisible([toggles:"decArcsLabels"], my("state"));


// --- Decreasing: number of steps OR step size, not both ---------------------

toggles:"decUseNumberSteps":"handle" = bar;
toggles:"decUseNumberSteps":"script" := (
	regional(widgets);
	widgets = [textfields:"decNumberSteps",
		buttons:"decNumberStepsPlus", buttons:"decNumberStepsMinus"];

	if(my("state"),
		// Clear the other input so no stale step size is left behind
		if(toggles:"decUseSizeSteps":"state",
			textfields:"decUpperSizeSteps":"value" = "";
			textfields:"decLowerSizeSteps":"value" = "";
			textfields:"decUpperSizeSteps":"onupdate";
			textfields:"decLowerSizeSteps":"onupdate";
			toggles:"decUseSizeSteps":"click";
		);

		// Without arches the steps are not visible at all
		if(!toggles:"decArcs":"state", toggles:"decArcs":"click");

		my("handle"):"submode" = "number";
	);

	setVisible(widgets, my("state"));
);

toggles:"decUseSizeSteps":"handle" = bar;
toggles:"decUseSizeSteps":"script" := (
	regional(widgets);
	widgets = [textfields:"decUpperSizeSteps", textfields:"decLowerSizeSteps",
		buttons:"decUpperSizeStepsPlus", buttons:"decUpperSizeStepsMinus",
		buttons:"decLowerSizeStepsPlus", buttons:"decLowerSizeStepsMinus"];

	if(my("state"),
		my("handle"):"value" = 0;

		if(toggles:"decUseNumberSteps":"state",
			textfields:"decNumberSteps":"value" = "";
			textfields:"decNumberSteps":"onupdate";
			my("handle"):"value" = 0;
			toggles:"decUseNumberSteps":"click";
		);

		my("handle"):"submode" = "size";
	);

	setVisible(widgets, my("state"));
);


// --- Value mark input -------------------------------------------------------
// One script for both modes, they only differ in the prefix.

/**
* Show or hide as many value mark field pairs as the add button has revealed.
*/
valueInputScript(prefix, addbutton, state) := (
	regional(fields, i);

	fields = [];
	forall(1..addbutton:"markValueCounter", i,
		fields = fields ++ [
			textfields:(prefix + "UpperValueMark" + i),
			textfields:(prefix + "LowerValueMark" + i)
		];
	);

	if(state,
		// The add button disappears once all five pairs are shown.
		if(addbutton:"markValueCounter" < 5, setVisible([addbutton], true));
		setVisible(fields, true);

		// Apply whatever is already in the fields
		forall(fields, #:"onupdate");
	,
		forall(1..addbutton:"markValueCounter", i,
			'uppervaluemarks_i = NADA;
			'lowervaluemarks_i = NADA;
		);

		setVisible([addbutton], false);
		setVisible(fields, false);
	);
);

toggles:"incValuesInput":"handle" = bar;
toggles:"incValuesInput":"script" :=
	valueInputScript("inc", buttons:"incAddValueMarkInputs", my("state"));

toggles:"decValuesInput":"handle" = bar;
toggles:"decValuesInput":"script" :=
	valueInputScript("dec", buttons:"decAddValueMarkInputs", my("state"));

// NOTE: the "currentValues" methods of both toggles were defined but never
// read anywhere - left out.


// --- Finally: put the two mode toggles on screen ----------------------------
obj = obj ++ [toggles:"increasing", toggles:"decreasing"];
obj = obj ++ [textfields:"upperUnit", textfields:"lowerUnit"];

);
//[VAM] numbercards
/** v24 *****************************************************************************************
* Number cards to explore place value concept.
*
* Recent changes:
* 2026-08-06 Adjusted VAM to new framework structure.
* 2026-08-07 Rebuilt: configuration via "default to" with speaking 'names, dropped the
*            top level regional() (config is read from class methods), renamed variables
*            that shadowed builtins or drawing modifiers, fixed schulschrift -> SCHULFONT,
*            fixed placecards of different cards ending up in the same children list.
* 2026-08-09: Adjust divomath functions to new json serialization pipeline
************************************************************************************************/

// Zahlenkarten
if(VAM == "numbercards",


// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //
//
// NOTE: no regional() here on purpose. These values are read from class methods,
// which do not run in the init script's scope - a regional declaration would make
// them invisible there. The apostrophe marks them as explicitly global.

'numberofcards				= default to(ENVIRONMENTALPARAMS:"cards", 1, true); // no. of cards to create
'cardpositionsx				= default to(ENVIRONMENTALPARAMS:"x", apply(1..'numberofcards, 10*#-7), true);
'cardpositionsy				= default to(ENVIRONMENTALPARAMS:"y", apply(1..'numberofcards, 16), true);
'cardvalues						= default to(ENVIRONMENTALPARAMS:"value", apply(1..'numberofcards, 1234), true);

// Force lists - a single card may arrive as a plain value
if(!islist('cardpositionsx), 'cardpositionsx = ['cardpositionsx]);
if(!islist('cardpositionsy), 'cardpositionsy = ['cardpositionsy]);
if(!islist('cardvalues),     'cardvalues     = ['cardvalues]);
'cardpositionsx = apply('cardpositionsx, if(isstring(#), parse(#), #));
'cardpositionsy = apply('cardpositionsy, if(isstring(#), parse(#), #));
'cardvalues     = apply('cardvalues,     if(isstring(#), parse(#), #));

// --- Look and feel ---
'showincolor					= default to(ENVIRONMENTALPARAMS:"color", true, true); // show cards in color
'showcolortoggle			= default to(ENVIRONMENTALPARAMS:"colortoggle", true, true); // show color toggle btn
'unfoldedalpha				= default to(ENVIRONMENTALPARAMS:"alpha", .2, true); // alpha of an unfolded Numbercard
'thousandsseparator		= default to(ENVIRONMENTALPARAMS:"separator", "", false); // separator between groups of 3 digits

'unfoldedatstart			= default to(ENVIRONMENTALPARAMS:"unfold", apply(1..'numberofcards, true), true);
if(!islist('unfoldedatstart), 'unfoldedatstart = ['unfoldedatstart]);

// Normalize booleans (divomath reports back "" instead of false)
'showincolor = tobool('showincolor);
'showcolortoggle = tobool('showcolortoggle);
'unfoldedatstart = apply('unfoldedatstart, tobool(#));

// --- Which place value of every card is editable ---
// Configured as strings of "t"/"f", e.g. ["ttt", "ftf"], read right to left.
// "@else" means: everything editable, derived from the length of the card values.
'editableasstring			= default to(ENVIRONMENTALPARAMS:"edit", "@else", false);
if('editableasstring != "@else" & !islist('editableasstring), 'editableasstring = ['editableasstring]);

'editableplaces = []; // resulting array like [[true, true, true], [false, true, false]]

if('editableasstring != "@else", // Config by divomath
	forall('editableasstring, str, // loop over every raw string like "ffttft"
		regional(entry);
		entry = [];
		repeat(length(str), // loop over every char, in reverse order (-#)
			entry = entry :> if(str_(-#) == "t", true, false);
		);
		'editableplaces = 'editableplaces :> entry;
	);
, // else: all trues, based on the number of digits of each value
	'editableplaces = apply('cardvalues, apply(1..length(text(#)), true));
	'editableasstring = [];
	forall('editableplaces, state,
		// ...and store the corresponding string (e.g. "tfttf")
		'editableasstring = 'editableasstring :> "";
		forall(state, 'editableasstring_(-1) = 'editableasstring_(-1) + if(#, "t", "f"));
	);
);

// Number of digits per card. NOT CONFIGURABLE - derived from "edit".
// NOTE: this is a LIST, one entry per card. It used to be overwritten by a scalar
// further down (max(...)), which broke the per card lookup.
'maxplaces = apply('editableplaces, length(#));


// ------------------------------------------------------------------ //
// Result handling: overwrite the divomath hooks for this VAM          //
// ------------------------------------------------------------------ //

divomath update results() := if(ISDIVOMATH,
	divomath clear results();

	regional(cards, cardnr, placevaluenames);
	placevaluenames = ["E","Z","H","T","ZT","HT","M","ZM","HM"];

	// Select the cards explicitly instead of guessing from the end of "obj"
	cards = select(obj, #:"type" == "numbercard");
	cardnr = 1; // for naming results of multiple cards

	forall(cards, card,
		// Add number value as a whole
		divomath put result("nc" + cardnr, card:"value");

		// Add individual place values by hand.
		// (Can't be done with children, might not have any)
		regional(remainder, digit, place);
		remainder = card:"value";
		place = 1;
		while(remainder > 0,
			digit = mod(remainder, 10);
			remainder = floor(remainder/10);

			// Use a numerical indicator for places beyond the named ones
			divomath put result("nc" + cardnr + "_" + if(
				!isundefined(placevaluenames_place),
				placevaluenames_place,
				place
			), digit);

			place = place + 1;
		);

		// Add result, if numbercard is folded
		divomath put result("nc" + cardnr + "_unfolded", card:"expanded");

		cardnr = cardnr + 1;
	);

	// Export state as results as well, for forward referencing
	regional(dmstate);
	dmstate = divomath set state();
	forall(keys(dmstate), divomath put result(#, dmstate:#));

	// Post results
	divomath post results();
);

divomath set state() := (
	regional(cards, state);
	cards = select(obj, #:"type" == "numbercard");

	state = {
		"cards"       : length(cards),                  // Record numofcards
		"x"           : apply(cards, #:"coord"_1),      // Record xcoords
		"y"           : apply(cards, #:"coord"_2),      // Record ycoords
		"value"       : apply(cards, #:"value"),        // Record values
		"edit"        : 'editableasstring,    					// Record editable status per card
		"unfold"      : apply(cards, #:"expanded"),     // Record fold/unfold status
		"color"       : 'showincolor,                   // Record colored/uncolored status
		"colortoggle" : 'showcolortoggle,               // Record button drawing status
		"alpha"       : 'unfoldedalpha,                 // Record cards alpha
		"separator"   : 'thousandsseparator             // cards separator character
	};

	state;
);


// ===================== //
// C | Class Definitions //
// ===================== //

// C.1 | Placecard
new Placecard(c, initialvalue, maxplaces) := (
	regional(o);
	o = new VAMobject("placecard");
	o:"coord"				= c;
	o:"maxplaces"		= maxplaces;
	o:"width"				= maxplaces;
	o:"height"			= 1;
	o:"value"				= initialvalue;
	o:"color"				= MONTEGREY;
	o:"bgcolor"			= MONTEGREY;
	o:"mix"					= 0;
	o:"edit"				= false;
	o:"ismoveable"	= false;
	o:"downbutton"	= {"center": [-10,-10], "radius": 0};
	o:"upbutton"		= {"center": [-10,-10], "radius": 0};

	o:"ishot" := or(
		dist(my("upbutton"):"center", mouse().xy) < my("upbutton"):"radius",
		dist(my("downbutton"):"center", mouse().xy) < my("downbutton"):"radius"
	);

	o:"shape" := rectangle(my("coord"), my("width"), my("height"));

	o:"draw" := (
		// For nonzero place card
		if(my("value") > 0,
			// Draw the box
			fillpoly(my("shape"), color->(1-my("mix"))*my("bgcolor") + my("mix")*my("color"));
			drawpoly(my("shape"), color->grey(0));

			// Draw card text
			regional(ps);
			ps = pixelsize("0", size->screenresolution(), family->SCHULFONT);

			repeat(my("maxplaces"),
				// Draw digit
				drawtext(
					my("coord") + (
						my("maxplaces") - # + .5 - 2*floor((#-1)/3)/ps_1, // adjust x
						(ps_3) / 4 / screenresolution()                   // adjust y
					),
					if(# == my("maxplaces"), my("value"), "0"),
					align->"center",
					size->screenresolution(),
					family->SCHULFONT
				);

				// Draw separator
				if(mod(#,3) == 0 & # < my("maxplaces"),
					drawtext(
						my("coord") + (
							my("maxplaces") - # - .15,      // adjust x
							(ps_3) / 4 / screenresolution() // adjust y
						),
						'thousandsseparator,
						align->"center",
						size->screenresolution(),
						family->SCHULFONT
					);
				);
			);
		, // else draw empty rectangle if unfolded
			if(my("parent"):"expanded",
				drawpoly(my("shape"), size->2, color->(1-my("mix"))*my("bgcolor") + my("mix")*my("color"));
			);
		);

		// Draw + and - buttons
		regional(circ);
		if(my("edit"),
			if(my("value") < 9, // can become more
				self():"upbutton" = {
					"center": my("coord") + [my("width") + 2*my("height"), my("height")/2],
					"radius": my("height")/2
				};
				circ = my("upbutton");

				fillcircle(circ:"center", circ:"radius", color->DIVOBLUE);
				drawtext(
					circ:"center" - [circ:"radius", circ:"radius"] + [.54,.1],
					"+",
					color->MONTEGREY,
					size->screenresolution(),
					align->"center"
				);
			, // inner else
				self():"upbutton" = {"center": [-10,-10], "radius": 0};
			);

			if(my("value") > 0, // can become less
				self():"downbutton" = {
					"center": my("coord") + [my("width") + my("height") - 0.2, my("height")/2],
					"radius": my("height")/2
				};
				circ = my("downbutton");

				fillcircle(circ:"center", circ:"radius", color->DIVOBLUE);
				drawtext(
					circ:"center" - [circ:"radius", circ:"radius"] + [.54,.22],
					"-",
					color->MONTEGREY,
					size->screenresolution(),
					align->"center"
				);
			, // inner else
				self():"downbutton" = {"center": [-10,-10], "radius": 0};
			);
		);

		// Debug Draw
		if(LOGLEVEL > 0,
			draw(my("shape"));
			draw(my("coord"));
		);
	);

	o:"click" := (
		if(dist(my("downbutton"):"center", mouse().xy) < my("downbutton"):"radius",
			self():"value" = my("value") - 1;
			my("parent"):"value" = my("parent"):"value" - 10^(my("maxplaces")-1);
		);
		if(dist(my("upbutton"):"center", mouse().xy) < my("upbutton"):"radius",
			self():"value" = my("value") + 1;
			my("parent"):"value" = my("parent"):"value" + 10^(my("maxplaces")-1);
		);
	);

	o; // Return placecard.
);

// C.2 | Numbercard
new Numbercard(c, initialvalue, maxplaces, editable) := (
	regional(o);
	o = new VAMobject("numbercard");
	o:"coord"						= c;
	o:"maxplaces"				= maxplaces;
	o:"width"						= maxplaces;
	o:"height"					= 1;
	o:"editable"				= editable; // bool array of editable placecards
	o:"value"						= initialvalue;
	o:"expanded"				= false;
	o:"children"				= [];
	o:"alpha"						= 1;
	o:"offset"					= 1;
	o:"fadetime"				= 3/5;
	o:"foldtime"				= 5/5;
	o:"color"						= MONTEGREY;
	o:"fadealpha"				= 'unfoldedalpha;
	o:"ismoveable"			= false;
	o:"montessori"			= 'showincolor;
	o:"showtogglemonte"	= 'showcolortoggle;

	o:"hitbox" := rectangle(
		my("coord") - 2*(1.4,0),
		2*1.4 + my("maxplaces"),
		my("height")
	);

	o:"ishot" := or(
		inrectangle(my("hitbox"), mouse().xy),
		listor(apply(my("children"), #:"ishot"))
	);

	o:"shape" := rectangle(my("coord"), my("width"), my("height"));

	o:"draw" := (
		regional(value, dodraw, ps);

		// Draw the card
		fillpoly(my("shape"), color->my("color"), alpha->my("alpha"));
		drawpoly(my("shape"), size->2, color->grey(0), alpha->my("alpha"));

		// Draw the value
		value = my("value");
		dodraw = true;
		ps = pixelsize("0", size->screenresolution(), family->SCHULFONT);

		repeat(my("maxplaces"),
			if(dodraw,
				drawtext(
					my("coord") + (
						my("maxplaces") - # + .5 - 2*floor((#-1)/3)/ps_1,
						(ps_3)/4/screenresolution()
					),
					mod(value,10),
					align->"center",
					size->screenresolution(),
					family->SCHULFONT,
					alpha->my("alpha")
				);

				// Draw separator
				if(mod(#,3) == 0 & # < my("maxplaces"),
					drawtext(
						my("coord") + (
							my("maxplaces") - # - .15,      // adjust x
							(ps_3) / 4 / screenresolution() // adjust y
						),
						'thousandsseparator,
						align->"center",
						size->screenresolution(),
						family->SCHULFONT,
						alpha->my("alpha")
					);
				);
			);
			value = floor(value/10);
			dodraw = (value > 0);
		);

		// Unfold Button
		// NOTE: locals are called "linesize"/"rectcolor" - "size" would shadow the
		// size-> modifier, and the old code declared "rectcol" but assigned "rectcolor".
		regional(rect, linesize, rectcolor, barcolor, offset);
		offset = (1.4,0);
		rect = roundedrectangle(my("coord") - offset, 1, my("height"), .1);
		linesize = 2;
		rectcolor = DIVOBLUE;
		barcolor = MONTEGREY;

		draw(rect, color->rectcolor, size->linesize);
		fill(rect, color->rectcolor);
		repeat(if(my("expanded"), 1, 4), // Draw burger-like lines to display "unfold"
			fillpoly(rectangle(
				my("coord") + (-offset_1 - 0.1 + .2*#, -.05 + .2*(5-#)),
				(5-#)*.2, .1
			), color->barcolor);
		);

		forall(my("children"), #:"draw");

		// Color Button
		if(my("showtogglemonte"),
			regional(togglerect, circ0, circ1, circ2);
			togglerect = roundedrectangle(my("coord") - 2*offset, 1, my("height"), .1); // border
			circ0 = circle(my("coord") - 2*offset + [1,0], 2);  // outer circle
			circ1 = circle(my("coord") - 2*offset + [1,0], 1);  // middle circle
			circ2 = circle(my("coord") - 2*offset + [1,0], .5); // inner circle

			if(!my("montessori"), // Colorful button
				fill(togglerect~~circ0, color->MONTEBLUE);
				fill(togglerect~~circ1, color->MONTERED);
				fill(togglerect~~circ2, color->MONTEGREEN);
			, // Grey button
				fill(togglerect~~circ0, color->grey(.9));
				fill(togglerect~~circ1, color->grey(.6));
				fill(togglerect~~circ2, color->grey(.3));
			);
			draw(togglerect, color->DIVOBLUE, size->linesize);
		);

		// DEBUG DRAW
		if(LOGLEVEL > 0,
			drawpoly(my("hitbox"));
			draw(my("hitbox")_1, color->[1,0,0]);
			draw(my("coord"));
		);
	);

	o:"move" := if(my("ismoveable"), self():"coord" = coord);

	o:"active" := inrectangle( // If condition in o:"click"
		rectangle(
			my("coord") - (1.4,0),
			2 + my("maxplaces"),
			my("height")
		),
		mouse().xy
	);

	o:"colortoggle" := if(my("showtogglemonte"),
		regional(offset);
		offset = (1.4,0);
		inrectangle(
			rectangle(my("coord") - 2*offset, 1, my("height")),
			mouse().xy
		);
	);

	o:"click" := (
		if(my("active"), // Fold / Unfold action
			regional(children, pc, offset, fadetime, foldtime);
			fadetime = my("fadetime");
			foldtime = my("foldtime");
			children = [];

			self():"expanded" = if(my("expanded"),
				// --- fold ---
				forall(my("children"), child,
					child:"edit" = false;
					new animationobject(
						child, "coord",
						child:"coord",
						my("coord") + (my("maxplaces") - child:"maxplaces", 0),
						foldtime, "accel"
					);
					new animationobjectwithdelay(
						child, "mix",
						1,
						1, // should be 0 for animation
						fadetime, "accel", foldtime
					);
				);
				false // set my("expanded")
			, // --- unfold ---
				regional(val);
				val = my("value");
				repeat(my("maxplaces"), place,
					// A card is created for every place, so empty slots stay visible
					offset = (
						my("maxplaces") - place,
						1.2*(place - my("offset") - my("maxplaces"))
					);
					pc = new Placecard(
						my("coord") + (my("maxplaces") - place, 0),
						mod(val,10), place
					);
					pc:"parent" = self();
					pc:"color" = if(my("montessori"), // colorful
						MONTEPALETTE_(mod(place-1,3) + 1)
					, // else grey
						MONTEGREY
					);
					new animationobjectwithdelay(
						pc, "coord",
						my("coord") + (my("maxplaces") - place, 0),
						my("coord") + offset,
						foldtime, "accel", fadetime
					);
					new animationobject(
						pc, "mix",
						1, // should be 0 for animation
						1,
						fadetime, "accel"
					);
					setpropertylater(pc, "edit", my("editable")_place, foldtime + foldtime);

					children = [pc] ++ children;
					val = floor(val/10);
				); // end repeat
				self():"children" = children;
				true; // set my("expanded")
			); // end if(my("expanded"))
		); // end "active"-if

		// Check if Color-Button has been clicked
		if(my("colortoggle"),
			self():"montessori" = !my("montessori");
			// Change color attribute of children accordingly
			forall(my("children"),
				#:"color" = if(my("montessori"), // colorful
					MONTEPALETTE_(mod(#:"maxplaces"-1, 3) + 1)
				, // else grey
					MONTEGREY
				);
			);
		);

		// handle click on children
		forall(my("children"), if(#:"ishot", #:"click"));

		// Send results/state to divomath
		divomath update results();
	);

	o:"getaction" := if(
		inrectangle(
			rectangle(my("coord") - (2,0), 2 + my("maxplaces"), my("height")),
			mouse().xy
		),
		"move",
		"adjust"
	);

	o; // Return numbercard.
);


// ================== //
// D | Initialization //
// ================== //

// D.1 | Build card templates based on config
// ==========================================
'cardtemplates = [];
repeat('numberofcards,
	'cardtemplates = 'cardtemplates :> {
		"c"      : ['cardpositionsx_#, 'cardpositionsy_#],
		"val"    : 'cardvalues_#,
		"max"    : 'maxplaces_#,
		"edit"   : 'editableplaces_#,
		"unfold" : 'unfoldedatstart_#
	};
);

// D.2 | Init numbercards
// ======================
forall('cardtemplates, card,
	regional(thing, children, val, offset, pc);

	thing = new Numbercard( // Create card based on configured array.
		card:"c",
		card:"val",
		card:"max",
		card:"edit"
	);

	// Build Placecards for every card.
	// NOTE: "children" is reset per card - it used to be a global that kept
	// accumulating, so later cards inherited the placecards of earlier ones.
	children = [];
	val = thing:"value";
	repeat(thing:"maxplaces", place,
		offset = if(card:"unfold",
			(thing:"maxplaces" - place, 1.2*(place - thing:"offset" - thing:"maxplaces")),
			(thing:"maxplaces" - place, 0)
		);
		pc = new Placecard( // least significant first
			thing:"coord" + (thing:"maxplaces" - place, 0),
			mod(val,10), place
		);

		pc:"parent" = thing;
		pc:"color" = if(thing:"montessori", // colorful
			MONTEPALETTE_(mod(place-1,3) + 1)
		, // else grey
			MONTEGREY
		);
		pc:"coord" = thing:"coord" + offset;
		pc:"mix" = 1;
		pc:"edit" = if(card:"unfold", thing:"editable"_place, false);

		children = [pc] ++ children;
		val = floor(val/10); // next value
	); // end repeat

	thing:"alpha" = 'unfoldedalpha;
	thing:"fadealpha" = 'unfoldedalpha;
	thing:"children" = children;
	thing:"expanded" = card:"unfold";

	obj = obj :> thing; // Add card to obj list.
);

); // End VAM-if
//[VAM] percentagebar
/** v19 *****************************************************************************************
*
* Recent changes:
* 2026-06-20: Fix breaking ifs from CindyJS 0.8.45 update.
* 2026-07-24: Fix "100 %" label not showing when arches are ative.
* 2026-07-24: Change "fix buttons" icon to a lock.
* 2026-07-25: Change drawing behavior of ticks and arches. Now depends on (one of the) step toggles being active.
* 2026-07-25: Introduce barpadding as a parameter instead of fixed value of 1.5
* 2026-07-25: Change default barwidth to 25.
* 2026-07-25: Change wording of some toggle labels.
* 2026-07-25: Add parameter "showbuttons" for showing/hiding UI toggles (default: true)
* 2026-07-25: Fix snapbar only acting on last bar
* 2026-07-25: Fix overflow inconsistency for pluspercentage button script
* 2026-07-27: Unify web controls for configuration
* 2026-07-27: Change barposition and barwidth to autoadjust if not otherwise specified
* 2026-07-27: Fix snapbar behavior
* 2026-07-27: Fix random other stuff
* 2026-08-07: Draw plus and minus Buttons without symbol, but with geometry
************************************************************************************************/


// Prozenstreifen
if(VAM == "percentagebar",


// ================= //
// A | Documentation //
// ================= //
//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

barprecision					= default to(ENVIRONMENTALPARAMS:"barprecision", .01, true); 
barposition 					= default to(ENVIRONMENTALPARAMS:"barposition", NADA, true); 
barwidth 							= default to(ENVIRONMENTALPARAMS:"barwidth", NADA, true); 
barheight 						= default to(ENVIRONMENTALPARAMS:"barheight", 1.5, true); 
barpadding 						= default to(ENVIRONMENTALPARAMS:"barpadding", 2.5, true); 
barvalue 							= default to(ENVIRONMENTALPARAMS:"barvalue", 0, true); 
basevalue 						= default to(ENVIRONMENTALPARAMS:"basevalue", 1000, true);

subdivisions 					= default to(ENVIRONMENTALPARAMS:"subdivisions", 1, true);
unit 									= default to(ENVIRONMENTALPARAMS:"unit", "MB", false);
barcolor 							= default to(ENVIRONMENTALPARAMS:"barcolor", DZLMCOLORGOLD, true);
fontfamily 						= default to(ENVIRONMENTALPARAMS:"fontfamily", NADA, true);
leftoutpercentages		= default to(ENVIRONMENTALPARAMS:"leftoutpercentages", [], true);

leftoutvalues					= default to(ENVIRONMENTALPARAMS:"leftoutvalues", [], true);
custompercentages			= default to(ENVIRONMENTALPARAMS:"custompercentages", [], true);
customvalues					= default to(ENVIRONMENTALPARAMS:"customvalues", [], true);
scaffoldbasevalue			= default to(ENVIRONMENTALPARAMS:"scaffoldbasevalue", false, true);
scaffoldvalue					= default to(ENVIRONMENTALPARAMS:"scaffoldvalue", false, true);
scaffoldpercentage		= default to(ENVIRONMENTALPARAMS:"scaffoldpercentage", false, true);
isbardraggable				= default to(ENVIRONMENTALPARAMS:"isbardraggable", true, true);
alwaysdrawarches			= default to(ENVIRONMENTALPARAMS:"alwaysdrawarches", true, true); // Bögen von Anfang an zeichnen.
snapbar								= default to(ENVIRONMENTALPARAMS:"snapbar", false, true);
decimalspercentage		= default to(ENVIRONMENTALPARAMS:"decimalspercentage", 2, true);
decimalsvalue					= default to(ENVIRONMENTALPARAMS:"decimalsvalue", 2, true);
numberofbars					= default to(ENVIRONMENTALPARAMS:"numberofbars", 1, true);
keepstable						= default to(ENVIRONMENTALPARAMS:"keepstable", "basevalue", false);
showbuttons						= default to(ENVIRONMENTALPARAMS:"showbuttons", true, true);
overflow							= default to(ENVIRONMENTALPARAMS:"overflow", false, true);
hidetoggles						= default to(ENVIRONMENTALPARAMS:"hidetoggles", [], true);

if(isundefined(barposition),
	barposition = screenbounds()_1;
	barposition = barposition.xy;
	barposition_1 = barposition_1 + barpadding / 2;
	barposition_2 = barposition_2 - 1/3 * (VISIBLERECT_3_2 - VISIBLERECT_1_2) - .5 * barheight;
);

if(isundefined(barwidth),
	barwidth = VISIBLERECT_2_1 - VISIBLERECT_1_1;
	barwidth = barwidth - barpadding;
);

if(!contains(["basevalue", "value", "percentage"], keepstable),
	keepstable = "basevalue";
	error at("VAM percentagebar", "keepstable has to be one of 'basevalue', 'value' or 'percentage. Set to 'basevalue'.");
);

// ================ //
// Helper functions //
// ================ //

anystepsactive() := toggles:"showtf-div":"state"
	% toggles:"showtf-divpercentage":"state"
	% toggles:"showtf-divvalue":"state";


// ===================== //
// C | Class Definitions //
// ===================== //

/**
* C.1 | Percentagebar
* Main functionality of a bar, that is draggable in a certain area. Provides labels for different values
**/
new Percentagebar(coord, width, height, value, precision, divisions, baseval, unit) := (
	regional(o);
	o = new VAMobject("Percentagebar");
	
	// Look and feel
	o:"coord" = coord;
	o:"color" = barcolor;
	o:"width" = width;
	o:"height" = height;
	o:"margin" = .07; // margin of bar shape to surrounding box
	o:"precision" = precision; // precision of movement of bar (in [0,1])
	o:"fontsize" = 14;
	o:"fontfamily" = fontfamily; // set globally
	o:"labelpadding" = .2;
	o:"isclickable" = isbardraggable;
	o:"ismoveable" = isbardraggable;

	// Booleans for showing/hiding stuff, set manually after init
	o:"drawpercentagelabels" = NADA;
	o:"drawvaluelabels" = NADA;
	o:"drawbasevaluelabel" = NADA;
	o:"drawcurrentpercentage" = NADA;
	o:"drawcurrentvalue" = NADA;
	o:"drawarches" = NADA;
	o:"canoverflow" = NADA;
	o:"scaffoldvalue" = scaffoldvalue;
	o:"scaffoldpercentage" = scaffoldpercentage;
	o:"scaffoldbasevalue" = scaffoldbasevalue;
	o:"drawsteps" = NADA;

	// Handles for interface (textfields, buttons, toggles)
	o:"toggles" = NADA; // set at init
	o:"textfields" = NADA; // set at init
	o:"buttons" = NADA; // set at init

	// Values for Percentagebar
	o:"unit" = unit;
	o:"value" = value; // between 0 and 1
	o:"basevalue" = baseval;
	o:"divisions" = divisions; // determines ticks, gets updated via Textfield
	o:"ticks" := apply(1..my("divisions"), #/my("divisions"));
	o:"standardticks" = [0,1];
	
	// Shape & hitbox
	o:"box" = rectangle(coord-[o:"margin",o:"margin"], width+2*o:"margin", height+2*o:"margin");
	o:"shape" := roundedrectangle(my("coord"), my("value")*my("width"), my("height"), .1);
	o:"hitbox" := rectangle(my("coord"),my("width"),my("height"));

	o:"ishot" := inrectangle(my("hitbox"), mouse().xy);
	o:"isactive" = false; // for use with multiple bars. Controls which bar is targetted by toggle switch state changes (see "toggleactive")

	o:"draw" := (
		// Draw background box	
		fillpoly(my("box"), color->grey(.85));
		drawpoly(my("box"), color->grey(.2), size->if(my("isactive"),1.5,.5));

		// Draw actual draggable bar
		fill(my("shape"), color->my("color"), alpha->if(my("isactive"),1,.7));

		// Draw inbetween ticks
		regional(p1); // anchor point for vertical lines
		if(my("drawsteps"),
			forall(my("ticks") -- [1],
				p1 = my("coord") + [#,0]*my("width"); // Set bottom point for tick
				draw( // draw vertical line segment
					p1, p1 + [0,my("height")],
					size->2,
					color->DZLMCOLORBLUE
				); 
			);
		);

		// Draw standard ticks (left and right by default)
		forall(my("standardticks"),
			p1 = my("coord") + [#,0]*my("width"); // Set bottom point for tick
			draw( // draw vertical line segment
				p1, p1 + [0,my("height")],
				size->.1,
				color->grey(.1)
			); 
		);

		// Draw custompercentages & customvalues
		forall(custompercentages ++ customvalues,
			p1 = my("coord") + [#,0]*my("width"); // Set bottom point for tick
			draw( // draw vertical line segment
				p1, p1 + [0,my("height")],
				size->2,
				color->grey(.0)
			); 
		);

		// Draw labels for percentages and corresponding values
		regional(size, font, label, text, box, position, xoffset, yoffset);
		size = my("fontsize");
		family = my("fontfamily");
		
		// Draw percentage labels
		if(my("drawpercentagelabels"),
			yoffset = my("height")+my("labelpadding"); // move up by the height of the bar
			forall(my("ticks") ++ my("standardticks") -- leftoutpercentages,
				if(my("drawarches"),
					if((my("value") >= #) % ((# == 1) & my("drawbasevaluelabel")),
						text = format(100*#, decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
						box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
						xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
						position = my("coord") + [xoffset, yoffset]; // actual position
			
						// Draw arches
						if(my("drawarches"), eval(my("drawpercentagearches"), yoffset->yoffset+box_4_2-box_1_2));
		
						// Draw labels
						drawtext(position, text, size->size, font->family, color->grey(.2));
					);
				,
					text = format(100*#, decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
					box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
					xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
					position = my("coord") + [xoffset, yoffset]; // actual position
	
					// Draw arches
					//if(my("drawarches"), eval(my("drawpercentagearches"), yoffset->yoffset+box_4_2-box_1_2));
	
					// Draw labels
					drawtext(position, text, size->size, font->family, color->grey(.2));
				);
			);
		);

		// Draw value labels
		if(my("drawvaluelabels"),
			forall(my("ticks") ++ my("standardticks") -- leftoutvalues,
				if(my("drawarches"),
					if(my("value") >= # ,
						text = format(#*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
						box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
						xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
						yoffset = -(box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
						position = my("coord") + [xoffset, yoffset]; // actual position

						// Draw arches
						if(my("drawarches"), eval(my("drawvaluearches"), yoffset->yoffset-my("labelpadding")));

						// Draw
						if(# != 1, // exclude drawing of base value label
							drawtext(position, text, size->size, font->family, color->grey(.2));
						);
					);
				,
					text = format(#*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
					box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
					xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
					yoffset = -(box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
					position = my("coord") + [xoffset, yoffset]; // actual position
	
					// Draw arches
					//if(my("drawarches"), eval(my("drawvaluearches"), yoffset->yoffset-my("labelpadding")));
	
					// Draw
					if(# != 1, // exclude drawing of base value label
						drawtext(position, text, size->size, font->family, color->grey(.2));
					);
				);
			);
		);

		// Draw arches
		if(my("drawarches") & my("drawsteps"),
			regional(dy);
			dy = getboundingbox(A, [0,0], size, family)_3_2; // height of textboxes for offset
			eval(my("drawvaluearches"), yoffset->-dy-2*my("labelpadding"));
			eval(my("drawpercentagearches"), yoffset->my("height")+dy+my("labelpadding"));
		);


		// Draw basevalue label
		if(my("drawbasevaluelabel"),
			text = format(my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
			box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
			xoffset = my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
			yoffset = -(box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
			position = my("coord") + [xoffset, yoffset]; // actual position
			
			// Draw
			drawtext(position, text, size->size, font->family, color->grey(.2));

				// Draw scaffold overlay for base value
				if(my("scaffoldbasevalue"),
					regional(scaffoldbox);
					scaffoldbox = roundedrectangle(position, box_2_1-box_1_1, box_4_2-box_1_2, .05);
					draw(scaffoldbox, color -> grey(.5));
					fill(scaffoldbox, color -> grey(.9));
			);
		);

		// Draw labels for custom percenteges
		yoffset = my("height")+my("labelpadding"); // move up by the height of the bar
		forall(custompercentages,
			text = format(100*#, decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
			box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
			xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
			position = my("coord") + [xoffset, yoffset]; // actual position
		
		// Draw labels
			drawtext(position, text, size->size, font->family, color->grey(.0));
		 
		);

		// Draw labels for custom values
		forall(customvalues,
			text = format(#*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
			box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
			xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
			yoffset = - (box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
			position = my("coord") + [xoffset, yoffset]; // actual position

			// Draw
			drawtext(position, text, size->size, font->family, color->grey(.0));
		
		);

		// Draw labels for current percentage
		if(my("drawcurrentpercentage"),
			text = format(100*my("value"), decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
			box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
			position = my("coord") + [ // actual position, start at bar coord
				my("value")*my("width") - .5*(box_2_1-box_1_1), // move to vertical line and adjust by half the texts length
				my("height")+my("labelpadding") // move up by the height of the bar
			];

			// Draw
			drawtextbox(position, text, size, family, grey(1), bold->true);

			// Draw scaffold overlay for percentage
			if(my("scaffoldpercentage"),
				regional(scaffoldbox);
				scaffoldbox = roundedrectangle(position, box_2_1-box_1_1, box_4_2-box_1_2, .05);
				draw(scaffoldbox, color -> grey(.5));
				fill(scaffoldbox, color -> grey(.9));
			);
		);

		// Draw current value
		if(my("drawcurrentvalue"),
			text = format(my("value")*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
			box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
			position = my("coord") + [ // actual position, start at bar coord
				my("value")*my("width") - .5*(box_2_1-box_1_1), // move to vertical line and adjust by half the texts length
				- (box_3_2-box_2_2) - my("labelpadding") // move down by the height of the text
			];

			// Draw
			drawtextbox(position, text, size, family, grey(1), bold->true);

			// Draw scaffold overlay for percentage
			if(my("scaffoldvalue"),
				regional(scaffoldbox);
				scaffoldbox = roundedrectangle(position, box_2_1-box_1_1, box_4_2-box_1_2, .05);
				draw(scaffoldbox, color -> grey(.5));
				fill(scaffoldbox, color -> grey(.9));
			);

		);

		// Debug draw
		if(LOGLEVEL > 0, drawtext(my("coord")+[0.3,0],my("value")));
		if(LOGLEVEL > 0, draw(my("coord")));
		if(LOGLEVEL > 1, drawpoly(my("hitbox"), color->[0,1,0]));
	);

	o:"drawpercentagearches" := ( // helper for drawing percentage arches (in "draw"), gets evaled with yoffset
		regional(ticks, width, height, todraw);

		if(isundefined(yoffset),yoffset=0);
		ticks = 0 <: my("ticks") :> 1; // ticks with start (0) and end value (1) added
		width = my("width") / my("divisions"); // ellipses width / major axis
		height = width / PHI; // ellipses height / minor axis

		// go through all ticks and draw arch if required
		forall(2..length(ticks)-1,
			todraw = my("value") >= ticks_#; //checks for current tick, if value is bigger
			if(todraw,
				connect(
					ellipse(my("coord") + [(#-1.5)*width, yoffset],	width/2, height/2, 0, PI),
					color->my("color")
				);
			);
		);
	);
	
	o:"drawvaluearches" := ( // helper for drawing value arches (in "draw"), gets evaled with yoffset
		regional(ticks, width, height, todraw);

		if(isundefined(yoffset),yoffset=0);
		ticks = 0 <: my("ticks") :> 1; // ticks with start (0) and end value (1) added
		width = my("width") / my("divisions"); // ellipses width / major axis
		height = width / PHI; // ellipses height / minor axis

		// go through all ticks and draw arch if required
		forall(2..length(ticks)-1,
			todraw = my("value") >= ticks_#; //checks for current tick, if value is bigger
			if(todraw,
				connect(
					ellipse(my("coord") + [(#-1.5)*width, yoffset],	width/2, height/2, PI, 2*PI),
					color->my("color")
				);
			);
		);
	);

	o:"toggleactive" := (
		// Deactivate all other bars
		regional(otherbars);
		otherbars = select(obj,#:"type"=="Percentagebar") -- [self()];
		forall(otherbars, #:"setinactive");
		
		// Set self to active
		my("setactive");
	);

	o:"setactive" := (
		if(toggles:"percentage":"state" != self():"drawcurrentpercentage", toggles:"percentage":"click");
		if(toggles:"part":"state" != self():"drawcurrentvalue", toggles:"part":"click");
		if(toggles:"basevalue":"state" != self():"drawbasevaluelabel", toggles:"basevalue":"click");
		if(toggles:"parts":"state" != self():"drawvaluelabels", toggles:"parts":"click");
		if(toggles:"percentages":"state" != self():"drawpercentagelabels", toggles:"percentages":"click");
		if(toggles:"arch":"state" != self():"drawarches", toggles:"arch":"click");
		if(toggles:"overflow":"state" != self():"canoverflow", toggles:"overflow":"click");
		
		self():"drawcurrentpercentage"	:= toggles:"percentage":"state";
		self():"drawcurrentvalue"				:= toggles:"part":"state";
		self():"drawbasevaluelabel"			:= toggles:"basevalue":"state";
		self():"drawvaluelabels"				:= toggles:"parts":"state";
		self():"drawpercentagelabels"		:= toggles:"percentages":"state";
		self():"drawarches"							:= toggles:"arch":"state";
		self():"canoverflow"						:= toggles:"overflow":"state";
		self():"drawsteps" 							:= anystepsactive();

		textfields:"divisions":"value" = my("divisions") + "";
		textfields:"divisions-value":"value" =  my("basevalue")/my("divisions") + "";
		textfields:"divisions-percentage":"value" =  100/my("divisions") + "";
		textfields:"basevalue":"value" = my("basevalue") + "";
		textfields:"value":"value" = my("value") * my("basevalue")+ "";
		textfields:"percentage":"value" = 100 * my("value") + "";
		'generictextfieldhandle = self();
		
		self():"isactive" = true;
	);
	o:"setinactive" := (
		if(my("isactive"),
			self():"drawcurrentpercentage"	= toggles:"percentage":"state";
			self():"drawcurrentvalue"				= toggles:"part":"state";
			self():"drawbasevaluelabel"			= toggles:"basevalue":"state";
			self():"drawvaluelabels"				= toggles:"parts":"state";
			self():"drawpercentagelabels"		= toggles:"percentages":"state";
			self():"drawarches"							= toggles:"arch":"state";
			self():"canoverflow"						= toggles:"overflow":"state";
			self():"drawsteps" 							= anystepsactive();
		);
		
		self():"isactive" = false;
	);

	o:"move" := if(my("ismoveable"),
		// Set current bar to active and deactivate all other bars
		if(!my("isactive"), my("toggleactive"));

		my("setvalue");

		// Set percentage tf accordingly
		my("textfields"):"percentage":"value" = 100 * my("value") + "";

		// Set value tf accordingly
		my("textfields"):"value":"value" = my("basevalue") * my("value") + "";
	);

	o:"moveend" := if(my("ismoveable"),		
		// Set current bar to active and deactivate all other bars
		my("toggleactive");

		// Send updated value to SL
		post value("percentagevalue", my("value"), MSGTOKEN);
	);

	o:"click" := if(my("isclickable"),
		my("setvalue");
	);
	
	o:"setvalue" := (
		// Set value according to mouse coords
		self():"value" = (mouse().xy - my("coord"))_1 / my("width");
		
		// Cut of properly
		if(!my("canoverflow"), // cap at 100% and 0%
			self():"value" = min(max(my("value"),0),1);
		,	// else: cap only at 0%
			self():"value" = max(my("value"),0);
		);

		// Round according to given precision
		self():"value" = my("precision") * round(my("value")/my("precision"));
	);

	o:"setTicks" := if(false,
		regional(newTicks);
		newTicks=[];
		repeat(my("divisions")-1,i,
				newTicks = newTicks:>i/(my("divisions"));
		);
		self():"ticks" = newTicks;
	);

	o; // Return the object.
);


// ================== //
// D | Initialization //
// ================== //

// D.1 | Init Toggle Switches
// new Toggle(coord,width,state,label,fontsize)
// ============================================
regional(screen, togglepad, marginy, togglesize);
screen = apply(screenbounds(), #.xy);
togglepad = .5;
togglesize = 1.5;
marginy = 1;
toggles = {
	// COL 1
	"percentage"	:	new Toggle(screen_4 + [togglepad,togglepad+marginy+4*togglesize*.8], togglesize, false, "Anteil", 14),
	"part"				: new Toggle(screen_4 + [togglepad,togglepad+marginy+3*togglesize*.8], togglesize, false, "Teil", 14),
	"basevalue"		: new Toggle(screen_4 + [togglepad,togglepad+marginy+2*togglesize*.8], togglesize, false, "Ganzes", 14),
	"parts"				:	new Toggle(screen_4 + [togglepad,togglepad+marginy+1*togglesize*.8], togglesize, false, "Werte unten", 14),
	"percentages" : new Toggle(screen_4 + [togglepad,togglepad+marginy+0*togglesize*.8], togglesize, false, "Prozente oben", 14),
	// COL 2
	"arch"									: new Toggle(screen_4 + [togglepad+7,togglepad+marginy+4*togglesize*.8], togglesize, alwaysdrawarches, "Bögen", 14),
	"showtf-div"						: new Toggle(screen_4 + [togglepad+7,togglepad+marginy+3*togglesize*.8], togglesize, alwaysdrawarches, "Anzahl der Schritte:", 14),
	"showtf-divpercentage"	: new Toggle(screen_4 + [togglepad+7,togglepad+marginy+2*togglesize*.8], togglesize, false, "Größe des Schritts in %:", 14),
	"showtf-divvalue"				: new Toggle(screen_4 + [togglepad+7,togglepad+marginy+1*togglesize*.8], togglesize, false, "Größe des Schritts", 14),
	// COL 3
	"showtf-perc"	: new Toggle(screen_4 + [togglepad+21,togglepad+marginy+3*togglesize*.8], togglesize, false, "Eingabe Anteil", 14),
	"showtf-value": new Toggle(screen_4 + [togglepad+21,togglepad+marginy+2*togglesize*.8], togglesize, false, "Eingabe Teil", 14),
	"showtf-base"	: new Toggle(screen_4 + [togglepad+21,togglepad+marginy+1*togglesize*.8], togglesize, false, "Eingabe Ganzes", 14),
	"overflow"		: new Toggle(screen_4 + [togglepad+21,togglepad+marginy+0*togglesize*.8], togglesize, overflow, "Overflow", 14)
};

toggles:"showtf-divvalue":"label" = toggles:"showtf-divvalue":"label" + if(unit=="",":", " in " + unit + ":");

// D.2 | Init Text Inputs for (sub)divisions and base value
// =======================================================
regional(textfieldoffset);
textfieldoffset = [9.5,0];

textfields = {
	// COL 1
	"divisions"							:	new TextInput(toggles:"showtf-div":"coord" + textfieldoffset, "", "numeric"),
	"divisions-percentage" 	: new TextInput(toggles:"showtf-divpercentage":"coord" + textfieldoffset, "", "numeric"),
	"divisions-value" 			: new TextInput(toggles:"showtf-divvalue":"coord" + textfieldoffset, "", "numeric"),
	// COL 2
	"percentage" 						: new TextInput(toggles:"showtf-perc":"coord" + .85*textfieldoffset, "", "numeric"),
	"value" 								: new TextInput(toggles:"showtf-value":"coord" + .85*textfieldoffset, "", "numeric"),
	"basevalue" 						: new TextInput(toggles:"showtf-base":"coord" + .85*textfieldoffset, "", "numeric")
};

'generictextfieldhandle = bar;
'generickeyboardcoord = (screenbounds()_3).xy - [7, -12];
'generickeyboardoffset = [0,0];
'genericcleanupfunction := (
	regional(othertextfields);
	othertextfields = values(textfields) -- [self()];

	self():"drawborder" = if(isundefined(my("keyboard")), false, true);

	forall(othertextfields, tf,
		obj = obj -- [tf:"keyboard"];
		tf:"keyboard" = NADA;
		tf:"drawborder" = false;
	);	
);

apply(textfields,
	#:"handle" := 'generictextfieldhandle; // Pointer to the bar to alter
	#:"keyboardcoord" = 'generickeyboardcoord;
	#:"keyboardoffset" = 'generickeyboardoffset;
	#:"customclickscript" := 'genericcleanupfunction; // setup so only exactly one keyboard is shown
);

// Config subdivisions tf -- COL 2.1
textfields:"divisions":"value" =  subdivisions + ""; // Textinput value needs to be string
textfields:"divisions":"onupdate" := (
	my("handle"):"divisions" = parse(my("value"));
	obj = obj -- [my("keyboard")];
	self():"keyboard" = NADA;
	// Update other relevant tfs
	textfields:"divisions-value":"value" = if(parse(my("value")) != 0,
		my("handle"):"basevalue"/parse(my("value")) + "";
	,
		"error"
	);
	textfields:"divisions-percentage":"value" = if(parse(my("value")) != 0,
		100/parse(my("value")) + "";
	,
		"error";
	);
);

// Config percentage related subdivisions tf -- COL 2.2
textfields:"divisions-percentage":"value" =  100/subdivisions + ""; // Textinput value needs to be string
textfields:"divisions-percentage":"onupdate" := (
	obj = obj -- [my("keyboard")];
	self():"keyboard" = NADA;
	// Update other relevant tfs
	textfields:"divisions-value":"value" = if(parse(my("value")) != 0,
		my("handle"):"basevalue" * parse(my("value"))/100 + "";
	,
		"error";
	);
	textfields:"divisions":"value" = if(parse(my("value")) != 0,
		100/parse(my("value")) + "";
	,
		"error";
	);
	self():"handle":"divisions" = parse(textfields:"divisions":"value");
);

// Config value related subdivisions tf -- COL 2.3
textfields:"divisions-value":"value" =  basevalue/subdivisions + ""; // Textinput value needs to be string
textfields:"divisions-value":"onupdate" := (
	obj = obj -- [my("keyboard")];
	self():"keyboard" = NADA;
	
	// Update other relevant tfs
	textfields:"divisions-percentage":"value" = if(my("handle"):"basevalue" != 0,
		100*parse(my("value"))/my("handle"):"basevalue" + "";
	,
		"error";
	);
	textfields:"divisions":"value" = if(parse(my("value")) != 0,
		my("handle"):"basevalue"/parse(my("value")) + "";
	,
		"error";
	);

	self():"handle":"divisions" = parse(textfields:"divisions":"value");
);

// Config percentage tf -- COL 3.1
textfields:"percentage":"value" =  barvalue * 100 + ""; // Textinput value needs to be string
textfields:"percentage":"onupdate" := (
	// Destroy keyboard
	obj = obj -- [my("keyboard")];
	self():"keyboard" = NADA;

	// Update other corresponding textfield
	if(keepstable == "basevalue" % parse(textfields:"value":"value") == 0,
		textfields:"value":"value" = parse(self():"value") / 100 * my("handle"):"basevalue" + "";
	,
		textfields:"basevalue":"value" = if(parse(my("value")) != 0,
			parse(textfields:"value":"value") / parse(my("value")) * 100 + "";
		,
			"error";
		);
		my("handle"):"basevalue" = parse(textfields:"basevalue":"value");
	);

	// Update bar
	my("handle"):"value" = parse(my("value")) / 100;
);

// Config value tf -- COL 3.2
textfields:"value":"value" =  basevalue * barvalue + ""; // Textinput value needs to be string
textfields:"value":"onupdate" := (
	// Destroy keyboard
	obj = obj -- [my("keyboard")];
	self():"keyboard" = NADA;

	// Update other corresponding textfield
	if(keepstable == "basevalue" % parse(textfields:"percentage":"value") == 0,
		textfields:"percentage":"value" = 100 * parse(self():"value") / parse(textfields:"basevalue":"value") + "";
	,
		textfields:"basevalue":"value" = parse(self():"value") / parse(textfields:"percentage":"value") * 100 + "";
		my("handle"):"basevalue" = parse(textfields:"basevalue":"value");
	);

	// Update bar
	my("handle"):"value" = parse(my("value")) / my("handle"):"basevalue";
);

// Config base value tf -- COL 3.3
textfields:"basevalue":"value" =  basevalue + ""; // Textinput value needs to be string
textfields:"basevalue":"onupdate" := (
	// Destroy keyboard
	obj = obj -- [my("keyboard")];
	self():"keyboard" = NADA;

	// Update other corresponding textfields
	if(keepstable == "value", // Update percentage only
		textfields:"percentage":"value" = if(parse(my("value")) != 0,
			100 * parse(textfields:"value":"value") / parse(my("value")) + "";
		,
			"error";
		);
	, 
		textfields:"value":"value" = if(parse(my("value")) != 0,
			parse(textfields:"percentage":"value") / 100 * parse(my("value")) + "";
		,
			"error";
		);
	);

	// Update field that displays the value per division
	textfields:"divisions-value":"value" = parse(textfields:"divisions-value":"value") * parse(textfields:"basevalue":"value") / my("handle"):"basevalue" + "";

	// Update bar
	my("handle"):"value" = parse(textfields:"percentage":"value") / 100;
	my("handle"):"basevalue" = parse(my("value"));

	// Update the other two division fields with new bar value (although they should not change)
	textfields:"divisions-value":"onupdate";
);

// D.3 | Init +/- Buttons 
// ======================
// new Button(coord,width,height,label,fontsize)
buttons = {};
buttons:"minusbase" = new Button(textfields:"basevalue":"coord" + [textfields:"basevalue":"width" + .1, 0], .7, .7, "", 20);
buttons:"plusbase" = new Button(buttons:"minusbase":"coord" + [buttons:"minusbase":"width" + .2, 0], .7, .7, "", 20);
buttons:"fixbase" = new Button(buttons:"plusbase":"coord" + [buttons:"plusbase":"width" + .6, 0], .7, .7, "🔒", 24);

buttons:"minusvalue" = new Button(textfields:"value":"coord" + [textfields:"value":"width" + .1, 0], .7, .7, "-", 20);
buttons:"plusvalue" = new Button(buttons:"minusvalue":"coord" + [buttons:"minusvalue":"width" + .2, 0], .7, .7, "+", 20);
buttons:"fixvalue" = new Button(buttons:"plusvalue":"coord" + [buttons:"plusvalue":"width" + .6, 0], .7, .7, "🔓", 24);

buttons:"minuspercentage" = new Button(textfields:"percentage":"coord" + [textfields:"percentage":"width" + .1, 0], .7, .7, "", 20);
buttons:"pluspercentage" = new Button(buttons:"minuspercentage":"coord" + [buttons:"minuspercentage":"width" + .2, 0], .7, .7, "", 20);
buttons:"fixpercentage" = new Button(buttons:"pluspercentage":"coord" + [buttons:"pluspercentage":"width" + .6, 0], .7, .7, "🔓", 24);

buttons:"minusdiv" = new Button(textfields:"divisions":"coord" + [textfields:"divisions":"width" + .1, 0], .7, .7, "", 20);
buttons:"plusdiv" = new Button(buttons:"minusdiv":"coord" + [buttons:"minusdiv":"width" + .2, 0], .7, .7, "", 20);

buttons:"minusdiv-percentage" = new Button(textfields:"divisions-percentage":"coord" + [textfields:"divisions-percentage":"width" + .1, 0], .7, .7, "", 20);
buttons:"plusdiv-percentage" = new Button(buttons:"minusdiv-percentage":"coord" + [buttons:"minusdiv-percentage":"width" + .2, 0], .7, .7, "", 20);

buttons:"minusdiv-value" = new Button(textfields:"divisions-value":"coord" + [textfields:"divisions-value":"width" + .1, 0], .7, .7, "", 20);
buttons:"plusdiv-value" = new Button(buttons:"minusdiv-value":"coord" + [buttons:"minusdiv-value":"width" + .2, 0], .7, .7, "", 20);

// Add drawafter methods for plus and minus
apply(select(keys(buttons), substring(#,0,5) == "minus"), buttons:#:"drawafter" := my("drawminus"));
apply(select(keys(buttons), substring(#,0,4) == "plus"),  buttons:#:"drawafter" := my("drawplus"));

// Config buttons for subdividing
buttons:"minusdiv":"handle" = textfields:"divisions";
buttons:"minusdiv":"cornerradius" = .35;
buttons:"minusdiv":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(1,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusdiv":"handle" = textfields:"divisions";
buttons:"plusdiv":"cornerradius" = .35;
buttons:"plusdiv":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(100,val+1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for subdividing by percentage
buttons:"minusdiv-percentage":"handle" = textfields:"divisions-percentage";
buttons:"minusdiv-percentage":"cornerradius" = .35;
buttons:"minusdiv-percentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusdiv-percentage":"handle" = textfields:"divisions-percentage";
buttons:"plusdiv-percentage":"cornerradius" = .35;
buttons:"plusdiv-percentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(100,val+1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for subdividing by value
buttons:"minusdiv-value":"handle" = textfields:"divisions-value";
buttons:"minusdiv-value":"cornerradius" = .35;
buttons:"minusdiv-value":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusdiv-value":"handle" = textfields:"divisions-value";
buttons:"plusdiv-value":"cornerradius" = .35;
buttons:"plusdiv-value":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(bar:"basevalue",val+1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for base value
buttons:"minusbase":"handle" = textfields:"basevalue";
buttons:"minusbase":"cornerradius" = .35;
buttons:"minusbase":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(1,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusbase":"handle" = textfields:"basevalue";
buttons:"plusbase":"cornerradius" = .35;
buttons:"plusbase":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = val + 1;
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"fixbase":"handle" = textfields:"basevalue";
buttons:"fixbase":"hasbody" = false;
buttons:"fixbase":"hasborder" = false;
buttons:"fixbase":"cornerradius" = 0;
buttons:"fixbase":"color" := DZLMCOLORLIGHT * if(tobool(keepstable == "basevalue"), .8, 1);
buttons:"fixbase":"script" := (
	keepstable = "basevalue";
	set my("label", "🔒");
	buttons:"fixlabel":"label" = "🔓";
	buttons:"fixpercentage":"label" = "🔓";
);

// Config buttons for (current) value
buttons:"minusvalue":"handle" = textfields:"value";
buttons:"minusvalue":"cornerradius" = .35;
buttons:"minusvalue":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val - my("handle"):"handle":"basevalue" * my("handle"):"handle":"precision");
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusvalue":"handle" = textfields:"value";
buttons:"plusvalue":"cornerradius" = .35;
buttons:"plusvalue":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(my("handle"):"handle":"basevalue",val + my("handle"):"handle":"basevalue" * my("handle"):"handle":"precision");
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"fixvalue":"handle" = textfields:"value";
buttons:"fixvalue":"hasbody" = false;
buttons:"fixvalue":"hasborder" = false;
buttons:"fixvalue":"cornerradius" = 0;
buttons:"fixvalue":"color" := DZLMCOLORLIGHT * if(tobool(keepstable == "value"), .8, 1);
buttons:"fixvalue":"script" := (
	keepstable = "value";
	set my("label", "🔒");
	buttons:"fixbase":"label" = "🔓";
	buttons:"fixpercentage":"label" = "🔓";
);

// Config buttons for percentage
buttons:"minuspercentage":"handle" = textfields:"percentage";
buttons:"minuspercentage":"cornerradius" = .35;
buttons:"minuspercentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val - 100 * my("handle"):"handle":"precision");
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"pluspercentage":"handle" = textfields:"percentage";
buttons:"pluspercentage":"cornerradius" = .35;
buttons:"pluspercentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = val + 100 * my("handle"):"handle":"precision";
	if(!my("handle"):"handle":"canoverflow", val = min(100, val));
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"fixpercentage":"handle" = textfields:"percentage";
buttons:"fixpercentage":"hasbody" = false;
buttons:"fixpercentage":"hasborder" = false;
buttons:"fixpercentage":"cornerradius" = 0;
buttons:"fixpercentage":"color" := DZLMCOLORLIGHT * if(tobool(keepstable == "percentage"), .8, 1);
buttons:"fixpercentage":"script" := (
	keepstable = "percentage";
	set my("label", "🔒");
	buttons:"fixlabel":"label" = "🔓";
	buttons:"fixvalue":"label" = "🔓";
);

// fix for iPad pen issue: debounce clicks on all percentagebar buttons
penfixbutton(btn) := (
	btn:"ipadpentimestampfix" = -1;
	btn:"click" := if(timestamp() - my("ipadpentimestampfix") > 200,
		self():"ipadpentimestampfix" = timestamp();
		my("script");
	);
);

forall(keys(buttons), key, penfixbutton(buttons:key));

// D.4 | Configure Toggles corresponding to G,P,p textfields to toggle visibility
// ==============================================================================
toggles:"showtf-base":"script" := if(my("state"),
	obj = obj ++ [textfields:"basevalue"];
	obj = obj ++ [buttons:"plusbase"];
	obj = obj ++ [buttons:"minusbase"];
	obj = obj ++ [buttons:"fixbase"];
,
	obj = obj -- [textfields:"basevalue"];
	obj = obj -- [buttons:"plusbase"];
	obj = obj -- [buttons:"minusbase"];
	obj = obj -- [buttons:"fixbase"];
);

toggles:"showtf-value":"script" := if(my("state"),
	obj = obj ++ [textfields:"value"];
	obj = obj ++ [buttons:"plusvalue"];
	obj = obj ++ [buttons:"minusvalue"];
	obj = obj ++ [buttons:"fixvalue"];
,
	obj = obj -- [textfields:"value"];
	obj = obj -- [buttons:"plusvalue"];
	obj = obj -- [buttons:"minusvalue"];
	obj = obj -- [buttons:"fixvalue"];
);

toggles:"showtf-perc":"script" := if(my("state"),
	obj = obj ++ [textfields:"percentage"];
	obj = obj ++ [buttons:"pluspercentage"];
	obj = obj ++ [buttons:"minuspercentage"];
	obj = obj ++ [buttons:"fixpercentage"];
,
	obj = obj -- [textfields:"percentage"];
	obj = obj -- [buttons:"pluspercentage"];
	obj = obj -- [buttons:"minuspercentage"];
	obj = obj -- [buttons:"fixpercentage"];
);

toggles:"showtf-div":"script" := if(my("state"),
	obj = obj ++ [textfields:"divisions"];
	obj = obj ++ [buttons:"plusdiv"];
	obj = obj ++ [buttons:"minusdiv"];
,
	obj = obj -- [textfields:"divisions"];
	obj = obj -- [buttons:"plusdiv"];
	obj = obj -- [buttons:"minusdiv"];
	if(!anystepsactive(), eval(toggles:"arch":"setstate", 'newstate->false));
);

toggles:"showtf-divpercentage":"script" := if(my("state"),
	obj = obj ++ [textfields:"divisions-percentage"];
	obj = obj ++ [buttons:"plusdiv-percentage"];
	obj = obj ++ [buttons:"minusdiv-percentage"];
,
	obj = obj -- [textfields:"divisions-percentage"];
	obj = obj -- [buttons:"plusdiv-percentage"];
	obj = obj -- [buttons:"minusdiv-percentage"];
	if(!anystepsactive(), eval(toggles:"arch":"setstate", 'newstate->false));
);

toggles:"showtf-divvalue":"script" := if(my("state"),
	obj = obj ++ [textfields:"divisions-value"];
	obj = obj ++ [buttons:"plusdiv-value"];
	obj = obj ++ [buttons:"minusdiv-value"];
,
	obj = obj -- [textfields:"divisions-value"];
	obj = obj -- [buttons:"plusdiv-value"];
	obj = obj -- [buttons:"minusdiv-value"];
	if(!anystepsactive(), eval(toggles:"arch":"setstate", 'newstate->false));
);

toggles:"arch":"script" := if(my("state") & !anystepsactive(),
	eval(toggles:"showtf-div":"setstate", 'newstate->true);
);

// D.5 | Init Percentagebar
// new Percentagebar(coord, width, height, value, precision, divisions, baseval, unit)
// ===================================================================================
bars = [];
if(numberofbars <= 1, // build one bar
	bar = new Percentagebar(barposition, barwidth, barheight, barvalue, barprecision, subdivisions, basevalue, unit);
	bars = bars :> bar;
, // ELSE: more than one bar
	barwidth = barwidth - (numberofbars-1) * barpadding;
	barwidth = barwidth / numberofbars;

	repeat(numberofbars,
		bar = new Percentagebar(barposition, barwidth, barheight, barvalue, barprecision, subdivisions, basevalue, unit);
		barposition = barposition + [barwidth+barpadding, 0];
		bars = bars :> bar;
	);
);

forall(bars, bar,
	bar:"drawpercentagelabels"	= toggles:"percentages":"state";
	bar:"drawvaluelabels"				= toggles:"parts":"state";
	bar:"drawbasevaluelabel"		= toggles:"basevalue":"state";
	bar:"drawcurrentpercentage"	= toggles:"percentage":"state";
	bar:"drawcurrentvalue"			= toggles:"part":"state";
	bar:"drawarches"						= toggles:"arch":"state";
	bar:"canoverflow"						= toggles:"overflow":"state";
	bar:"drawsteps" 						= anystepsactive();
	
	bar:"standardTicks"	= 'standardTicks;
	
	// Add handles to bar for all the UI stuff
	bar:"toggles" = toggles;
	bar:"textfields" = textfields;
	bar:"buttons" = buttons;

	if(snapbar,
		bar:"precision" := if(my("drawsteps"),
			1/max(1,my("divisions"))
		,
			barprecision
		)
	);
);

// Update handles for textfields, since bar wasn't defined earlier
'generictextfieldhandle = bars_1;

obj = obj 
	++ if(showbuttons, values(toggles))
	-- apply(select(hidetoggles, contains(keys(toggles), #)), toggles:#);
obj = obj 
	++ values(textfields)
	-- [
		textfields:"basevalue", textfields:"value", textfields:"percentage", 
		textfields:"divisions",	textfields:"divisions-percentage",	textfields:"divisions-value"
	];
obj = obj ++ values(buttons) 
	-- [
		buttons:"plusbase", buttons:"plusvalue",buttons:"pluspercentage",
		buttons:"minusbase", buttons:"minusvalue",buttons:"minuspercentage",
		buttons:"minusdiv", buttons:"plusdiv",
		buttons:"minusdiv-percentage",	buttons:"plusdiv-percentage",
		buttons:"minusdiv-value", buttons:"plusdiv-value"
	];
obj = obj :> arch1;
obj = obj :> arch2;
obj = obj :> agg;
obj = obj ++ bars;




bars_1:"toggleactive";

// Call toggle scripts for G,P,p toggle to put in textfields approriately
toggles:"showtf-base":"script";
toggles:"showtf-value":"script";
toggles:"showtf-perc":"script";
toggles:"showtf-div":"script";
toggles:"showtf-divpercentage":"script";
toggles:"showtf-divvalue":"script";

// Remove divisions textfield and buttons if buttons are not showing.
if(!showbuttons,
	obj = obj -- [textfields:"divisions", buttons:"plusdiv", buttons:"minusdiv"];
);

); // end vam-if
//[VAM] strapwork
/** v49 ****************************************************************************************
*
* Recent changes:
* 2026-08-04 Adjust VAM to new framework structure
* 2026-08-04 Fix some minor bugs
* 2026-08-09 Adjust divomath functions to new json serialization pipeline
* 2026-08-10: Fix result reporting being wrong an on individual level
************************************************************************************************/


// Parkettierung / Bandornamente
if(VAM == "strapwork",

// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

// --- Container setup ---
rows									= default to(ENVIRONMENTALPARAMS:"rows", 1, true); // Number of rows/strips in Container
state									= default to(ENVIRONMENTALPARAMS:"state", apply(1..rows, ""), true); // Predefined RegPoly per strip
limit									= default to(ENVIRONMENTALPARAMS:"limit", apply(1..100, 10), true); // Limit of RegPolys per row/strip (-1 => no limit)
sepstate							= default to(ENVIRONMENTALPARAMS:"sepstate", "", false); // Separator positions (i.e. number of polys left of Separator)
interactable					= default to(ENVIRONMENTALPARAMS:"interactable", "cps", false); // Container is interactable (c=Container, p=Polys, s=Separators)
 
// --- RegPolys ---
vertices							= default to(ENVIRONMENTALPARAMS:"polys", [0,3,6], true); // Number of RegPolys or list of number of vertices
colors								= default to(ENVIRONMENTALPARAMS:"polycolors", 1..100, true); // Colors of the RegPolys
size									= default to(ENVIRONMENTALPARAMS:"size", 1, true); // General size of Polys and Container
polypadding						= default to(ENVIRONMENTALPARAMS:"polypadding", .5, true); // Padding between RegPolys
 
// --- Pattern container ---
patternlimit					= default to(ENVIRONMENTALPARAMS:"patternlimit", 5, true); // Limit for PatternContainer
patternstate					= default to(ENVIRONMENTALPARAMS:"patternstate", apply(1..rows, ""), true); // Predefined RegPoly per strip
 
// --- Reference container (rc) ---
rcrows								= default to(ENVIRONMENTALPARAMS:"rcrows", 1, true); // Number of rows/strips in reference container
rcstate								= default to(ENVIRONMENTALPARAMS:"rcstate", apply(1..rcrows, ""), true); // Predefined RegPoly per strip
rclimit								= default to(ENVIRONMENTALPARAMS:"rclimit", apply(1..100, 10), true); // Limit of RegPolys per row/strip (-1 => no limit)
rcsepstate						= default to(ENVIRONMENTALPARAMS:"rcsepstate", "", false); // Separator positions (i.e. number of polys left of Separator)
rcinteractable				= default to(ENVIRONMENTALPARAMS:"rcinteractable", "", false); // reference container can be used like a normal Container
 
// --- Look and feel ---
drawpolys							= default to(ENVIRONMENTALPARAMS:"drawpolys", true, true); // Draw base RegPolys
drawpatterncontainer	= default to(ENVIRONMENTALPARAMS:"drawpatterncontainer", true, true); // Draw Pattern Container
drawseparator					= default to(ENVIRONMENTALPARAMS:"drawseparator", true, true); // Draw Separator
drawborders						= default to(ENVIRONMENTALPARAMS:"drawborders", true, true); // Draw borders of RegPolys
drawresetbutton				= default to(ENVIRONMENTALPARAMS:"drawresetbutton", true, true); // Draw reset button
drawrccontainer				= default to(ENVIRONMENTALPARAMS:"drawrccontainer", false, true); // Draw reference container
drawrcseparator				= default to(ENVIRONMENTALPARAMS:"drawrcseparator", false, true); // Draw reference containers Separator
sepsize								= default to(ENVIRONMENTALPARAMS:"sepsize", 1, true); // General size of Separators and Reset Button
buttonsize						= default to(ENVIRONMENTALPARAMS:"buttonsize", 1, true); // Reset buttons size
 
// Normalize booleans (divomath reports back "" instead of false)
drawpolys							= tobool(drawpolys);
drawpatterncontainer	= tobool(drawpatterncontainer);
drawseparator					= tobool(drawseparator);
drawborders						= tobool(drawborders);
drawresetbutton 			= tobool(drawresetbutton);
drawrccontainer 			= tobool(drawrccontainer);
drawrcseparator				= tobool(drawrcseparator);
 
// NOTE: rcinteractable is bool OR string ("cps" or a subset) for backwards compatibility, see Initialization - so deliberately no tobool here.

// --- shared local constants and vars ---
SHAPEMAP = { // Maps shape names (uses k+"gon" for k>8)
	"0":"circle", "3":"triangle", "4":"square", "5":"pentagon",
	"6":"hexagon", "7":"heptagon", "8":"octagon", "100": "circle"
};
COLORMAP = { // Maps color names
	"1":"blue", "2": "darkblue", "3":"red", "4":"green",
	"5":"violet", "6":"greyish", "7":"black"
};

'polyid = 0; // for identifying RegPolys (mainly for debugging)


// ================= //
// Divomath settings //
// ================= //

// Overwrite divomath result updating function.
divomath update results() := if(ISDIVOMATH,
	debug at("strapwork, divomath update results()", "===updateResults()==================================================");
 
	divomath clear results();
 
	regional(strips, stripcounter, stripasstring, polyindex, slot, separators);
	stripcounter = 1;
	strips = reverse(container:"strips"); // all strips (top to bottom)
 
	separators = separator:"getstatestring"; // Get state string if Separator copies...
	if(isundefined(separators), separators = "");
	separators = parse("[" + separators + "]"); // ...and parse as list.
 
	// Add a divomath result for every Poly and every Separator of every strip,
	// keyed "<stripno>.<runningno>". Separators are reported as a 0.
	forall(strips, strip, // Check every strip
		stripasstring = "";
		polyindex = 0; // counts Polys only - "separators" refers to these
		slot = 1;      // running number for the result keys, Separators included
 
		forall(strip, poly, // Check every Poly
			polyindex = polyindex + 1;
 
			// Build string from poly ids for clean row wise reporting
			stripasstring = stripasstring + (poly:"original":"id" + 1);
 
			divomath put result(stripcounter + "." + slot, poly:"original":"id" + 1);
			slot = slot + 1;
 
			// If a Separator sits behind this Poly, report it under its OWN key.
			// NOTE: this used to reuse the key of the Poly, so the 0 overwrote
			// the value that had just been reported - which is why "1.2" came
			// back as 0 instead of the Poly id.
			if(contains(separators, polyindex),
				divomath put result(stripcounter + "." + slot, 0);
				stripasstring = stripasstring + "0";
				slot = slot + 1;
			);
		);
 
		// Report entire strip as a string as well
		divomath put result("row" + stripcounter, stripasstring);
 
		stripcounter = stripcounter + 1;
	);
 
	// Export state as results as well, for forward referencing
	regional(dmstate);
	dmstate = divomath set state();
	forall(keys(dmstate), key,
		divomath put result(key, dmstate:key);
		debug at("strapwork, divomath update results()", "Added key: " + key + ", val: " + dmstate:key);
	);
 
	divomath post results();
);

// Overwrite divomath setState()
divomath set state() := (
	regional(state);
	state = {
		"size" : size,
		"polycolors" : colors,
		"rows" : rows,
		"limit" : limit,
		"sepstate" : if(!isundefined(separator), separator:"getstatestring", "" + sepstateinitial),
		"drawpolys" : drawpolys,
		"drawpatterncontainer" : drawpatterncontainer,
		"drawseparator" : drawseparator,
		"drawborders" : drawborders,
		"polypadding" : polypadding,
		"rcrows" : rcrows,
		"rclimit" : rclimit,
		"rcsepstate" : if(!isundefined(rcseparator), rcseparator:"getstatestring", "" + rcsepstateinitial),
		"drawrccontainer" : drawrccontainer,
		"drawrcseparator" : drawrcseparator
	};

	// Configure vertices to handle image-strings correctly
	regional(polys);
	polys = vertices;

	state:"polys" = polys;
	
	// Configure "state" attribute
	// Get current state and built list compatible with config, i.e. ["3,6", "1,1,1", "1,2,3,1"] for 3 strips
	regional(currentstate);
	currentstate = []; 
		
	forall(container:"strips", stripspolys, // loop over every strip
		currentstate = currentstate :> ""; // Set blank new state config string for a strip
		
		forall(stripspolys, // loop over every poly
			currentstate_(-1) = currentstate_(-1) + (#:"original":"id" + 1); // append corresponding originals ID (+1) to state string
			currentstate_(-1) = currentstate_(-1) + ","; // separate by comma
		);

		// Drop the trailing comma
		if(length(currentstate_(-1)) > 0, currentstate_(-1)_(-1) = "");
	);
	state:"state" = currentstate; // Add state attribute to state

	// Configure current "patternstate"
	regional(currentpatternstate);
	currentpatternstate = [];

	forall(patterncontainer:"strips", stripspolys, // loop over every strip
		currentpatternstate = currentpatternstate :> ""; // Set blank new state config string for a strip
		
		forall(stripspolys, // loop over every poly
			currentpatternstate_(-1) = currentpatternstate_(-1) + (#:"original":"id" + 1); // append corresponding originals ID (+1) to state string
			currentpatternstate_(-1) = currentpatternstate_(-1) + ","; // separate by comma
		);

		// Drop the trailing comma
		if(length(currentpatternstate_(-1)) > 0, currentpatternstate_(-1)_(-1) = "");
	);
	state:"patternstate" = currentpatternstate; // Add patternstate attribute to state

	// Configure current "rcstate"
	regional(currentrcstate);
	currentrcstate = [];

	forall(rccontainer:"strips", stripspolys, // loop over every strip
		currentrcstate = currentrcstate :> ""; // Set blank new state config string for a strip
		
		forall(stripspolys, // loop over every poly
			currentrcstate_(-1) = currentrcstate_(-1) + (#:"original":"id" + 1); // append corresponding originals ID (+1) to state string
			currentrcstate_(-1) = currentrcstate_(-1) + ","; // separate by comma
		);

		// Drop the trailing comma
		if(length(currentrcstate_(-1)) > 0, currentrcstate_(-1)_(-1) = "");
	);
	state:"rcstate" = currentrcstate; // Add rcstate attribute to state

	state; // Return
);


// ===================== //
// C | Class Definitions //
// ===================== //

/**
* CLASS RegPoly: Provides a means to render a regular polygon based on its center and the radius of the circumcircle* and
* having it interactable (i.e. being able to "move", "copy" and interact with a container on "moveend".
* Uses regularpolygon() function but scales and rotates the result depending on the parity of vertices
* (even: rotate by PI/4, scale up so that radius is edge to opposite edge, odd: no rotation, scale -> 2*radius = edge to opposite edge).
*
* *is not circumcircle in the resulting RegPoly
**/
new RegPoly(center,radius,vertices,rotation,palettecolor):= ( 
	regional(regpoly);
	regpoly = new VAMobject("RegPoly");

	if(isstring(vertices), 
		regpoly:"image" = vertices;
		vertices = 0;
	); // Create circle, if RegPolys draws image

	regpoly:"inputradius"	= radius; // backup only, for copy creation
	regpoly:"inputrotation"= rotation; // backup only, for copy creation
	
	regpoly:"id" = 'polyid; 'polyid = 'polyid +1;
	regpoly:"name"				= ( // Name for posting to divomath
		if(vertices < 9 % vertices == 100, SHAPEMAP:vertices, vertices + "-gon") + // name of shape
		"_" + 
		COLORMAP:(mod(palettecolor-1,	length(DIVOPALETTE)) + 1); // generic name of color ("blue", "red", ...)
	);
	
	regpoly:"vertices"		= if(vertices < 3, 100, vertices); // if no vertices approximate a circle
	regpoly:"coord" 			= center;
	regpoly:"radius" 			= if(iseven(regpoly:"vertices"),
		radius / cos(PI/regpoly:"vertices"), // length edge to edge = 2 * radius
		radius * 2 / (1 + cos(PI/regpoly:"vertices")) // length corner to edge = 2 * radius
			* if(regpoly:"vertices" == 3, .9, 1); // squish only triangle to look better
	);
	regpoly:"center"			:= my("coord") - [ // coord adjusted so that all RegPolys are aligned at the bottom edge
		0, // deltax
		if(iseven(my("vertices")), 
			0, // even parity RegPolys are aligned. Base circle is inner circle.
			my("radius") * sin(PI / my("vertices")) * (1 - cos(PI / my("vertices"))) / (1 + cos(PI / my("vertices")))			// voodoo magic for odd parity
		);
	];
	regpoly:"rotation"		= rotation + if(iseven(regpoly:"vertices"),  // custom rotation AND...
		PI/regpoly:"vertices", // ...rotate even Polys, so they are not corner up
		0
	);
	regpoly:"ismoveable" 	= true;
	regpoly:"copyonmove"	= false;
	regpoly:"parent" 			= NADA; // Workbench or Container or similar
	regpoly:"colorkey"		= palettecolor;
	regpoly:"color" 			= DIVOPALETTE_(mod(palettecolor-1,	length(DIVOPALETTE)) + 1);

	regpoly:"shape" := regularpolygon(
				my("center"), // center
				my("radius"), // radius
				my("vertices"), // vertices, is 100 for a circle
				my("rotation") // rotation
	);
	regpoly:"hitbox" := my("shape");

	regpoly:"draw" := (
		fillpoly(my("shape"),color->if(isundefined(my("image")),my("color"),grey(1)));
		if(drawborders,drawpoly(my("shape"),color->grey(0),size->bordersize));

		// Draw image
		if(!isundefined(my("image")),
			drawimage(my("coord"),ICONS:(my("image")), scale->.28*my("radius"));
		);
		
		// Debug
		if(LOGLEVEL > 0, 
			draw(my("center"));
			drawtext(my("center")+[.2,0], my("id"),color->apply(my("color"), abs(1-#)), bold->true);
			draw(my("coord"), color->grey(.9));
		);		
	);

	regpoly:"ishot" := inpoly(my("shape"),mouse().xy);

	regpoly:"copy" := (
		regional(polycopy);
		polycopy = new RegPoly(
			my("coord"),
			my("inputradius"),
			if(isundefined(my("image")),my("vertices"),my("image")),
			my("inputrotation"),
			my("colorkey")
		);

		// Check if Poly has original itself (so it is a copy in a PatternContainer)
		// If true, use it's original, otherwise just use self() (which will be the original)
		polycopy:"original" = if(isundefined(self():"original"), self(), self():"original"); // Reference to copyable RegPoly for divomath result adding

		polycopy; // Return copy of RegPoly
	);
	
	regpoly:"moveend" := if(my("ismoveable"), // Handle dropped RegPolys
		// Get Container the Poly is dropped on
		regional(polydroptarget);
		polydroptarget = select(obj, #:"type" == "Container" & #:"ishot"); // possibly multiple Containers
		polydroptarget = if(length(polydroptarget)>0, polydroptarget_1); // select first Container

		// Removes Poly from parent if dropped somewhere else
		if(my("parent") != droptarget,
			eval(my("parent"):"remove", poly->self());
			self():"parent"=NADA;
		);

		// Call drop-handler from Container
		eval(polydroptarget:"drop",dropobject->self());

		// Remove stray RegPolys from obj
		if(isundefined(my("parent")), obj = obj -- [self()]);
	);

	regpoly; // Return the RegPoly
);

new Separator(coord, height, parent) := (
	regional(sep);
	sep = new VAMobject("Separator");
	
	sep:"coord" = coord;
	sep:"parent" = parent; // should be a Container
	sep:"original" = NADA; // reference for copies of Separator
	sep:"timing" = parent:"timing";
	sep:"color" = grey(.3);
	sep:"ismoveable" = false;
	sep:"copyonmove" = true;
	sep:"width" = .4;
	sep:"copies" = [];

	sep:"shape" := ( // mutliple polys
		regional(shape, blobscale, barscale);
		blobscale = .6;
		shape = [];

		//hitbox = hitbox :> regularpolygon(my("coord")-[0,2*blobscale*my("width")], blobscale *2* my("width"), 100, PI/4); // bottom square
		shape = shape :> ellipse(my("coord")-[0,1.5*sepsize*blobscale*my("width")], sepsize*.6, sepsize*.3);
		barscale = sepsize*.2;
		shape = shape :> rectangle(my("coord") - barscale*[my("width"),2*my("width")], 2*barscale*my("width"), my("parent"):"height" + 2*barscale*my("width"));
	);
	sep:"hitbox" := (
		regional(hitbox, blobscale, barscale);
		hitbox = my("shape");

		// Add larger box to the bottom to make it easier to grab
		barscale = sepsize*.2;
		blobscale = .6;
		hitbox = hitbox :> ellipse(my("coord")-[0,3*sepsize*blobscale*my("width")], sepsize*.6, sepsize*.6);
	);
	sep:"ishot" := contains(apply(my("hitbox"), inpoly(#,mouse().xy)), true); // mouse in one the parts of the hitbox
	
	sep:"draw" := (
		// Draw all Polys
		forall(my("shape"), fillpoly(#, color->my("color")));

		// Debug draw
		if(LOGLEVEL>3,
			forall(my("hitbox"), drawpoly(#, color->[1,0,0]));
		);
	);
	
	sep:"move" := if(my("ismoveable"),
		self():"coord" = my("coord") + [mousedelta_1, 0]; // move only along x-axis
		self():"coord"_1 = max(my("parent"):"coord"_1,my("coord")_1); // limit to the left
		self():"coord"_1 = min(my("parent"):"coord"_1+my("parent"):"width",my("coord")_1); // limit to the right
	);

	sep:"moveend" := if(my("ismoveable"),
		regional(x, strips, position, polyX);
		x = my("coord")_1; // own x-coord for proper alignment
		strips = my("parent"):"strips"; // strips of RegPolys to compare against

		// Get position where to insert Separator
		position = apply(strips, s, apply(s, #:"coord"_1 < x)); // [][] of true/false depending on, if RegPoly is left of dropped Separator
		position = apply(position, s, select(s, #)); // throw away all "false" (Polys right of dropped Separator)
		position = apply(position, s, length(s)); // count trues (number of Polys left of dropped Separator)
		position = max(position); // max number of trues (position of rightmost element still left of Separator, may be zero)

		// Get reference x-coordinate of RegPoly
		if(position > 0,
			polyX = select(strips, length(#) >= position)_1; // first strip with enough RegPolys for correct positioning
			polyX = polyX_position; // RegPoly at appropriate position of that strip
			polyX = polyX:"coord"_1; // its x-coord
		); // polyX NADA, if position is 0 (Separator dropped before first Poly or no Poly in Container)

		// Get xcoord where to insert and check if there already is a Separator at that position
		regional(sepxpos, sepalreadyexists);
		sepxpos = polyX + size + .5 * my("parent"):"polypadding";
		sepalreadyexists = contains(apply(my("original"):"copies", #:"coord"_1), sepxpos);
		if(isundefined(sepalreadyexists), sepalreadyexists = false);

		// Handle storage of dropped Separator
		if(isundefined(polyX) % sepalreadyexists, // if there is no useful place to insert Separator...
			// ...remove from 'copies' and obj
			self():"original":"copies" = my("original"):"copies" -- [self()];
			obj = obj -- [self()];

		, // else: Move into position, i.e. set x-coord of dropped Separator
			new animationobject(
				self(),
				"coord",
				my("coord"),
				[sepxpos, my("coord")_2],
				my("timing"),
				"accel"
			);
		);
		
		// Update divomath states/results
		divomath update results();
	);

	sep:"copy" := (
		regional(copy);
		copy = new Separator(my("coord"),my("height"), my("parent"));
		copy:"ismoveable" = true;
		copy:"copyonmove" = false;
		copy:"original" = self(); // thing i am copied from (different from parent => Container)
		copy:"color" = copy:"color";

		self():"copies" = my("copies") ++ [copy];

		copy;
	);

	sep:"popall" := (
		obj = obj -- my("copies");
		self():"copies" = [];
	);

	sep:"putchild" := ( // eval with position with the number of Polys left of Separator
		regional(refpoly, maxlength);

		// Get strip with most polys
		refpoly = apply(my("parent"):"strips", length(#)); // lengths of all strips of parent Container
		maxlength = max(refpoly);
		forall(1..length(refpoly), stripindex, // Get strip with most Polys
			if(refpoly_stripindex == maxlength, refpoly = my("parent"):"strips"_stripindex);
		);

		refpoly = refpoly_position; // get RegPoly in correct position

		// Create copy and place correctly
		regional(sepxpos, sepcopy);
		sepxpos = my("parent"):"coord"_1;
		sepxpos = sepxpos + my("parent"):"stripmargin"; // move to left border of first poly
		sepxpos = sepxpos + position * (2*size + my("parent"):"polypadding"); // move to left border of poly right of correct position
		sepxpos = sepxpos - .5 * my("parent"):"polypadding"; // move back to center between polys

		sepcopy = my("copy");
		sepcopy:"coord" = [sepxpos, my("coord")_2];

		obj = obj ++ [sepcopy];

	);

	// Get position in relation to parent container (i.e. max number of polys to the left of self())
	sep:"getcontainerposition" := (
		regional(refposition, position, distance);

		refposition = my("original"):"coord"_1 - (my("original"):"parent":"polypadding"/2-my("original"):"parent":"stripmargin"); // adjust original position
		position = my("coord")_1;
		distance = polypadding + 2*size; // should be distance between to separators
		round((position - refposition) / distance);
	);

	sep:"getstatestring" := (
		regional(statestring, position, maxpolycount);
		statestring = "";

		// Add positions separated by comma
		forall(my("copies"),
			position = #:"getcontainerposition";
			maxpolycount = max(apply(my("parent"):"strips", length(#)));
			position = min(position, maxpolycount);
			statestring = statestring + position + ",";
		);

		// Drop trailing comma
		if(length(statestring) > 0, statestring_(-1) = "");

		statestring; // Return string
	);

	sep; // Return
);

// Multiline Container to hold RegPolys
new Container(coord, numofstrips, limits) := (
	regional(cont);
	cont = new VAMobject("Container");

	cont:"stripmargin" = .3; // distance to left and right border, half the distance is used to next strip
	cont:"polypadding" = polypadding;
	cont:"polyoffset" = 2*size + cont:"polypadding"; // distance between center of two RegPolys in a strip

	cont:"coord" = coord;
	cont:"childseparator" = NADA; // gets set when initialising Separator
	cont:"#strips" = numofstrips; // int: number of strips
	cont:"strips" = ( // Stores RegPolys per strip
		regional(strips);
		strips = [];
		repeat(cont:"#strips", strips = strips :> []);
	);
	cont:"longeststripindex" := ( // Returns first stripindex with max number of Polys in it
		regional(maxlength, index);
		maxlength = apply(my("strips"), length(#));
		maxlength = max(maxlength);
		
		// Find first occurence of maxlength
		forall(1..length(my("strips")),
			if(isundefined(index) & length(my("strips")_#) == maxlength, index = #);
		);
		index; // Return
	);
	
	cont:"limits" = limits; // [] int: size limits of strips
	cont:"hardpolylimit" := (
		regional(fitting);

		// How many polys actually fit between the container's left edge and
		// the right edge of the visible area.
		fitting = VRBOTTOMRIGHT_1 - my("coord")_1;
		fitting = fitting - 2 * my("stripmargin"); // margins left and right
		fitting = fitting - size;                  // room to drop the next poly
		fitting = fitting / (2*size + my("polypadding"));
		fitting = max(1, floor(fitting));

		// A finite limit caps it further, an infinite one (-1) does not.
		if(min(my("limits")) < 0, fitting, min(max(my("limits")), fitting));
	);

	cont:"refpoints" := ( // [] Point: reference points for strip beginnings
		regional(ref, dx, dy);
		ref = [];
		repeat(my("#strips"),
			dx = size + my("stripmargin");
			dy = (2*#-1) * (size + my("stripmargin")/2);
			ref = ref :> my("coord") + [dx, dy];
		);
		ref;
	);

	cont:"height" = (2*size + cont:"stripmargin") * cont:"#strips";
	cont:"stripheight" = cont:"height" / cont:"#strips";
	cont:"width" := 2*my("stripmargin") + (2*size + my("polypadding")) * my("hardpolylimit");

	cont:"ismoveable" = false;
	cont:"isclickable" = false;
	cont:"bordersize" = 3;
	cont:"timing" = .2; // animation time
	cont:"timeflow" = "accel";

	cont:"hitbox" := my("shape");
	cont:"ishot" := in rectangle(my("hitbox"), mouse().xy);

	cont:"shape" := rectangle(my("coord"), my("width"),	my("height"));
	cont:"draw" := (
		// Loop over strips...
		repeat(my("#strips"),
			// ...and fill strip with some background color
			fillpoly(rectangle(
					my("coord") + (#-1) * [0,my("stripheight")],
					my("width"),
					my("stripheight")
				),
				color->if(isodd(#),grey(.94),grey(.98))	
			);

			// ...also draw indicators for infinte strips
			if(my("limits")_# < 0,
				fillpoly(
					regular polygon(my("refpoints")_# + [my("width")-size-2.5*my("stripmargin"),0], size/4, 3, -30°),
					color->if(iseven(#),grey(0.94),grey(1))
				);
			);
		);

		// Draw border
		//drawpoly(my("shape"), color->grey(.3), size->my("bordersize"));

		// Debug draw
		if(LOGLEVEL > 0,
			draw(my("coord"));
			repeat(length(my("refpoints")), // draw refpoints and an appropriatly sized circle around each
				draw(my("refpoints")_#);
				drawcircle(my("refpoints")_#,size, color->grey(.85));
				drawtext(my("refpoints")_#+[.2,0],my("limits")_#,color->grey(.7));
			);
		);
	);

// Eval Methods
// ============
	cont:"remove" := ( // Removes RegPoly from *any* strip, eval with "poly" as RegPoly
		self():"strips" = apply(my("strips"), # -- [poly]);
	
		// Realign Polys
		my("scrollbar"):"adjustedvalue" = round(my("scrollbar"):"value"); // update to animate correctly on removing
		my("movepolysintoplace");

		// Toggle scrollbar visibility (on overflowing strip)
		my("scrollbar"):"setvisibility";
	);

	cont:"appendtostrip" := ( // eval with RegPoly "poly" and strip index "index" as int
		self():"strips"_index = my("strips")_index :> poly;
		poly:"parent" = self();
	);

	cont:"drop" := ( // handles stuff getting dropped on a container --> eval with object as "dropobject"
		if(dropobject:"type" == "RegPoly", my("droppoly"),
		if(dropobject:"type" == "Container" & dropobject:"subtype" == "Pattern", my("dropcontainer"),
		if(dropobject:"type" == "Separator", my("dropseparator"), // not needed
		// else
		println("Dropped a " + dropobject:"type" + " ... nothing to do");
		)));
	);

	cont:"droppoly" := ( // eval with dropobject (from own "drop" method)
		// For safety, should not be needed
		if(!contains(obj,dropobject), obj = obj :> dropobject);

		// Get correct strip index to put poly in
		regional(stripindex);
		stripindex = 1+length(select(apply(apply(1..my("#strips"),my("coord")_2 + #*my("height")/my("#strips")),#<mouse().xy_2),#));

		// Put poly in makeshift container to call "dropcontainer" with
		regional(cont);
		cont = {};
		cont:"strips" = apply(1..my("#strips"), if(#==stripindex, [dropobject], []));
		cont:"#strips" = length(cont:"strips");

		// Call dropcontainer
		eval(my("dropcontainer"), dropobject->cont);

		// Reset dropcoord for next call
		dropcoord = NADA;
	);

	cont:"dropcontainer" := ( // eval with dropobject (from own "drop" method)
		// can also be evaled with dropcoord to use specific coord (defaults to mouse coords)
		if(isundefined(dropcoord), dropcoord = mouse().xy);

		regional(polys, hotstrip, position, len, lim, overflowcontent);



		repeat(dropobject:"#strips", stripindex,

			polys = dropobject:"strips"_stripindex; // Strip to put in Container
			hotstrip = my("strips")_stripindex; // VALUE COPY of strip, reassign later

			// Find position, where to insert dropobject
			position = select(hotstrip, dropcoord_1 > #:"coord"_1); // all Polys left of the mouse
			position = 1 + length(position); // count them, add one --> next position to insert

			// (Re)Set strip contents
			hotstrip = hotstrip_(1..position-1) ++ // Assemble Polys BEFORE the dropobject
				polys ++ // Append list of polys
				hotstrip_(position..length(hotstrip)); // Append Polys AFTER the dropobject

			// Set RegPolys parent to Container
			apply(polys, #:"parent" = self());

			// Reassign hotstrip to corresponding field
			self():"strips"_stripindex = hotstrip;

			// Remove overflowing elements at size limit of container
			hotstrip = my("strips")_stripindex;
			len = length(hotstrip);
			lim = my("limits")_stripindex;
		
			if(lim > -1 & length(hotstrip) > my("limits")_stripindex, // Check if overflowing
				overflowcontent = hotstrip_(1+min(len,lim)..len); // Get overflowing RegPolys
				obj = obj -- hotstrip_(1+min(len,lim)..len); //// Remove overflowing RegPolys from obj
				self():"strips"_stripindex = my("strips")_stripindex -- overflowcontent; // Remove overflowing RegPolys from strip
			);
		);

		// Animate RegPolys in ALL strips to new position
		my("scrollbar"):"adjustedvalue" = round(my("scrollbar"):"value"); // update to animate correctly on removing
		my("movepolysintoplace");

		// Toggle scrollbar visibility (on overflowing strip)
		my("scrollbar"):"setvisibility";

		// Reset dropcoord for next call
		dropcoord = NADA;
	);

// CONVENIENCE METHODS
// =====================

	cont:"movepolysintoplace" := ( // Animate Polygons to appropriate position for *all* strips
		regional(offset, strip, refpoint, poly);
		
		offset = my("scrollbar"):"adjustedvalue"; // value to shift all polys to the left by
		if(isundefined(offset), offset = 0); // if there is no scrollbar consider it to be 0

		// Handle which Polys are drawn (i.e. are put into and removed from obj)
		my("displaysubset");

		repeat(length(my("strips")), // Loop over every strip and refpoint
			strip = my("strips")_#;
			refpoint = my("refpoints")_#;

			repeat(length(strip), polyindex, // Loop over every RegPoly per strip
				poly = strip_polyindex;
				new animationobject(
					poly,
					"coord",
					poly:"coord",
					refpoint + (polyindex-1-offset) * [my("polyoffset"),0],
					my("timing"),
					my("timeflow")
				);
			);
		);

		// Reposition Separators too
		my("childseparator"):"realignchildren";

		// Update divomath states/results
		divomath update results();
	);

	cont:"popall" := ( // Removes all contents from all strips (and obj) and returns as one list
		regional(polygons);
		polygons = [];

		forall(my("strips"), strip, // iterate over strips
			forall(strip, // inside strips iterate over RegPolys
				polygons = polygons :> #; // add Poly to list
				eval(my("remove"), poly->#); // Remove Poly from strip
			);
		);

		obj = obj -- polygons; // Remove all Polys from obj

		polygons; // Return
	);

	cont:"displaysubset" := ( // Displays only a subset of RegPolys (and Separators) (for scrolling)
		regional(offset, polystodisplay);

		offset = my("scrollbar"):"adjustedvalue"; // offset by which to select Polys by
		if(isundefined(offset), offset = 0); // if there is no scrollbar consider it to be 0

		// Handle displaying
		forall(my("strips"), polys, // loop over every strip
			// remove all polys
			obj = obj -- polys;
			
			// get all polys that are to be displayed
			polystodisplay = polys_(1+offset..min(length(polys),my("hardpolylimit")+offset));

			// Put chosen polys back into obj
			obj = obj ++ polystodisplay;
		);

		polystodisplay; // Return it (just cause)
	);

// Somewhat more elaborate fields (i.e. separate objects)
// ======================================================
	cont:"showscrollbar" := my("scrollbar"):"max" > 0; // flag to show bar, if there is need to be able to scroll

	cont:"scrollbar" = (
		regional(offset, bar);

		// Create bar
		offset = [1.2*cont:"stripmargin", .5*cont:"stripmargin" + cont:"height"];
		bar = new HorizontalScrollbar(cont:"coord"+offset, cont:"width"-offset_1);
		
		// Config bar
		bar:"parent" = cont;
		bar:"hasbuttons" = true;
		bar:"max" := max(0,max(apply(my("parent"):"strips",length(#))) - my("parent"):"hardpolylimit");

		bar:"precision" := 1/max(1,my("max"));


		bar:"adjustedvalue" = round(bar:"value"); // rounded value, reset in "script", to have an event fire on change
		bar:"setvisibility" := ( // sets if bar is visible (called from parent when removing or adding Poly)
			if(my("parent"):"showscrollbar",
				obj = select(obj, # != self()) :> self(), // put self() in obj EXACTLY once
				obj = select(obj, # != self()) // remove self() from obj
			);
		);

		bar:"hitbox" := (
			regional(offset, scalefactor);
			offset = (my("shape")_4 - my("shape")_1)_2;
			scalefactor = .25;			
			[
				my("shape")_1 + scalefactor * [-0,-offset],
				my("shape")_2 + scalefactor * [0,-offset],
				my("shape")_3 + scalefactor * [0,offset],
				my("shape")_4 + scalefactor * [-0,offset]
			];
		);

		bar:"bar":"hitbox" := (
			[
				[my("shape")_1_1, my("parent"):"hitbox"_1_2],
				[my("shape")_2_1, my("parent"):"hitbox"_2_2],
				[my("shape")_3_1, my("parent"):"hitbox"_3_2],
				[my("shape")_4_1, my("parent"):"hitbox"_4_2],
			];
		);

		// Create script to change position of all of parents polys and Separators
		bar:"script" := (
			regional(adjval, currval);
			adjval = my("adjustedvalue"); // Current adjusted value
			currval = my("value"); // Current value (executes "script" in the first place)

			// Change adjusted value and toggle WHICH RegPolys and Separators are drawn WHERE
			if(adjval != round(currval),
				self():"adjustedvalue" = round(currval);
			);

			divomathSetState();

			my("parent"):"movepolysintoplace";
		);
		
		// Display bar at the start
		if(cont:"showscrollbar", obj = obj :> bar);

		bar; // Return
	);

	cont; // Return
);

new PatternContainer(coord, rows, limit) := (
	regional(cont);
	cont = new Container(coord, rows, apply(1..rows, #=limit));

	// Inherited from Container, don't use
	obj = obj -- [cont:"scrollbar"];
	cont:"showscrollbar" = false; // don't ever show scrollbar, scrollbar can't be NADA without breaking errors though.

	// Fields
	cont:"subtype" = "Pattern";
	cont:"bordersize" = 0;
	cont:"ismoveable" = false;
	cont:"copyonmove" = true;
	cont:"width" := (
		regional(numofpolys);
		numofpolys = max(apply(my("strips"),length(#))); // max number of polys in strip
		numofpolys = max(1, numofpolys); // min 1

		numofpolys * 2*size + (numofpolys) * my("polypadding") + if(numofpolys<my("limits")_1,.5*size,0);
	);
	cont:"move" := if(my("ismoveable"),
		// Move self
		self():"coord" = my("coord") + mousedelta;

		// Move contents (RegPolys)
		forall(my("strips"), strip,
			apply(strip,#:"coord" = #:"coord" + mousedelta); // should only have exactly one strip
		);
	);

	cont:"moveend" := if(my("ismoveable"), // Handle dropped PatternContainer
		// Get Container the Poly is dropped on
		regional(droptarget);

		droptarget = select(obj, #:"type" == "Container" & isundefined(#:"subtype") & #:"ishot"); // possibly multiple Containers
		droptarget = if(length(droptarget)>0,droptarget_1); // select first Container

		// Call drop-handler from droptarget
		eval(droptarget:"drop", dropobject->self());

		// Remove copy of PatternContainer from obj
		obj = obj -- [self()];

		// Remove contents from obj too, if no droptarget was found
		if(isundefined(droptarget), 
			apply(my("strips"), strip, obj = obj -- strip);
		);
	);

	cont:"copy" := (
		regional(copy, polycopy);
		copy = new PatternContainer(my("coord"), my("#strips"), my("limits")_1);
		copy:"ismoveable" = true;
		copy:"copyonmove" = false;

		// Copy RegPolys of original and put in only strip
		repeat(my("#strips"), stripindex,
			copy:"strips"_stripindex = apply(1..length(my("strips")_stripindex), my("strips")_stripindex_#:"copy");
		);

		forall(copy:"strips", strip,
			obj = obj ++ strip; // Add copies to obj
		);
		copy;
	);

	cont; // Return
);

// Local vars
'screenref = VRBOTTOMLEFT; // bottom left corner of visible area
'marginleft = 1; // distance from left border
'marginbottom = .5; // distance from bottom border
'screenref = 'screenref + size * [1,1] + ['marginleft,'marginbottom];


// D.1 | Create Polygons
// =====================
polys = []; // List of all initial RegPolys

// Create RegPolys and align at the bottom of the screen
repeat(length(vertices),
	polys = polys :> new RegPoly('screenref, size, vertices_#, 0, colors_#);
	polys_(-1):"copyonmove" = true;
	'screenref = 'screenref + (2*1.1*size+polypadding) * [1,0]; // next center to draw RegPoly
);

// Add bg highlight for polys
bg = {
	"type" : "bg",
	"shape": [
		VRBOTTOMLEFT  + ['marginleft/3, 'marginbottom/3],
		VRBOTTOMRIGHT - ['marginleft/3, -'marginbottom/3],
		VRBOTTOMRIGHT + 2*('marginbottom+size) * [0,1] - ['marginleft/3, 'marginbottom/3],
		VRBOTTOMLEFT  + 2*('marginbottom+size) * [0,1] + ['marginleft/3, -'marginbottom/3]
	]
};
if(drawpolys,	bg:"draw" := drawpoly(my("shape"),	color-> grey(.1)));

// D.2 | Create PatternContainer
// =============================
// Align left above bar of RegPolys
if(drawpatterncontainer,
	patterncontainer = new PatternContainer([0,0], rows, patternlimit);
);
patterncontainer:"coord" = if(drawpolys,
	(bg:"shape"_4).xy;
,
	(bg:"shape"_1).xy;
);
patterncontainer:"coord" = patterncontainer:"coord" + ['marginleft,'marginbottom];

// Fill Patterncontainer with predefined RegPolys
counter = 1; // start at first strip

patternstate = apply(patternstate, tokenize(#,",")); // Create config from supplied strings from divomath

forall(patternstate, row, // iterate over config for every row
	forall(select(row, #!=""), polyid, // iterate over every polyid per row that is not an empty string
		polycopy = polys_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)

		eval(patterncontainer:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip

		// (!) Put copy in obj on obj build, so they get drawn on top (see below)
	);
	counter = counter + 1; // next cycle --> next strip
);

patterncontainer:"timing" = .000001;
patterncontainer:"timeflow" = "jump";
patterncontainer:"movepolysintoplace";
patterncontainer:"timing" = .2;
patterncontainer:"timeflow" = "accel";

// D.3 | Create and config Container
// =================================
// Align with coord of bg
coordoffset = [0, .6+'marginbottom]; // .6 is axis length of Separators' ellipse

containercoord = if(drawpatterncontainer,
	// Align with pattern container
	patterncontainer:"coord" + coordoffset + [0,patterncontainer:"height"]
, 
	if(drawpolys,
		(bg:"shape"_4).xy + 2*coordoffset;
	,
		VRBOTTOMLEFT + coordoffset;
	)
);
containercoord = containercoord + ['marginleft,0];

container = new Container(containercoord,	rows,	limit); 

// Fill Container with predefined RegPolys
counter = 1; // start at first strip

state = apply(state, tokenize(#,",")); // Create config from supplied strings from divomath

forall(state, row, // iterate over config for every row
	forall(select(row, #!=""), polyid, // iterate over every polyid per row that is not an empty string
		polycopy = polys_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)

		eval(container:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip

		// (!) Put copy in obj on obj build, so they get drawn on top (see below)
	);
	counter = counter + 1; // next cycle --> next strip
);

// D.4 | Create Separator
// ======================
separator = new Separator(container:"coord", container:"height", container);

// Apply sepstate to initialize copies
sepstateinitial = sepstate; // Store original sepstate for divomath set state()
sepstate = set(tokenize(sepstate,","));
forall(select(sepstate,#!=""), pos, eval(separator:"putchild", position->pos));

container:"childseparator" = separator;

// ...=============================================================
// Make Container and corresponding Polys/Separators non-interactable if required
// ...Container itself
if(indexOf(interactable, "c") + indexOf(interactable, "C") == 0,
	container:"ishot" = false; // Container
);

// ...Polys in Container
if(indexOf(interactable, "p") + indexOf(interactable, "P") == 0,
	apply(container:"strips",strip,apply(strip,poly, poly:"ishot"=false)); // Polys
);

// ...Separators of Container
if(indexOf(interactable, "s") + indexOf(interactable, "S") == 0,
	separator:"ishot" = false; // Separator
	apply(container:"childseparator":"copies",sep,sep:"ishot"=false); // child Separators
);

// D.5 | Reset Button
// ==================
'screenref = VRTOPRIGHT; // top right corner of the visible area
'screenref = 'screenref - ['marginleft, 'marginbottom]; // coord of Button

btn = new ImageButton(NADA, buttonsize*sepsize*2, buttonsize*sepsize*1, ICONS:"reset");
btn:"coord" := (container:"shape"_3).xy - [my("width"),-'marginbottom] + if(container:"showscrollbar", [0,container:"scrollbar":"height"], [0,0]);
btn:"cornerradius" = max(btn:"width", btn:"height");
btn:"color" = DIVODARKBLUE;
btn:"bordercolor" = DIVODARKBLUE;
btn:"polysref" = polys; // reference for polys, since CindyJS does not access polys var properly
btn:"script" := ( // Resets state to editor default setting if used in divomath
	// Reassign relevant vars with appropriate values
	if(ISDIVOMATH,
		// default to divomath reference is exists or else default state
		state = divomathConfig:"__state";
		if(isundefined(state),
			state = defaultto(DIVOMATH'CINDYJSSTATEDEF:"state", apply(1..rows, ""));
		);
		state = apply(state, tokenize(#,","));

		sepstate = divomathConfig:"__sepstate";
		if(isundefined(sepstate),
			sepstate = defaultto(DIVOMATH'CINDYJSSTATEDEF:"sepstate", "");
		);
	,
		// non divomath reset
		sepstate = separator:"getstatestring";
	);

	// Remove all RegPolys
	forall(select(obj, #:"type" == "Container" & isundefined(#:"subtype")), #:"popall");
	if(length(polys) > 0,
		'polyid = polys_(-1):"id" + 1; // Reset global polyid
	);
	
	// Remove all Separators
	forall(select(obj, #:"type" == "Separator" & isundefined(#:"original") & isundefined(#:"parent":"subtype")), #:"popall");

	// Reset original state, @TODO: Same as in container init. Refactor
	regional(polycopy, counter);				
	counter = 1; // start at first strip
	
	forall(state, row, // iterate over config for every row
		forall(select(row, #!=""), polyid, // iterate over every polyid per row that is an integer
	
			// Create new Polys
			polycopy = my("polysref")_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)
			eval(container:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip	
		);
		counter = counter + 1; // next cycle --> next strip
	);

	container:"movepolysintoplace"; // align polys

	// Apply sepstate to initialize copies
	sepstate = set(tokenize(sepstate,","));
	forall(select(sepstate,#!=""), pos, eval(separator:"putchild", position->pos));
);

// D.6 | Reference Container
// =========================
rccontainer = new Container([0,0],	rcrows,	rclimit);
rccontainer:"subtype" = "ReferenceContainer";
rccontainer:"coord" = [container:"coord"_1, container:"coord"_2 + container:"height" + container:"scrollbar":"height" + btn:"height" + 4*'marginbottom];

// Fill Container with predefined RegPolys
counter = 1; // start at first strip

rcsepstateinitial = rcsepstate; // Store original rcsepstate for divomath set state()
rcstate = apply(rcstate, tokenize(#,",")); // Create config from supplied strings from divomath

forall(rcstate, row, // iterate over config for every row
	forall(select(row, #!=""), polyid, // iterate over every polyid per row that is not an empty string
		polycopy = polys_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)

		eval(rccontainer:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip

		// (!) Put copy in obj on obj build, so they get drawn on top (see below)
	);
	counter = counter + 1; // next cycle --> next strip
);

rccontainer:"timing" = .000001;
rccontainer:"timeflow" = "jump";
rccontainer:"movepolysintoplace"; // align polys
rccontainer:"timing" = .2;
rccontainer:"timeflow" = "jump";

// D.6 | Reference Containers Separator
// ====================================
rcseparator = new Separator(rccontainer:"coord", rccontainer:"height", rccontainer);

// Apply sepstate to initialize copies
rcsepstate = set(tokenize(rcsepstate,","));
forall(select(rcsepstate,#!=""), pos, eval(rcseparator:"putchild", position->pos));

rcseparator:"coord" := rccontainer:"coord";
rccontainer:"childseparator" = rcseparator;

// ...==================================================
// Make Container and Polys non-interactable if required
// rcinteractable is bool (for backwards compatibility)
if(isbool(rcinteractable),
	if(!rcinteractable,
		rccontainer:"ishot" = false;
		apply(rccontainer:"strips",strip,apply(strip,poly, poly:"ishot"=false));
		rcseparator:"ishot" = false; // Separator
		apply(rccontainer:"childseparator":"copies",sep,sep:"ishot"=false); // child Separators
	);
, // else: As string "cps" or subset
	// ...Container itself
	if(indexOf(rcinteractable, "c") + indexOf(rcinteractable, "C") == 0,
		rccontainer:"ishot" = false; // Container
	);
	
	// ...Polys in Container
	if(indexOf(rcinteractable, "p") + indexOf(rcinteractable, "P") == 0,
		apply(rccontainer:"strips",strip,apply(strip,poly, poly:"ishot"=false)); // Polys
	);
	
	// ...Separators of Container
	if(indexOf(rcinteractable, "s") + indexOf(rcinteractable, "S") == 0,
		rcseparator:"ishot" = false; // Separator
		apply(rccontainer:"childseparator":"copies",sep,sep:"ishot"=false); // child Separators
	);
);


// E | Build obj
// =============
obj = obj :> bg;
if(drawresetbutton, obj = obj :> btn); // Reset button
obj = obj :> container;
obj = obj :> patterncontainer;
if(drawpolys, obj = obj ++ polys);
obj = obj ++ flatten(container:"strips"); // Initial Polys of Container build at Container init
if(drawseparator,obj = obj :> separator);
if(drawrccontainer,obj = obj :> rccontainer);
if(drawrcseparator,obj = obj :> rcseparator);

// Order to draw (Separator last, so it is on top)
typeorder = ["bg", "Container", "RegPoly", "Separator"];


// Remove overflowing polys from view and show scrollbar (for some reason this only works properly here!?)
container:"timing" = .000001;
container:"timeflow" = "jump";
container:"dropcontainer";
container:"timing" = .2;
container:"timeflow" = "jump";
);
//[VAM] thales
/** v3 *****************************************************************************************
* Interactable to explore thales theorem and its inverse
*
* Recent changes:
* 2026-07-29: Refactor configuration settings
* 2026-07-29: Invert softc so true actually provides a soft construction
* 2026-07-29: Completely redo DisplayHandler Class for a scrollable one column interface
* 2026-07-30: Add highlighting when Point C is selected
* 2026-07-30: Change how reset button and toggles initially get their position
* 2026-07-30: Rework tracing behavior
* 2026-07-30: Change scaling of angle labels
* 2026-08-03: Darker red for remove button in angle list
* 2026-08-07: Draw button for removing point without symbol, but with geometry
************************************************************************************************/


// Satz des Thales und Umkehrung
if(VAM == "thales",


// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

// --- Geometry: Starting positions ---
A											= default to(ENVIRONMENTALPARAMS:"A", [7,5], true);
B											= default to(ENVIRONMENTALPARAMS:"B", [18,10], true);
C											= default to(ENVIRONMENTALPARAMS:"C", [12,12], true);

// --- Moveability and Snapping ---
amoveable							= default to(ENVIRONMENTALPARAMS:"amoveable", false, true);
bmoveable							= default to(ENVIRONMENTALPARAMS:"bmoveable", false, true);
snap									= default to(ENVIRONMENTALPARAMS:"snap", true, true); // When moving C, snap to circle(M, AB)
snappingdifference		= default to(ENVIRONMENTALPARAMS:"snappingdifference", 5, true); // Distance to right angle in deg
generalsnapsize				= default to(ENVIRONMENTALPARAMS:"generalsnapsize", 5, true); // Snap to every multiple of that angle in deg
generalsnapdifference	= default to(ENVIRONMENTALPARAMS:"generalsnapdifference", .5, true); // Snap to generalsnapsize if difference is less than this
softc									= default to(ENVIRONMENTALPARAMS:"softc", true, true); // Soft construction if TRUE

// --- Visibility: Geometry ---
drawcenter						= default to(ENVIRONMENTALPARAMS:"drawcenter", true, true);
drawcircle						= default to(ENVIRONMENTALPARAMS:"drawcircle", true, true);

// --- Visibility: UI elements ---
showstampbutton				= default to(ENVIRONMENTALPARAMS:"showstampbutton", true, true);
showundobutton				= default to(ENVIRONMENTALPARAMS:"showundobutton", true, true);
showresetbutton				= default to(ENVIRONMENTALPARAMS:"showresetbutton", true, true);
showconstructionbutton= default to(ENVIRONMENTALPARAMS:"showconstructionbutton", true, true);
showhelpbutton				= default to(ENVIRONMENTALPARAMS:"showhelpbutton", true, true);

// --- Visibility: Toggles ---
drawtogglealpha				= default to(ENVIRONMENTALPARAMS:"drawtogglealpha", true, true);
drawtogglebeta				= default to(ENVIRONMENTALPARAMS:"drawtogglebeta", true, true);
drawtogglegamma				= default to(ENVIRONMENTALPARAMS:"drawtogglegamma", true, true);
drawtogglegamma1			= default to(ENVIRONMENTALPARAMS:"drawtogglegamma1", true, true);
drawtogglegamma2			= default to(ENVIRONMENTALPARAMS:"drawtogglegamma2", true, true);
drawtogglevalues			= default to(ENVIRONMENTALPARAMS:"drawtogglevalues", true, true);
drawtoggleCM					= default to(ENVIRONMENTALPARAMS:"drawtoggleCM", false, true); //  @deprecated, never true (see toggle init)

// --- Initial toggle states (also triggers, when hidden) ---
showalpha							= default to(ENVIRONMENTALPARAMS:"showalpha", false, true);
showbeta							= default to(ENVIRONMENTALPARAMS:"showbeta", false, true);
showgamma							= default to(ENVIRONMENTALPARAMS:"showgamma", true, true);
showgamma1						= default to(ENVIRONMENTALPARAMS:"showgamma1", false, true);
showgamma2						= default to(ENVIRONMENTALPARAMS:"showgamma2", false, true);
showanglevalues				= default to(ENVIRONMENTALPARAMS:"showanglevalues", false, true);
showhelp							= default to(ENVIRONMENTALPARAMS:"showhelp", true, true);
showCM								= default to(ENVIRONMENTALPARAMS:"showCM", true, true); // @deprecated, always true

// --- Stamps / Trace ---
stampmode							= default to(ENVIRONMENTALPARAMS:"stampmode", "stamp", false); // "stamp" or "trace"
stampbuttonimage			= default to(ENVIRONMENTALPARAMS:"stampbuttonimage", "stamp", false); // "stamp" or "measure-angle"
stickstampbuttontopoint= default to(ENVIRONMENTALPARAMS:"stickstampbuttontopoint", false, true);
showstampedpoints			= default to(ENVIRONMENTALPARAMS:"showstampedpoints", true, true);
showstampedvalues			= default to(ENVIRONMENTALPARAMS:"showstampedvalues", true, true);
drawtrace							= default to(ENVIRONMENTALPARAMS:"drawtrace", false, true);
tracesize							= default to(ENVIRONMENTALPARAMS:"tracesize", 4, true); // line size of trace
tracecolor						= default to(ENVIRONMENTALPARAMS:"tracecolor", DIVOBLUE, true);
traceminstep					= default to(ENVIRONMENTALPARAMS:"traceminstep", .1, true); // min difference between trace points

// --- Angle display ---
showcurrentanglevalue	= default to(ENVIRONMENTALPARAMS:"showcurrentanglevalue", true, true);
anglevaluesinline			= default to(ENVIRONMENTALPARAMS:"anglevaluesinline", true, true);
displayanglefontsize	= default to(ENVIRONMENTALPARAMS:"displayanglefontsize", 24, true); // Fontsize for list of measured angles
displayanglefully			= default to(ENVIRONMENTALPARAMS:"displayanglefully", false, true); // Show "gamma =" or not when showing stamped angles
defaultanglesizes			= default to(ENVIRONMENTALPARAMS:"defaultanglesizes", [3,3,2,3,3], true); // Default radii of the five arcs in order [a,b,g,g1,g2]
anglelabelsize				= default to(ENVIRONMENTALPARAMS:"anglelabelsize", 18, true); // Base size for alpha/beta/gamma1/gamma2
anglelabelgammafactor	= default to(ENVIRONMENTALPARAMS:"anglelabelgammafactor", 1.3, true); // gamma slightly bigger
anglelabelminscale		= default to(ENVIRONMENTALPARAMS:"anglelabelminscale", .65, true); // lower bound (1 = no shrinking at all)

// --- Look and feel ---
pointlabelsize				= default to(ENVIRONMENTALPARAMS:"pointlabelsize", 24, true);
linelabelsize					= default to(ENVIRONMENTALPARAMS:"linelabelsize", 18, true);
linesize							= default to(ENVIRONMENTALPARAMS:"linesize", 1.5, true);
circlelinesize				= default to(ENVIRONMENTALPARAMS:"circlelinesize", 1.5, true);
circlelinecolor				= default to(ENVIRONMENTALPARAMS:"circlelinecolor", .3*[1,1,1], true);
imgoffset							= default to(ENVIRONMENTALPARAMS:"imgoffset", [0,.65], true);
jumptostamp 					= default to(ENVIRONMENTALPARAMS:"jumptostamp", false, true);
stampgradient					= default to(ENVIRONMENTALPARAMS:"stampgradient", true, true); // color gradient of stamps with regards to the distance to M
stampgradientstrength	= default to(ENVIRONMENTALPARAMS:"stampgradientstrength", .8, true); // 0 = no gradient, 1 = full gradient
stampcolor						= default to(ENVIRONMENTALPARAMS:"stampcolor", [.8,.2,.2], true); // color if no gradient
 
// --- Positions (NADA = auto align) ---
toolbarmargin					= default to(ENVIRONMENTALPARAMS:"toolbarmargin", .3, true);
backbuttoncoord				= default to(ENVIRONMENTALPARAMS:"backbuttoncoord", NADA, true);
resetbuttoncoord			= default to(ENVIRONMENTALPARAMS:"resetbuttoncoord", NADA, true);
stampbuttoncoord			= default to(ENVIRONMENTALPARAMS:"stampbuttoncoord", NADA, true);
constructionbuttoncoord= default to(ENVIRONMENTALPARAMS:"constructionbuttoncoord", NADA, true);
helpbuttoncoord				= default to(ENVIRONMENTALPARAMS:"helpbuttoncoord", NADA, true);
togglerefcoord				= default to(ENVIRONMENTALPARAMS:"togglerefcoord", NADA, true);
gammadisplaycoord			= default to(ENVIRONMENTALPARAMS:"gammadisplaycoord", NADA, true);
gammalistcoord				= default to(ENVIRONMENTALPARAMS:"gammalistcoord", NADA, true);


// ===================== //
// C | Class Definitions //
// ===================== //

/**
* Base thales construction based on the diameter AB and point C on circle
*/
new ThalesTrig(A,B,C) := (
	regional(trig);
	trig = new VAMobject("Thales");
	trig:"A" = A; trig:"B" = B; trig:"C" = C;
	trig:"M" := centroid([my("A"),my("B")]);
	trig:"coord" := my("A");
	trig:"/BAC" := angle(my("B"),my("A"),my("C")); // Angle BAC
	trig:"alpha" := if(my("/BAC")>PI, 2*PI-(my("/BAC")), (my("/BAC")));
	trig:"/CBA" := angle(my("C"),my("B"),my("A")); // Angle CBA
	trig:"beta" := if(my("/CBA")>PI, 2*PI-(my("/CBA")), (my("/CBA")));
	trig:"/ACB" := angle(my("A"),my("C"),my("B")); // Angle ACB
	trig:"gamma" := if(my("/ACB")>PI, 2*PI-(my("/ACB")), (my("/ACB")));
	trig:"/ACM" := angle(my("A"),my("C"),my("M")); // Angle ACM
	trig:"gamma1" := if(my("/ACM")>PI, 2*PI-(my("/ACM")), (my("/ACM")));
	trig:"/MCB" := angle(my("M"),my("C"),my("B")); // Angle MCB
	trig:"gamma2" := my("gamma") - my("gamma1");

	trig:"stamps" = []; // stamps of C

	trig:"firstmove" = true; // Flag to execute movestart once when starting to move a thing
	trig:"ismoveable" = true;
	trig:"softc" = false;
	trig:"font" = NADA;
	trig:"thresh" = 1;

	trig:"history" = []; // history of actions
	trig:"anglecolor" = [DZLMCOLORGOLD,DIVOBLUE,DZLMCOLORDARK,DIVORED,DIVOVIOLET];
	trig:"pointcolor" = [DIVOBLUE, DIVOBLUE, DIVOBLUE];
	trig:"displaycolor" = DZLMCOLORDARK;
	trig:"opacity" = .15; // ...of angle fill
	trig:"defaultanglesize" = defaultanglesizes;
	trig:"anglescaling" = .4;
	trig:"anglesize" := [
		min(min(my("anglescaling")*dist(my("A"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_1), // alpha
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("B"),my("A"))), my("defaultanglesize")_2), // beta
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_3), // gamma
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_4), // gamma1 (facing alpha)
		min(min(my("anglescaling")*dist(my("C"),my("B")),my("anglescaling")*dist(my("C"),my("A"))), my("defaultanglesize")_5), // gamma2 (facing beta)
	];

	trig:"anglelabelsize" = anglelabelsize;
	trig:"anglelabelgammafactor" = anglelabelgammafactor;
	trig:"anglelabelminscale" = anglelabelminscale;
 
	// One shared scale factor for all angle labels, so they stay consistent
	// with each other. Uses the SMALLEST of the five ratios, damped by sqrt
	// and clamped from below.
	trig:"anglelabelscale" := (
		regional(ratios, s);
		ratios = apply(1..5, my("anglesize")_# / my("defaultanglesize")_#);
		s = min(ratios);
		s = sqrt(max(s, 0));								// damp: shrink less aggressively
		max(s, my("anglelabelminscale"));		// never smaller than this
	);
	
	trig:"snap" = snap;
	trig:"snapdifference" = snappingdifference;
	trig:"amoveable" = amoveable;
	trig:"bmoveable" = bmoveable;

	trig:"gammavalueposition" = NADA;
	trig:"gammavaluedisplaywidth" = 7;
	trig:"gammavaluedisplayheight" = 2;

	trig:"showstampedpoints" = true;
	trig:"showstampedvalues" = false;
	trig:"showstampbutton" = true;
	trig:"showconstructionbutton" = false;
	trig:"showhelpbutton" = false;
	trig:"showcurrentanglevalue" = true;
	trig:"anglevaluesinline" = anglevaluesinline;

	trig:"drawalpha" = true;
	trig:"drawbeta" = true;
	trig:"drawgamma" = true;
	trig:"drawgamma1" = true;
	trig:"drawgamma2" = true;
	trig:"drawradius" = true;
	trig:"drawcenter" = false;
	trig:"drawcircle" = false;

	trig:"pointlabelsize" = pointlabelsize;
	trig:"linelabelsize" = linelabelsize;
	trig:"linesize" = linesize;
	trig:"circlelinesize" = circlelinesize;
	trig:"circlelinecolor" = circlelinecolor;
	trig:"stampmode" = stampmode;
	trig:"drawtrace" = drawtrace;

	trig:"stampgradient" = stampgradient;
	trig:"stampgradientstrength" = stampgradientstrength;
	trig:"stampcolor" = stampcolor;

	trig:"traces" = [];					// list of segments, each a list of points
	trig:"recordingtrace" = drawtrace;	// is the trace currently being recorded?
	trig:"tracesize" = tracesize;
	trig:"tracecolor" = tracecolor;
 
	// Starts a new segment. Called when recording is switched on.
	trig:"starttracesegment" := (
		self():"traces" = my("traces") :> [];
	);
 
	// Appends the current position to the active segment, but only if it moved
	// far enough - otherwise the list grows by hundreds of points per second.
	trig:"appendtrace" := (
		if(length(my("traces")) == 0, my("starttracesegment"));
		if(length(my("traces")_(-1)) == 0,
			self():"traces"_(-1) = [my("C")];
		,
			if(dist(my("traces")_(-1)_(-1), my("C")) >= traceminstep,
				self():"traces"_(-1) = my("traces")_(-1) :> my("C");
			);
		);
	);

	trig:"ishot" := (
		regional(ishot);
		ishot = NADA;
		if(dist(mouse().xy, my("A")) <= my("thresh"), ishot = "A");
		if(dist(mouse().xy, my("B")) <= my("thresh"), ishot = "B");
		if(dist(mouse().xy, my("C")) <= my("thresh"), ishot = "C");
		self():"lasthot" = ishot;

		!isundefined(ishot);
	);
	trig:"lasthot" = NADA;
	
	trig:"draw" := (
		// Draw circle
		if(my("drawcircle"),drawcircle(centroid([my("A"),my("B")]), .5*dist(my("A"),my("B")), size->my("circlelinesize"), color->my("circlelinecolor")));

		// Draw stamps / trace
		if(my("stampmode") == "stamp",
			if(my("showstampedpoints"),
				forall(my("stamps"),
					regional(col, distance, refdistance, ratio);
					if(my("stampgradient"),
						distance = dist(#, my("M"));
						// Reference: half the diagonal of the visible rect (bottom left to top right)
						refdistance = dist(VISIBLERECT_1, VISIBLERECT_3) / 2;
						ratio = min(distance / refdistance, 1);
						col = [
							.8,
							.1 + (1 - ratio) * my("stampgradientstrength"),
							.1 + ratio * my("stampgradientstrength")
						];
					,
						col = my("stampcolor");
					);
					draw(#, size->my("size"), color->col);
				);
			);
		, 
			if(my("stampmode") == "trace",
				forall(my("traces"),
					if(length(#) > 1,
						connect(#, size->my("tracesize"), color->my("tracecolor"));
					);
				);
			);
		);

		// Draw gamma value background
		if(my("showcurrentanglevalue"),
			regional(w, h, bgbox, textbox);
			w=my("gammavaluedisplaywidth"); h=my("gammavaluedisplayheight");
			bgbox = rectangle(my("gammavalueposition"), w, h);
			fill(roundedrectangle(my("gammavalueposition"), w, h, .2), color->my("displaycolor"), alpha->.2);

			// Draw gamma value
			regional(anglevalue, hascomma, pos);
			anglevalue = my("gamma")+0; // always rad
			anglevalue = anglevalue / PI * 180; // Convert to deg
			anglevalue = replace(format(anglevalue,2),".",","); // format correctly
			hascomma = indexof(anglevalue,",") == 0;
			if(hascomma, anglevalue = anglevalue + ",00"); // add 2 zeros if no decimal
			if(anglevalue_(-2) == ",", anglevalue = anglevalue + "0"); // add 1 zero if only one decimal
			anglevalue = anglevalue + "°"; // add degree symbol

			pos = centroid(bgbox);
			textbox = getboundingbox(anglevalue,pos,24, my("font"), bold->true);
			pos = pos + .5*(textbox_1 - textbox_3);	

			draw textbox(pos + [-.4,.15], GREEK:"g" + " = " + anglevalue, 20, my("font"), my("displaycolor"), NADA, bold->true);
		);

		// Draw angle values if not drawn inline with angles
		if(my("drawanglevalues") & !my("anglevaluesinline"),
			regional(refcoord, yoffset, fontsize, label);
			yoffset = 1.3;
			refcoord = drawanglevalues:"coord" - [-1,1.5];
			fontsize = 20;
			// Alpha
			label = GREEK:"a" + " = " + replace(format(todeg(my("alpha")),2),".",",") + "°";
			draw textbox(refcoord, label, fontsize, my("font"), my("anglecolor")_1, NADA);
			// Beta
			refcoord = refcoord - [0,yoffset];
			label = GREEK:"b" + " = " + replace(format(todeg(my("beta")),2),".",",") + "°";
			draw textbox(refcoord, label, fontsize, my("font"), my("anglecolor")_2, NADA);
			// Gamma1
			refcoord = refcoord - [0,yoffset];
			label = GREEK:"g"+SUB:"1" + " = " + replace(format(todeg(my("gamma1")),2),".",",") + "°";
			draw textbox(refcoord, label, fontsize, my("font"), my("anglecolor")_4, NADA);
			// Gamma2
			refcoord = refcoord - [0,yoffset];
			label = GREEK:"g"+SUB:"2" + " = " + replace(format(todeg(my("gamma2")),2),".",",") + "°";
			draw textbox(refcoord, label, fontsize, my("font"), my("anglecolor")_5, NADA);
		);

		// DRAW ANGLES
		regional(mc, ma, mb, a,b,c, bisectorpoint, offset, customoffset, anglelabel);
		a = vectorlength(my("B")-my("C"));
		b = vectorlength(my("A")-my("C"));
		c = vectorlength(my("A")-my("B"));
		ma = vectorlength(my("A")-my("M"));
		mb = vectorlength(my("B")-my("M"));
		mc = vectorlength(my("C")-my("M"));

		// Draw and fill alpha
		if(my("drawalpha"),
		
			// Draw
			if(my("/ACB") < PI,
				drawangle(my("B"),my("A"),my("C"),my("anglesize")_1, color->my("anglecolor")_1),
				drawangle(my("C"),my("A"),my("B"),my("anglesize")_1, color->my("anglecolor")_1)
			);
			
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("B"),my("A"),my("C"),my("anglesize")_1, color->my("anglecolor")_1, alpha->my("opacity")),
				fillangle(my("C"),my("A"),my("B"),my("anglesize")_1, color->my("anglecolor")_1, alpha->my("opacity"))
			);
			
			// Draw label
			anglelabel = GREEK:"a" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("alpha")+0)*180/PI,2),".",",") + "°", "");
			label angle(
				my("B"), my("A"), my("C"),
				my("anglesize")_1,
				anglelabel,
				my("anglelabelsize")*my("anglelabelscale"),
				my("font"),
				'fontcolor->my("anglecolor")_1
			);
		);

		// Draw and fill beta
		if(my("drawbeta"),
		
			// Draw
			if(my("/ACB") < PI,
				drawangle(my("C"),my("B"),my("A"),my("anglesize")_2, color->my("anglecolor")_2),
				drawangle(my("A"),my("B"),my("C"),my("anglesize")_2, color->my("anglecolor")_2)
			);
			
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("C"),my("B"),my("A"),my("anglesize")_2, color->my("anglecolor")_2, alpha->my("opacity")),
				fillangle(my("A"),my("B"),my("C"),my("anglesize")_2, color->my("anglecolor")_2, alpha->my("opacity"))
			);
			
			// Draw label
			anglelabel = GREEK:"b" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("beta")+0)*180/PI,2),".",",") + "°", "");
			label angle(
				my("C"), my("B"), my("A"),
				my("anglesize")_2,
				anglelabel,
				my("anglelabelsize")*my("anglelabelscale"),
				my("font"),
				'fontcolor->my("anglecolor")_2
			);
		);

		// Draw and fill gamma1
		if(my("drawgamma1"),
		
			// Set color based on help button and position of C on circle
			regional(currentcolor);
			currentcolor = if(my("showhelp") & my("gamma")~=PI/2, my("anglecolor")_1, my("anglecolor")_4);

			// Draw arc
			if(my("/ACB") < PI,
				drawarc(my("A"),my("C"),my("M"),my("anglesize")_4, color->currentcolor),
				drawarc(my("M"),my("C"),my("A"),my("anglesize")_4, color->currentcolor)
			);

			// Draw sides of angle
			connect([my("C")+my("anglesize")_4*normalize(my("A")-my("C")), my("C")+my("anglesize")_3*normalize(my("A")-my("C"))], color->currentcolor);
			connect([my("C")+my("anglesize")_4*normalize(my("M")-my("C")), my("C")+if(my("drawgamma"),my("anglesize")_3*normalize(my("M")-my("C")),[0,0])], color->currentcolor);
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("A"),my("C"),my("M"),my("anglesize")_4,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity")),
				fillangle(my("M"),my("C"),my("A"),my("anglesize")_4,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity"))
			);

			// Draw label
			anglelabel = GREEK:"g"+SUB:"1" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("gamma1")+0)*180/PI,2),".",",") + "°", "");
			label angle(
				my("A"), my("C"), my("M"),
				my("anglesize")_4,
				anglelabel,
				my("anglelabelsize")*my("anglelabelscale"),
				my("font"),
				'fontcolor->currentcolor
			);
		);

		// Draw and fill gamma2
		if(my("drawgamma2"),
		
			// Set color based on help button and position of C on circle
			regional(currentcolor);
			currentcolor = if(my("showhelp") & my("gamma")~=PI/2, my("anglecolor")_2, my("anglecolor")_5);

			// Draw arc
			if(my("/ACB") < PI,
				drawarc(my("M"),my("C"),my("B"),my("anglesize")_5, color->currentcolor),
				drawarc(my("B"),my("C"),my("M"),my("anglesize")_5, color->currentcolor)
			);
			
			// Draw sides of angle
			connect([my("C")+my("anglesize")_5*normalize(my("B")-my("C")), my("C")+my("anglesize")_3*normalize(my("B")-my("C"))], color->currentcolor);
			connect([my("C")+my("anglesize")_5*normalize(my("M")-my("C")), my("C")+if(my("drawgamma"),my("anglesize")_3*normalize(my("M")-my("C")),[0,0])], color->currentcolor);

			// Fill
			if(my("/ACB") < PI,
				fillangle(my("M"),my("C"),my("B"),my("anglesize")_5,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity")),
				fillangle(my("B"),my("C"),my("M"),my("anglesize")_5,if(my("drawgamma"),my("anglesize")_3,0), color->currentcolor, alpha->my("opacity"))
			);
			
			// Draw label
			anglelabel = GREEK:"g"+SUB:"2" + if(my("drawanglevalues")&my("anglevaluesinline"), " = " + replace(format((my("gamma2")+0)*180/PI,2),".",",") + "°", "");
			label angle(
				my("M"), my("C"), my("B"),
				my("anglesize")_5,
				anglelabel,
				my("anglelabelsize")*my("anglelabelscale"),
				my("font"),
				'fontcolor->currentcolor
			);
		);

		// Draw and fill gamma
		if(my("drawgamma"),
		
			// Draw
			if(my("/ACB") < PI,
				drawangle(my("A"),my("C"),my("B"),my("anglesize")_3, color->my("anglecolor")_3),
				drawangle(my("B"),my("C"),my("A"),my("anglesize")_3, color->my("anglecolor")_3)
			);
			
			// Fill
			if(my("/ACB") < PI,
				fillangle(my("A"),my("C"),my("B"),my("anglesize")_3, color->my("anglecolor")_3, alpha->my("opacity")),
				fillangle(my("B"),my("C"),my("A"),my("anglesize")_3, color->my("anglecolor")_3, alpha->my("opacity"))
			);
			
			// Draw label
			label angle(
				my("A"), my("C"), my("B"),
				my("anglesize")_3,
				GREEK:"g",
				my("anglelabelsize")*my("anglelabelgammafactor")*my("anglelabelscale"),
				my("font"),
				'fontcolor->my("anglecolor")_3
			);
		);

		// Draw edges
		forall(pairs([trig:"A",trig:"B",trig:"C"]), connect(#, size->my("linesize"), color->grey(0))); // ~ of trig
		if(my("drawradius") & (my("drawgamma1") % my("drawgamma2")), connect([my("C"), centroid([my("A"),my("B")])], color->grey(0)));

		// Draw edge labels
		eval(label segment(my("A"), my("B"), my("C"), "c", my("linelabelsize"), my("font")), 'labelposition->.6);
		eval(label segment(my("B"), my("C"), my("A"), "a", my("linelabelsize"), my("font")));
		eval(label segment(my("A"), my("C"), my("B"), "b", my("linelabelsize"), my("font")));

		// Draw points
		draw(trig:"A", color->my("pointcolor")_1, size->my("size"));
		draw(trig:"B", color->my("pointcolor")_2, size->my("size"));
		draw(trig:"C", color->my("pointcolor")_3, size->my("size"));
		if(my("drawcenter"), draw(centroid([my("A"),my("B")]), color->grey(.6), size->my("size")-1));

		// Draw Point Labels
		offsetA = -[.8,.6] * my("pointlabelsize") / 24;
		offsetB = [.4,-.5];
		offsetC = [.2,.1];
		draw textbox(my("A") + offsetA, "A", my("pointlabelsize"), my("font"), NADA, bold->false);
		draw textbox(my("B") + offsetB, "B", my("pointlabelsize"), my("font"), NADA, bold->false);
		draw textbox(my("C") + offsetC, "C", my("pointlabelsize"), my("font"), NADA, bold->false);
		if(my("drawcenter"),
			regional(offsetM);
			offsetM = [-1,0] * my("pointlabelsize") / 24;
			draw textbox(my("M") + offsetM, "M", my("pointlabelsize"), my("font"), grey(0), NADA, bold->false);
		);

		// Highlight the point currently being dragged
		if(MOUSEDOWN & my("lasthot") == "C", 
			drawcircle(my("C"), my("thresh"), color->my("pointcolor")_3, size->2, alpha->.5);
		);

		// Highlight the stamp belonging to the selected list entry
		if(!isundefined(my("anglelist")),
			regional(hi);
			hi = my("anglelist"):"hotboxindex";
			if(!isundefined(hi) & hi <= length(my("stamps")),
				drawcircle(my("stamps")_hi, .5, color->DZLMCOLORGOLD, size->3);
			);
		);
	);

	trig:"move" := if(my("ismoveable"),
		// Trigger movestart event once per drag event
		if(my("firstmove"),
			my("movestart");
			self():"firstmove" = !my("firstmove");
		);

		// Handle moving of points
		if(my("amoveable") & my("lasthot")=="A", self():"A" = my("A") + mousedelta); // Move A with mouse
		if(my("bmoveable") & my("lasthot")=="B", self():"B" = my("B") + mousedelta); // Move B with mouse
		if(my("lasthot")=="C", self():"C" = my("C") + mousedelta); // Move C with mouse

		// Handle clamping at frame edges
		regional(screen, margin);
		screen = reverse(apply(screenbounds(), #.xy));
		margin = 1;
		self():"C" = [
				min(max(my("C")_1,screen_1_1+margin),screen_2_1-margin),
				min(max(my("C")_2,screen_1_2+margin),screen_4_2-margin)
			];

		// Handle snapping to 90°
		if((my("snap") & dist(my("gamma"), PI/2) < my("snapdifference")° & my("lasthot") == "C") % !my("softc"),
			self():"C" = my("M") + .5*dist(my("B"),my("A"))*normalize(my("C") - my("M"));			
		);

		// Handle general snapping to multiple of fixed angle
		regional(step, target);
		step = generalsnapsize / 180 * PI; // step size in rad
		target = round(my("gamma")/step)*step; // target angle to snap to

		if(dist(my("gamma"),target) < generalsnapdifference*PI/180, // Start snap handling
			regional(ab,ac);
			ab = my("B") - my("A");
			ac = my("C") - my("A");

			// --- edge case when gamma =~ PI ---
			if(dist(PI,target) < 10^(-6),
				regional(t);
				t = (ac*ab) / (ab*ab); // Calc projection parameter (vec*vec is scalar product, t=0 projection to A, t=1 projection to B)
				self():"C" = my("A") + t * ab;		
			,
				// ELSE
				// --- default case: Circle with viewing angle target with cord AB ---
				if(sin(target) > 10^(-6), // don't divide by zero later
					regional(L, normalvec, radius, h);
					L = vectorlength(ab);
					normalvec = [-ab_2, ab_1] / L; // normalized normal vector to ab

					radius = L / (2*sin(target)); // radius
					h = L / (2*tan(target)); // distance between midpoint of AB and midpoint of viewing angle circle (just draw a picture)

					// Choose side: same side as C relative to AB
					regional(sign, midpoint);
					sign = if(det([[ab_1,ab_2],[ac_1,ac_2]]) >= 0, 1, -1); // get orientation for correct circle
					O = my("M") +  sign * h * normalvec; // Midpoint (works, DRAW A PICTURE);	

					// Get next point on the circle (through radial projection)
					w = my("C") - O;
					if(vectorlength(w) > 10^(-9),	// failsafe, for when length of w =~ 0, so not to divide by 0
						self():"C" = O + radius * w / vectorlength(w);
					);
				);
			);
		);

		// Handle tracing
		if(my("stampmode") == "trace" & my("recordingtrace"), my("appendtrace"));
	);

	trig:"movestart" := (
		// Update history
		self():"history" = my("history") ++ [{"action" : "move", "object": "C", "oldcoord" : my("C"), "newcoord" : NADA}];
	);
	
	trig:"moveend" := if(my("ismoveable"),
		log point moved("C", my("C").xy);
		
		// Update history and reset firstmove flag
		self():"history"_(-1):"newcoord" = my("C");
		self():"firstmove" = !my("firstmove");
	);

	self():"lasthot" = NADA; // Reset last hot element

	trig; // Return ThalesTrig
);

/**
* Handler for tablelike displaying of stamped values.
* Always single column, right aligned, scrollable if the list does not fit.
*/ 
new DisplayHandler(coord) := (
	regional(display);
	display = new VAMobject("DisplayHandler");
	display:"coord" = coord; // bottom left corner of the TOPMOST box
	display:"labels" = NADA; // (list) set after init
	display:"rows" := length(my("labels"));

	// --- Scrolling state ---
	display:"scrolloffset" = 0;  // number of entries hidden above the visible area
	display:"lastrowcount" = 0;  // to detect newly added entries (auto follow)

	// --- Look and feel ---
	display:"boxcolors" = [grey(.83), grey(.93)];
	display:"highlightcolor" = DZLMCOLORGOLD;

	display:"fontcolor" = grey(0);
	display:"fontsize" = displayanglefontsize;
	display:"font" = NADA;
	display:"bold" = false;

	display:"boxradius" = .2;
	display:"boxpadding" = .2;

	// --- Buttons ---
	display:"removebutton" = (
		regional(button);
		button = new Button([0,0],.7,.7, "", NADA);
		button:"cornerradius" = .35;
		button:"color" = DARKRED;
		button:"bordercolor" := my("color");
		button:"fontcolor" = grey(1);

		button:"drawafter" := my("drawcross");

		button; // Return
	);

	display:"scrollupbutton" = (
		regional(button);
		button = new Button([0,0], .9, .7, UPARROW, NADA);
		button:"parent" = display;
		button:"cornerradius" = .2;
		button:"color" = grey(.85);
		button:"bordercolor" = grey(.55);
		button:"fontcolor" = grey(.1);
		button:"hasshadow" = false;
		button:"show" := my("parent"):"needsscrolling";
		button:"script" := (
			my("parent"):"scrolloffset" = max(0, my("parent"):"scrolloffset" - 1);
		);

		button; // Return
	);

	display:"scrolldownbutton" = (
		regional(button);
		button = new Button([0,0], .9, .7, DOWNARROW, NADA);
		button:"parent" = display;
		button:"cornerradius" = .2;
		button:"color" = grey(.85);
		button:"bordercolor" = grey(.55);
		button:"fontcolor" = grey(.1);
		button:"hasshadow" = false;
		button:"show" := my("parent"):"needsscrolling";
		button:"script" := (
			my("parent"):"scrolloffset" = min(
				my("parent"):"maxscrolloffset",
				my("parent"):"scrolloffset" + 1
			);
		);

		button; // Return
	);

	// --- Box dimensions ---
	display:"boxheight" = (
		regional(h);
		h = getboundingbox("000,00°", [0,0], displayanglefontsize, NADA);
		(h_3 - h_1)_2 + 2 * toolbarmargin;
	);
	display:"boxwidth" = (
		regional(label, w);
		label = "000,00°";
		if(displayanglefully, label = GREEK:"g" + " = " + label);
		w = getboundingbox(label, [0,0], displayanglefontsize, NADA);
		(w_2 - w_1)_1 + display:"removebutton":"width" + 2 * toolbarmargin + .2;
	);

	// --- Capacity and scrolling maths ---
	// Number of boxes that fit between coord and the bottom of the visible area
	display:"rawcapacity" := (
		regional(bottom);
		bottom = VISIBLERECT_1_2; // bottom edge of visible rect
		max(1, floor((my("coord")_2 - bottom + my("boxpadding")) / (my("boxheight") + my("boxpadding"))));
	);

	display:"needsscrolling" := my("rows") > my("rawcapacity");

	// Reserve one row for the scroll buttons when scrolling is needed
	display:"maxdisplayablerows" := if(my("needsscrolling"),
		max(1, my("rawcapacity") - 1),
		my("rawcapacity")
	);

	display:"maxscrolloffset" := max(0, my("rows") - my("maxdisplayablerows"));
	display:"visiblerows" := min(my("rows"), my("maxdisplayablerows"));
	display:"lastvisible" := min(my("rows"), my("scrolloffset") + my("maxdisplayablerows"));

	// True if entry with (1 based) index i is currently on screen. Eval with 'entryindex.
	display:"isvisible" := ('entryindex > my("scrolloffset")) & ('entryindex <= my("lastvisible"));

	/**
	* Keeps the scroll position sane. Called from "draw".
	* - jumps to the end whenever a new entry was added
	* - clamps the offset when entries were removed or the box got bigger
	*/
	display:"updatescroll" := (
		if(my("rows") > my("lastrowcount"), self():"scrolloffset" = my("maxscrolloffset"));
		self():"lastrowcount" = my("rows");
		self():"scrolloffset" = max(0, min(my("scrolloffset"), my("maxscrolloffset")));
	);

	// Aligns both scroll buttons side by side below the list. Called from "draw".
	display:"setscrollbuttoncoords" := (
		regional(xright, ybottom, gap);
		gap = .15;
		xright = my("coord")_1 + my("boxwidth"); // right edge of the list

		ybottom = my("coord")_2
			- (my("visiblerows") - 1) * (my("boxheight") + my("boxpadding"))
			- my("boxpadding")
			- my("scrolldownbutton"):"height";

		// down on the right, up to its left
		my("scrolldownbutton"):"coord" = [xright - my("scrolldownbutton"):"width", ybottom];
		my("scrollupbutton"):"coord"   = [
			xright - my("scrolldownbutton"):"width" - gap - my("scrollupbutton"):"width",
			ybottom
		];
	);

	// --- Shapes ---
	// Built for ALL entries so that indices stay absolute. Entries scrolled out
	// of view simply end up outside the visible area and are filtered on draw.
	display:"boxshapes" := (
		apply(1..my("rows"),
			regional(row, bottomleftcoord);
			row = (# - 1) - my("scrolloffset");
			bottomleftcoord = my("coord") - row * [0, my("boxpadding") + my("boxheight")];

			roundedrectangle(bottomleftcoord, my("boxwidth"), my("boxheight"), my("boxradius"))
		);
	);
	display:"boxhitboxes" := (
		apply(1..my("rows"),
			regional(row, bottomleftcoord);
			row = (# - 1) - my("scrolloffset");
			bottomleftcoord = my("coord") - row * [0, my("boxpadding") + my("boxheight")];

			rectangle(bottomleftcoord, my("boxwidth"), my("boxheight"))
		);
	);

	// --- Interaction ---
	display:"hotboxindex" = NADA;
	display:"ishot" := (
		regional(hotbox, hitboxes, ishot);

		hitboxes = my("boxhitboxes"); // fetch ONCE, see performance note above

		repeat(my("rows"), // find hot box, but only among the visible ones
			if(isundefined(hotbox)
				& eval(my("isvisible"), 'entryindex->#)
				& inrectangle(hitboxes_#, mouse().xy),
				hotbox = #;
				self():"hotboxindex" = hotbox;
			);
		);

		if(isundefined(hotbox), self():"hotboxindex" = NADA);

		// Hot if a box is hit. Scroll buttons only count when they exist:
		// a hidden Button returns ___ from its "ishot", which would poison
		// the whole expression and stop "click" from ever firing.
		ishot = !isundefined(hotbox);
		if(my("needsscrolling"),
			ishot = ishot
				% tobool(my("scrollupbutton"):"ishot")
				% tobool(my("scrolldownbutton"):"ishot");
		);

		ishot; // Return
	);

	display:"setbuttoncoord" := if(!isundefined(my("hotboxindex")),
		regional(coord);
		coord = my("boxhitboxes")_(my("hotboxindex"))_3; // top right corner of selected box
		coord = coord - [my("removebutton"):"width", my("removebutton"):"height"]; // move down left
		coord = coord - my("boxpadding")*[1,1]; // move further down by DisplayHandlers padding
		my("removebutton"):"coord" = coord;
	);

	display:"draw" := (
		regional(shapes, hitboxes, labels, currentlabel, pos, boundingbox, textheight, textwidth);

		my("updatescroll");
		my("setscrollbuttoncoords");
		my("setbuttoncoord"); // keep remove button in place even without dragging

		// Fetch ONCE. These are ":=" methods that rebuild the complete list on
		// every access; reading them inside the loop made drawing quadratic.
		shapes   = my("boxshapes");
		hitboxes = my("boxhitboxes");
		labels   = my("labels");

		repeat(my("rows"),
			if(eval(my("isvisible"), 'entryindex->#),
				// Draw box
				fill(shapes_#, 
					color->if(#==my("hotboxindex"), my("highlightcolor"), if(isodd(#), my("boxcolors")_1, my("boxcolors")_2))
				);

				// Draw value label
				currentlabel = labels_#;
				if(displayanglefully, currentlabel = GREEK:"g" + " = " + currentlabel);

				boundingbox = getboundingbox(currentlabel, hitboxes_#_1, my("fontsize"), my("font"));
				textheight = boundingbox_4_2 - boundingbox_1_2;
				textwidth  = boundingbox_2_1 - boundingbox_1_1;

				pos = hitboxes_#_2;
				pos_1 = pos_1 - textwidth - toolbarmargin; // align to the right of the box
				if(#==my("hotboxindex"), pos_1 = pos_1 - my("removebutton"):"width" - toolbarmargin); // room for button
				pos_2 = pos_2 + toolbarmargin/2; // offset up by half the heights padding
				pos_2 = pos_2 + pixelsize(currentlabel, size->my("fontsize"), font->my("font"))_3 / screenresolution() / 2;
				draw textbox(pos, currentlabel, my("fontsize"), my("font"), color->my("fontcolor"), NADA, bold->#==my("hotboxindex"));

				// Draw numbering in front of box (absolute index, independent of scrolling)
				currentlabel = # + ":";
				boundingbox = getboundingbox(currentlabel, hitboxes_#_1, my("fontsize"), my("font"));
				textwidth = boundingbox_2_1 - boundingbox_1_1;
				pos_1 = hitboxes_#_1_1 - textwidth - toolbarmargin;
				draw textbox(pos, currentlabel, my("fontsize"), my("font"), NADA, color->if(isodd(#), my("boxcolors")_1, my("boxcolors")_2));

				// Draw remove button on the highlighted box
				if(#==my("hotboxindex"), my("removebutton"):"draw");
			);
		);

		// Draw scroll buttons
		if(my("needsscrolling"),
			my("scrollupbutton"):"draw";
			my("scrolldownbutton"):"draw";
		);
	);

	display:"move" := (
		my("ishot"); // highlight gets updated when dragging
		my("setbuttoncoord");
	);

	display:"moveend" := ();

	display:"click" := (
		// Scroll buttons first, they never overlap a box
		if(my("needsscrolling") & tobool(my("scrollupbutton"):"ishot"),
			my("scrollupbutton"):"script";
		,
			if(my("needsscrolling") & tobool(my("scrolldownbutton"):"ishot"),
				my("scrolldownbutton"):"script";
			,
				if(!isundefined(my("hotboxindex")) & tobool(my("removebutton"):"ishot"),
					my("removebutton"):"script";
				,
					if(!isundefined(my("hotboxindex")), my("onselect"));
				);
			);
		);
	);

	display:"onselect" := ();
	
	display; // Return DisplayHandler
);

// ================== //
// D | Initialization //
// ================== //

//  === Init Thales Trig ===

trig = new ThalesTrig(A,B,C);
trig:"drawcircle" = drawcircle;
trig:"drawcenter" = drawcenter;
trig:"showstampedpoints" = showstampedpoints;
trig:"showstampedvalues" = showstampedvalues;
trig:"showstampbutton" = showstampbutton;
trig:"showconstructionbutton" = showconstructionbutton;
trig:"showhelpbutton" = showhelpbutton;
trig:"showcurrentanglevalue" = showcurrentanglevalue;
trig:"softc" = softc; // soft construction if this is true
trig:"showhelp" = showhelp;
trig:"move"; // Trigger C to stick to circle if softc is false

//  === Init back button ===

backbutton = new ImageButton([0,0], 2, 2, ICONS:"undo");
backbutton:"imgfill" = 2;
backbutton:"coord" = if(isundefined(backbuttoncoord), (screenbounds()_1).xy + toolbarmargin*[1,-1] + [0, -backbutton:"height"], 	backbuttoncoord);

backbutton:"script" := (
	log button clicked(my("name"));
	
	if(length(trig:"history") > 1,

		regional(last);
		last = trig:"history"_(-1);
	
		// Handle move events
		while(last:"action" == "move",
			trig:(last:"object") = last:"oldcoord"; // Reset coord
			trig:"history" = trig:"history"_(1..(length(trig:"history")-1));
			last = trig:"history"_(-1);
		);
	
		// Handle stamp events
		if(last:"action" == "stamp",
			trig:"stamps" = trig:"stamps"_(1..(length(trig:"stamps")-1));
		);

		// Handle trace events
		if(last:"action" == "tracesegment",
			if(length(trig:"traces") > 0,
				trig:"traces" = trig:"traces"_(1..(length(trig:"traces")-1));
			);
			trig:"recordingtrace" = false;
		);
	
		// Handle remove events
		if(last:"action" == "removestamp",
			regional(i);
			i = last:"index";
			if(i==1, // Put at head
				trig:"stamps" = last:"coord" <: trig:"stamps"
			,
				if(i > length(trig:"stamps"), // Put at tail
					trig:"stamps" = trig:"stamps" :> last:"coord";
				, // Put in between
					trig:"stamps" = trig:"stamps"_(1..i-1) ++ [last:"coord"] ++ trig:"stamps"_(i..length(trig:"stamps"));
				);
			);
		);
		// Update history (i.e. remove handled entry)
		if(length(trig:"history") > 0,
			trig:"history" = trig:"history"_(1..(length(trig:"history")-1));
		);
	);
);


// === Init reset button ===

resetbutton = new ImageButton([0,0], 2, 2, ICONS:"reset2");
resetbutton:"imgfill" = 2;
resetbutton:"coord" = if(isundefined(resetbuttoncoord),
	if(showundobutton,
		backbutton:"coord" + toolbarmargin*[1,0] + [backbutton:"width",0],
		backbutton:"coord"   // rutscht auf die erste Position
	),
	resetbuttoncoord
);
resetbutton:"script" := (
	log button clicked(my("name"));
	
	trig:"C" = C;	// Reset C
	trig:"history" = []; // Clear history array
	trig:"stamps" = []; // Clear stamps
	trig:"traces" = []; // Clear trace
	trig:"recordingtrace" = drawtrace;	// back to configured initial state
);


// === Init stamp button ===

stampbutton = new ImageButton([0,0], 2, 2, ICONS:stampbuttonimage);
stampbutton:"imgfill" = 2;

// Set coord for stamp button
if(stickstampbuttontopoint,
	stampbutton:"coord" := (
		regional(labelwidth, buttoncoord);
		labelwidth = getboundingbox("C", [0,0], trig:"pointlabelsize", trig:"font");
		labelwidth = labelwidth_2 - labelwidth_1;
		buttoncoord = trig:"C" + [.2,.1]; // same offset like in trigs draw function when drawing label "C"
		buttoncoord = buttoncoord + labelwidth; // offset to the right by labelwidth
		buttoncoord = buttoncoord + [toolbarmargin,0]; // offset to the right some more
		buttoncoord;
	);
,
	stampbutton:"coord" = if(isundefined(stampbuttoncoord), (screenbounds()_2).xy - toolbarmargin*[1,1] - [stampbutton:"width",stampbutton:"height"], 	stampbuttoncoord);
);

stampbutton:"script" := (
	log button clicked(my("name"));
	log stamped point("C", trig:"C".xy, trig:"gamma");
 
	if(stampmode == "stamp" % !isundefined(triggerstamp),
		trig:"stamps" = trig:"stamps" :> trig:"C";
		trig:"history" = trig:"history" ++ [{"action" : "stamp", "object": "C", "coord" : trig:"C"}];
	, if(stampmode == "trace",
		trig:"recordingtrace" = !trig:"recordingtrace";
		if(trig:"recordingtrace",
			// switching ON: begin a new segment
			trig:"starttracesegment";
			trig:"history" = trig:"history" ++ [{"action" : "tracesegment"}];
		);
	));
);

// Change icon with state
stampbutton:"label" := if(stampmode == "trace",
	if(trig:"recordingtrace", ICONS:"traceon", ICONS:"traceoff"),
	ICONS:stampbuttonimage
);


// === Config placement of gamma value display ===

trig:"gammavalueposition" = if(isundefined(gammadisplaycoord), 
	if(trig:"showstampbutton" & !stickstampbuttontopoint,
		stampbutton:"coord" - [trig:"gammavaluedisplaywidth"+toolbarmargin,0],
		(screenbounds()_2).xy - toolbarmargin*[1,1] - [trig:"gammavaluedisplaywidth", trig:"gammavaluedisplayheight"]
	);
,
	gammadisplaycoord;
);


// === Init robust/soft construction button ===

if(!ISCINDYJS, imgoffset=[0,0]); // only use imgoffset if in CindyJS, since it does not care about "ref"

softrobustbutton = new Toggle([0,0], 1.5, !softc, "", NADA);
softrobustbutton:"coord" = if(showcurrentanglevalue, trig:"gammavalueposition", stampbuttoncoord) - [softrobustbutton:"width" + toolbarmargin, 0];
if(!isundefined(constructionbuttoncoord), softrobustbutton:"coord" = constructionbuttoncoord);
softrobustbutton:"imgfill" = 3.7;
softrobustbutton:"imgscale" := (
	regional(px);
	px = imagesize(ICONS:"pointoncircle");
	my("imgfill") * min(my("width"), my("height")) * screenresolution() / max(px_1, px_2);
);
softrobustbutton:"highlightcolor" = DZLMCOLORDARK;
softrobustbutton:"script" := (
	log button clicked(my("name"));
	
	trig:"softc" = !trig:"softc";
	trig:"pointcolor"_3 = trig:"pointcolor"_3 + if(trig:"softc", [.2,.2,.2], -[.2,.2,.2]); // change color of C to represent state change
	trig:"move";
);
softrobustbutton:"drawafter" := (
	drawimage(my("coord")+ [my("width")/2,my("height")+.1]+imgoffset, ICONS:"pointoncircle", scale->my("imgscale"), ref->["50%","0%"]);
);


// === Init visual help toggle button ===

helpbutton = new Toggle([0,0], 1.5, showhelp, "", NADA);
helpbutton:"coord" = if(showconstructionbutton, softrobustbutton:"coord", trig:"gammavalueposition") - [softrobustbutton:"width" + 2*toolbarmargin, 0];
if(!isundefined(helpbuttoncoord), helpbutton:"coord" = helpbuttoncoord);
helpbutton:"imgfill" = 3.7;
helpbutton:"imgscale" := (
	regional(px);
	px = imagesize(ICONS:"bucket2");
	my("imgfill") * min(my("width"), my("height")) * screenresolution() / max(px_1, px_2);
);
helpbutton:"highlightcolor" = DZLMCOLORDARK;
helpbutton:"script" := (
	log button clicked(my("name"));
	
	trig:"showhelp" = !trig:"showhelp";
);
helpbutton:"drawafter" := (
	drawimage(my("coord")+ [my("width")/2,my("height")+.1]+imgoffset, ICONS:"bucket2", scale->my("imgscale"), ref->"cb");
);


// === Init DisplayHandler ===

display = new DisplayHandler([0,0]);
display:"coord" := [
	VISIBLERECT_2_1 - toolbarmargin - my("boxwidth"),
	trig:"gammavalueposition"_2 - my("boxheight") - toolbarmargin
];
if(!isundefined(gammalistcoord), display:"coord" = gammalistcoord);

// display:"boxwidth" = trig:"gammavaluedisplaywidth"; // set by display instead
display:"labels" := (
	regional(labels);
	labels = apply(trig:"stamps", # = angle(trig:"A", #, trig:"B")+0); // Get angle in rad
	labels = apply(labels, # = if(# > PI, 2*PI-#, #)); // normalize angle
	labels = apply(labels, 
		# = replace(format(# / PI * 180,2),".",",");
		if(!contains(list(#),","), # = # + ",00"); // add 2 zeros if no decimal
		if(#_(-2) == ",", # = # + "0"); // add 1 zero if only one decimal
		# = # + "°"; // add degree symbol
	);
);

display:"removebutton":"script" := (
	log button clicked(my("name"));
	
	regional(hotboxindex);
	hotboxindex = display:"hotboxindex";

	// Add event to history
	trig:"history" = trig:"history" ++ [{"action" : "removestamp", "index": hotboxindex, "coord" : trig:"stamps"_hotboxindex}];

	// Remove object from stamps
	trig:"stamps" = trig:"stamps"_(1..hotboxindex-1)
		++ trig:"stamps"_(hotboxindex+1..length(trig:"stamps"));

	// Reset hotboxindex, if last element has been removed
	display:"hotboxindex" = min(hotboxindex, display:"rows");
	if(display:"hotboxindex"==0, display:"hotboxindex" = NADA, display:"setbuttoncoord");
);

// === Wire trig up against display ===
trig:"anglelist" = display;
display:"handle" = trig;
if(jumptostamp,
	display:"onselect" := (
		my("handle"):"C" = my("handle"):"stamps"_(my("hotboxindex"));
	);
);

// === Init draw helper toggles ===

regional(yoffset, fontsize, refcoord);

refcoord = if(isundefined(backbuttoncoord), backbutton:"coord", [-1,18]);
if(!isundefined(togglerefcoord), refcoord = togglerefcoord);
yoffset = 1.8;
fontsize = 20;

drawalpha = new Toggle(refcoord-[0,2],1.5,showalpha,GREEK:"a",fontsize);
drawalpha:"highlightcolor" = trig:"anglecolor"_1;
trig:"drawalpha" := drawalpha:"state";
drawalpha:"script" := log button clicked(my("name"));

drawbeta = new Toggle(drawalpha:"coord"-[0,yoffset],1.5,showbeta,GREEK:"b",fontsize);
drawbeta:"highlightcolor" = trig:"anglecolor"_2;
trig:"drawbeta" := drawbeta:"state";
drawbeta:"script" := log button clicked(my("name"));

drawgamma = new Toggle(drawbeta:"coord"-[0,yoffset],1.5,showgamma,GREEK:"g",fontsize);
drawgamma:"highlightcolor" = trig:"anglecolor"_3;
trig:"drawgamma" := drawgamma:"state";
drawgamma:"script" := log button clicked(my("name"));

// dont use CM toggle, should be drawn iff gamma1 or gamma2 are drawn
drawCM = new Toggle(drawgamma:"coord"-[0,yoffset],1.5,showCM,"$\\overline{CM}$",fontsize-3);
drawCM:"highlightcolor" = DIVOBLACK;
trig:"drawradius" := drawCM:"state";
drawCM:"script" := log button clicked(my("name"));

drawgamma1 = new Toggle(drawgamma:"coord"-[0,yoffset],1.5,showgamma1,GREEK:"g"+SUB:"1",fontsize);
drawgamma1:"highlightcolor" = trig:"anglecolor"_4;
drawgamma1:"highlightcolor" := if(helpbutton:"state" & trig:"gamma"~=PI/2, trig:"anglecolor"_1, trig:"anglecolor"_4);
trig:"drawgamma1" := drawgamma1:"state";
drawgamma1:"script" := log button clicked(my("name"));

drawgamma2 = new Toggle(drawgamma1:"coord"-[0,yoffset],1.5,showgamma2,GREEK:"g"+SUB:"2",fontsize);
drawgamma2:"highlightcolor" := if(helpbutton:"state" & trig:"gamma"~=PI/2, trig:"anglecolor"_2, trig:"anglecolor"_5);
trig:"drawgamma2" := drawgamma2:"state";
drawgamma2:"script" := log button clicked(my("name"));

drawanglevalues = new Toggle(drawgamma2:"coord"-[0,yoffset],1.5,showanglevalues,"Winkel messen",fontsize);
drawanglevalues:"highlightcolor" = DIVOBLACK;
trig:"drawanglevalues" := drawanglevalues:"state";
drawanglevalues:"script" := log button clicked(my("name"));

obj = obj :> trig;
if(showundobutton, obj = obj :> backbutton);
if(showresetbutton, obj = obj :> resetbutton);

if(trig:"showstampbutton", obj = obj :> stampbutton);
if(trig:"showconstructionbutton", obj = obj :> softrobustbutton);
if(trig:"showhelpbutton", obj = obj :> helpbutton);
if(trig:"showstampedvalues", obj = obj :> display);
if(drawtogglealpha, obj = obj :> drawalpha);
if(drawtogglebeta, obj = obj :> drawbeta);
if(drawtogglegamma, obj = obj :> drawgamma);
//if(drawtoggleCM, obj = obj :> drawCM);
if(drawtogglegamma1, obj = obj :> drawgamma1);
if(drawtogglegamma2, obj = obj :> drawgamma2);
if(drawtogglevalues, obj = obj :> drawanglevalues);
);
//[VAM*] localderivate
/** v2 *****************************************************************************************
*
* Recent changes:
***********************************************************************************************/


// Lokale Ableitungen
if(VAM == "localderivative",


// ================= //
// A | Documentation //
// ================= //

//DOCTEXTPOS = [9,15.5];
DOCTEXT = "...";


// ================= //
// B | Configuration //
// ================= //

'someParameter = default to(ENVIRONMENTALPARAMS:"someParameter", "default value", false); // TRUE parses the value. Try, if not a string.


// ===================== //
// C | Class Definitions //
// ===================== //

new ThereIsNothingHereYet() := ();


// ================= //
// D | Initilization //
// ================= //

obj = obj :> new CoordinateSystem(NADA);
obj_1:"leftborder" = 2;
obj_1:"rightborder" = 19;
obj_1:"upperborder" = 19;
obj_1:"lowerborder" = 7;
);
//[FW] Init end
/** v1 ******************************************************************************************
* Finishing up init.
*
* Recent changes:
************************************************************************************************/

if(ISCINDYJS,
	log debug("=== Init done === " + floor(random(100))); // Sanity check.
	log debug("LOGLEVEL (0-3): " + LOGLEVEL);
	log debug("using CindyJS: " + ISCINDYJS);
	log debug("in divomath environment: " + ISDIVOMATH);
	log debug("supplied environmental parameters: " + ENVIRONMENTALPARAMS);
	log debug("loaded VAM: " + VAM);
);

INITDONE = true; // Indicate that Init process is done

// Visual check for last compile time
if(!ISCINDYJS & !ISDIVOMATH,
	println("Last compiled at: " + readable datetime());
);`,

    keydown: 
`//[FW] keypressed
/** v8 ******************************************************************************************
* Handles key presses (mainly for debugging).
*
* Recent changes:
* 2027-07-27: Add more detailed debug output on keypress
* 2027-07-27: Refactor stuff
* 2026-08-11: Split debug printing
************************************************************************************************/

debug at("key pressed event", "Key press triggered. Key: " + key());

// Debug print divomath details
if(key() == "y" % key() == "Y",
	println("================= SETTINGS =================");
	println("ISCINDYJS: " + ISCINDYJS);
	println("Screenbounds: " + screenbounds());
	println("ENVIRONMENTALPARAMS: " + ENVIRONMENTALPARAMS);
	println("BGCOLOR: " + BGCOLOR);
	println("LOGLEVEL: " + LOGLEVEL);
	println("----------------- divomath -----------------");
	println("DM ISDIVOMATH: " + ISDIVOMATH);
	println("DM ISVIEWER: " + DIVOMATH'ISVIEWER);
	println("DM base object: " + divomathConfig);
	println("DM config: " + DIVOMATH'CONFIG);
	println("DM var state: " + DIVOMATH'VARSTATE);
	println("DM prev answer: " + DIVOMATH'PREVANSWER);
	println("==========================================="); 
);

// Debug print divomath details
if(key() == "x" % key() == "X",
	println("===========================================");
	println("Test set state() overwrite. Returns: " + divomath set state());
	println("Test update results() overwrite. Returns: " + divomath update results());
	println("==========================================="); 
);

if(key() == "c" % key() == "C",
	print log messages();
);


if(key() == "s" % key() == "S", 
	divomathUpdateResults();
	divomathSetState();
);

if(key() == "+",
	LOGLEVEL = min(3, LOGLEVEL + 1);
	debug at("key pressed event", "LOGLEVEL increased. New level: " + key());
);

if(key() == "-",
	LOGLEVEL = max(0, LOGLEVEL - 1);
	debug at("key pressed event", "LOGLEVEL increased. New level: " + key());
);`,

    mousedown: 
`//[FW] mousedown
/** v3 ******************************************************************************************
* Handle mousedown events.
*
* Recent changes:
************************************************************************************************/

log mouse down();

MOUSEDOWN = true;
MOUSEPRESSEDTIME=seconds();

// Find all moveable elements at current mouse position.
hotlist = select(obj,eval(#:"ishot",coord->mouse().xy));

// Consider typeorder when clicking
hotlist = flatten(apply(typeorder,to,select(hotlist,o,o:"type"==to)))
					++select(hotlist,o,not(contains(typeorder,o:"type")));

if(!isundefined(oldaction), 
	hotlist = [oldaction];
);

// If there is an element in hotlist, find the relative ditsance between reference point and mouse coords.
if(length(hotlist)>0,
	hot = hotlist_(length(hotlist));
	startmouse = mouse().xy;
	oldmouse = mouse().xy;

	clickcopy = hot:"clickcopy";
	
	if(not(isundefined(clickcopy)),
		obj = obj :> clickcopy;
		hot=clickcopy;
	);

	startcoord = hot:"coord";
	localcoord = startmouse - hot:"coord";

	action=eval(hot:"getaction",coord->startmouse, delta->localcoord, mouse -> mouse().xy);

	x=0; // fix for stuff not drawing when clicked
,
	hot = NADA;
);
`,

    mousedrag: 
`//[FW] mousedrag
/** v1 ******************************************************************************************
* FW handling for dragging an object.
* Updates mouse coords if a hot element is moved.
*
* Recent changes:
************************************************************************************************/

if(!isundefined(hot),

	if(!isundefined(hot:"deletecopyifnotmovedandsubstitutebyoriginal"), 
		hot:"deletecopyifnotmovedandsubstitutebyoriginal"=NADA
	); 
	
	act(hot,action,startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
	oldmouse = mouse().xy;
	
);
`,

    mousemove: 
`//[FW] mousemove
/** v4  ******************************************************************************************
* FW handling for moving the mouse without clicking.
* Updates coordinates for objects where "sticky" is true.
*
* Recent changes:
************************************************************************************************/


// Falls ein Element bewegt wird (also hot definiert ist), aktualisiere seine Koordinate

if(!isundefined(oldaction),

 act(oldaction,action+"sticky",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
 oldmouse = mouse().xy;

 clrscr();
 forall(obj, #:"draw");
 repaint();

);`,

    mouseup: 
`//[FW] mouseup
/* v4 ******************************************************************************************
* FW handling for mouse release.
* Basically executes "click"-events and "~end" events.
*
* recent changes:
* - 2026-06-20: Fixed breaking ifs from CindyJS 0.8.45 update.
************************************************************************************************/

log mouse up();

// Code für RELEASE
MOUSEDOWN = false;

if(!isundefined(hot),

	act(hot, action, startmouse, startcoord, mouse().xy, mouse().xy - oldmouse);

  //Allgemeiner "drop on" event – entscheiden, ob der vor, nach oder vor und nach act(...) sein soll.
  if(!isundefined(action),
		forall(select(obj,o,eval(o:"ishot",coord->mouse())),droptarget, 
			eval(droptarget:"dropevent", dropobject->hot);
		); 
	);

  if(isundefined(hot:"sticky"),
			act(hot,action+"end",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
	);
	
  if(!isundefined(hot:"sticky"),
		if(!(hot:"sticky"),
			act(hot,action+"end",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse),
			act(hot,action+"pause",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse)
  	);
  );
  
);

if(tobool(hot:"sticky"), oldaction = hot);


// Code für CLICK = Release when close


if(tobool(dist(startmouse,mouse().xy)<pinchsensitivity),
// then click

	forall(obj,o,
		if(tobool(o:"ishot"),
			if(isundefined(o:"deletecopyifnotmovedandsubstitutebyoriginal"), 
				o:"click"; 
				,
				obj=obj--[o]; // Kopie wieder löschen
				hot=o:"deletecopyifnotmovedandsubstitutebyoriginal"; //gemerktes Original wiederaktivieren
				//hot:"click";
			);
		//err("click:"+o:"name");
		);
	);

	if(!isundefined(oldaction),
	  act(oldaction,action+"end",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
	  oldaction = NADA;
	);

);
`,

    tick: 
`//[FW] tick
/** v1 ******************************************************************************************
* Handle animation execution
*
* Recent changes:
************************************************************************************************/

animations = select(animations, a,
	regional(λ,γ,value,now);
  now=seconds();
  if(isundefined(a:"exec"),

  λ = min(1,(now-(a:"starttime"))/((a:"endtime")-(a:"starttime")));
 if(λ>0,
	if (a:"timeflow" == "linear",  
				//default  
	,
	if (a:"timeflow" == "accel",
			λ = 5/2*λ^3-3/2*λ^5;
	,
	if (a:"timeflow" == "jump",
			if(λ<1, λ=0);
	,
	)));
	if (a:"timeflow" == "set",
		(a:"object"):(a:"property") = if(λ<1, a:"startvalue",a:"endvalue"),
		if (isundefined(a:"movepath"), 
			  (a:"object"):(a:"property") = a:"endvalue"* λ + a:"startvalue" * (1 - λ)
				,
				(a:"object"):(a:"property")=eval((a:"movepath"):"f",start->a:"startvalue",end->a:"endvalue",α->λ)
		);
	);
);

  );
 	// forall(ANI u,a, call(a,"recalc:"));
	running = now < a:"endtime";
	if (!running & !isundefined(a:"command"), a:"object":(a:"command"));
	if (!running & a:"kill", obj = select(obj,# != a:"object"));
	running
);

if(length(animations)==0, stopanimation());
`
},
defaultAppearance: {
  dimDependent: 0.7,
  fontFamily: "sans-serif",
  lineSize: 1,
  pointSize: 5.0,
  textsize: 12.0
},
angleUnit: "°",
animation: {
  autoplay: false,
  controls: false,
  speed: 0.5257731958762887,
  speedRange: [0.0, 1.0],
  accuracy: 1
},
autoplay: false,
animcontrols: false,
ports: [{
  id: "CSCanvas",
  transform: [{visibleRect: [0, 18, 24, 0]}],
  background: "rgb(255,255,255)"
}],
csconsole: false,
images: {
    "clap.png": "https://abako.dzlm.de/cindy/divomath/img/clap.png",
    "icon-bucket.png": "https://abako.dzlm.de/cindy/divomath/img/icon-bucket.png",
    "icon-hand.png": "https://abako.dzlm.de/cindy/divomath/img/icon-hand.png",
    "icon-measure-angle-DZLMDARK.png": "https://abako.dzlm.de/cindy/divomath/img/icon-measure-angle-DZLMDARK.png",
    "icon-paintbucket.png": "https://abako.dzlm.de/cindy/divomath/img/icon-paintbucket.png",
    "icon-pointoncircle.png": "https://abako.dzlm.de/cindy/divomath/img/icon-pointoncircle.png",
    "icon-reset-DZLMDARK.png": "https://abako.dzlm.de/cindy/divomath/img/icon-reset-DZLMDARK.png",
    "icon-reset.png": "https://abako.dzlm.de/cindy/divomath/img/icon-reset.png",
