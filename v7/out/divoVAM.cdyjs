];

// A.* | Color palettes
// Color palettes consisting of colors above
VAMPALETTE= [
	DARKRED,
	DARKBLUE,
	DARKGREEN,
	DZLMCOLORGOLD,
	DZLMCOLORDARK
];

COLORMAP = {
	"DARKRED" : DARKRED, "DARKBLUE" : DARKBLUE, "DARKGREEN" : DARKGREEN,
	"DZLMCOLORGOLD" : DZLMCOLORGOLD, "DZLMCOLORDARK" : DZLMCOLORDARK,
	"PLACECOLORGREEN" : PLACECOLORGREEN,
	"PLACECOLORBLUE" : PLACECOLORBLUE,
	"PLACECOLORRED" : PLACECOLORRED,
	"DIVOGREEN" : DIVOGREEN, "DIVOVIOLET" : DIVOVIOLET, "DIVOGREY" : DIVOGREY,
	"DIVOBLACK" : DIVOBLACK, "DIVORED" : DIVORED, "DIVOBLUE" : DIVOBLUE
};

// Plasma colors ... blue -> purple -> magenta -> orange -> yellow
COLORSPLASMA16 = [
    [5.03830e-02, 2.98030e-02, 5.27975e-01],
    [2.00445e-01, 1.79020e-02, 5.93364e-01],
    [3.12543e-01, 8.23900e-03, 6.35700e-01],
    [4.17642e-01, 5.64000e-04, 6.58390e-01],
    [5.17933e-01, 2.15630e-02, 6.54109e-01],
    [6.10667e-01, 9.02040e-02, 6.19951e-01],
    [6.92840e-01, 1.65141e-01, 5.64522e-01],
    [7.64193e-01, 2.40396e-01, 5.02126e-01],
    [8.26588e-01, 3.15714e-01, 4.41316e-01],
    [8.81443e-01, 3.92529e-01, 3.83229e-01],
    [9.28329e-01, 4.72975e-01, 3.26067e-01],
    [9.65024e-01, 5.59118e-01, 2.68513e-01],
    [9.88260e-01, 6.52325e-01, 2.11364e-01],
    [9.94141e-01, 7.53137e-01, 1.61404e-01],
    [9.77995e-01, 8.61432e-01, 1.42808e-01],
    [9.40015e-01, 9.75158e-01, 1.31326e-01]
];

