	DIVODARKBLUE,
	DIVORED,
	DIVOGREEN,
	DIVOVIOLET,
	DIVOGREY,
	DIVOBLACK,
	DIVOYELLOW
];

// A.4. | Montessori colors
MONTEGREEN = (100,228,178)/255;
MONTEBLUE = (108,169,255)/255;
MONTERED = (240,150,112)/255;
MONTEGREY = (242,242,242)/255;

MONTEPALETTE = [
