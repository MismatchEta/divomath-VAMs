`//[FW] global drawing
/** v3 ******************************************************************************************
* Draws all the things in obj according to typeorder
*
* Recent Changes:
* - 2027-07-27: Add drawing of VISIBLERECT for debugging
************************************************************************************************/

// Color background.
fill(screen(), color->BGCOLOR);

// First: Draw all objects from OBJ according to TYPEORDER.
forall(typeorder,to,
		forall(obj,o, if(o:"type"==to, o:"draw"))
);

// Second: Draw all the objects with types not in TYPEORDER.
forall(obj,o,
		if(not(contains(typeorder,o:"type")),o:"draw");
);

// ========= //
// DEBUGGING //
// ========= //

// Draw visible rectangle for CindyJS ([0,17,24,0] by convention)
if(LOGLEVEL >= LOGDEBUG,
	drawpoly(VISIBLERECT, size->2, color->grey(.35));
);

// Draw power of 2 circles around origin.
if(LOGLEVEL >= LOGDEBUG,
	repeat(5, drawcircle([0,0],2^#, color->grey(.65)));
);

// Draw DOCTEXT of VAM.
if(LOGLEVEL >= LOGDEBUG, 
	drawtextbox(DOCTEXTPOS, DOCTEXT, NADA, NADA, grey(.35));
);

// Send divomath results first time the scene is drawn.
if(ISDIVOMATH & FIRSTDRAW, divomathUpdateResults());

// Set flag to remember first call to draw script is done.
FIRSTDRAW = false;`,

    init: 
`//[FUN] Divomath
/** v3 ******************************************************************************************
* Fields and functions for interacting with the divomath platform. divomath uses the following hooks
* - divomath get var state				- Hook for divomath callbackfunction
* - divomathAddResult(key, value)	- Adds a submission to the result
* - divomathSendResult()					- Sends a result to divomath
* - divomathConfig								- JSON object containing configurations for VAM and last submissions of the user (see below)
*
* NOTE: the leading "divomath" in the function names is variable is a convention and must be specified in the configuration of the specific implemention of the VAM.
*
* On init divomath provides Cindy with an object of configuration and state settings set by the VAMs editors on divomath side.
* This can be used to configure positioning of components and similar stuff. It can also be used to access the last submitted result.
*
* Example strucutre of the configuration object:
* {
*     "configuration":{														# === From "Komponentenverhalten" textbox from divomath editor (for non VAM specific config) ===
*         "cindyJsPrefix":"divomath",							# Sets prefix for functions and fields mentioned above.
*         "debuglevel":0,													# Sets debuglevel (0-3) for VAM.
*         "vam":"strapwork"												# VAM choice for Init.
*     },
*     "cindyjs":{																	# === "cindyjs" object from "Zustand" textbox fromdivomath editor (for VAM specific config) ===
*         "drawborders":false,										# - Contains VAM specific settings.
*         "size":0.9,															# - Cindy parses ALL values from divomath to String.
*         "state":[2,1,3]													# - Values here overwrite URL GET values if any.
*     },
*     "divomathVarState":{												# === Current/Last saved state of VAM ===
*         "datetime":[2026,6,17,9,17,22,267],			# - Gets set by VAM with "divomath set state()".
*					"timestamp":1781680642267,							# - Needs to be overwritten by every VAM according to its needs.
* 				"drawborders":false,										# - Overwrites config from "cindyjs" object if any.
*        	"limit":[8],														# - Cindy still parses ALL values from divomath to String.
*         "polypadding":0.6,
*         "size":0.9,
*         "state":[1,1,1,1]        
*    },
*		 "runtime":"VIEWER",													# Divomath runtime can be "EDITOR" or "VIEWER". Should be VIEWER when used by students.
*			"__limit": [3],															# Keys with leading dunder ("__") are used for referencing from other VAM states.
*			"__size": 3.1,															# - They overwrite the corresponding value from divomathVarState (e.g. limit, size, drawborders).
*			"__drawborders": true,											# - Has to be done top level when addressing another divomath component.
*		 {RESULT_key}:"value",												# Keys with leading "RESULT_" are posted when using the "divomath * result()" functions.
*		 {RESULT_foo}:"bar",													# - Overwrite corresponding value from divomathVarState (e.g. key, foo, x, iscool).
*		 {RESULT_x}: 3,																# - Also overwrites reference keys (indicated by dunder).
*		 {RESULT_iscool}: false												# - Are otherwise used for validating solutions in divomath.
*		 {RESULT_DONTUSE}: true												# - Don't use these though, see below.
* }
*
* (!!) The values from the divomath configuration object are stored in ENVIRONMENTALPARAMS according to the specifications from the example.
* This means the following order is applied for a VAM specific key-value pair ("foo", "bar"):
*		1. Get pair from cindyjs object if any.
*		2. Overwrite/get pair from divomathVarState if any.
*		3. Overwrite/get pair from correpsonding reference object (dunder, "__").
*		4. Overwrite/get pait from corresponding RESULT object.
*
* (!!) The RESULT fields also contained in separate object "PreviousAnswer" and should be get from there. Example structure:
* "Prev Answer":{
* 		"datetime":[2026,6,17,9,28,40,944],					# Gets stored automatically when using "divomath post results()".
* 		"timestamp":1781681320944										# Gets stored automatically when using "divomath post results()".
*     "1.1":0,																		# Results stored as (key, value) as specified when calling "divomath put result(2)".
*     "1.2":3,
*     "drawborders":true,
*     "limit":[3,5],
*     "size":0.75,
*     "state":[1,2,3,4,5],
* }
*
* Recent changes:
* 2026-07-26: Change log behavior.
* 2026-08-09: Add json serializing to divomath get var state(1).
* 2026-08-09: Add guards to divomath put results(2).
************************************************************************************************/

// ==================================== //
// Access divomath configuration object //
// ==================================== //

ISDIVOMATH 								= !isundefined(divomathConfig); 			// Flag for setting VAM specific non divomath config overwrites on init

DIVOMATH'BLOB 						= divomathConfig;											// Complete JSON config object
DIVOMATH'CONFIG 					= DIVOMATH'BLOB.configuration; 				// Configuration field from editor
DIVOMATH'CINDYJSSTATEDEF	= DIVOMATH'BLOB.cindyjs; 							// Default state definition (from state field in editor)
DIVOMATH'VARSTATE 				= DIVOMATH'BLOB.divomathVarState; 		// Last stored state (set by divomathSetState)
DIVOMATH'ISVIEWER 				= DIVOMATH'BLOB.runtime == "VIEWER";	// VAM is running inside divomath VIEWER
DIVOMATH'ISEDITOR 				= DIVOMATH'BLOB.runtime == "EDITOR";	// VAM is running inside divomath EDITOR

DIVOMATH'PREVANSWER 			= divomathPreviousAnswer; 						// Last submission for VAM

// ===================== //
// divomath state setter //
// ===================== //

/**
* Used by divomaths SendState function to update the state (if any) and set the previousAnswer variable.
* Uses divomathSetState(), which has to be implemented in every VAM individually, according to the VAMs specific needs.
* @param dmcb: name of divomath callback (dmcb) function
*/
divomath get var state(dmcb) := (
	regional(state);
	state = divomath set state();
	state:"timestamp" = timestamp();
	state:"datetime" = date() ++ time();

	debug at("divomath get var state(1)", "State object has been sent to divomath.");
	
	// Send last answer to DM and (maybe) overwrite state
	if(!isundefined(state),
		debug at("divomath get var state(1)", "JSON: " + to json(state));
		javascript(dmcb + "(" + to json(state) + ")");
	,
		javascript(dmcb+"()");
	);
);

/** @Overwrite
* Build a state object, to be transfered to divomath.
* Should be NADA if state is not supposed to change or should equal DIVOMATH'VARSTATE.
* --- Has to be overwritten by every VAM ---
**/
divomath set state() := (
	regional(state);
	state = NADA;

	warn at("divomathSetState", "Function is not overwritten in current VAM: " + VAM);
		
	state; // Return state;
);


// ======================== //
// divomath result handling //
// ======================== //

/** @Overwrite
* Update divomath results to be used for validation.
* Should use divomath put result(2) and divomath post result() instead
* of the direct hooks divomathAddResult(2) and divomathSendResult()
* --- Has to be overwritten by every VAM ---
* --- Don't call directly use wrapper below instead --- 
**/
divomath update results() := (
	warn at("divomathUpdateResults", "Function is not overwritten in current VAM: " + VAM);
);

/**
* Wrapper for divomath update results (call this instead of divomath update results)
**/
divomath push results() := if(ISDIVOMATH,
	divomath update results()
);

/**
* Clears all current user submissions in divomath.
* (See "divomath put result(2)" and "divomath post results()" for updating results)
*	- Use inside "divomath update results()" when overwriting.
* - Call first.
**/
divomath clear results() := if(ISDIVOMATH,
	divomathClearResult();

	debug at("divomath clear results()", "Divomath results cleared.");
);

/**
* Adds result to be updated for divomath as a "key" and "value" pair.
* (See "divomath post results()" and "divomath clear results()" for updating results)
* 	- Use inside "divomath update results()" when overwriting.
**/
divomath put result(key, value) := if(ISDIVOMATH,
	// divomath's own hook builds its JavaScript by concatenation, so the value
	// has to arrive as a valid JS literal: strings quoted, lists as [..],
	// undefined as null. "to json" produces exactly that for every type,
	// which makes the old wrap quote() unnecessary.
	value = to json(value);

	divomathAddResult(key, value); // call divomath hook

	debug at("divomath put result(2)", "Divomath result added with key: " + key);

	[key, value]; // Return pair
);

/**
* Sends results from "divomath put result(2)" to divomath
* (See "divomath put result(2)" and "divomath clear results()" for updating results)
* - Use inside "divomath update results()" when overwriting.
*	- Call last.
**/
divomath post results() := if(ISDIVOMATH,
	divomath put result("timestamp", timestamp());
	divomath put result("datetime", date() ++ time());
	
	divomathSendResult();

	debug at("divomath post results()", "Divomath results updated.");
);


// ====================== //
// divomath config parser //
// ====================== //

/**
* Checks divomath config object for (key, value) pairs for configuring current VAM.
* (key, value) pairs are getting put in ENVIRONMENTALPARAMS.
*/
divomath get params() := if(ISDIVOMATH,
	regional(prevanswerkeys, underscorekeys, laststatekeys, editorstatekeys);

	// --- 1. Handle last submission (from ~PreviousAnswer object) ---
	prevanswerkeys = keys(DIVOMATH'PREVANSWER);
	
	forall(prevanswerkeys, key,
		add property(ENVIRONMENTALPARAMS, key, DIVOMATH'PREVANSWER:key);
		debug at("divomath get params()", "Property " + key + " added to ENVIRONMENTALPARAMS from DIVOMATH'PREVANSWER. value: " + DIVOMATH'PREVANSWER:key);
	);

	if(length(prevanswerkeys) == 0, debug at("divomath get params()", "No prevanswer keys found. So no previous answer available."));

	// --- 2. Handle referencing keys (starting with dunder) ---
	//
	// They can sit in two places: at the top level of the blob (how the
	// existing VAMs do it - only passed on in the VIEWER, not in the EDITOR)
	// or inside the "cindyjs" object (works in both). The cindyjs object is
	// read FIRST because "add property" keeps the first entry, so a key
	// defined in both places is won by the cindyjs one.
	//
	// The prefix is a divomath level marker: "__rcrows" resolves to a result
	// of an earlier slide. It has to be stripped, otherwise the value ends up
	// under a key nobody reads and the stored state wins instead.
	underscorekeys = [];
	
	forall([DIVOMATH'CINDYJSSTATEDEF, DIVOMATH'BLOB], source,
		regional(sourcename, dunderkeys);
		sourcename = if(source == DIVOMATH'CINDYJSSTATEDEF, "cindyjs object", "blob top level");

		dunderkeys = if(isundefined(source), [], select(keys(source), key, starts with(key, "__")));

		forall(dunderkeys, key,
			regional(plainkey);
			plainkey = substring(key, 2, length(key))
		;

			add property(ENVIRONMENTALPARAMS, plainkey, source:key);
			debug at("divomath get params()", "Property " + plainkey
				+ " added from dunder reference " + key + " (" + sourcename
				+ "). value: " + source:key
			);
		);

		underscorekeys = underscorekeys ++ dunderkeys;
	);

	if(length(underscorekeys) == 0,
		debug at("divomath get params()", "No underscore keys found. So no references."));

	// --- 4. Handle default divomath config (from cindyjs object) ---
	editorstatekeys = keys(DIVOMATH'CINDYJSSTATEDEF);
	
	forall(editorstatekeys, key,
		add property(ENVIRONMENTALPARAMS, key, DIVOMATH'CINDYJSSTATEDEF:key);
		debug at("divomath get params()", "Property " + key + " added to ENVIRONMENTALPARAMS from default editor config. value: " + DIVOMATH'CINDYJSSTATEDEF:key);
	);

	if(length(editorstatekeys) == 0, debug at("divomath get params()", "No default config found."));

	// --- Dump final object ---
	debug at("divomath get params()", "Finished getting parameters. State of ENVIRONMENTALPARAMS: " + ENVIRONMENTALPARAMS);

	ENVIRONMENTALPARAMS; // Return (altough changes in place)
);


default state to(key, value) := If(ISDIVOMATH,

error at("default state to()", "DONT USE ANYMORE, use default to(3) instead.");

	regional(prevansvalue, resultkey, resultvalue, stateobject, statevalue, defaultstateobject, defaultstatevalue);

	// Get config overwrites for forward referencing from RESULT structure (if any)
	resultkey = "__" + key; // Built key with dunder to separate from other keys of DIVOMATH'CONFIG
	resultvalue = divomathConfig:resultkey; // Get corresponding value if any

	// Check DIVOMATH'PREVANSWER for if there already was an interaction from a previous session
	prevansvalue = if(contains(keys(DIVOMATH'PREVANSWER), key), DIVOMATH'PREVANSWER:key);

	// Get value from stateobject, if any (for resetting previous state)
	stateobject = default to(DIVOMATH'VARSTATE, {}); // Set DIVOMATH'VARSTATE manually to empty object
	if(islist(stateobject), stateobject = {}); // ?? DIVOMATH'VARSTATE is empty list not nada, if divomath site is revisted
	statevalue = if(contains(keys(stateobject), key), stateobject:key);

	// Get default state from cindyjs entry of editor state settings
	defaultstateobject = default to(DIVOMATH'CINDYJSSTATEDEF, {});
	defaultstatevalue = if(contains(keys(defaultstateobject), key), defaultstateobject:key);

	// Set correct value, order: Overwrite > previous answer > saved state > editor defined state > cindy default state
	if(!isundefined(prevansvalue), 
		value = prevansvalue; // try prev ans if any
	, 
		if(!isundefined(resultvalue),
			value = resultvalue; // else: try overwrite value if any
		,
			if(!isundefined(statevalue), 
				value = statevalue; // else: try state if any
			,
				if(!isundefined(defaultstatevalue), 
					value = defaultstatevalue; // else: try state if any
				)
			)
		)
	); // if all fails use value from param

	// Return
	value;
);
//[FUN] Debug Logging
/** v1 ******************************************************************************************
* Functions for logging and debugging.
*
* Recent changes:
************************************************************************************************/

// ======================== //
// Basic logging mechanisms //
// ======================== //
add log message(level, message) := (
	LOGMESSAGES = append(LOGMESSAGES, "[ " + readable datetime() + " ] [ " + level + " ] " + message);

	if(length(LOGMESSAGES) > 0,
		println(LOGMESSAGES_(-1))
	);

  if(length(LOGMESSAGES) > MAXLOGMESSAGES,
    LOGMESSAGES = LOGMESSAGES_(length(LOGMESSAGES) - MAXLOGMESSAGES + 1..length(LOGMESSAGES));
  );
);

clear log messages() := LOGMESSAGES = [];

log debug(message) := if(LOGLEVEL >= 3,
	add log message("DEBUG", message);
);

log error(message) := if(LOGLEVEL >= 1,
	add log message("ERROR", message);
);

log once(level, key, message) := if(!contains(LOGONCEKEYS, key),
	LOGONCEKEYS = append(LOGONCEKEYS, key);
	
	log debug("[ ONCE ] " + message);
);

log warn(message) := if(LOGLEVEL >= 2,
	add log message("WARN", message);
);

print log messages() := (
	if(length(LOGMESSAGES) == 0,
		println("> No log messages have been recorded.");
	,
		println("> Printing all **" + length(LOGMESSAGES) + "** recorded log messages.");
	);
	forall(LOGMESSAGES, message,
		println("> " + message);
	);
);

// ============================================ //
// Detailed error/warning/debugging mechanisms  //
// ============================================ //
debug assert(condition, message) := if(LOGLEVEL >= 3,
	regional(msg);
	msg = "[ ASSERT FAILED ] " + message;
	if(!condition, log debug(msg));
	assert(condition, msg);
);

debug at(place, message) := (
	log debug("[ AT : " + place + " ] " + message);
);

debug value(name, value) := (
	log debug("[ VALUE ] " + name + " = " + value);
);

error assert(condition, message) := if(LOGLEVEL >= 1,
	regional(msg);
	msg = "[ ASSERT FAILED ] " + message;
	if(!condition, log error(msg));
	assert(condition, msg);
);

error at(place, message) := (
	log error("[ AT : " + place + " ] " + message);
);

error value(name, value) := (
	log error("[ VALUE ] " + name + " = " + value);
);

warn assert(condition, message) := if(LOGLEVEL >= 1,
	regional(msg);
	msg = "[ ASSERT FAILED ] " + message;
	if(!condition, log warn(msg));
	assert(condition, msg);
);

warn at(place, message) := (
	log warn("[ AT : " + place + " ] " + message);
);

warn value(name, value) := (
	log warn("[ VALUE ] " + name + " = " + value);
);

//[FUN] Event Logging
/** v1 ******************************************************************************************
* Logging for Learning Analytics stuff
*
* Recent changes:
************************************************************************************************/

// ==================== //
// Generic event logger //
// ==================== //

log event(type, name, data) := if(LOGGINGENABLED,
	warn at("log event(3)", "Not implemented yet. Needs proper JSON serializer first.");
	
	if(false, // @Todo: Build JSON serializer
		debug at("log event(3)", "Creating event: " + type + " / " + name);
	
	  remember event(type, name, data);
	
	  javascript("sendEventToApi(" 
	    + "'" + PROGRAMID + "', "
	    + "'" + SCENARIOID + "', "
	    + "'" + USERID + "', "
	    + format(EVENTLOG_(-1), 14)					// Experimental generic logger. Do not use until JSON serialization is implemented.
	    + ");"
	  );
  );
);

remember event(type, name, data) := (
	debug at("remember event(3)", "Stored event [" + type + ", " + name + "] with EVENTID: " + EVENTID);
	
  EVENTLOG = append(EVENTLOG, {
  	"clienteventid"	: EVENTID,
    "type"					: type,
    "name"					: name,
    "source"				: "cindyscript",
    "time"					: time(),
    "data"					: data
  });
  
  EVENTID = EVENTID + 1;
);


// ====================== //
// Specific event loggers //
// ====================== //

log button clicked(buttonid) := if(LOGGINGENABLED,
	regional(id);
	id = EVENTID;
	
  debug at("log button clicked(1)", buttonid);

  remember event("interaction", "button_clicked", buttonid);

  javascript("sendButtonClickedEventToApi("
    + "'" + PROGRAMID + "',"
    + "'" + SCENARIOID + "',"
    + "'" + USERID + "',"
    + id + ","
    + "'" + buttonid + "'"
    + ");"
  );
);

log geometry created(objectname, alg, inputlist) := if(LOGGINGENABLED,
  regional(id, inputstring);
	id = EVENTID;
	
  inputstring = inputlist + "";

  debug at("log geometry created(3)", objectname + " via " + alg);

  remember event("geometry", "created", [objectname, alg, inputstring]);

  javascript("sendGeometryEventToApi("
    + "'" + PROGRAMID + "',"
    + "'" + SCENARIOID + "',"
    + "'" + USERID + "',"
    + id + ","
    + "'created',"
    + "'" + objectname + "',"
    + "'" + alg + "',"
    + "'" + inputstring + "'"
    + ");"
  );
);

log geometry removed(objectname, alg, inputlist) := if(LOGGINGENABLED,
  regional(id, inputstring);
	id = EVENTID;
	
  inputstring = inputlist + "";

  debug at("log geometry removed(3)", objectname + " via " + alg);

  remember event("geometry", "removed", [objectname, alg, inputstring]);

  javascript("sendGeometryEventToApi("
    + "'" + PROGRAMID + "',"
    + "'" + SCENARIOID + "',"
    + "'" + USERID + "',"
    + id + ","
    + "'removed',"
    + "'" + objectname + "',"
    + "'" + alg + "',"
    + "'" + inputstring + "'"
    + ");"
  );
);

log point moved(pointname, point) := if(LOGGINGENABLED,
	regional(id);
	id = EVENTID;

  debug at("log point moved(2)", pointname + " -> " + point.xy);

  remember event("geometry", "point_moved", [pointname, point.x, point.y]);

  javascript("sendPointMovedEventToApi("
    + "'" + PROGRAMID + "',"
    + "'" + SCENARIOID + "',"
    + "'" + USERID + "',"
    + id + ","
    + "'" + pointname + "',"
    + point.x + ","
    + point.y
    + ");"
  );
);

log stamped point(pointname, point, angle) := if(LOGGINGENABLED,
  regional(id, jscode);
  id = EVENTID;
  
  debug at("log stamped point(3)", pointname + " at " + point.xy + ", angle = " + angle);

  remember event("interaction", "point_stamped", [pointname, point.x, point.y, angle]);

  jscode = "sendStampedPointEventToApi("
    + "'" + PROGRAMID + "',"
    + "'" + SCENARIOID + "',"
    + "'" + USERID + "',"
    + id + ","
    + "'" + pointname + "',"
    + point.x + ","
    + point.y + ","
    + "'" + angle + "'"
    + ");";

  debug value("jscode stamped", jscode);

  javascript(jscode);
);

log started() := if(LOGGINGENABLED,
	regional(id, jscode);
	id = EVENTID;
	
  debug at("log started()", "Logging material start");

  remember event("system", "started", "-");

	jscode = "sendStartedEventToApi("
    + "'" + PROGRAMID + "',"
    + "'" + SCENARIOID + "',"
    + "'" + USERID + "',"
    + id
    + ");";

  javascript(jscode);
);


// =============================== //
// Generic logger for mouse events //
// =============================== //

log mouse event(action) := if(LOGGINGENABLED,
  regional(id, pos, target);
	id = EVENTID;

  pos = mouse();

  target = "-";
  if(length(elementsatmouse()) > 0,
    target = (elementsatmouse()_1).name + "";
  );

  debug at("log mouse event(1)", action + " at " + pos);

  remember event("input", action, [pos.x, pos.y, target]);

  javascript("sendMouseEventToApi("
    + "'" + PROGRAMID + "',"
    + "'" + SCENARIOID + "',"
    + "'" + USERID + "',"
    + id + ","
    + "'" + action + "',"
    + pos.x + ","
    + pos.y + ","
    + "'" + target + "'"
    + ");"
  );
);


// ================================ //
// Logger for specific mouse events //
// ================================ //

log mouse down()			 := log mouse event("mouse_down");
log mouse up()				 := log mouse event("mouse_up");
log mouse click()			 := log mouse event("mouse_click");
log mouse drag start() := log mouse event("mouse_drag_start");
log mouse drag end() 	 := log mouse event("mouse_drag_end");
//[FUN] Object functions
/** v2 ******************************************************************************************
* Helper functions for interacting with objects (instance method like)
*
* Recent changes:
* 2026-07-26: Change log behavior.
************************************************************************************************/

/**
* Call a property (function) of a VAM object, with some settable parameters.
* @param object: VAM object reference
* @param action: key of the property (String)
* @param startmouse: used to calc "coord" for mouse starting mouse coordinates as reference point for the object on click
* @param startcoord: used to calc "coord" for mouse starting mouse coordinates
* @param mouse: TODO
* @param mousedelta: TODO
* @return: The result of the called function.
**/
act(object, action, startmouse, startcoord, mouse, mousedelta) := (
	eval(object:action,	coord->startcoord-startmouse+mouse, 
											delta->startcoord-startmouse,
											mouse->mouse,
											startmouse->startmouse,
											startcoord->startcoord,
											mousedelta->mousedelta
	);
);

// =======//
// Getter //
// =======//

/** 
* Get a property by the given "property"-key (and a given "object")
**/
get(property) := get(self(), property);
get(object, property) := object:property;

/** Specific getters for default VAM properties **/
get action() := get("action");
get action(object) := get(object, "getaction");

get clickable(value) := get("isclickable");
get clickable(object, value) := get(object, "isclickable");

get coord() := get("coord");
get coord(object) := get(object, "coord");

get hot() := get("ishot");
get hot(object) := get(object, "ishot");

get moveable() := get("ismoveable");
get moveable(object) := get(object, "ismoveable");

get name() := get("name");
get name(object) := get(object, "name");

get type() := get("type");
get type(object) := get(object, "type");

/** Alternatives for getters from self() **/
get my(property) := get(property);
get my action() := get action();
get my coord() := get coord();
get my name() := get name();
get my type() := get type();

/** Alternative getters for some default booleans (with specific "object") **/
is moveable() := get("ismoveable");
am i moveable() := is moveable();
is moveable(object) := object:"ismoveable";

is clickable() := get("isclickable");
am i clickable() := is clickable();
is clickable(object) := get(object, "isclickable");

is hot() := get("ishot");
am i hot() := is hot();
i am hot() := am i hot();	// very specific use case when used with if.
is hot(object) := get(object, "ishot");

/** Alternative to get(1) **/
my(property) := get my(property);


// =================//
// Cautious Setters //
// =================//

/**
* Add a key value pair iff the key does not already exists.
**/
add property(object, property, value) := if(!contains(keys(object), property),
	set(object, property, value);
	debug at("add property(3)", "Property " + property + " has been added to object.");
,
	warn at("add property(3)", "Property " + property + " already exists in object. Nothing added.");
);

add property(property, value) := add property(self(), property, value);

/**
* Change a "property" if it exists (for given "object")
**/
change property(object, property, value) := if(contains(keys(object), property),
	set(object, property, value)
,
	warn at("change property(3)", "Object does not contain property " + property + ". Nothing changed.")
);

change property(property, value) := change property(self(), property, value);
change(property, value) := change property(property, value);


// =======//
// Setter //
// =======//

/**
* Set a specific property by the given "property"-key (for specific "object")
**/
set(object, property, value) := (
	debug at("set(3)", property + " set.");
	object:property = value;
);
set(property, value) := set(self(), property, value);
set my(property, value) := set(property, value);

/**
* Specific setters
**/
set action(value) := set("action", value);
set action(object, value) := set(object, "action", value);

set clickable(value) := set("isclickable");
set clickable(object, value) := set(object, "isclickable", value);

set coord(value) := set("coord", value);
set coord(object, value) := set(object, "coord", value);

set hot(value) := set("ishot");
set hot(object, value) := set(object, "ishot", value);

set moveable(value) := set("ismoveable", value);
set moveable(object, value) := set(object, "ismoveable", value);

set name(value) := set("name", value);
set name(object, value) := set(object, "name", value);

set type(value) := set("type", value);
set type(object, value) := set(object, "type", value);

/**
* Alternatives for setters from self()
**/
set my action(value) := set action(value);
set my clickable(value) := set clickable(value);
set my coord(value) := set coord(value);
set my hot(value) := set hot(value);
set my moveable(value) := set moveable(value);
set my name(value) := set name(value);
set my type(value) := set type(value);


// ========//
// Toggles //
// ========//

toggle clickable(object) := set clickable(object, !is clickable(object));
toggle clickable() := toggle clickable(self());
toggle my clickable() := toggle clickable();

toggle hot(object) := set hot(object, !is hot(object));
toggle hot() := toggle hot(self());
toggle my hot() := toggle hot();

toggle moveable(object) := set moveable(object, !is moveable(object));
toggle moveable() := toggle moveable(self());
toggle my moveable() := toggle moveable();


// ===== //
// Other //
// ===== //

/**
* Filter an object according to a given list of keys.
**/
pick keys(keylist) := pick keys(self(), keylist);
pick keys(object, keylist) := (
	regional(result);
  result = {};
  
  forall(keylist,
    result:# = object:#;
  );

  result;
);

/**
* Get all values of an object in a list (equivalent to keys())
**/
values(object) := (
	regional(values);
	values = [];

	forall(keys(object), key,
		values = values :> object:key
	);

	values;
);
//[FUN] Obj interaction
/** v1 ******************************************************************************************
* Helper functions for interacting with "obj"
*
* Recent changes:
************************************************************************************************/

/**
* Remove all objects of given type from obj.
**/
kill type(type) := (
	regional(len);
	len = length(obj);
	obj = select(obj, #:"type" != type);
	
	debug at("kill type(1)", (len - length(obj)) + "of type " + type + " objects have been removed from obj.");
);

/** 
* Remove specific item from obj.
**/
kill(item) := (
	regional(iteminobj);
	iteminobj = contains(obj,item);
	
	obj = obj -- [item];

	if(iteminobj,
		debug at("kill(1)", item:"name" + " has been removed from obj.");
	,
		debug at("kill(1)", item:"name" + " not in obj. Nothing to do.");
	);
);

/**
* Remove self() from obj.
**/
kill me() := kill(self());
//[FUN] Strings
/** v2 ******************************************************************************************
* String stuff.
*
* Recent changes:
* 2026-08-09: Add to json(1) and escape json(1) as serializer
************************************************************************************************/

colorize string(s,c):= if(ISCINDYJS,
	"\\color{#"+hexcolor(c)+"}{\\Large "+s+"}"
,
	"{\\color{"+hexcolor(c)+"}"+s+"}"
);

ends with(str, postfix) := (
	substring(str, length(str)-length(postfix), length(str)) == postfix;
);

/**
* Escape the characters that must not appear unescaped inside a JSON string.
* Backslash goes first, otherwise the backslashes added afterwards get escaped
* a second time.
**/
escape json(text) := (
	regional(out);
 
	out = replace(text, "\\", "\\\\");
	out = replace(out, QUOTE, "\\" + QUOTE);
	out = replace(out, unicode("0009"), "\\t");
	out = replace(out, unicode("000A"), "\\n");
	out = replace(out, unicode("000D"), "\\r");
 
	out;
);

/**
* Get box, wherein text is actually horizontally centered.
**/
get adjusted boundingbox(text, coord, size, font) := (
	regional(pxsize);
	bold = default to(bold, false);

	pxsize = pixelsize(text, size->size, font->font, bold->bold); // [width,height,baseline] in px
	pxsize = pxsize / screenresolution(); // convert to world units
	rectangle(coord-[0,.5*pxsize_3],pxsize_1,pxsize_2); // return rectangle moved down by half the baseline to center box around text
);

/**
* Find the bounding rectangle for a text with given size and font.
**/
get boundingbox(text, coord, size, font) := (
	regional(pxsize, bld);

	bld = default to(mod'bold, false);

	pxsize = pixelsize(text, size->size, font->font, bold->bld); // Return [width,height,baseline] in px.
	pxsize = pxsize / screenresolution(); // Convert to world units.

	rectangle(coord,pxsize_1,pxsize_2); // Return rectangle moved down by half the baseline to center box around text.
);

/**
* Return the numeral for a given number.
**/
numeral(number) := (
	regional(nameindex, value, numeral, subnumeral);
	numeral = "";
	number = abs(number); // get absolute value of number
	nameindex = 1;
	while(number>0, 
		value = mod(number,1000); // get last 3 digits of number
		number = floor(number/1000); // get remaining digits of number
		subnumeral = "";

		// handle triples from right to left
		if(value != 0, // only crunch, if value needs to be written as numeral
			// handle hundreds
			if(value >= 100,
				subnumeral = NUMERALS:((value+"")_1); // get hundreds
				if(subnumeral == "eins", subnumeral = "ein"); // fix grammar inconsistency 
				subnumeral = subnumeral + "hundert";
			);
			// handle tens
			value = mod(value,100);
			if(value > 0, // only crunch, if value has tens or units
				if(value < 20,
					subnumeral = subnumeral + NUMERALS:value;
					if(subnumeral == "eins" & nameindex > 2, subnumeral = "eine"); // fix grammar inconsistency 
					if(subnumeral == "eins" & nameindex == 2, subnumeral = "ein"); // fix grammar inconsistency 
				, // else: value >= 20
					subnumeral = subnumeral + if(mod(value,10)==1, "ein", if(mod(value,10) != 0, NUMERALS:(mod(value,10)), "")); // ones digit
					subnumeral = subnumeral + if(mod(value,10)!=0, "und", "");
					subnumeral = subnumeral + TENSNUMERALS:(10*floor(value/10)); // tens digit
				);
			);
		);

		// add big number numeral
		if(subnumeral != "",
			if(nameindex == 2, subnumeral = subnumeral + BIGNUMBERNUMERALS_nameindex); 
			if(nameindex > 2, 
				subnumeral = subnumeral + " " + BIGNUMBERNUMERALS_nameindex;
				subnumeral = subnumeral + if(subnumeral_(-1) == "e", "n ", "en ");
			);
		);

		// piece together
		numeral = subnumeral + numeral;
		nameindex = nameindex + 1; // next big number (million, billion, ...)
	);
	
	numeral; // return
);

readable datetime() := (
	regional(resultstring);
	resultstring = "";
	// Handle date
	forall(date(),
		if(# < 10, resultstring = resultstring + "0");
		resultstring = resultstring + # + "-";
	);

	resultstring = substring(resultstring,0,length(resultstring)-1);
	resultstring = resultstring + ", ";

	forall(time(),
		if(# < 10, resultstring = resultstring + "0");
		resultstring = resultstring + # + ":";
	);

	resultstring = substring(resultstring,0,length(resultstring)-1);
	
	resultstring;
);

starts with(str, prefix) := (
	indexof(str, prefix) == 1;
);

/**
* Serialise a CindyScript value as JSON.
*
* Needed wherever a value is handed to JavaScript by string concatenation:
* Cinderella and CindyJS stringify values inside a dictionary differently, so
* building the JSON explicitly is the only way to get the same result in both.
*
* Handles numbers, booleans, strings, lists and dictionaries, nested in any
* combination. Undefined becomes null.
*
* STRICT: strings are quoted and escaped HERE. Do not add quotes at the call
* site - they would be escaped and end up inside the value.
*
* Branch order matters: keys() returns an empty list for a plain list, so the
* list case has to be checked before the dictionary case.
**/
to json(value) := (
	regional(out, n, parts, ks);

	out = if(isundefined(value),
		"null";
	, if(isstring(value),
		QUOTE + escape json(value) + QUOTE;
	, if(islist(value),
		parts = "";
		n = length(value);
		forall(1..n,
			parts = parts + to json(value_#);
			if(# < n, parts = parts + ",");
		);
		"[" + parts + "]";
	, (
		// Dictionary or scalar. keys() is undefined for numbers and booleans,
		// and length(undefined) behaves differently in Cinderella and CindyJS -
		// so guard it instead of testing length(keys(value)) directly.
		ks = keys(value);
		if(isundefined(ks), ks = []);

		if(length(ks) > 0,
			parts = "";
			n = length(ks);
			forall(1..n,
				parts = parts + QUOTE + escape json(ks_#) + QUOTE + ":" + to json(value:(ks_#));
				if(# < n, parts = parts + ",");
			);
			"{" + parts + "}";
		, // numbers and booleans
			"" + value;
		);
	))));

	out;
);

wrap quote(string) := QUOTE + string + QUOTE;
//[FUN] Geometry
/** v1 ******************************************************************************************
* Helper functions for interacting with objects (instance method like)
*
* Recent changes:
************************************************************************************************/

angle(p1, p2, p3) := (
	regional(angle);
	angle = directed angle(p1,p2,p3);
	if(angle < 0, 
		angle = angle + 2* PI, angle
	);
);

/**
* Arc defined by 3 points and the distance r from point p2.
**/
arc(p1, p2, p3, r) := (
	regional(v1,v2,startangle,stopangle);
	
	// Corresponding vectors
	v1 = p1 - p2;
	v2 = p3 - p2;

	// Calc start and stop angle of vectors
	startangle = arctan2(v1_1, v1_2);
	stopangle = arctan2(v2_1, v2_2);
	if(stopangle < startangle, stopangle = stopangle + 2*PI); // Adjust stopangle to always be bigger than startangle

	// Return
	ellipse(p2,r,r,startangle, stopangle);
);

/**
* Calculate center of mass of a polygon (arithmetic mean of vertices).
**/
center of mass(polygon) := sum(polygon)/length(polygon);

/**
* Calculate centroid of a polygon using the geometric formula.
* @param polygon: A list of points forming the polygon
* @returns: [x,y] Coords of the centroid.
**/
centroid(polygon) := (
		regional(n, area, cx, cy);
		
    n = length(polygon);
    area = 0;
    cx = 0;
    cy = 0;
    
    repeat(n, i,
        j = mod(i, n) + 1;  // Next vertex (loops back to first)
        p1 = polygon_i;      // Current vertex
        p2 = polygon_j;      // Next vertex
        
        // Cross product term for area calculation
        factor = p1.x * p2.y - p2.x * p1.y;
        
        // Accumulate coordinates for centroid
        cx = cx + (p1.x + p2.x) * factor;
        cy = cy + (p1.y + p2.y) * factor;
        
        // Accumulate signed area
        area = area + factor;
    );
    
    // Complete the area calculation
    area = area/2;
    
    // Calculate final centroid coordinates
    if(abs(area) > 0.000001, // Check if area is not too close to 0
        cx = cx/(6*area);
        cy = cy/(6*area);
        [cx, cy]
    ,
        // Fallback to arithmetic mean if area is too small
        center of mass(polygon)
    );
);

directed angle(p1, p2, p3) := (
	regional(v1,v2);
	v1 = p1 - p2;
	v2 = p3 - p2;
	arctan2(v2_1, v2_2) - arctan2(v1_1, v1_2);
);

/** 
* Returns a list of points along an elliptical arc
* @param center: center of the ellipse (e.g., [0,0])
* @param a: semi-axis length in x-direction
* @param b: semi-axis length in y-direction
* @param angle: rotation angle of the ellipse in radians (optional)
* @param t1: start angle (parameter domain, e.g., 0) (optional)
* @param t2: end angle (parameter domain, e.g., pi/2) (optional)
* @param steps: number of segments (optional)
**/
ellipse(center, a, b, t1, t2) := ellipse(center, a, b, NADA, t1, t2, NADA);
ellipse(center, a, b) := ellipse(center, a, b, NADA, NADA, NADA, NADA);
ellipse(center, a, b, angle, t1, t2, steps) := (
	// Setup optional variables
	angle	= if(!isundefined(angle), angle, 0);
	t1		= if(!isundefined(t1), t1, 0);
	t2		= if(!isundefined(t2), t2, 2*PI);
  steps = if(!isundefined(steps), steps, 100);

	regional(points);
  points = [];

  forall(0..steps,
    t = t1 + (t2 - t1) * # / steps;
    p = [a * cos(t), b * sin(t)];

    // Apply rotation
    p = [
      cos(angle)*p_1 - sin(angle)*p_2,
      sin(angle)*p_1 + cos(angle)*p_2
    ];

    // Apply translation
    p = p + center;
    points = points :> p;
  );

  points;
);

/** 
* Gets the bounding box of a polygon as [minX, maxX, minY, maxY].
**/
get boundingbox(poly) := (
	regional(minX, maxX, minY, maxY);
	minX = maxX = minY = maxY = NADA;
	
	forall(poly,
		// Fill on first pass.
		if(isundefined(minX), minX = #_1);
		if(isundefined(maxX), maxX = #_1);
		if(isundefined(minY), minY = #_2);
		if(isundefined(maxY), maxY = #_2);
		
		// Update on subsequent passes as required.
		if(#_1 < minX, minX = #_1);
		if(#_1 > maxX, maxX = #_1);
		if(#_2 < minY, minY = #_2);
		if(#_2 > maxY, maxY = #_2);
	);
	
	// Return
	[minX, maxX, minY, maxY];
);
in circle(center, radius, point) := is in circle(center, radius, point);
is in circle(center, radius, point) := dist(center, point) <= radius;

/** 
* Checks if a point is inside a polygon (by ray casting).
**/
in poly(poly, point) := is in poly(poly, point);
is in poly(poly, point) := (
	regional(rayStart, rayDir, edgeStart, edgeDir, 
		A, solution, numIntersections
	);
	
	// Fix starting point just left outside the bounding box of the poly.
	rayStart = (get boundingbox(poly)_1 - 1, point.y + exp(1));
	rayDir = point - rayStart;
	
	// Start ray left of the bounding box and at the y coordinate
	// of the point moved up by Euler's number to minimize chance of
	// edge cases, i.e. intersecting at a corner of the polygon.
	// Also: Possible shortcut, if point outside bounding box.

	// Iterate over all edges and check for count intersections with ray.
	numIntersections = 0;
	repeat(length(poly),
		// If not at the last vertex get edge by looking ahead one.	
		if(# != length(poly),
			edgeStart = poly_#;
			edgeDir = poly_(#+1) - poly_#;
		, // Else, consider the last and first vertex (last pass only)
			edgeStart = poly_#;
			edgeDir = poly_1 - poly_#;
		);

		// Check ray and edge for intersection
		A = [[rayDir_1, -edgeDir_1], [rayDir_2, -edgeDir_2]];
		solution = linearsolve(A, edgeStart - rayStart);

		// Count as intersection if both entries of solution are in [0,1].
		if(!isundefined(solution),
			if(solution_1 >= 0 & solution_1 <= 1 & solution_2 >= 0 & solution_2 <= 1,
				numIntersections = numIntersections + 1;
			);
		);	
	); // End repeat

	// Return	true if odd number of intersections
	mod(numIntersections, 2) == 1;
);

/**
* Check if a given point [x,y] is in a rectangle.
* @param rect: [A,B,C,D] list of [x,y]-points of rectangle
* @param point: point [x,y] to check
**/
in rectangle(rect, point) := is in rectangle(rect, point);
is in rectangle(rect, point) := (
	point.x >= rect_1_1 & 
	point.x <= rect_2_1 & 
	point.y <= rect_3_2 & 
	point.y >= rect_1_2;
);

/**
* Check if a given point [x,y] is in a rounded rectangle.
**/
in rounded rectangle(coord, width, height, cornerradius, point) := is in rounded rectangle(coord, width, height, cornerradius, point);
is in roundedrectangle(coord, width, height, cornerradius, point) := (
	regional(isinside);
	inside = false; // assume point is outside

	if(in rectangle(rectangle(coord,width,height),point), // is in bounding rectangle
		inside = true;
		if(in rectangle(rectangle(coord,cornerradius,cornerradius),point) & 
				!in circle(coord+cornerradius*[1,1],cornerradius,point),
			inside = false; // outside of bottom left circle
		);
		if(in rectangle(rectangle(coord+[width-cornerradius,0],cornerradius,cornerradius),point) & 
				!in circle(coord+[width-cornerradius, cornerradius],cornerradius,point),
			inside = false; // outside of bottom right circle
		);
		if(in rectangle(rectangle(coord+[width-cornerradius,height-cornerradius],cornerradius,cornerradius),point) & 
				!in circle(coord+[width-cornerradius, height-cornerradius],cornerradius,point),
			inside = false; // outside of top right circle
		);
		if(in rectangle(rectangle(coord+[0,height-cornerradius],cornerradius,cornerradius),point) & 
				!in circle(coord+[cornerradius, height-cornerradius],cornerradius,point),
			inside = false; // outside of top left circle
		);
	);

	inside; // false
);

/**
* Check if a given point [x,y] is in a triangle.
* @param rect: [A,B,C] list of [x,y]-points of triangle
* @param point: point [x,y] to check
**/
in triangle(triangle, point) := is in triangle(triangle, point);
is in triangle(triangle, point) := if(length(triangle) == 3,
	and(
		gtzero(area(triangle_1,triangle_2,point)) == gtzero(area(triangle_2,triangle_3,point)),
		gtzero(area(triangle_2,triangle_3,point)) == gtzero(area(triangle_3,triangle_1,point))
	)
,
	warn at("is in triangle(2)", "Provided list has length " + length(triangle) + ". No triangle.");
	false
);

/**
* Returns coords of point, when mirrored at line given by an array of two points [p1,p2].
**/
mirror(point, line) := (
	regional(a,b,c, help);
	// Find parameters of line.
	a = line_1_2 - line_2_2;
	b = line_2_1 - line_1_1;
	c = line_1_1 * line_2_2 - line_2_1 * line_1_2;
	
	// Foot of perpendicular line.
	help = -2 * (a * point_1 + b * point_2 + c) / (a^2 + b^2);
	
	// Return 
	[help * a + point_1, help * b + point_2];
);

normalize(vector) := vector/vectorlength(vector);

/**
* A polygon, starting starting at coords in the bottom left going CCW.
* @param coords: [x,y] of bottom left corner of the rectangle
* @param width/height: width/height of rectangle
* @returns: [A,B,C,D] list of corners of the rectangle
**/
rectangle(coords, width, height) := (
	apply([(0,0),(width,0),(width,height),(0,height)],#+coords);
);

/**
* Generate a regular polygon with a specified number of verticies.
* @param center: [x,y] of the center of the poly
* @param radius: radius of the circumcircle
* @param vertices: number of vertices
* @returns: LIST of points or NADA (if vertices < 3)
**/
regular polygon(center, radius, vertices, rotation) := if(vertices > 2,
	apply(1..vertices,
		center + radius * (
			sin(rotation + #*2*PI / vertices),
			cos(rotation + #*2*PI/vertices)
		)
	)
,
	debug at("regular polygon(4)", "Must have more than 2 vertices but got " + vertices + ".");
);

/**
* Rotate a point around a center by a given angle.
**/
rotate(point, angle, center) := (
	point = point - center;
	point = point * [
		[cos(angle),sin(angle)],
		[-sin(angle),cos(angle)]
	];
	point + center;
);

/**
* A rectangle width given width and height width rounded corners
* @param coords: [x,y] of bottom left corner of the (not rounded) rectangle
* @param width/height: width/height of (not rounded) rectangle
* @param cornerradius: Radius with which to round the corners. Should be at maximum: min(width,height)/2
* returns: Shape representing the rounded rectagnle
**/
rounded rectangle(coords, width, height, cornerradius) := (
	regional(lowerleft, lowerright, upperright, upperleft, verticalrect, horizontalrect, shadowrect);
	
	// The 'normal' rectangle for reference
	shadowrect = rectangle(coords, width, height);
	
	// Adjust cornerradius if to big
	if(cornerradius > min(width,height)/2, cornerradius = min(width,height)/2);

	// Create circles for rounded corners (lowerleft, ...)
	lowerleft  = circle(shadowrect_1 + [cornerradius,cornerradius]  , cornerradius);
	lowerright = circle(shadowrect_2 + [-cornerradius,cornerradius] , cornerradius);
	upperright = circle(shadowrect_3 + [-cornerradius,-cornerradius], cornerradius);
	upperleft  = circle(shadowrect_4 + [cornerradius,-cornerradius] , cornerradius);

	// Create two bounding rectangles
	verticalrect   = rectangle(
		shadowrect_1 + [cornerradius,0],
		width-2*cornerradius,
		height
	);
	verticalrect   = polygon(verticalrect);
	horizontalrect = rectangle(
		shadowrect_1 + [0,cornerradius],
		width,
		height-2*cornerradius
	);
	horizontalrect = polygon(horizontalrect);

	// Build shape and return
	lowerleft ++ lowerright ++ upperright ++ upperleft ++ verticalrect ++ horizontalrect;
);

/**
* Rounded rectangle as a plain point list.
* Much cheaper to fill than the CSG version built from circles and polygons,
* which matters when many of them are drawn every frame.
*/
rounded rectangle poly(coords, width, height, cornerradius, steps) := (
	regional(r, pts, c, a);
	r = min(cornerradius, min(width, height)/2);
	steps = default to(steps, 4); // points per corner
	pts = [];

	forall([[width-r, r, -PI/2], [width-r, height-r, 0],
	        [r, height-r, PI/2],  [r, r, PI]], c,
		forall(0..steps,
			a = c_3 + # * (PI/2) / steps;
			pts = pts :> coords + [c_1 + r*cos(a), c_2 + r*sin(a)];
		);
	);

	pts;
);

to deg(angle) := angle/PI*180;

to rad(angle) := angle/180*PI;

vectorlength(vector) := sqrt(sum(apply(vector,#^2)));
//[FUN] Drawing
/** v2 ******************************************************************************************
* Helper functions for drawing
*
* Recent changes:
* 2027-07-30: Add functions - label angle, label segment, label point
************************************************************************************************/

draw arc(p1,p2,p3,r) := connect(arc(p1,p2,p3,r), color->color);

draw angle(p1,p2,p3,r) := draw closed arc(p1,p2,p3,r);
draw closed arc(p1,p2,p3,r) := connect([p2] ++ arc(p1,p2,p3,r) ++ [p2], color->color);

draw angle(p1,p2,p3,r1,r2) := draw closed arc(p1,p2,p3,r1,r2);
draw closed arc(p1,p2,p3,r1,r2) := draw(polygon([p2] ++ arc(p1,p2,p3,r1) ++ [p2]) -- polygon([p2] ++ arc(p1,p2,p3,r2) ++ [p2]), color->color);

draw move arrow(P,dx):= (
	dy=perp(dx);
	drawall(
		[ // arrow
			[P,P+dx],
			[P,P+(dx+dy)*.3],
			[P,P+(dx-dy)*.3],
			[P+dx,P+dx+(-dx+dy)*.3],
			[P+dx,P+dx+(-dx-dy)*.3]
		],
		color->(0,0,0),
		alpha->0.5
	);
);

/**
* Text output
*
* draw label(...)       plain text
* draw boxedlabel(...)  text on a filled background box
*
* MODIFIER CONVENTION: Optional arguments are passed as modifiers with a "mod'" prefix:
*
*   mod'font      fontfamily            default NADA
*   mod'color     font colour           default black
*   mod'bold      default false
*   mod'alpha     applies to text AND box, default 1
*   mod'bgcolor   box colour, draw boxedlabel only, default grey(.9)
*
* NOTE: sizes are given in PIXELS. Multiply by FONTSCALE where the size is
* defined (see the classes), not here - "get boundingbox" measures with the
* same number and the two must not drift apart.
**/

// --- plain text -----------------------------------------------------------
draw label(coord, text, size) := (
	regional(fnt, fc, bld, alp);

	fnt = default to(mod'font, NADA);
	fc  = default to(mod'color, grey(0));
	bld = default to(mod'bold, false);
	alp = default to(mod'alpha, 1);

	drawtext(coord, text, size->size, font->fnt, bold->bld, color->fc, alpha->alp);
);
draw label(coord, text) := draw label(coord, text, NADA);

// --- text on a background box ---------------------------------------------
draw boxedlabel(coord, text, size) := (
	regional(fnt, fc, bld, alp, bg, box);

	fnt = default to(mod'font, NADA);
	fc  = default to(mod'color, grey(0));
	bld = default to(mod'bold, false);
	alp = default to(mod'alpha, 1);
	bg  = default to(mod'bgcolor, grey(.9));

	box = get boundingbox(text, coord, size, fnt);

	fillpoly(box, color->bg, alpha->alp);
	
	draw label(coord, text, size, mod'font->fnt, mod'color->fc, mod'bold->bld, mod'alpha->alp);
);
draw boxedlabel(coord, text) := draw boxedlabel(coord, text, NADA);

// --- legacy -----------------------------------------------------------------
// @deprecated  Kept so existing VAMs keep working unchanged.
draw textbox(coord, text, size, font, fontcolor, bgcolor) := draw label(coord, text, size,
	mod'font  	-> font,
	mod'color 	-> default to(fontcolor, default to(color, grey(0))),
	mod'bold  	-> default to(bold, false),
	mod'alpha 	-> default to(alpha, 1)
);
draw textbox(coord, text, size, font, bgcolor) := draw textbox(coord, text, size, font, NADA, bgcolor);
draw textbox(coord, text, size, font)          := draw textbox(coord, text, size, font, NADA, NADA);
draw textbox(coord, text)                      := draw textbox(coord, text, NADA, NADA, NADA, NADA);

fill angle(p1,p2,p3,r) := fill closed arc(p1,p2,p3,r);
fill closed arc(p1,p2,p3,r) := fillpoly([p2] ++ arc(p1,p2,p3,r) ++ [p2], color->color, alpha->alpha);

fill angle(p1,p2,p3,r1,r2) := fill closed arc(p1,p2,p3,r1,r2);
fill closed arc(p1,p2,p3,r1,r2) := fill(polygon([p2] ++ arc(p1,p2,p3,r1) ++ [p2]) -- polygon([p2] ++ arc(p1,p2,p3,r2) ++ [p2]), color->color, alpha->alpha);

/**
* Angle labeling
* Place a label inside an angular sector so that it does not collide with the
* legs of the angle. The distance from the vertex is derived from the opening
* angle: the sector is 2*r*sin(theta/2) wide, so the label needs
*     r >= (textwidth/2 + padding) / sin(theta/2)
* to fit. Wide angles keep the label close to the vertex, narrow angles push
* it outwards automatically.
*
* @param P, Q  points on the two legs
* @param S     vertex of the angle
* @param r     nominal radius (usually the drawn arc radius)
* @param text  label text
* @param size  fontsize
* @param font  fontfamily (may be NADA)
* eval optionally with:
*   'labelmode -> "auto" (default) | "inside" | "outside"
*   'labelpadding -> extra space around the text (default .15)
*   'maxradiusfactor -> cap relative to the shorter leg (default .45)
* @returns the coordinate the label was drawn at
**/
label angle(P, S, Q, r, text, size, font) := (
	regional(u, v, bisector, theta, box, w, h, rmin, radius, maxradius, pos, mode, padding);

	mode    = if(isundefined('labelmode), "auto", 'labelmode);
	padding = if(isundefined('labelpadding), .15, 'labelpadding);
	fontcolor = if(isundefined('fontcolor), grey(0), 'fontcolor);

	// Unit vectors along the legs and the bisector
	u = normalize(P - S);
	v = normalize(Q - S);
	bisector = u + v;
	// Degenerate case: legs are opposite (straight angle) -> use perpendicular
	if(vectorlength(bisector) < .0001,
		bisector = [-u_2, u_1];
	,
		bisector = normalize(bisector);
	);

	// Opening angle
	theta = angle(P, S, Q);
	if(theta > PI, theta = 2*PI - theta);

	// Label dimensions
	box = getboundingbox(text, [0,0], size, font);
	w = box_2_1 - box_1_1;
	h = box_4_2 - box_1_2;

	// Radius needed so the label fits between the legs
	rmin = (w/2 + padding) / max(sin(theta/2), .05); // guard against tiny angles
	rmin = rmin + h/2;

	radius = if(mode == "inside",
		r * .6
	, if(mode == "outside",
		r + h/2 + padding
	, // "auto"
		max(r * .6, rmin)
	));

	// Never push the label beyond the shorter leg
	maxradius = if(isundefined('maxradiusfactor), .45, 'maxradiusfactor)
		* min(dist(S, P), dist(S, Q));
	if(radius > maxradius, radius = maxradius);

	// Centre the bounding box on the computed point
	pos = S + radius * bisector;
	pos = pos + S - centroid(getboundingbox(text, S, size, font));

	drawtextbox(pos, text, size, font, fontcolor, NADA, bold->false);

	pos; // Return
);

/**
* Place a label next to a segment, offset perpendicular to it and always on
* the side facing AWAY from a reference point (usually the opposite vertex).
* This keeps the label outside the triangle for every configuration, so it
* never ends up lying on one of the edges.
*
* @param P, Q      endpoints of the segment
* @param awayfrom  reference point the label should avoid (opposite vertex)
* @param text      label text
* @param size      fontsize
* @param font      fontfamily (may be NADA)
* eval optionally with:
*   'labelposition -> position along the segment, 0..1 (default .5 = midpoint)
*   'labelpadding  -> extra gap between segment and label (default .15)
* @returns the coordinate the label was drawn at
*/
label segment(P, Q, awayfrom, text, size, font) := (
	regional(t, anchor, dir, normal, box, h, w, gap, pos);
 
	t   = if(isundefined('labelposition), .5, 'labelposition);
	gap = if(isundefined('labelpadding), .15, 'labelpadding);
	fontcolor = if(isundefined('fontcolor), grey(0), 'fontcolor);
	
	anchor = P + t * (Q - P);
	dir    = normalize(Q - P);
	normal = [-dir_2, dir_1];
 
	// Flip the normal so it points away from the reference point
	if((awayfrom - anchor) * normal > 0, normal = -normal);
 
	box = getboundingbox(text, [0,0], size, font);
	w = box_2_1 - box_1_1;
	h = box_4_2 - box_1_2;
 
	// Push out by half the diagonal extent in the normal direction, so the
	// label clears the line regardless of its orientation
	pos = anchor + (abs(normal_1)*w/2 + abs(normal_2)*h/2 + gap) * normal;
 
	// Centre the bounding box on that point
	pos = pos + anchor - centroid(getboundingbox(text, anchor, size, font));
 
	drawtextbox(pos, text, size, font, fontcolor, NADA, bold->false);
 
	pos; // Return
);
 
/**
* Place a label next to a point, offset away from a reference point
* (usually the centroid of the figure), so it never overlaps the figure.
*
* @param P         the point to label
* @param awayfrom  reference point the label should avoid
* @param text      label text
* @param size      fontsize
* @param font      fontfamily (may be NADA)
* eval optionally with:
*   'labelpadding -> extra gap between point and label (default .25)
* @returns the coordinate the label was drawn at
*/
label point(P, awayfrom, text, size, font) := (
	regional(dir, box, w, h, gap, pos);
 
	gap = if(isundefined('labelpadding), .25, 'labelpadding);
	fontcolor = if(isundefined('fontcolor), grey(0), 'fontcolor);
 
	dir = P - awayfrom;
	if(vectorlength(dir) < .0001, dir = [0,1], dir = normalize(dir));
 
	box = getboundingbox(text, [0,0], size, font);
	w = box_2_1 - box_1_1;
	h = box_4_2 - box_1_2;
 
	pos = P + (abs(dir_1)*w/2 + abs(dir_2)*h/2 + gap) * dir;
	pos = pos + P - centroid(getboundingbox(text, P, size, font));
 
	drawtextbox(pos, text, size, font, fontcolor, NADA, bold->false);
 
	pos; // Return
);

/**
* Width and height of a text as {"w": ..., "h": ...}, in world units.
* Convenience wrapper around get boundingbox().
**/
text box size(text, fontsize, fontfamily) := (
	regional(box);
	box = get boundingbox(text, [0,0], fontsize, fontfamily);
 
	{"w": box_2_1 - box_1_1, "h": box_4_2 - box_1_2};
);
//[FUN] Web Controls
/** v1 ******************************************************************************************
* Helper functions for messaging with parent frame in browser sessions, handling GET requests
* and the like.
*
* Recent changes:
************************************************************************************************/

/**
* Get a URL search parameter based on key
**/
get url param(key) := (
	regional(valueincs);
	
	javascript("
    var params = new URLSearchParams(window.location.search);
    var value = String(params.get('" + key + "'));
		var csquery = 'valueincs = ';
		csquery += '"+QUOTE+"';
		csquery += value;
		csquery += '"+QUOTE+"';
		cdy.evokeCS(csquery);
	");
	
	valueincs;
);

/**
* Get all URL search parameters
**/
get url params() := (
	regional(urlparams);
	urlparams = {};
	
	javascript("
    var params = new URLSearchParams(window.location.search);
    
		for (let [k,v] of params.entries()) {
			// stringify key and value
			var key = JSON.stringify(k);
      var val = JSON.stringify(v);
			
			// Build command: urlparams.key = val;
			var csquery = 'urlparams:' + key + ' = ' + val + ';';
			cdy.evokeCS(csquery);
		};
	");
	urlparams; // Return value
);

/**
* Post a message to parent browser frame.
**/
post value(name, value, msgtoken) := (
	javascript("
		window.parent.postMessage(
			{
				type: 'CJS_TO_SL_SET',
				token: '" + msgtoken + "',
				name: '" + name + "',
				value: " + value + "
			},
			'*'
		);
	");

	debug at("post value(3)", "Msg sent, Payload: name='" + name + "', value=" + value);
);
//[FUN] Math-like
/** v1 ******************************************************************************************
* Functions concerning math-like behavior
*
* Recent changes:
************************************************************************************************/

c2v(z) := complex to vector(z);
complex to vector(z) := [re(z), im(z)];

gt zero(x) := x > 0;
lt zero(x) := x < 0;
is zero(x) := x == 0;

hex(int) := hexadecimal(int);
hexadecimal(int) := "0123456789ABCDEF"_(1+floor(int/16)) + "0123456789ABCDEF"_(1+mod(int,16));

int(hex) := integer(hex);
integer(hex) := (
	regional(len, key, result);
	
	len = length(hex);
	result = 0;

	repeat(len,
		key = hex_(len+1-#);
		result = result + 16^(#-1) * HEXMAP:key;
		println(# + " : " +result)
	);
);

sign(x):= if(x < 0,
	-1
,
	if(x > 0,
		1
	,
		0
	)
);
//[FUN] Other
/** v2 ******************************************************************************************
* Functions that don't fall in a specific category (yet).
*
* Recent changes:
* 2026-07-27: Add default parse to(2) and default to(3)
* 2026-08-06: Remove object case from list(1) since that is already done by values(1)
************************************************************************************************/

datetime() := date() ++ time();

default to(var, defaultvalue) := if(!isundefined(var), var,	defaultvalue);
default parse to(var, defaultvalue) := if(isstring(var),
	if(!isundefined(var), parse(var),	defaultvalue);
,
	default to(var, defaultvalue);
);
default to(var, defaultvalue, parse) := if(parse,	default parse to(var, defaultvalue), default to(var, defaultvalue));

get screen params():= (
	bordersize = screenresolution()* BORDERSIZE; // equals 0.5 mm fineliner
	pinchsensitivity = 10/screenresolution() * PINCHSENSITIVITY;
);
  
hexcolor(c) := hex(255*(c_1)) + hex(255*(c_2)) + hex(255*(c_3)); 

is bool(expression) := expression == true % expression == false;

is defined(thing) := !isundefined(thing);

/**
* Create a list from a given thing.
**/
list(thing) := (
	regional(list);
	list = NADA;

	if(!islist(thing),

		// Undefined
		if(isundefined(thing),
			list = [];
		);

		// String
		if(isstring(thing),
			list = [];
			repeat(length(thing), list = list :> thing_#);
		);

		// default case: wrap in a one element list.
		// NOTE: this deliberately includes VAM objects - use values(o) if the
		// field values are wanted instead.
		if(isundefined(list), list = [thing]);
	);
	list;
);



/** True if ALL entries of a list are true. Empty list -> true. **/
list and(list) := !list or(apply(list, !#));
//list and(list) := !contains(list, false);
 
/** True if ANY entry of a list is true. Empty list -> false. **/
list or(list) := contains(list,true);

/**
* Smallest entry of a list together with its index: [value, index].
**/
min with index(l) := (
	regional(newlist);
	newlist = [];
	forall(1..length(l),
		newlist = newlist ++ [[l_#, #]];
	);
	sort(newlist, #_1)_1;
);

to bool(expression) := (
	regional(result);
	result = NADA;
	if(isstring(expression), result = expression != ""); // empty string false, else true
	if(isinteger(floor(expression)), result = floor(abs(expression)) != 0); // 0 => false, else true
	if(expression == true, result = true); // keep true true
	if(expression == false, result = false); // keep false false
	if(isundefined(result), result = false); // default to false for everything else
	result;
);

/**
* All entries of a list that are not undefined.
**/
select defined(l) := select(l, !isundefined(#));

type(data) := (
	regional(type);
	
	if(isundefined(type) & islist(data), type = "list");
	if(isundefined(type) & !isundefined(keys(data)), type = "object");
	if(isundefined(type) & isstring(data), type = "string");
	if(isundefined(type) & isinteger(data), type = "integer");
	if(isundefined(type) & isreal(data), type = "float");
	if(isundefined(type) & iscomplex(data), type = "complex");
	if(isundefined(type) & isbool(data), type = "boolean");

	type;
);

//[FUN] Animation
/** v1 ******************************************************************************************
* Functions relating to animations.
*
* Recent changes:
************************************************************************************************/

/** 
* Create animation object.
**/
new animationobject(object, property, startvalue, endvalue, duration, timeflow) := (
	regional(now);
	now = seconds();
	if(not(isundefined(delay)),now=now+delay);
	animations = animations :> 
		{ "object" : object, "property": property, 
			"startvalue" : startvalue, "endvalue" : endvalue,
	  	"starttime" : now, "endtime" : now + duration,
			"kill" : false,
			"timeflow" : timeflow,   // should be linear, accel, or jump
			"movepath": movepath
		};
	playanimation();
);

new animationobjectwithdelay(object, property, startvalue, endvalue, duration, timeflow, delay) := (
	regional(now,then); now = seconds();
	then=now+delay;
	animations = animations :> 
		{ "object" : object, "property": property, 
			"startvalue" : startvalue, "endvalue" : endvalue,
	  	"starttime" : then, "endtime" : then + duration,
			"kill" : false,
			"timeflow" : timeflow,   // should be linear, accel, or jump
			"movepath": movepath
		};
	playanimation();
);

setpropertylater(object, property, value, delay) := (
	regional(now,then); now = seconds();
	then=now+delay;
	animations = animations :> 
		{ "object" : object, "property": property, 
			"startvalue" : (object:property), "endvalue" : value,
	  	"starttime" : now, "endtime" : then,
			"kill" : false,
			"timeflow" : "set"   // should be linear, accel, or jump
		};
	playanimation();
);

new animationobject(object, property, startvalue, endvalue, duration, timeflow, kill) := (
	regional(now); now = seconds();
	animations = animations :> 
		{ "object" : object, "property": property, 
			"startvalue" : startvalue, "endvalue" : endvalue,
	  	"starttime" : now, "endtime" : now + duration,
			"kill" : kill,
			"timeflow" : timeflow, // should be linear, accel, or jump
			"movepath": movepath
		};
	playanimation();
);


new animationpath(object, property, startvalue, endvalue, duration, timeflow, f) := (
	regional(now); now = seconds();
	animations = animations :> 
		{ "object" : object, "property": property, 
			"startvalue" : startvalue, "endvalue" : endvalue,
	  	"starttime" : now, "endtime" : now + duration,
			"kill" : false,
			"timeflow" : timeflow,
			"movepath": f
		};
	playanimation();
);


new dolater(object, command, duration) := (
	regional(now); now = seconds();
	animations = animations :> 
		{ "object" : object, 
	  	"starttime" : now, 
			"endtime" : now + duration,
			"command" : command
		};
	playanimation();
);

//[FW] Constants
/** v5 ******************************************************************************************
* Predefined Constants (convention: CAPITALIZE CONSTANTS)
*
* Recent changes:
* 2026-06-11 Remove legacy naming scheme (potentially breaks older VAMs)
* 2026-06-11 Add constants for logging states (0..3)
* 2026-07-27 Add VISIBLERECT
* 2026-06-30 Add Icons for tracebuttonimageon and tracebuttonimageoff
* 2026-08-13 Add COLORPLASMA16 colors
************************************************************************************************/

// Predefined Constants
// - Convention: Captilize constants
// - Second copy of variable which does not follow convention for legacy use

// A | Preddefined colors
// A.0 | General colors
DARKRED=(228,26,28)/255;
DARKBLUE=(55,126,184)/255;
DARKGREEN=(77,175,74)/255;

// A.1 | DZLM colors
DZLMCOLORLIGHT = (207,221,225)/255;
DZLMCOLORDARK = (70,120,132)/255;
DZLMCOLORGOLD = (239,182,96)/255;
DZLMCOLORBLUE = (127,127,247)/255;
DZLMCOLORRED = (239,134,131)/255;

// A.2 | Colors representing place values
PLACECOLORRED = (102,194,165)/255;
PLACECOLORGREEN = (252,141,98)/255;
PLACECOLORBLUE = (141,160,203)/255;

PLACEVALUEPALETTE = [
	PLACECOLORGREEN,  // Hundreds
	PLACECOLORBLUE,		// Tens
	PLACECOLORRED			// Units
];

// A.3 | Divomath colors
DIVOGREEN = (129,239,104)/255;
DIVOVIOLET = (150,59,216)/255;
DIVOGREY = (130,149,192)/255;
DIVOBLACK = grey(0);
DIVORED = (246,68,69)/255;
DIVOBLUE = (120,148,194)/255;
DIVODARKBLUE = (6,67,86)/255;
DIVOYELLOW = (252,175,81)/255;

DIVOPALETTE = [
