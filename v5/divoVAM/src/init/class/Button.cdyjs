// v8
// Recent changes:
// - Added new Button type: ImageButton (inherits from Button)
// - Fixed click hightling not restoring to normal coloring
// - changed drawing of label in "draw"

new Button(coord,width,height,label,fontsize) := (
	regional(obj);
	obj = new VAMobject("Button");

	obj:"coord"  = coord;
	obj:"width"  = width;
	obj:"height" = height;
	obj:"cornerradius" = (width+height) / 50;
	obj:"color"	 = DZLMCOLORLIGHT;
	obj:"bordercolor" = DZLMCOLORDARK;
	obj:"fontcolor" = DZLMCOLORDARK;
	obj:"label"	 = label;
	obj:"fontsize" = defaultto(fontsize, 12);
	obj:"fontfamily" = nada;
	obj:"labelheight" = (
		regional(box);
		box = getboundingbox(label,[0,0],obj:"fontsize",obj:"fontfamily");
		box_4_2 - box_1_2;
	);

	obj:"ismoveable" = false;
	obj:"isfloating" = false;
	obj:"hasshadow" = true;
	obj:"hasborder" = true;
	obj:"show" = true;
	obj:"customlabeloffset" = [0,0];
	obj:"shadowoffset" = [0.03,-.05];
	obj:"hitbox" := rectangle(
		my("coord"),
		my("width"),
		my("height")
	);
	obj:"shape" := roundedrectangle(
		my("coord"),
		my("width"),
		my("height"),
		my("cornerradius")
	);
	obj:"draw" := if(my("show"),
		// Draw shadow
		if(my("hasshadow"),
			fill(roundedrectangle(
				my("coord")+my("shadowoffset"),
				my("width"),
				my("height"),
				my("cornerradius")
				),
				color->[0,0,0],
				alpha->0.2
			);
		);

		// Fill box
		fill(
			my("shape"),
			color->if(mousedown&my("ishot"),0.95*my("color"),my("color")),
			alpha->1
		);


		// Draw border
		if(my("hasborder"), draw(my("shape"), color->my("bordercolor")));
		
		// Draw Label
		regional(boxcenter, offset);
		
		offset = my("hitbox")_1 + .5 * (my("hitbox")_3 - my("hitbox")_1); // Button center
		boxcenter = getadjustedboundingbox(my("label"), offset, my("fontsize"), my("fontfamily")); // labels bounding box
		boxcenter = boxcenter_1 + .5 * (boxcenter_3 - boxcenter_1);
		offset = offset + offset - boxcenter;
		
		drawtextbox(offset + my("customlabeloffset"), my("label"), my("fontsize"), my("fontfamily"), NADA, color->my("fontcolor"), bold-> false);

		// Draw something after the button
		my("drawafter");

		// Debug draw
		if('debuglevel > 2,
			connect([my("hitbox")_1,my("hitbox")_3], color->[0,1,0]);
			connect([my("hitbox")_2,my("hitbox")_4], color->[0,1,0]);
			drawpoly(getboundingbox(my("label"), offset+my("customlabeloffset"), my("fontsize"), my("fontfamily")));
		);
	);
	obj:"drawafter" := nada;
	obj:"ishot" := if(my("show"),inrectangle(my("hitbox"),mouse().xy));
  obj:"click"	:= my("script");
  obj:"script" := println("Implement obj:script");

	obj:"move" := if(my("isfloating"),
		self():"coord" = my("coord") + mousedelta;
	);

	obj; // Return the button.
);


new ImageButton(coord,width,height,imgpath) := (
	regional(imgbtn);
	imgbtn = new Button(coord, width, height, imgpath, NADA);

	imgbtn:"imgscale" = 1;

	imgbtn:"draw" := if(my("show"),
		// Draw shadow
		if(my("hasshadow"),
			fill(roundedrectangle(
				my("coord")+[0.03,-0.05],
				my("width"),
				my("height"),
				my("cornerradius")
				),
				color->[0,0,0],
				alpha->0.2
			);
		);

		// Draw box and border
		fill(
			my("shape"),
			color->if(mousedown&my("ishot"),0.95*my("color"),my("color")),
			alpha->1
		);
		if(my("hasborder"), draw(
			my("shape"),
			color->my("bordercolor");
		));

		// Draw Image
			drawimage(my("coord")+.5*[my("width"),my("height")], my("label"), scale->my("imgscale"), rendering->"nice");

		// Draw something after the button has been drawn
		my("drawafter");
	);

	imgbtn; // Return the button.
);