";

// OVERRIDE from FW: divomath config, example usage
divomathSetState() := (
	regional(state);

	println("Calling divomathSetState from default VAM."); // debug

	state = 'dmstate; // original state (should be preserved)
	state.color = [0,1,0]; // change to green on next reload
	state.coord = [42,69]; // put "coord" value with some value in state for reasons
	state.astring = unicode("0022")+"defaultVAM"+unicode("0022"); // strings need to be enclosed in quotion marks (unicode 0x22)!

	nada; // Return state;
);

o = new VAMobject("Dummy");
o:"coord" = [4,4];
o:"ismoveable" = true;
o:"isclickable"  = true;
o:"color" = if(!isundefined('dmstate.color),
		'dmstate.color
	,
		DARKRED
);

o:"draw" := (
	fill(
		circle(my("coord"),1),
		color->my("color");
	);
	draw(my("coord"),color->[1,1,1]);
	drawtext(my("coord")+[.1,.1],my("coord"));
);

o:"click" := (
	o:"color" = [random(),random(),random()];
		
	if(!isundefined(divomathConfig),
		// Set result if in divomath
		divomathClearResult();
		divomathAddResult("centerX", my("coord")_1);
		println("Result added. centerX:" + my("coord")_1);
		divomathAddResult("centerY", my("coord")_2);
		println("Result added. centerY:" + my("coord")_2);
		divomathAddResult("center", my("coord"));
		println("Result added. center:" + my("coord"));
		divomathSendResult();

	// Debug print config
		println(divomathConfig);
	);		
);

obj = obj :> o;
'debuglevel = 10;
);

/* v15
* recent changes:
* - added handles for fontsize of expression, drawing expression, drawing verbal description, drawing tool button, selecting initial tool, setting the toolbuttons x and y, grouping type
* - fixed grid not properly displaying cutting when first cut and then regrouped
* - added line visualizing cut
* - added handles for configuring initial grid state (coloring, cutting, grouping)
* - made position of verbal description and expression properly configurable
* - implemented divomath state and result reporting functions
* - replaced divomathAddResult() with wrapper divomathPutResult()
* - added call to divomathUpdateResults() when moving hbar
* - fixed incorrect positioning of atoms when adding rows
* - added picturemode to be able to create a non interactive quasi-image when set to true
* - added Toggle and corresponding config for changing visibility of text/expression labels
* - fixed expression/verbal not showing correctly on init
* - added divomathUpdateResults() call to grid:"moveend" and grid:"click"
* - fixed wrong toolbutton position state saving in divomath
*/

// Distributivfeld
if(vam == "distributive",

// A | Documentation
//'doctextpos = [9,15.5];
'doc = "
	...
=======================================================
configuration:
  ...
=======================================================
";

// VAM global vars
regional('gridposition, 'rows, 'cols, 'atomsize, 'atomradius, 'atomcolors, 'atomverticalpadding, 'atomhorizontalpadding, 'groupspacing,
'cutwidth, 'gridmoveable, 'buttonsize, 'buttonpadding, 'lblpadding, 'animationspeed, 'picturemode);

'atomcolors = {
	"blue" : (40,111,255)/255,
	"green" : (50,202,48)/255,
	"orange" : (255,129,29)/255,
	"purple" : (165,57,255)/255
};

// B.1 | Divomath config
// States
'gridposition = defaultstateto("gridposition", [10,7]); // grid position on init
'rows = defaultstateto("rows", 5); // Starting number of rows in Grid
'cols = defaultstateto("cols", 7); // Starting number of columns in Grid
'atomsize = defaultstateto("size", 1); // General size of Atoms
'atomradius = defaultstateto("cornerradius", .5); // Corner radius of Atoms
'atomverticalpadding = defaultstateto("verticalpadding", .1); // vertical padding between Atoms
'atomhorizontalpadding = defaultstateto("horizontalpadding", .1); // horizontal padding between Atoms
'groupspacing = defaultstateto("groupspacing", .2); // Spacing for grouping on click
'cutwidth = defaultstateto("cutwidth", .3); // Spacing when cutting
'gridmoveable = defaultstateto("gridmoveable", true); // Flag, if whole grid is moveable
'buttonsize = defaultstateto("buttonsize", 2); // Size of Tool button
'buttonpadding = defaultstateto("buttonpadding", .4); // Size of Tool button;
'animationspeed = defaultstateto("animationspeed", .15); // Speed modifier for animations
'lblpadding = defaultstateto("labelpadding", 10.3); // Padding between output text and border;
'fontsize = defaultstateto("fontsize", 18); // Text size for text display
'drawexpression = defaultstateto("drawexpression", true); // Draw value or dont
'drawverbal = defaultstateto("drawverbal", true); // Draw verbal description or dont
'drawtoolbutton = defaultstateto("drawtoolbutton", true); // Draw button for changing tool
'tool = defaultstateto("tool", "hand"); // Preset tool (one of "hand", "bucket" or "scissors")
'toolbuttonx = defaultstateto("toolbuttonx", NADA); // Custom x coord for toolbutton (right edge if NADA)
if(isstring('toolbuttonx), 'toolbuttonx = NADA);
'toolbuttony = defaultstateto("toolbuttony", NADA); // Custom y coord for toolbutton (top edge if NADA)
if(isstring('toolbuttony), 'toolbuttony = NADA);
'groupingtype = defaultstateto("groupingtype", "ROWCOL"); // One of "NONE", "ROW", "COL" or "ROWCOL" - determines what groupings are possible
'coloredrowindex = defaultstateto("coloredrowindex", NADA);
if(isstring('coloredrowindex), 'coloredrowindex = NADA);
'coloredcolindex = defaultstateto("coloredcolindex", NADA);
if(isstring('coloredcolindex), 'coloredcolindex = NADA);
'cuthorizontally = defaultstateto("cuthorizontally", false);
'cutvertically = defaultstateto("cutvertically", false);
'groupby = defaultstateto("groupby", "NONE");
'expressionposition = defaultstateto("expressionposition", NADA);
'expressionmoveable = defaultstateto("expressionmoveable", false);
'verbalposition = defaultstateto("verbalposition", NADA);
'verbalmoveable = defaultstateto("verbalmoveable", false);
'picturemode = defaultstateto("picturemode", false); // Removes all interactivity if set to true
'showexpressiontoggle = defaultstateto("showexpressiontoggle", false);
'expressiontogglestate = defaultstateto("expressiontogglestate", true);

println(">>>> x: " + 'toolbuttonx);
println(">>>> x: " + isstring('toolbuttonx));
println(">>>> y: " + 'toolbuttony);
println(">>>> y: " + isstring('toolbuttony));

// Configure result handling and setState.
// Overwrite divomath result updating function.
divomathUpdateResults() := if(usedivomath,
	divomathClearResult();
	if('debuglevel>2, println("===updateResults()=================================================="));

	divomathPutResult("rows", grid:"rows"); // Report number of rows
	divomathPutResult("columns", grid:"cols"); // Report number of cols
	divomathPutResult("coloredrows", if(isundefined(grid:"flags":"color-row"),0,grid:"flags":"color-row")); // Report number of colored rows
	divomathPutResult("coloredcolumns", if(isundefined(grid:"flags":"color-col"),0,grid:"cols" - grid:"flags":"color-col" + 1)); // Report number of colored cols
	divomathPutResult("cuthorizontally", grid:"flags":"cut-row"); // Report wether grid is horiontally cut
	divomathPutResult("cutvertically", grid:"flags":"cut-col"); // Report wether grid is vertically cut
	divomathPutResult("groupby", grid:"flags":"group-by"); // Report grouping state

	divomathSendResult();
);

// Overwrite divomath setState()
divomathSetState() := (
	regional(state);

	// Build state object with current values
	state = {
		"gridposition" : grid:"coord",
		"rows" : grid:"rows",
		"cols" : grid:"cols",
		"atomsize" : 'atomsize,
		"atomradius" : 'atomradius,
		"atomverticalpadding" : 'atomverticalpadding,
		"atomhorizontalpadding" : 'atomhorizontalpadding,
		"groupspacing" : 'groupspacing,
		"cutwidth" : 'cutwidth,
		"gridmoveable" : 'gridmoveable,
		"buttonsize" : 'buttonsize,
		"buttonpadding" : 'buttonpadding,
		"animationspeed" : 'animationspeed,
		"lblpadding" : 'lblpadding,
		"fontsize" : 'fontsize,
		"drawexpression" : 'drawexpression,
		"drawverbal" : 'drawverbal,
		"drawtoolbutton" : 'drawtoolbutton,
		"tool" : QUOTE + grid:"tool" + QUOTE,
		"toolbuttonx" : if(!isundefined('toolbuttonx), grid:"toolbutton":"coord"_1, QUOTE+NADA+QUOTE),
		"toolbuttony" : if(!isundefined('toolbuttony), grid:"toolbutton":"coord"_2, QUOTE+NADA+QUOTE),
		"groupingtype" : QUOTE + 'groupingtype + QUOTE,
		"coloredrowindex" : if(!isundefined(grid:"flags":"color-row"), grid:"flags":"color-row",QUOTE+NADA+QUOTE),
		"coloredcolindex" : if(!isundefined(grid:"flags":"color-col"), grid:"flags":"color-col",QUOTE+NADA+QUOTE),
		"cuthorizontally" : grid:"flags":"cut-row",
		"cutvertically" : grid:"flags":"cut-col",
		"groupby" : QUOTE + grid:"flags":"group-by" + QUOTE,
		"expressionposition" : grid:"expression":"coord",
		"expressionmoveable" : grid:"expression":"ismoveable",
		"verbalposition" :  grid:"verbal":"coord",
		"verbalmoveable" : grid:"verbal":"ismoveable"
	};

	state; // Return
);

// C | Classes
// C.1 | Atom: Thing that gets arranged into a rectangle
new Atom(c, parent) := (
	regional(atom);
	atom = new VAMobject("Atom");
	atom:"coord" = if(isundefined(c),[0,0],c);
	atom:"size" = 'atomsize;
	atom:"color" = 'atomcolors:"blue";
	atom:"radius" = 'atomradius;
	atom:"parent" = parent;
	atom:"left" = NADA;
	atom:"right" = NADA;
	atom:"up" = NADA;
	atom:"down" = NADA;
	atom:"neighbors" := {
		"up": my("up"),
		"down": my("down"),
		"left": my("left"),
		"right": my("right")
	};

	atom:"shape" := roundedrectangle(my("coord"),my("size"),my("size"),my("radius"));
	atom:"hitbox" := atom:"shape";

	atom:"ishot" := if('picturemode, false, inroundedrectangle(my("coord"),my("size"),my("size"),my("radius"),mouse().xy));

	atom:"draw" := ( // can be evaled with 'atomalpha
		if(isundefined('atomalpha), 'atomalpha = 1);
		fill(my("shape"), color->my("color"), alpha->'atomalpha);

		if('debuglevel>0, draw(my("coord")));
	);

	atom:"click" := println("beep " + random());

	atom; // Return Atom
);

// C.2 | Grid: ...of Atoms
new Grid(c, rows, cols) := (
	regional(grid);
	grid = new VAMobject("Grid");
	grid:"coord" = c;
	grid:"rows" = max(1,rows);
	grid:"cols" = max(1,cols);
	grid:"verticalpadding" = 'atomverticalpadding;
	grid:"horizontalpadding" = 'atomhorizontalpadding;
	grid:"width" := (
		my("grid")_1_(-1):"coord"_1 + 'atomsize - my("coord")_1;
	);
	grid:"height" := my("grid")_(-1)_1:"coord"_2 + 'atomsize - my("coord")_2;
	grid:"ismoveable" := 'gridmoveable % my("tool") != "hand";

	// group, paintbucket and scissors controls
	grid:"cutwidth" = 'cutwidth;
	grid:"flags" = {
		"group-by": "NONE", // "NONE", "ROW" or "COLUMN" depending on how atoms should be visually grouped by increasing the padding
		"color-row": NADA, // MAX index of colored row
		"color-col": NADA, // MIN index of colored col
		"cut-row": false, // flag, if row is cut (bigger gap)
		"cut-col": false // flag, if column is cut (bigger gap)
	};

	// Scissors controls
	grid:"linetreshold" = 'atomsize; // treshold, at which line is either VERTICAL or HORIZONTAL
	grid:"linedirection" = NADA; // "VERTICAL" or "HORIZONTAL" depending on linetreshold
	grid:"linestart" = NADA; // point
	grid:"lineend" = NADA; // point

	grid:"grid" = (
		regional(atoms, newatom);
		atoms = []; // stores grid of Atoms

		repeat(rows, rowindex,
			atoms = atoms :> [];
			repeat(cols, colindex,
				newatom = new Atom(c + 'atomsize*[colindex-1,rowindex-1] + [(colindex-1)*'atomverticalpadding,(rowindex-1)*'atomhorizontalpadding], grid);
				newatom:"color" = 'atomcolors:"blue";
				atoms_rowindex = atoms_rowindex :> newatom;
			);
		);
		atoms; // Assign array of Atoms
	);

	grid:"hitbox" := rectangle(my("coord"), my("width"), my("height")); // Rounded rectangle just fitting around all Atoms
	grid:"shape" := roundedrectangle(my("coord"), my("width"), my("height"), 'atomradius); // Rounded rectangle just fitting around all Atoms
	
	grid:"ishot" := if('picturemode, false,
		if(my("tool") == "hand",
			inroundedrectangle(my("coord"), my("width"), my("height"), 'atomradius, mouse().xy);
		,
			true; // always true, so whole canvas can be drawn on
		);
	);
	grid:"draw" := (
		regional(m, rowindex, colindex);
		m = mouse().xy;		

		// Draw all Atoms
		forall(my("grid"), row,
			forall(row, atom,	atom:"draw");
		);

		// Draw line, when tool is scissors
		if(my("tool") != "hand",
			draw(my("linestart"), my("lineend"),
				color->if(my("tool") == "bucket", DZLMCOLORGOLD, grey(.5)),
				size->if(my("tool") == "bucket", 20, 4),
				dashtype->if(my("tool") == "bucket", 0, 2);
			);
		);

		// Draw persistent cutting line (HORIZONTAL)
		if(my("flags"):"cut-row",
			regional(refrow, point1, point2);
			refrow = my("flags"):"color-row" + 1; // line above the cut
			point1 = centroid([my("grid")_refrow_1:"coord",my("grid")_(refrow-1)_1:"coord"+[0,'atomsize]]);
			point2 = centroid([my("grid")_refrow_(-1):"coord" + ['atomsize,0], my("grid")_(refrow-1)_(-1):"coord" + ['atomsize,'atomsize]]);
			connect([point1, point2], color->grey(.5), size->1);
		);

		// Draw persistent cutting line (VERTICAL)
		if(my("flags"):"cut-col",
			regional(refcol, point1, point2);
			refcol = my("flags"):"color-col"; // line to the right of cut
			point1 = centroid([my("grid")_1_refcol:"coord",my("grid")_1_(refcol-1):"coord"+['atomsize,0]]);
			point2 = centroid([my("grid")_(-1)_refcol:"coord"+[0,'atomsize],my("grid")_(-1)_(refcol-1):"coord"+['atomsize,'atomsize]]);
			connect([point1, point2], color->grey(.5), size->1);
		);

		// Debug Draw
		if('debuglevel > 0,
			draw(my("shape"), size->3, dashtype->1);
			draw(my("coord"), size->4, color->[0,0,1]);
		);
	);

// === Interaction with Grid
	grid:"move" := if(my("ismoveable"),
		if(my("tool") == "hand",
			// Move Atoms
			forall(my("grid"), row,
				forall(row, atom,
					atom:"coord" = atom:"coord" + mousedelta;
				);
			);
		
			// Move grid itself (i.e. own coord and hitbox)
			self():"coord" = my("coord") + mousedelta;
		);
		
		if(my("tool") != "hand",
			regional(m);
			m = mouse().xy;

			// Set starting point of cut
			if(isundefined(my("linestart")), self():"linestart" = m);

			// Set direction and end point of cut
			// -1- direction not set yet
			if(isundefined(my("linedirection")),
				self():"lineend" = m;
				if(dist(my("lineend"), my("linestart")) > 'atomsize,
					regional(distxy);
					distxy = apply(my("lineend") - my("linestart"), abs(#));
					self():"linedirection" = if(distxy_1 > distxy_2, "HORIZONTAL", "VERTICAL");
				);
			);

			// -2- direction is "horizontal"
			if(my("linedirection") == "HORIZONTAL",
				self():"lineend" = [m_1, my("linestart")_2];
			);

			// -3- direction is "vertical"
			if(my("linedirection") == "VERTICAL",
				self():"lineend" = [my("linestart")_1, m_2];
			);
		);

	);

	grid:"moveend" := if(my("tool") != "hand",
		// Get index of active row/col
		regional(activeindex, ref);
		ref = my("linestart"); // Reference point for getting active index

		// Get Index of Atoms at linestart and lineend
		activeindex = [] :> eval(my("getactiveindex"), 'point->ref);
		activeindex = activeindex :> eval(my("getactiveindex"), 'point->mouse().xy);

		// Bucket logic ((un-)drawing stuff)
		if(my("tool") == "bucket" & !isundefined(activeindex_1) & !isundefined(activeindex_2),
			if(my("linedirection") == "VERTICAL",
				// Set/Reset flag for painting column, depending on if col is drawn over a second time
				self():"flags":"color-row" = if(my("flags"):"color-row" == activeindex_1_1, NADA, activeindex_1_1);
			);
			if(my("linedirection") == "HORIZONTAL",
				// Set/Unset flag for painting row, depending on if row is drawn over a second time
				self():"flags":"color-col" = if(my("flags"):"color-col" == activeindex_1_2, NADA, activeindex_1_2);
			);
			my("repaint"),
		);
		
		// Scissors logic ((un-)cutting stuff)
		if(my("tool") == "scissors",
			if(my("linedirection") == "VERTICAL", activeindex = activeindex_1_2);
			if(my("linedirection") == "HORIZONTAL", activeindex = activeindex_1_1);
			eval(my("cutgrid"), 'activeindex->activeindex, 'direction->my("linedirection"));
		);

		// Reset scissors vars
		self():"linestart" = NADA;
		self():"lineend" = NADA;
		self():"linedirection" = NADA;

		// Update expression text
		my("updateexpression");

		divomathUpdateResults();
	);

	grid:"click" := if(my("tool") == "hand", // handles grouping of rows or cols
		regional(state);
		state = my("flags"):"group-by";

		// 1. Set new state
		if(state == "NONE",
			if('groupingtype == "ROWCOL" % 'groupingtype == "ROW", state = "ROW"
			,
				if('groupingtype == "COL", state = "COLUMN");
			);
		, // else if
		if(state == "ROW",
			if('groupingtype == "ROWCOL" % 'groupingtype == "COL", state = "COLUMN"
			,
				state = "NONE";
			);
		, // else if
		if(state == "COLUMN", state = "NONE";
		)));
		
		// Update global state var and move atoms into place
		self():"flags":"group-by" = state;
		my("groupatoms");

		// Update expression text
		my("updateexpression");

		divomathUpdateResults();
	);

// === Add/remove a column/row
	grid:"addcol" := (
		regional(newcoord);
		self():"cols" = my("cols") + 1; // Increment column count

		// Loop over every row and add an Atom to the right
		repeat(my("rows"), row,
			newcoord = self():"grid"_row_(-1):"coord" + ['atomsize+my("verticalpadding"),0];
			if(my("flags"):"group-by" == "COLUMN", newcoord = newcoord + ['groupspacing,0]); // Adjust for spacing

			// Add new Atom in row
			self():"grid"_row = my("grid")_row :> new Atom(newcoord, self());
		);
		my("repaint");
	);
	
	grid:"removecol" := if(my("cols")>1,
		// Set flag for coloring rows and cutting status to undefined and false if not enough rows left
		if(my("flags"):"color-col" >= my("cols"),
			self():"flags":"color-col" = NADA;
			self():"flags":"cut-col" = false;
		);

		self():"cols" = my("cols") - 1; // Decrement column count

		// Loop over every row and remove rightmost Atom
		repeat(my("rows"), row,
			self():"grid"_row = my("grid")_row -- [my("grid")_row_(-1)];
		);
		my("repaint");
	);

	grid:"addrow" := (
		regional(newcoord, offset);
		offset = [0, 'atomsize+my("horizontalpadding")]; // offset to move down by for new row
		if(my("flags"):"group-by" == "ROW", offset = offset + [0,'groupspacing]); // Adjust for spacing
		
		self():"grid" = [] <: my("grid"); // Prepend empty row to grid

		self():"coord" = my("coord") - offset;

		self():"rows" = my("rows") + 1; // Increment row count

		// Loop over reference row and fill new first row with Atoms
		forall(my("grid")_2, atom,
			self():"grid"_1 = my("grid")_1 :> new Atom(atom:"coord" - offset, self());
		);
		
		// Inrease flag for coloring rows an repaint
		if(!isundefined(my("flags"):"color-row"), self():"flags":"color-row" = my("flags"):"color-row" + 1);
		my("repaint");
	);

	grid:"removerow" := if(my("rows")>1,
		// Set flag for coloring rows and cutting status to undefined and false if not enough rows left
		if(my("flags"):"color-row" <= 1,
			self():"flags":"color-row" = NADA;
			self():"flags":"cut-row" = false;
		);

		self():"grid" = my("grid")_(2..length(my("grid")));
		self():"coord" = my("grid")_1_1:"coord";
		self():"rows" = my("rows") - 1;

		// Decrease flag for coloring rows and repaint
		if(!isundefined(my("flags"):"color-row"), self():"flags":"color-row" = my("flags"):"color-row" - 1);
		my("repaint");
	);

// === Convenience and Eval Methods
	grid:"groupatoms" := (
		regional(state);
		state = my("flags"):"group-by";

		// 1. Animate Atoms accordingly
		regional(refatom, atom, newcoord); 
		refatom = my("grid")_1_1;
		apply(1..my("rows"), rowindex, apply(1..my("cols"), colindex,
			atom = my("grid")_rowindex_colindex;

			// Calculate basis for new coordinate without groupspacing (ROW or COLUMN)
			newcoord = refatom:"coord" + [(colindex-1)*('atomsize+'atomhorizontalpadding),0]; // x-offset normally;
			newcoord = newcoord + [0,(rowindex-1)*('atomsize+'atomhorizontalpadding)]; // x-offset with groupspacing;
			if(my("flags"):"cut-row" & my("flags"):"color-row" < rowindex, newcoord = newcoord + [0,'cutwidth]); // add row cutting offset
			if(my("flags"):"cut-col" & my("flags"):"color-col" < colindex+1, newcoord = newcoord + ['cutwidth,0]); // add row cutting offset

			// Adjust for row and column grouping
			if(state == "ROW", newcoord = newcoord + [0,(rowindex-1)*'groupspacing]);
			if(state == "COLUMN",newcoord = newcoord + [(colindex-1)*'groupspacing,0]);
			
			// Animate Atom
			new animationobject(atom, "coord", atom:"coord", newcoord, 'animationspeed, "accel");
		)); // END applys
	);

	grid:"repaint" := ( // Repaints all atoms in a grid based on color-flags
		regional(rowthresh, colthresh, topleft, topright, bottomleft, bottomright);
		
		// Threshold indexes for color change
		rowthresh = my("flags"):"color-row";
		if(isundefined(rowthresh), rowthresh = 0); // default, if no threshhold exists
		colthresh = my("flags"):"color-col";
		if(isundefined(colthresh), colthresh = my("cols")+1); // default, if no threshhold exists

		// Select topleft and topright subgrid (BLUE, ORANGE)
		topleft = if(rowthresh < my("rows"), my("grid")_((rowthresh+1)..my("rows")), []); // select complete rows
		topright = if(colthresh <= my("cols"), apply(topleft, row, row = row_(colthresh..my("cols"))), []); // select cols of topright subgrid
		topleft = apply(topleft, row, row = row_(1..(colthresh-1))); // cut off columns to the right for final topleft

		// Select bottomleft and bottomright subgrid (GREEN, PURPLE)
		bottomleft = if(rowthresh > 0, my("grid")_(1..rowthresh), []); // select complete rows
		bottomright = if(colthresh <= my("cols"), apply(bottomleft, row, row = row_(colthresh..my("cols"))), []); // select cols of bottomright subgrid
		bottomleft = apply(bottomleft, row, row = row_(1..(colthresh-1))); // cut off columns to the right for final bottomleft

		// Paint everything
		apply(topleft, row, apply(row, atom, atom:"color" = 'atomcolors:"blue"));
		apply(topright, row, apply(row, atom, atom:"color" = 'atomcolors:"orange"));
		apply(bottomleft, row, apply(row, atom, atom:"color" = 'atomcolors:"green"));
		apply(bottomright, row, apply(row, atom, atom:"color" = 'atomcolors:"purple"));

		// Update expression text
		my("updateexpression");

	);
	
	grid:"updateexpression" := (
		// Get state of grid
		regional(groupstate, rowcol, colcol, rowcut, colcut, expr, verbal, r, c, rci, cci);
		groupstate = my("flags"):"group-by";
		rowcol = !isundefined(my("flags"):"color-row");
		colcol = !isundefined(my("flags"):"color-col");
		rowcut = my("flags"):"cut-row";
		colcut = my("flags"):"cut-col";
		
		// Relevant numbers to display
		r = my("rows"); // Total rows
		c = my("cols"); // Total columns
		rci = my("flags"):"color-row"; // Index of colored row (row color index)
		cci = my("flags"):"color-col"; // Index of colored columns (column color index)

		// Handle different states in order: GROUPING > ROW COLOR > COL COLOR > ROW CUT > COL CUT
		// 1 no grouping
		if(groupstate == "NONE",
			if(rowcol, // 2 row colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "(" + (r-rci) + CDOT + (cci-1) + ") + " + 
											"(" + (r-rci) + CDOT + (c-cci+1) + ") + " + 
											"(" + rci + CDOT + (cci-1) + ") + " + 
											"(" + rci + CDOT + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " " + (cci-1) + "er und " + 
												numeral(r-rci) + " " + (c-cci+1) + "er und " + 
												numeral(rci) + " " + (cci-1) + "er und " + 
												numeral(rci) + " " + (c-cci+1) + "er. ";
						, // 5 col not cut
							value = (r-rci) + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ") + " + rci + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten und 
" + numeral(rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + (cci-1) + " + (" + (r-rci) + "+" + rci + ")" + CDOT + (c-cci+1);
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (cci-1) + " Punkten/Quadraten und
" + numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (c-cci+1) + " Punkten/Quadraten.";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "(" + (r-rci) + CDOT + c + ") + (" + (rci) + CDOT + c + ")";
							verbal = numeral(r-rci) + " " + c + "er und " + numeral(rci) + " " + c + "er.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + c;
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + c + " Punkten/Quadraten.";
						);
					);
				);
			, // 2 row not colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "(" + r + CDOT + (cci-1) + ")+(" + r + CDOT + (c-cci+1) + ")";
							verbal = numeral(r) + " " + (cci-1) + "er und " + numeral(r) + " " + (c-cci+1) + "er.";
						, // 5 col not cut
							value = r + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = r * c;
							verbal = value + " Punkte/Quadrate.";
						);
					);
				);
			);
		);

		// 1 grouping by row
		if(groupstate == "ROW",
			if(rowcol, // 2 row colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "(" + (r-rci) + CDOT + (cci-1) + ") + " + 
											"(" + (r-rci) + CDOT + (c-cci+1) + ") + " + 
											"(" + rci + CDOT + (cci-1) + ") + " + 
											"(" + rci + CDOT + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " " + (cci-1) + "er und " + 
												numeral(r-rci) + " " + (c-cci+1) + "er und " + 
												numeral(rci) + " " + (cci-1) + "er und " + 
												numeral(rci) + " " + (c-cci+1) + "er. ";
						, // 5 col not cut
							value = (r-rci) + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ") + " + rci + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten und 
" + numeral(rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + (cci-1) + " + (" + (r-rci) + "+" + rci + ")" + CDOT + (c-cci+1);
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (cci-1) + " Punkten/Quadraten und
" + numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (c-cci+1) + " Punkten/Quadraten.";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r-rci) + " und " + numeral(rci) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						)
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "(" + (r-rci) + CDOT + c + ") + (" + rci + CDOT + c + ")";
							verbal = numeral(r-rci) + " " + c + "er und " + numeral(rci) + " " + c + "er.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "(" + (r-rci) + "+" + rci + ")" + CDOT + c;
							verbal = (r-rci) + " und " + rci + " Reihen mit je " + c + " Punkten/Quadraten.";
						);
					);
				);
			, // 2 row not colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "(" + r + CDOT + (cci-1) + ") + (" + r + CDOT + (c-cci+1) + ")";
							verbal = numeral(r) + " " + (cci-1) + "er und " + numeral(r) + " " + (c-cci+1) + "er.";
						, // 5 col not cut
							value = r + CDOT + "(" + (cci-1) + "+" + (c-cci+1) + ")";
							verbal = numeral(r) + " Reihen mit je " + (cci-1) + " und " + (c-cci+1) + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = r  + CDOT + c;
							verbal = numeral(r)  + " " + c + "er.";
						);
					);
				);
			);
		);

		// 1 grouping by column
		if(groupstate == "COLUMN",
			if(rowcol, // 2 row colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "(" + (cci-1) + CDOT + (r-rci) + ") + " + 
											"(" + (cci-1) + CDOT + rci + ") + " + 
											"(" + (c-cci+1) + CDOT + (r-rci) + ") + " + 
											"(" + (c-cci+1) + CDOT + rci + ")";
							verbal = numeral(cci-1) + " " + (r-rci) + "er und " + 
												numeral(cci-1) + " " + (rci) + "er und " + 
												numeral(c-cci+1) + " " + (r-rci) + "er und " + 
												numeral(c-cci+1) + " " + (rci) + "er. ";
						, // 5 col not cut
							value = "(" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + (r-rci) + " + (" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + rci;
							verbal = numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + (r-rci) + " Punkten/Quadraten und
" + numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + rci + " Punkten/Quadraten.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = (cci-1) + CDOT + "(" + (r-rci) + "+" + rci + ") + " + (c-cci+1) + CDOT + "(" + (r-rci) + "+" + rci + ")";
							verbal = numeral(cci-1) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten und 
" + numeral(c-cci+1) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten.";
						, // 5 col not cut
							value = "(" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + "(" + (r-rci) + "+" + (rci) + ")";
							verbal = numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten.";
						)
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "(" + c + CDOT + (r-rci) + ") + (" + c + CDOT + rci + ")";
							verbal = numeral(c) + " " + (r-rci) + "er und " + numeral(c) + " " + rci + "er.";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = c + CDOT + "(" + (r-rci) + "+" + rci + ")";
							verbal = numeral(c) + " Spalten mit je " + (r-rci) + " und " + rci + " Punkten/Quadraten.";
						);
					);
				);
			, // 2 row not colored
				if(colcol, // 3 column colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "(" + (cci-1) + CDOT + r + ") + (" + (c-cci+1) + CDOT + r + ")";
							verbal = numeral(cci-1) + " " + r + "er und " + numeral(c-cci+1) + " " + r + "er.";
						, // 5 col not cut
							value = "(" + (cci-1) + "+" + (c-cci+1) + ")" + CDOT + r;
							verbal = numeral(cci-1) + " und " + numeral(c-cci+1) + " Spalten mit je " + r + " Punkten/Quadraten.";
						);
					);
				, // 3 column not colored
					if(rowcut, // 4 row cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = "@...";
							verbal = "@...";
						);
					, // 4 row not cut
						if(colcut, // 5 col cut
							value = "@...";
							verbal = "@...";
						, // 5 col not cut
							value = c + CDOT + r;
							verbal = numeral(c) + " " + r + "er.";
						);
					);
				);
			);
		);

		// Set expression handlers value and verbalvalue to built expressions
		self():"expression":"value" = value + ""; // force string for value, might be int
		self():"verbal":"value" = "Ich sehe " + verbal;
	);
	
	grid:"cutgrid" := ( //de-/increases atom distance at coloring edges... eval with 'activeindex for cut position and 'direction of cut from linedirection
	// example usage: eval(my("cutgrid"), 'activeindex->activeindex, 'direction->my("linedirection"));

		// ROW (un-)cutting
		if('direction == "HORIZONTAL" & ('activeindex == my("flags"):"color-row" % 'activeindex == my("flags"):"color-row" + 1) & 'activeindex < my("rows"),
			regional(rows);
			rows = my("grid")_((my("flags"):"color-row"+1)..my("rows")); // Select rows to alter
			if(my("flags"):"cut-row",
				// Uncut row, i.e. move all rows above the index down a little
				apply(rows, row, apply(row, atom, atom:"coord" = atom:"coord" - [0, my("cutwidth")]));
			,
				// Cut row, i.e. move all rows above the index up a little
				apply(rows, row, apply(row, atom, atom:"coord" = atom:"coord" + [0, my("cutwidth")]));
			);
			self():"flags":"cut-row" = !self():"flags":"cut-row"; // change flag state
		);

		// COLUMN (un-)cutting
		if('direction == "VERTICAL" & ('activeindex == my("flags"):"color-col" % 'activeindex == my("flags"):"color-col" - 1) & 'activeindex > 1,
			regional(col);
			cols = apply(my("grid"), row, row_(my("flags"):"color-col"..my("cols"))); // Select cols to alter
			if(my("flags"):"cut-col",
				// Uncut col, i.e. move all cols right of the index left a little
				apply(cols, row, apply(row, atom, atom:"coord" = atom:"coord" - [my("cutwidth"), 0]));
			,
				// Cut col, i.e. move all cols right of the index right a little
				apply(cols, row, apply(row, atom, atom:"coord" = atom:"coord" + [my("cutwidth"), 0]));
			);
			self():"flags":"cut-col" = !self():"flags":"cut-col"; // change flag state
		);
	);

	grid:"getactiveindex" := ( // for clicking a single atom ... eval with 'point (usually as mouse().xy))
		regional(hotrow, hotcol, c);
		hotrow = hotcol = NADA;
		c = my("coord");

		if(	'point_2 >= c_2 & 'point_2 <= c_2 + my("height") &
				'point_1 >= c_1 & 'point_1 <= c_1 + my("width"), // only calculate, if 'point inside grid

			// Calc index of hot row
			hotrow = 'point_2 - c_2;
			forall(1..my("rows"), rowindex,
				if('point_2 >= my("grid")_rowindex_1:"coord"_2, hotrow = rowindex);
			);

			// Calc index of hot column
			hotcol = 'point_1 - c_1;
			forall(1..my("cols"), colindex,
				if('point_1 >= my("grid")_1_colindex:"coord"_1, hotcol = colindex);
			);
		);

		[hotrow, hotcol]; // Return hot row and column
	);

	// Inner objects: UI elements
	// ==========================
	// === UI: Vertical bar
	grid:"vbar" = ( 
		regional(vbar);
		vbar = new VAMobject("Bar");
		vbar:"subtype" = "vertical";
		vbar:"parent" = grid;
		vbar:"ismoveable" = true;
		vbar:"width" = .1;
		vbar:"height" := my("parent"):"height";
		vbar:"color" = DIVODARKBLUE;
		vbar:"padleft" := 'atomsize/10 + if(my("parent"):"flags":"cut-col",my("parent"):"cutwidth",0);

		vbar:"coord" := nada; // Gets assigned by my("alignbar")
		vbar:"alignbar" := ( // (Re-)sets bar position
			self():"coord" := my("parent"):"coord" + [my("parent"):"width" + my("padleft"), 0];
			divomathUpdateResults();
		);
		vbar:"alignbar"; // Initially set coord

		vbar:"shape" := (
			regional(parts);
			parts = {};

			// Create vertical bar that is as tall as all strips combined
			parts:"bar" = rectangle(my("coord"), my("width"), my("height"));

			// Create circle
			regional(center, radius);
			radius = .7;
			center = my("coord") + [my("width"),0] + [radius+.2,my("height")/2];
			parts:"circle" = {"M": center, "r": radius};

			// Create vertical line through center of the circle
			parts:"circleline" = {"A": center - [0,1.1*radius], "B": center + [0,1.1*radius]};

			// Create triangles pointing left and right (scaling numbers are chosen by eye)
			trigoffset = [radius/2.3,0];
			parts:"lefttrig" = regularpolygon(center-trigoffset, radius/3, 3, PI/6);
			parts:"righttrig" = regularpolygon(center+1.05*trigoffset, radius/3, 3,-PI/6);

			parts; // Return shape object
		);

		vbar:"hitbox" := my("shape"):"circle";
		vbar:"ishot" := if(my("parent"):"tool" == "hand" & !'picturemode,
			dist(my("hitbox"):"M",mouse().xy) < my("hitbox"):"r",
			false
		);

		vbar:"draw" := if(my("parent"):"tool" == "hand",
			// Draw vertical bar
			fillpoly(my("shape"):"bar", color -> my("color"));

			// Draw base circle (hitbox)
			fill(circle(my("shape"):"circle":"M", my("shape"):"circle":"r"), color -> my("color"));		

			// Draw line through circle
			draw(my("shape"):"circleline":"A", my("shape"):"circleline":"B", size -> 3, color -> grey(1)
			);

			// Draw triangles
			fillpoly(my("shape"):"lefttrig", color -> grey(1));
			fillpoly(my("shape"):"righttrig", color -> grey(1));
		);

		vbar:"move" := if(my("ismoveable"),
			// Set position based on mouse coords
			self():"coord" = [
				max(coord_1,my("parent"):"coord"_1),
				my("parent"):"coord"_2
			];

			// Remove column if above 1 AND bar touches column
			if(my("coord")_1 < my("parent"):"coord"_1 + my("parent"):"width" - my("padleft"),
				my("parent"):"removecol";
			);

			// Add column if gap is big enough
			regional(space);
			space = 'atomsize + my("parent"):"verticalpadding" + my("padleft");
			if(my("coord")_1 - (my("parent"):"coord"_1 + my("parent"):"width") > space ,
				my("parent"):"addcol";
			);
		);

		vbar:"moveend" := my("alignbar");

		vbar; // Return bar
	);

	// === UI: Horizontal bar
	grid:"hbar" = ( 
		regional(hbar);
		hbar = new VAMobject("Bar");
		hbar:"subtype" = "horizontal";
		hbar:"parent" = grid;
		hbar:"ismoveable" = true;
		hbar:"width" := my("parent"):"width";
		hbar:"height" = .1;
		hbar:"color" = DIVODARKBLUE;
		hbar:"padup" := 2*'atomsize/10 + if(my("parent"):"flags":"cut-row",my("parent"):"cutwidth",0);

		hbar:"coord" := nada; // Gets assigned by my("alignbar")
		hbar:"alignbar" := ( // (Re-)sets bar position
			self():"coord" := my("parent"):"coord" - [0, my("padup")];
			divomathUpdateResults();
		);
		hbar:"alignbar"; // Initially set coord

		hbar:"shape" := (
			regional(parts);
			parts = {};

			// Create vertical bar that is as tall as all strips combined
			parts:"bar" = rectangle(my("coord"), my("width"), my("height"));

			// Create circle
			regional(center, radius);
			radius = .7;
			center = my("coord") + [my("width")/2,-radius-.2];
			parts:"circle" = {"M": center, "r": radius};

			// Create vertical line through center of the circle
			parts:"circleline" = {"A": center - [1.1*radius,0], "B": center + [1.1*radius,0]};

			// Create triangles pointing left and right (scaling numbers are chosen by eye)
			trigoffset = [0,radius/2.3];
			parts:"uptrig" = regularpolygon(center+1.05*trigoffset, radius/3, 3, 2*PI/3);
			parts:"downtrig" = regularpolygon(center-trigoffset, radius/3, 3,-PI/3);

			parts; // Return shape object
		);

		hbar:"hitbox" := my("shape"):"circle";
		hbar:"ishot" := if(my("parent"):"tool" == "hand" & !'picturemode, // Only hottable, when hand tool is selected
			dist(my("hitbox"):"M",mouse().xy) < my("hitbox"):"r",
			false
		);

		hbar:"draw" := if(my("parent"):"tool" == "hand",
			// Draw vertical bar
			fillpoly(my("shape"):"bar", color -> my("color"));

			// Draw base circle (hitbox)
			fill(circle(my("shape"):"circle":"M", my("shape"):"circle":"r"), color -> my("color"));		

			// Draw line through circle
			draw(my("shape"):"circleline":"A", my("shape"):"circleline":"B", size -> 3, color -> grey(1)
			);

			// Draw triangles
			fillpoly(my("shape"):"uptrig", color -> grey(1));
			fillpoly(my("shape"):"downtrig", color -> grey(1));
		);

		hbar:"move" := if(my("ismoveable"),
			// Set position based on mouse coords
			self():"coord" = [
				my("parent"):"coord"_1,
				min(coord_2,my("parent"):"coord"_2+my("parent"):"height")
			];

			// Remove row if above 1 AND bar touches row
			if(my("coord")_2 > my("parent"):"coord"_2 + my("padup"),
				my("parent"):"removerow";
			);

			// Add row if gap is big enough
			regional(space);
			space = 'atomsize + my("parent"):"horizontalpadding" + my("padup");
			if(my("parent"):"coord"_2 - my("coord")_2 > space,
				my("parent"):"addrow";
			);
		);

		hbar:"moveend" := my("alignbar");

		hbar; // Return bar
	);

	// === UI: Tool button
	grid:"tool" = 'tool; // Initial tools name
	grid:"toolbutton" := (
		regional(btn, c);

		c = (screenbounds()_2).xy - ('buttonsize+'buttonpadding) * [1,1];
		if(!isundefined('toolbuttonx), c_1 = 'toolbuttonx);
		if(!isundefined('toolbuttony), c_2 = 'toolbuttony);
		btn = new Button(c, 'buttonsize, 'buttonsize, "", 14);

		btn:"parent" = self();
		btn:"center" := my("coord") + .5*[my("width"),my("height")];
		btn:"imgscale" = .3;
		btn:"value" = {"hand":1,"bucket":2,"scissors":3}:'tool;
		btn:"tool" := ["hand", "bucket", "scissors"]_(my("value"));
		btn:"ishot" := if('picturemode, false, if(my("show"),inrectangle(my("hitbox"),mouse().xy))); 

		btn:"drawafter" := (
			drawimage(my("center"), ICONS:(my("tool")), scale->my("imgscale"));
		);
	
		btn:"script" := (
			self():"value" = 1 + mod(my("value"),3);
			self():"parent":"tool" = my("tool");
			divomathUpdateResults();
		);

		btn; // Return toolbutton
	);

	// === UI: Expression handler
	grid:"expression" = (
		regional(expr); expr = {};
		expr:"type" = "Expression";
		expr:"parent" = grid;
		expr:"coord" := [3,20]; //(screenbounds()_1).xy - [0,my("height")] + ['lblpadding, -'lblpadding];
		expr:"fontsize" = 'fontsize;
		expr:"font" = NADA;
		expr:"width" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_2_1 - box_1_1;
		);
		expr:"height" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_4_2 - box_1_2;
		);
		expr:"baseline" := (
			regional(size);
			size = pixelsize(my("value"), size->my("fontsize"), font->my("font"));
			size_3 / screenresolution();
		);

		expr:"value" = NADA; // gets set by grid:"updateexpression";

		expr:"bgcolor" = DZLMCOLORLIGHT;
		expr:"padding" = .3;
		expr:"hitbox" := getboundingbox(my("value"), my("coord")-[0,my("baseline")/2], my("fontsize"), my("font"));
		expr:"shape" := roundedrectangle(my("coord")-[0,my("baseline")/2]-my("padding")*[1,1], my("width")+2*my("padding"), my("height")+2*my("padding"), my("padding"));
		expr:"ishot" := if('picturemode, false, inrectangle(my("hitbox"), mouse().xy));
		expr:"ismoveable" = 'expressionmoveable;
		expr:"getaction" = "move";

		expr:"draw" := (
			// Draw box
			fill(my("shape"), color->my("bgcolor"));

			// Draw expression	
			drawtext(my("coord"), my("value"), font->my("font"), size->my("fontsize"));

			// Debug draw
			if('debuglevel > 0,
				drawpoly(my("shape"), color->[1,0,0]);
				draw(my("coord"), color->[1,0,0]);
			);
		);

		expr:"move" := if(my("ismoveable"), self():"coord" = my("coord") + mousedelta);

		expr; // Return expression
	);

	grid:"verbal" = (
		regional(expr); expr = {};
		expr:"type" = "Expression";
		expr:"parent" = grid;
		expr:"coord" := [3,6]; //(screenbounds()_1).xy - [0,my("height")] + ['lblpadding, -'lblpadding];
		expr:"fontsize" = 'fontsize;
		expr:"font" = NADA;
		expr:"width" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_2_1 - box_1_1;
		);
		expr:"height" := (
			regional(box);
			box = getboundingbox(my("value"), [0,0], my("fontsize"), my("font"));
			box_4_2 - box_1_2;
		);
		expr:"baseline" := (
			regional(size);
			size = pixelsize(my("value"), size->my("fontsize"), font->my("font"));
			size_3 / screenresolution();
		);

		expr:"value" = NADA; // gets set by grid:"updateexpression";

		expr:"bgcolor" = DZLMCOLORLIGHT;
		expr:"padding" = .3;
		expr:"hitbox" := getboundingbox(my("value"), my("coord")-[0,my("baseline")/2], my("fontsize"), my("font"));
		expr:"shape" := roundedrectangle(my("coord")-[0,my("baseline")/2]-my("padding")*[1,1], my("width")+2*my("padding"), my("height")+2*my("padding"), my("padding"));
		expr:"ishot" := if('picturemode, false, inrectangle(my("hitbox"), mouse().xy));
		expr:"ismoveable" = 'verbalmoveable;
		expr:"getaction" = "move";

		expr:"draw" :=	(
			// Draw box
			fill(my("shape"), color->my("bgcolor"));

			// Draw expression	
			drawtext(my("coord"), my("value"), font->my("font"), size->my("fontsize"));

			// Debug draw
			if('debuglevel > 0,
				drawpoly(my("shape"), color->[1,0,0]);
				draw(my("coord"), color->[1,0,0]);
			);
		);

		expr:"move" := if(my("ismoveable"), self():"coord" = my("coord") + mousedelta);

		expr; // Return expression
	);

	grid:"updateexpression"; // Update value and verbalvalue for init

	grid; // Return Grid
);

// D | Initialization
// D.0 | SL Config
// ===============
if(!usedivomath,
	// Grid state settings
	'gridposition = if(!isundefined('urlparams:"gridposition"), parse('urlparams:"gridposition"), [6,10]);
	'rows = if(!isundefined('urlparams:"rows"), parse('urlparams:"rows"), 5);
	'cols = if(!isundefined('urlparams:"cols"), parse('urlparams:"cols"), 7);
	'coloredrowindex = if(!isundefined('urlparams:"coloredrowindex"), parse('urlparams:"coloredrowindex"), NADA);
	'coloredcolindex = if(!isundefined('urlparams:"coloredcolindex"), parse('urlparams:"coloredcolindex"), NADA);
	'cuthorizontally = if(!isundefined('urlparams:"cuthorizontally"), parse('urlparams:"cuthorizontally"), false);
	'cutvertically = if(!isundefined('urlparams:"cutvertically"), parse('urlparams:"cutvertically"), false);
	'groupby = if(!isundefined('urlparams:"groupby"), 'urlparams:"groupby", "NONE");
	'groupingtype = if(!isundefined('urlparams:"groupingtype"), 'urlparams:"groupingtype", "ROWCOL"); // one of "NONE", "ROW", "COL", "ROWCOL"

	// UI settings
	// - Grid
	'atomsize = if(!isundefined('urlparams:"size"), parse('urlparams:"size"), 1);
	'atomradius = if(!isundefined('urlparams:"cornerradius"), parse('urlparams:"cornerradius"), .5);
	'atomverticalpadding = if(!isundefined('urlparams:"verticalpadding"), parse('urlparams:"verticalpadding"), .1);
	'atomhorizontalpadding = if(!isundefined('urlparams:"horizontalpadding"), parse('urlparams:"horizontalpadding"), .1);
	'groupspacing = if(!isundefined('urlparams:"groupspacing"), parse('urlparams:"groupspacing"), .2);
	'cutwidth = if(!isundefined('urlparams:"cutwidth"), parse('urlparams:"cutwidth"), .3);
	'gridmoveable = if(!isundefined('urlparams:"gridmoveable"), parse('urlparams:"gridmoveable"), true);
	'animationspeed = if(!isundefined('urlparams:"animationspeed"), parse('urlparams:"animationspeed"), .15);
	// - Button
	'buttonsize = if(!isundefined('urlparams:"buttonsize"), parse('urlparams:"buttonsize"), 2);
	'buttonpadding = if(!isundefined('urlparams:"buttonpadding"), parse('urlparams:"buttonpadding"), .4);
	'toolbuttonx = if(!isundefined('urlparams:"toolbuttonx"), parse('urlparams:"toolbuttonx"), NADA); // right edge by default
	'toolbuttony = if(!isundefined('urlparams:"toolbuttony"), parse('urlparams:"toolbuttony"), NADA); // top edge by default
	'drawtoolbutton = if(!isundefined('urlparams:"drawtoolbutton"), parse('urlparams:"drawtoolbutton"), true);
	'tool = if(!isundefined('urlparams:"tool"), 'urlparams:"tool", "hand"); // one of "hand", "bucket", "scissors"
	// - Text
	'fontsize = if(!isundefined('urlparams:"fontsize"), parse('urlparams:"fontsize"), 18);
	'drawexpression = if(!isundefined('urlparams:"drawexpression"), parse('urlparams:"drawexpression"), true);
	'expressionposition = if(!isundefined('urlparams:"expressionposition"), parse('urlparams:"expressionposition"), NADA);
	'expressionmoveable = if(!isundefined('urlparams:"expressionmoveable"), parse('urlparams:"expressionmoveable"), false);
	'drawverbal = if(!isundefined('urlparams:"drawverbal"), parse('urlparams:"drawverbal"), false);
	'verbalposition = if(!isundefined('urlparams:"verbalposition"), parse('urlparams:"verbalposition"), NADA);
	'verbalmoveable = if(!isundefined('urlparams:"verbalmoveable"), parse('urlparams:"verbalmoveable"), true);

	'picturemode = if(!isundefined('urlparams:"picturemode"), parse('urlparams:"picturemode"), false);
	'showexpressiontoggle = if(!isundefined('urlparams:"showexpressiontoggle"), parse('urlparams:"showexpressiontoggle"), false);
	'expressiontogglestate = if(!isundefined('urlparams:"expressiontogglestate"), parse('urlparams:"expressiontogglestate"), true);
);

// Build grid
// ==========
regional(grid);
grid = new Grid('gridposition,'rows,'cols);

// Set initial coloring
if('coloredrowindex > 0, grid:"flags":"color-row" = 'coloredrowindex);
if('coloredcolindex > 0, grid:"flags":"color-col" = grid:"cols" - 'coloredcolindex + 1);
grid:"repaint";

// Set initial cutting
if('cuthorizontally & 'coloredrowindex > 0, eval(grid:"cutgrid", 'activeindex->grid:"flags":"color-row", 'direction->"HORIZONTAL"));
if('cutvertically & 'coloredcolindex > 0, eval(grid:"cutgrid", 'activeindex->grid:"flags":"color-col", 'direction->"VERTICAL"));

// Set initial grouping
if('groupby != "NONE",
	grid:"flags":"group-by" = 'groupby;
	grid:"groupatoms";
);

// Reevaluate Expressions
grid:"updateexpression";

// Set up Toggle for hiding/showing expressions
regional(toggle, togglesize, togglepos);
togglepadding = .3;
togglesize = 1;
togglepos = (screenbounds()_1).xy - [0,.5*togglesize];
togglepos = togglepos + [togglepadding, -togglepadding];
toggle = new Toggle(togglepos, togglesize, 'expressiontogglestate, "Sprache/Term anzeigen", 12*togglesize);
toggle:"script" := (
	if(my("state"),
		if('drawexpression, obj = obj :> obj_1:"expression");
		if('drawverbal, obj = obj :> obj_1:"verbal");
	,
		obj = obj -- [grid:"expression"];
		obj = obj -- [grid:"verbal"];
	);
);

// Set up expressions
if(!isundefined('expressionposition), grid:"expression":"coord" = 'expressionposition);
if(!isundefined('verbalposition), grid:"verbal":"coord" = 'verbalposition);

// Build
obj = obj :> grid;
obj = obj :> obj_1:"vbar";
obj = obj :> obj_1:"hbar";
if('showexpressiontoggle, obj = obj :> toggle);
if('drawtoolbutton, obj = obj :> obj_1:"toolbutton");
if('expressiontogglestate & 'drawexpression, obj = obj :> obj_1:"expression");
if('expressiontogglestate & 'drawverbal, obj = obj :> obj_1:"verbal");
); // End VAM if

// v14
// last changes:
// - added web/SL controls

if(vam == "divisors", // change accordingly

// A | Documentation
//'doctextpos = [9,15.5];
'doc = "
>> Konfigurierbarer Zustand | VAM 'divisors'
color: <string> # eine repräsentierte Farbe (siehe Doku)
size: <float> # Größe der Blobs
blobmargin: <float> # Abstand der Blobs innerhalb eines Bandes
stripmargin: <float> # Abstand der Bänder untereinander
timing: <float> # Geschwindigkeit der Animation
blobs: <uint> # Anzahl der Blobs zu Beginn
maxblobs: <uint> # Maximale Anzahl erlaubter Blobs
divisor: <uint> # Gruppengröße zu Beginn
maxcols: <uint> # Maximal erlaubte Gruppengröße
displaycalc: <bool> # Formel anzeigen? ('a : b')
displayresult: <bool> # Ergebnis anzeigen? ('= c Rest d')
drawblobbuttons: <bool> # Draw blob Button controls?
drawdivbuttons: <bool> # Draw divisor Button controls?
drawbar: <bool> # Draw vertical bar for divisor controls?
displaydescription: <bool> # Beschreibung anzeigen?
displayblobcount: <bool> # Anzahl Blobs anzeigen?
displaydivisorcount: <bool> # Gruppengröße anzeigen?
==========================================================
>> Results | VAM 'divisors'
B I S H E R   K E I N E
";

// B | Divomath config
// States
regional(item, color, padding, stripmargin, timing, blobs, maxblobs, divisor, maxcols,
	sequentialorder, displaycalc, displayresult, displaydescription,
	displayblobcount, displaydivisorcount
);

item = 'dmstate.color;
color = if(!isundefined(item), apply(item, COLORMAP:#), [DIVORED, DIVOGREY]); // Color of Blobs and Strips as [str,str]

size = defaultstateto("size", .7); // Size of Blobs.
size = parse(size+"");

padding = defaultstateto("blobmargin", .2); // Padding between blobs in a strip.
padding = parse(padding+"");

stripmargin = defaultstateto("stripmargin", .5); // Vertical margin between strips.
stripmargin = parse(stripmargin+"");

timing = defaultstateto("timing", .5); // Timing of animations.
timing = parse(timing+"");

blobs = defaultstateto("blobs", 0); // Inital blob count.
blobs = parse(blobs+"");

maxblobs = defaultstateto("maxblobs", 100); // Maximum blob count.
maxblobs = parse(maxblobs+"");

divisor = defaultstateto("divisor", 1); // Inital divisor.
divisor = parse(divisor+"");

maxcols = defaultstateto("maxcols", 10); // Maximum number of divisors (columns).
maxcols = parse(maxcols+"");

sequentialorder = defaultstateto("sequentialorder", false); // Reordering strategy when divisors changes
sequentialorder = tobool(sequentialorder); // dm reports back "" when false, reset properly

// UI and display configs
drawblobbuttons = defaultstateto("drawblobbuttons", true); // Draw Button UI Elements for Blob count
drawblobbuttons = tobool(drawblobbuttons);

drawdivbuttons = defaultstateto("drawdivbuttons", true); // Draw Button UI Elements for div
drawdivbuttons = tobool(drawdivbuttons);

drawbar = defaultstateto("drawbar", true); // Draw vertical bar for changing div
drawbar = tobool(drawbar);

displaycalc = defaultstateto("displaycalc", true); // Display calculation text
displaycalc = tobool(displaycalc);

displayresult = defaultstateto("displayresult", true); // Display result text
displayresult = tobool(displayresult);

displaydescription = defaultstateto("displaydescription", true); // Display description text
displaydescription = tobool(displaydescription);

displayblobcount = defaultstateto("displayblobcount", true); // Display blob count text
displayblobcount = tobool(displayblobcount);

displaydivisorcount = defaultstateto("displaydivisorcount", true); // Display divisor count text
displaydivisorcount = tobool(displaydivisorcount);

// Configure result handling and setState.
// Overwrite divomath result updating function.
divomathUpdateResults() := if(usedivomath,
	divomathClearResult();

	// Proper result reporting here (for validation)
	// @TODO

	// Export state as results as well for forward referencing
	regional(dmstate);
	dmstate = divomathSetState();
	forall(keys(dmstate), #,
		divomathAddResult(#, dmstate:#);
	);

	// Post results
	divomathSendResult();
);

// Overwrite divomath setState()
divomathSetState() := (
	regional(cards, state);
	cards = select(obj, #:"type"=="numbercard"); // all the cards
	
	// Return current state
	state = {
		"size" : size, // Size of Blobs
		"blobmargin" : padding, // Padding between blobs in a strip
		"stripmargin" : stripmargin, // Margin between strips
		"timing" : timing, // Animation timing
		"blobs" : world:"#allblobs", // Initial Blob count
		"maxblobs" : maxblobs, // Maximum Blob count
		"divisor" : world:"#divisors", // Initial number of divisors
		"maxcols" : maxcols, // Max number of divisors
		"sequentialorder" : sequentialorder, // Reording strategy on divisor change
		"drawblobbuttons" : drawblobbuttons,
		"drawdivbuttons" : drawdivbuttons,
		"displaycalc" : displaycalc,
		"drawbar" : drawbar,
		"displayresult" : displayresult,
		"displaydescription" : displaydescription,
		"displayblobcount" : displayblobcount,
		"displaydivisorcount" : displaydivisorcount
	};

	state;
);

// GLOBAL VARS
'globalscaling = 1; // Adjusts size of stuff, gets set by world:"updateglobalscaling"

// C | Class definitions
// C.1 | Handler for positioning and drawing
new World() := (
	regional(o, btncolors);
	o = new VAMobject("World");

	// Fields
	o:"coord" = nada;
	o:"font" = "Be Vietnam";
	o:"blobs" = [];
	o:"#blobs" := length(my("blobs"));
	o:"#allblobs" := (
		regional(numofblobs);
		numofblobs = my("#blobs");
		forall(my("strips"), numofblobs = numofblobs + #:"size");
		numofblobs;
	);
	o:"strips" = [];
	o:"#strips" := length(my("strips"));
	o:"#divisors" = 0;
	o:"refheight" = 2.5 + if(screenbounds()_4_2 < 0, -screenbounds()_4_2, 0); // eyeballed height of bottom UI elements
	o:"shape" = (
		regional(shape, margin);
		shape = reverse(apply(screenbounds(),#.xy)); // whole screen
		
		// Remove bottom UI
		shape_1 = shape_1 + [0, o:"refheight"];
		shape_2 = shape_2 + [0, o:"refheight"];

		// Add some margins to each side
		margin = .5;
		shape_1 = shape_1 + margin*[1,1];
		shape_2 = shape_2 + margin*[-1,1] - [2, 0];  // also add room for bar
		shape_3 = shape_3 + margin*[-1,-1] - [2, 0];  // also add room for bar
		shape_4 = shape_4 + margin*[1,-1];
		
		shape;
	);

	o:"center" = o:"shape"_1 + 0.5 * (o:"shape"_3 - o:"shape"_1);
	o:"width" = o:"shape"_2_1 - o:"shape"_1_1;
	o:"height" = o:"shape"_4_2 - o:"shape"_1_2;
	// Helper fields for proper scaling
	o:"contentwidth" := if(length(my("strips")) > 0, // height of all strips combined		
		my("strips")_1:"shape"_2_1 - my("strips")_1:"shape"_1_1; // right corner - left corner
	,
		0 // 0, if no strips
	);
	o:"contentheight" := if(length(my("strips")) > 0, // height of all strips combined
		length(my("strips")) * my("strips")_1:"height" + (length(my("strips"))-1) * my("stripmargin");
	,
		0 // if no strips
	);

	o:"padding" = padding / 2 * 'globalscaling;
	o:"stripmargin" := stripmargin * 'globalscaling;
	
	o:"updateglobalscaling" := ( // update scaling based on available height/width, call accordingly

		'globalscaling = 1; // reset scaling for proper recalculation of scaling factor
		
		if(my("contentheight") > 0 & my("contentwidth") > 0, // only if strips exist
			'globalscaling = min([1, my("height") / my("contentheight"), my("width") / my("contentwidth")]);
		,
			'globalscaling = 1 // else set to 1
		);
	);

	// Inner objects: UI elements
	// ==========================
	// === UI: Bar to change divisors
	o:"bar" = ( 
		regional(bar);
		bar = new VAMobject("Bar");
		bar:"parent" = o;
		bar:"ismoveable" = true;
		bar:"width" = .1;
		bar:"color" = DIVODARKBLUE;
		bar:"height" := my("parent"):"contentheight";
		bar:"padleft" = 2*o:"padding";

		bar:"coord" := nada; // Gets assigned by my("alignbar")
		bar:"alignbar" := ( // (Re-)sets bar position
			self():"coord" := my("parent"):"center" + .5 * [my("parent"):"contentwidth", -my("parent"):"contentheight"] + [my("padleft"), 0];
		);
		bar:"alignbar"; // Initially set coord
		
		bar:"shape" := (
			regional(parts);
			parts = {};

			// Create vertical bar that is as tall as all strips combined
			parts:"bar" = rectangle(my("coord"), my("width"), my("height"));

			// Create circle
			regional(center, radius);
			radius = .7;
			center = my("coord") + [my("width"),0] + [radius+.2,my("height")/2];
			parts:"circle" = {"M": center, "r": radius};

			// Create vertical line through center of the circle
			parts:"circleline" = {"A": center - [0,1.1*radius], "B": center + [0,1.1*radius]};

			// Create triangles pointing left and right
			// (scaling numbers are chosen by eye)
			trigoffset = [radius/2.3,0];
			parts:"lefttrig" = regularpolygon(center-trigoffset, radius/3, 3, PI/6);
			parts:"righttrig" = regularpolygon(center+1.05*trigoffset, radius/3, 3,-PI/6);

			parts; // Return shape object
		);

		bar:"hitbox" := my("shape"):"circle";
		bar:"ishot" := dist(my("hitbox"):"M",mouse().xy) < my("hitbox"):"r" & my("parent"):"#strips" > 0;

		bar:"move" := if(my("ismoveable"),
			// Set position based on mouse coords
			set my("coord", [
				max(coord_1,my("parent"):"strips"_1:"coord"_1),
				my("parent"):"strips"_(-1):"shape"_1_2
			]);

			// Decrease divisor count if above 1 AND bar touches strips
			regional(stripedge);
			stripedgeX = my("parent"):"strips"_1:"coord" + [my("parent"):"strips"_1:"width",0];
			stripedgeX = stripedgeX_1;
			if(my("parent"):"#divisors" > 1 & stripedgeX > my("shape"):"bar"_1_1,
				my("parent"):"divisor-":"script";
			);

			// Calculate gap for triggering increasing divisor count
			regional(gap, requiredwidth);
			gap = my("shape"):"bar"_1_1;
			gap = gap - my("parent"):"strips"_1:"shape"_2_1;
			requiredwidth = new Blob():"size";

			// Increase divisor count if gap is big enough AND there is still more than one strip
			if(gap > requiredwidth & my("parent"):"#strips" > 1 & my("parent"):"#divisors" < maxcols,
				my("parent"):"divisor+":"script";
			);
		);

		bar:"moveend" := set my("coord", [ // Reset coord of bar
				my("parent"):"strips"_1:"shape"_2_1 + my("padleft"), 
				my("parent"):"strips"_(-1):"shape"_1_2
			]);

		bar:"draw" := if(my("parent"):"#strips" > 0,
			// Draw vertical bar
			fillpoly(my("shape"):"bar", color -> my("color"));

			// Draw base circle (hitbox)
			fill(circle(my("shape"):"circle":"M", my("shape"):"circle":"r"), color -> my("color"));		

			// Draw line through circle
			draw(my("shape"):"circleline":"A", my("shape"):"circleline":"B", size -> 3, color -> grey(1)
			);

			// Draw triangles
			fillpoly(my("shape"):"lefttrig", color -> grey(1));
			fillpoly(my("shape"):"righttrig", color -> grey(1));
		);

		bar; // Return bar
	);
	
	// === UI: Button for adding a blob
	o:"blob+" = (
		regional(btn);
		btn = new Button([2.6,.5],1,1,"+",22);
		btn:"handle" = o;
		btn:"show" := my("handle"):"#allblobs" < maxblobs;
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"script" := (
			regional(blob);
			my("handle"):"makeblob";
			blob = my("handle"):"blobs"_(-1);
			if(my("handle"):"#divisors" > 0,
				my("handle"):"moveblobstostrips"
			);
			my("handle"):"bar":"alignbar";
		);

		btn; // Return Button
	);

	// === UI: Button for removing a blob
	o:"blob-" = (
		regional(btn);
		btn = new Button([1.1,.5],1,1,"-",22);
		btn:"handle" = o;
		btn:"show" := if(my("handle"):"#allblobs" > 0,true,false);
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"script" := ( 
			// Remove last blob from last strip and reconfigure
			eval(my("handle"):"removeblob",numofblocks->1);
			if(my("handle"):"#strips" > 0,
				my("handle"):"strips"_(-1):"drawstrip" = false;
			);
			my("handle"):"removeemptystrips";
			my("handle"):"bar":"alignbar";
		);
		btn; // Return Button
	);

	// === UI: Button for increasing strip size
	o:"divisor+" = (
		regional(btn);
		btn = new Button([20,.5],1,1,"+",22);
		btn:"handle" = o;
		btn:"show" := my("handle"):"#divisors" < maxcols;
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"script" := (
			my("handle"):"#divisors" = my("handle"):"#divisors" + 1;
			my("handle"):"refillstrips";
			my("handle"):"bar":"alignbar";
		);
		btn; // Return Button
	);

	// === UI: Button for decreasing strip size
	o:"divisor-" = (
		regional(btn);
		btn = new Button([18.5,.5],1,1,"-",22);
		btn:"handle" = o;
		btn:"show" := my("handle"):"#divisors" > 1;
		btn:"cornerradius" = .5; // circle
		btn:"color" = DIVOBLUE;
		btn:"bordercolor" = btn:"color" / 2; // darker border
		btn:"fontcolor" = grey(1);
		btn:"script" := (
			my("handle"):"#divisors" = my("handle"):"#divisors" - if(
				my("handle"):"#divisors" > 0, 1, 0
			);
			my("handle"):"refillstrips";
			my("handle"):"bar":"alignbar";
		);
		btn; // Return Button
	);

	o:"uielements" := [
		my("bar"),
		my("blob+"), my("blob-"),
		my("divisor+"), my("divisor-")
	];
	
	// Methods
	o:"makeblob" := (
		set my("blobs", my("blobs") :> new Blob());
		my("blobs")_(-1):"parent" = self();
	);
	o:"makestrip" := (
		set my("strips", my("strips") :> new Strip(nada));
		my("strips")_(-1):"parent" = self();
	);
	o:"removeemptystrips" := (
		set my("strips", select(my("strips"),#:"size" > 0));
		my("positionstrips"); // Redraw
	);
	
	// Draw strips and (free) blobs
	o:"draw" := (	
		forall(my("blobs"),#:"draw");
		forall(my("strips"),#:"draw");
		
		// Draw line to visualy separate bottom UI elements
		//fillpoly(rectangle([-1,-1],35,3.5), color->grey(.95));
		//drawpoly(rectangle([-1,-1],35,3.5), color->grey(0));
		draw(join([0,2.5],[1,2.5]), color->grey(0));
		// Draw total blob count
		if(displayblobcount,
		drawtext([0.3,1.7],"Gesamtanzahl: " + my("#allblobs"), size->16, family->my("font"));
		);

		// Draw divisor count
		if(displaydivisorcount,
			regional(numofdivisors);
			numofdivisors = "Gruppengröße";
			numofdivisors = numofdivisors + if(
				my("#divisors") > 0, ": " + my("#divisors"), ""
			);
			drawtext([17.6,1.7],numofdivisors, size->16, family->my("font"));
		);

		// Draw calculation texts
		if(my("#divisors") > 0,
			regional(b,d,m, text, bottomleftx);
			b = my("#blobs");
			forall(my("strips"), b = b + #:"size");
			d = my("#divisors");
			m = mod(b,d);
			bottomleftx = 8.5;
			text = "";

			// - "a : b"
			if(displaycalc,
				bottomleftx = 8.5;
				text = b + "  :  " + d;
				drawtext([bottomleftx,1.7],
					text,
					size->16,
					bold->true,
					family->my("font")
				);
			);

			// - " = c"
			if(displayresult,
				bottomleftx = bottomleftx+.1+pixelsize(text)_1/screenresolution();
				text = "   =  " + floor(b/d);
				drawtext([bottomleftx,1.7],
					text,
					size->16,
					bold->true,
					family->my("font")
				);
			);
			
			// - " Rest d"
			if(displayresult & m != 0,
				bottomleftx = bottomleftx+pixelsize(text)_1/screenresolution()+.2;
				text = "   R " + m;
				drawtext([bottomleftx,1.7],
					text,
					color->DIVOBLUE,
					size->16,
					family->my("font")
				);
			);
			
			if(displaydescription,
				// - "c <b-er> passen in a."
				bottomleftx = 8.5;
				text = floor(b/d) + " " + VALUEMAP:d;
				text = text + if(floor(b/d) == 1, " passt ", " passen ");
				text = text + " in " + b + ".";
				drawtext([bottomleftx,1],
					text,
					size->16,
					family->my("font")
				);

				// - "Es bleiben d übrig."
				if(m != 0,
					text = "Es bleib";
					text = text + if(m == 1,"t ", "en ");
					text = text + m + " übrig.";
					drawtext(
						[bottomleftx,.3], 
						text,
						color->DIVOBLUE,
						size->16,
						family->my("font")
					);
				);
			);
		);

		// Debug draw
		if('debuglevel > 0,
			drawpoly(my("shape"), color->grey(.7));
			draw([my("shape")_1, my("shape")_3], color->grey(.7));
			draw([my("shape")_2, my("shape")_4], color->grey(.7));
			draw(my("center"), color->[.8,0,0]);
		);
	);

	o:"refillstrips" := ( // Refill Strips, when divisor count changes
		regional(div);
		div = my("#divisors");	

		if(sequentialorder, // Move Blobs along sequentially
			regional(tostrip);

			// Return blobs from all Strips to World
			forall(reverse(my("strips")),
				set my("blobs", #:"children" ++ my("blobs"));
			);

			// Remove all Strips
			set my("strips", []);

			// Refill strips
			repeat(ceil(my("#blobs")/div), // Create Strips rounding up.
				tostrip = []; // blobs that go into each Strip
				repeat(div, d, if(my("#blobs") >= d, // fill list and catch it's end
					tostrip = tostrip :> my("blobs")_d;
				));
				my("makestrip"); // make a new Strip
				eval( // put blobs in Strip
					my("putblob"),
					strip->my("strips")_(-1),
					blobs->tostrip
				);
			);
		, // Move Blobs "naturally"
			regional(spareblobs, diff);
			spareblobs = [];
			
			// Calculate if Strips shrink or grow
			if(my("#strips") != 0,
				diff = my("strips")_1:"size" - div,
				diff = -div
			);

			// Handle shrinking Strips
			if(diff > 0,
				// In all full Strips...
				forall(my("strips"), 
					if(#:"size" > div,
						// ..return overflowing Blobs to World
						set my("blobs", my("blobs") ++ #:"children"_(div+1..#:"size"));	
				
						// ...remove overflowing Blobs from Strip
						#:"children" = #:"children"_(1..div);
					);
				);

				// Fill last strip or create new one
				forall(my("blobs"),
					// Create new Strip if last one is full
					if(my("strips")_(-1):"size" >= div,
						my("makestrip");
					);
					// Put Blob in last strip
					eval(my("putblob"),strip->my("strips")_(-1),blobs->#);
				);
			);

			// Handle growing strips
			if(diff < 0,
				// Point to first and last Strip for iterating
				regional(current, last, i);
				i = 1;

				// Create a Strip if none exists
				if(my("#strips") == 0, my("makestrip"));

				// Move free Blobs to current Strips
				my("moveblobstostrips");

				current = my("strips")_i;
				last = my("strips")_(-1);

				// Move Blobs from first to current Strip until full
				while(current != last,
					diff = current:"size" - div;

					// Move to next Strip, if already full
					if(diff == 0 & my("strips")_(i+1):"size" > 0,
						i = i + 1;
						current = my("strips")_i;
						diff = current:"size" - div;
					);

					// Move one strip "up", if last one is empty
					if(last:"size" == 0, 
						my("removeemptystrips");
						last = my("strips")_(-1);
					);

					// Move Blob to current strip to fill it up
					if(diff < 0,
						eval(my("popblob"),strip->last, index->-1);
						eval(my("putblob"),strip->current,blobs->my("blobs")_(-1));
					);
				);
			);
		);

		// Toggle strip drawing for all Strips depending on if it is full or not
		forall(my("strips"),
			#:"drawstrip" = if(#:"size" == div, true, false)
		);

		// Redraw	
		my("positionstrips");
	);

	o:"moveblobstostrips" := ( // Move free Blobs to Strips
		regional(div, strip);
		div = my("#divisors");

		// Create a strip if none exist
		if(my("#strips") == 0, my("makestrip"));
		strip = my("strips")_(-1);

		// Move Blobs to Strips until none remain
		while(my("#blobs") > 0,

			// Create new Strip if current one is full
			if(strip:"size" >= div, 
				my("makestrip");
				strip = my("strips")_(-1);
			);
			
			// Move a Blob to selected Strip
			eval(my("putblob"),strip->strip,blobs->my("blobs")_1);
		);

		// Toggle strip drawing for all Strips depending on if it is full or not
		forall(my("strips"),
			#:"drawstrip" = if(#:"size" == div, true, false)
		);

		// Redraw	
		my("positionstrips");
	);

	o:"positionstrips" := ( // Align Strips in World
		// Update global scaling factor
		my("updateglobalscaling");

		// Position accordingly
		regional(s, diagonal, yposition);
		s = my("strips");

		repeat(length(s),
			diagonal = s_#:"shape"_3 - s_#:"shape"_1; // bottom left to top right
			yposition = length(s)/2 - # + .25 * my("stripmargin");
			s_#:"coord" = my("center") - 0.5 * diagonal; // center strips on screen
			s_#:"coord"_2 = my("center")_2 + // shift up or down
				(diagonal_2 + my("stripmargin")) * yposition; // depending on yposition
			s_#_"coord"_2 = s_#_"coord"_2; // center in available space (regarding UI)

			s_#:"positionchildren"; // reposition blobs for every strip
		);

		// Re-align last strip to be left aligned
		if(length(s) > 1,
			s_(-1):"coord" = s_(-2):"coord" - [0,diagonal_2 + my("stripmargin")];
			s_(-1):"positionchildren";
		);

		// Update divomath states/results
		divomathUpdateResults();
	);

	// Use with eval()
	o:"putblob" := (
		// Handles putting blobs in strips.
		// eval with a "strip" and a blob or list of "blobs".
		eval(strip:"put",children->list(blobs));
		set my("blobs", my("blobs") -- list(blobs));
	);
	
	o:"popblob" := (
		// Handles returning Blobs back to World from Strip.
		// eval with a "strip" to pop from and optional "index"
		index = if(isundefined(index),1,index);
		set my("blobs", my("blobs") :> strip:"children"_index);
		eval(strip:"remove",children->list(strip:"children"_index));
		
		my("blobs")_(-1); // Return popped Blob
	);

	o:"removeblob" := (
		// Handles deletion of Blobs.
		// eval with a number of blobs ("numofblobs") to remove.
		
		// Remove free blobs first (starting at the end of the list)
		while(numofblocks > 0 & my("#blobs") > 0,
			set my("blobs", my("blobs") -- [my("blobs")_(-1)]);
			numofblocks = numofblocks - 1;
		);

		// Continue removing from strips, starting from the last one
		forall(reverse(my("strips")), strip,
			if(numofblocks > 0,
				forall(reverse(strip:"children"),
					if(numofblocks > 0,
						strip:"children" = strip:"children" -- [#];
						numofblocks = numofblocks - 1;
					);
				);
				my("positionstrips");
			);
		);
	);	

	o; // Return World;
);

// C.2 | Blob container representing sets of divisor-many or remainder-many Blobs
new Strip(coord) := (
	regional(o);
	o = new VAMobject("Strip");
	
	o:"coord" = if(!isundefined(coord),coord,[6,6]); // bottom left corner
	o:"color" = color_1; // color of strip
	o:"drawstrip" = true; // draw connecting strip between children
	o:"children" = []; // contains Blobs
	o:"size" := length(my("children"));
	o:"padding" := padding * 'globalscaling; // horizontal distance between adjacent Blobs
	o:"width" := if(my("size")>0,
		my("size") * (my("children")_1):"size" * 2 + (my("size")-1) * my("padding");
	,
		0
	);
	o:"height" := if(my("size")>0,(my("children")_1):"size" * 2, 0);
	o:"shape" := rectangle(my("coord"),my("width"),my("height"));

	// Use with eval()
	o:"put" := (
		// Put list of elements in the strip.
		// eval children with a list of blobs or single blob
		children = list(children);
		forall(children,
			// add new parent
			#:"parent" = self();
			// add as child if not already a child of self
			if(!contains(my("children"), #),
				set my("children",my("children") :> #);
			);
			// Align children inside strip
			my("positionchildren");
		);
	);

	o:"remove" := ( 
		// Remove child or list of children from list of children of the strip.
		// eval children with a list of blobs or single blob.
		children = list(children);		
		// Reset parent of Blob to own parent (should be World) 
		forall(children, #:"parent" = my("parent"));
		// remove children from childeren-list
		set my("children", my("children") -- children);
		// recalculate new blob positions
		my("positionchildren");
	);

	o:"positionchildren" := (
		regional(children);
		children = my("children");

		// animation
		repeat(my("size"),
			new animationobject(
				children_#, //object
				"coord", // property
				children_#:"coord", // startvalue
				my("coord") + [
					(2*#-1)*children_#:"size" + (#-1)*my("padding"),
					children_#:"size"
				];, // endvalue
				timing, // duration
				"accel" // timeflow
			);
		);

//		// w/o animation
//		repeat(my("size"),
//			children_#:"coord" = my("coord") + [
//					(2*#-1)*children_#:"size" +
//						(#-1)*my("padding"),
//					children_#:"size"
//				];
//		);
	);

	o:"draw" := (
		// Debug: Draw bounding box
		if('debuglevel > 0, 
			drawpoly(my("shape"));
			draw(my("coord"));
		);

		// Draw strip between children
		if(my("drawstrip") & my("size") > 0,
			regional(strip, radius, delta);
			strip = my("shape");
			radius = my("children")_1:"size";
			delta = radius / 8;

			strip_1 = strip_1 + [radius,delta];
			strip_2 = strip_2 - [radius,-delta];
			strip_3 = strip_3 - [radius,delta];
			strip_4 = strip_4 + [radius,-delta];
			fillpoly(strip,alpha->0.3,color->my("color"));
		);

		// Draw children
		forall(my("children"),#:"draw");
	);
	
	o; // Return o;
);

// C.3 | Displayable element
new Blob() := (
	regional(o);
	o = new VAMobject("Blob");
	
	o:"ismoveable" = false;
	o:"size" := size * 'globalscaling;
	o:"parent" = nada;
	o:"color" := if(!isundefined(my("parent"):"drawstrip"),
			if(my("parent"):"drawstrip",color_1,color_2),
			color_2;
		);
	o:"ishot" := mouse().xy_1 - my("coord")_1 < my("size");
	o:"coord" = ( // Set coordinate randomly inside viewport
		regional(screen);

		screen = world:"shape";
		[
			screen_1_1+o:"size" + randominteger(screen_3_1 - screen_1_1),
			screen_1_2+o:"size" + randominteger(screen_3_2 - screen_1_2)
		];
	);

	o:"draw" := (
		// Draw to be used by parent
		fill(
			circle(my("coord"),my("size")),
			color->my("color")
		);
		
		//draw( // draw border
		//	circle(my("coord"),my("size")),
		//	color->grey(0.2),
		//	size->3.5
		//);
	);

	o; // Return blob.
);

// D | Initialization
// D.0 | SL Config
// ===============
if(!usedivomath,
	size = if(!isundefined('urlparams:"size"), parse('urlparams:"size"), .7);
	padding = if(!isundefined('urlparams:"blobmargin"), parse('urlparams:"blobmargin"), .2);
	stripmargin = if(!isundefined('urlparams:"stripmargin"), parse('urlparams:"stripmargin"), .5);
	timing = if(!isundefined('urlparams:"timing"), parse('urlparams:"timing"), .5);
	blobs = if(!isundefined('urlparams:"blobs"), parse('urlparams:"blobs"), 0);
	maxblobs = if(!isundefined('urlparams:"maxblobs"), parse('urlparams:"maxblobs"), 100);
	divisor = if(!isundefined('urlparams:"divisor"), parse('urlparams:"divisor"), 1);
	maxcols = if(!isundefined('urlparams:"maxcols"), parse('urlparams:"maxcols"), 10);
	sequentialorder = if(!isundefined('urlparams:"sequentialorder"), parse('urlparams:"sequentialorder"), true);
	drawblobbuttons = if(!isundefined('urlparams:"drawblobbuttons"), parse('urlparams:"drawblobbuttons"), true);
	drawdivbuttons = if(!isundefined('urlparams:"drawdivbuttons"), parse('urlparams:"drawdivbuttons"), true);
	drawbar = if(!isundefined('urlparams:"drawbar"), parse('urlparams:"drawbar"), true);
	displaycalc = if(!isundefined('urlparams:"displaycalc"), parse('urlparams:"displaycalc"), true);
	displayresult = if(!isundefined('urlparams:"displayresult"), parse('urlparams:"displayresult"), true);
	displaydescription = if(!isundefined('urlparams:"displaydescription"), parse('urlparams:"displaydescription"), true);
	displayblobcount = if(!isundefined('urlparams:"displayblobcount"), parse('urlparams:"displayblobcount"), true);
	displaydivisorcount = if(!isundefined('urlparams:"displaydivisorcount"), parse('urlparams:"displaydivisorcount"), true);
	color = if(!isundefined('urlparams:"color"), parse('urlparams:"color"), [DIVORED, DIVOGREY]);
);

// Create World
world = new World();
obj = obj :> world;

// Remove animation, if there are blobs and strips at the beginning.
if(blobs > 0 & divisor > 0,
	help = timing;
	timing = .00001;
);

// Template behavior
world:"#divisors" = divisor;
repeat(blobs, world:"makeblob");
if(divisor != 0,
	repeat(ceil(blobs/divisor), // Create strips rounding up.
		tostrip = []; // blobs that go into each strip
		repeat(divisor, d, if(world:"#blobs" >= d, // fill list and catch it's end
			tostrip = tostrip :> world:"blobs"_d
		));
		world:"makestrip"; // make a new strip
		eval(world:"putblob",strip->world:"strips"_(-1),blobs->tostrip); // put in blobs
	);
);

// toggle strip drawing for last blob depending on if it is full or not
if(mod(blobs,divisor) != 0,world:"strips"_(-1):"drawstrip" = false);

world:"positionstrips";

// Reset animation speed
if(!isundefined(help), timing = help);

// Draw UI Elements
if(drawbar,
	obj = obj :> world:"bar";
);
if(drawblobbuttons,
	obj = obj :> world:"blob+";
	obj = obj :> world:"blob-";
);
if(drawdivbuttons,
	obj = obj :> world:"divisor+";
	obj = obj :> world:"divisor-";
);

// DEBUG REMOVE @TODO
world:"updateglobalscaling"; // is that still necessary?

); // end vam-if

// v22
// last changes:
// - added web/SL controls
// - removed parsing for URL param "separator"

if(vam == "numbercards",

// A | Documentation
//'doctextpos = [9,15.5];
'doc = "
>> Konfigurierbarer Zustand | VAM 'numbercards'
cards: <int> # Anzahl der Karten (siehe Doku)
x: <list of floats> # x-Koordinaten der Karten
y: <list of floats> # y-Koordinaten der Karten
value: <list of ints> # zahlenwert(e) der Karte(n)
edit: <list of string> # Konfiguriert, welche Stellen editierbar sind (siehe Doku)
unfold: <list of bools> # Karte(n) aufgeklappt anzeigen?
color: <bool> # Darstellung in Farbe? (oder Graustufen)
colortoggle: <bool> # Schalter zum Wechsel zwischen Farbe/Grau anzeigen?
alpha: <float> # Transparenz einer Karte, wenn ausgeklappt
separator: <char> # Trennzeichen für 3er-Gruppen von Ziffern
==========================================================
>> Results | VAM 'numbercards'
...siehe Doku
";

// B.1 | Divomath config
// States
regional (numofcards, xcoords, ycoords, values, editasstring, edit, entry, max, unfold, monte, showtogglemonte, alpha, separator);
numofcards = defaultstateto("cards", 1); // no. of cards to create
numofcards = parse(numofcards + ""); // force numofcards to be a string to be parsed, because for some reason it does not work without parsing if it is already int...

xcoords = defaultstateto("x", apply(1..numofcards, 10*#-7)); // x-coord of cards
if(!islist(xcoords), xcoords = [xcoords]); // force list
xcoords = apply(xcoords, if(isstring(#), parse(#), #));

ycoords = defaultstateto("y", apply(1..numofcards, 16)); // y-coord of cards
if(!islist(ycoords), ycoords = [ycoords]); // force list
ycoords = apply(ycoords, if(isstring(#), parse(#), #));

values = defaultstateto("value", apply(1..numofcards, 1234)); // initial card values
if(!islist(values), values = [values]); // force list
values = apply(values, if(isstring(#), parse(#), #));

// Configure which Placecard of every number is editable
editasstring = defaultstateto("edit", "@else"); // list of strings like ["ttt", "ftf"] representing true or false
if(editasstring != "@else" & !islist(editasstring), editasstring = [editasstring]); // force list
edit = []; // resulting array like [[true, true, true], [false, true, false]] for 2 Numbercards
entry = []; // individual Numbercards config

if(editasstring != "@else", // Config by divomath
	forall(editasstring, str, // loop over every raw string like "ffttft"

		repeat(length(str), // loop over every char
			// Add true or false in reverse order (-#)
			entry = entry :> if(str_(-#)=="t", true, false);
		);
		edit = edit :> entry;
		entry = []; // Reset entry
	);
, // else: default values -> all trues based on "values" length
	edit = apply(values, apply(1..length(text(#)), true));
	editasstring = [];
	forall(edit, state, // loop over state of every number
		// ...and store the corresponding string (e.g. "tfttf")
		editasstring = editasstring :> "";
		forall(state, editasstring_(-1) = editasstring_(-1) + if(#,"t","f"));
	);
);

max = apply(edit, length(#)); // max number of digits for cards (NOT CONFIGURABLE)

unfold = defaultstateto("unfold", apply(1..numofcards, true)); // show cards unfolded
if(!islist(unfold), unfold = [unfold]); // force list
unfold = apply(unfold, tobool(#)); // fix: dm reports back "" when false, reset properly

monte = defaultstateto("color", true); // show cards in color
monte = tobool(monte); // dm reports back "" when false, reset properly

showtogglemonte = defaultstateto("colortoggle", true); // show color toggle btn
showtogglemonte = tobool(showtogglemonte); // dm reports back "" when false, reset properly

alpha = defaultstateto("alpha", .2); // alpha of Numbercards

separator = defaultstateto("separator", ""); // Separator for thousands

// Configure result handling and setState.
// Overwrite divomath result updating function.
divomathUpdateResults() := if(usedivomath,
	divomathClearResult();

	regional(cardnr, placevaluenames);
	cardnr = 1; // for naming results of multiple cards
	placevaluenames = ["E","Z","H","T","ZT","HT","M","ZM","HM"];
	forall(if(obj_(-1):"type"=="Button",obj -- [obj_(-1)],obj), card,
		// Add number value as a whole
		divomathAddResult("nc"+cardnr, card:"value"); // numbercard value
		if('debuglevel > -1, 
			println(">Result added: "+"nc"+cardnr + "=" + card:"value")
		);
		// Add individual place values by hand.
		// (Can't be done with children, might not have any)
		regional(remainder, digit, place);
		remainder = card:"value";
		place = 1;
		while(remainder > 0,
			digit = mod(remainder,10);
			remainder = floor(remainder/10);
			divomathAddResult("nc" + cardnr + "_" + if(
				// Use numerical indicator for numbers >10^10-1
				!isundefined(placevaluenames_place),
				placevaluenames_place,
				place
			), digit);
			if('debuglevel > 1, 
			println(">Result added: "+
				"nc" + cardnr + "_" + if(
					!isundefined(placevaluenames_place),
					placevaluenames_place,
					place) + "=" + digit
			)
		);
			place = place + 1;
		);

		// Add result, if numbercard is folded
		divomathAddResult("nc" + cardnr + "_unfolded", card:"expanded");
		if('debuglevel > 1, 
			println(">Result added: " +
				"nc" + cardnr + "_unfolded" + "=" + card:"expanded"
			)
		);
		// Go to next card, if any
		// (toggle button gets checked too, if visible)
		cardnr = cardnr + 1;
	);

	// Export state as results as well for forward referencing
	regional(dmstate);
	dmstate = divomathSetState();
	forall(keys(dmstate), #,
		divomathAddResult(#, dmstate:#);
	);

	// Post results
	divomathSendResult();
);

// Overwrite divomath setState()
divomathSetState() := (
	regional(cards, state);
	cards = select(obj, #:"type"=="numbercard"); // all the cards
	
	// Return current state
	state = {
		"cards" : length(cards), // Record numofcards
		"x" : apply(cards, #:"coord"_1), // Record xcoords
		"y" : apply(cards, #:"coord"_2), // Record ycoords
		"value" : apply(cards, #:"value"), // Record values
		"edit" : apply(editasstring, # = QUOTE + # + QUOTE), // Record editable status per card
		"unfold" : apply(cards, #:"expanded"), // Record fold/unfold status
		"color" : monte, // Record colored/uncolored status
		"colortoggle" : showtogglemonte, // Record button drawing status
		"alpha" : alpha, // Record cards alpha
		"separator" : QUOTE + separator + QUOTE // cards separator character
	};

	state;
);

// C | Class definitions
// C.1 | Placecard
new Placecard (c, initialvalue, maxplaces) := (
	regional (o);
	o = new VAMobject("placecard");	
	o:"coord" 			= c;
	o:"maxplaces"		= maxplaces;
	o:"width" 			= maxplaces;
	o:"height" 			= 1;
	o:"value" 			= initialvalue;
	o:"color" 			= MONTEGREY;
	o:"bgcolor" 		= MONTEGREY;
	o:"mix" 				= 0;
	o:"edit"				= false;
	o:"ismoveable"	= false;
	o:"downbutton"	= {"center": [-10,-10], "radius": 0};
	o:"upbutton"		= {"center": [-10,-10], "radius": 0};

	o:"ishot" := or(
		dist(my("upbutton"):"center",mouse().xy) < my("upbutton"):"radius",
		dist(my("downbutton"):"center",mouse().xy) < my("downbutton"):"radius"
	);

	o:"shape" := rectangle(
		my("coord"), 
		my("width"),
		my("height")
	);

	o:"draw" := (
		// For nonzero place card
		if(my("value")>0,
			// Draw the box
			fillpoly(my("shape"), color->(1-my("mix"))*my("bgcolor")+my("mix")*my("color"));
			drawpoly(my("shape"), color->grey(0));
			
			// Draw card text
			regional(ps);
			ps = pixelsize("0", size->screenresolution(), family->schulschrift);

			repeat(my("maxplaces"),
				// Draw digit
				drawtext(
					my("coord") + (
						my("maxplaces") - # + .5 - 2*floor((#-1)/3)/ps_1, // adjust x
						(ps_3) / 4 / screenresolution() // adjust y
					),
					if(# == my("maxplaces"), my("value"), "0"),
					align->"center",
					size->screenresolution(),
					family->schulschrift
				);

				// Draw seperator
				if(mod(#,3) == 0 & # < my("maxplaces"),
					drawtext(
						my("coord") + (
							my("maxplaces") - # - .15, // adjust x
							(ps_3) / 4 / screenresolution() // adjust y
						),
						separator,
						align->"center",
						size->screenresolution(),
						family->schulschrift
					);
				);
			);
		, // else draw empty rectangle if unfolded
			if(my("parent"):"expanded",
				drawpoly(my("shape"), size->2, color->(1-my("mix"))*my("bgcolor")+my("mix")*my("color"));
			);
		);
		// Draw + and - buttons
		regional(circ);
		if(my("edit"),
			if(my("value") < 9, // can become more
				
				// Create upbutton
				self():"upbutton" = {
					"center": my("coord") + [
						my("width") + 2*my("height"),
						my("height")/2
					],
					"radius": my("height")/2
				};
				circ = my("upbutton");

				// Draw upbutton
				fillcircle(circ:"center",circ:"radius", color->DIVOBLUE);
				drawtext(
					circ:"center"-[circ:"radius",circ:"radius"]+[.54,.1],
					"+",
					color->MONTEGREY,
					size->screenresolution(),
					align->"center"
				);
			, // inner else
				self():"upbutton" = {"center": [-10,-10], "radius": 0};;
			);

			if(my("value")>0, // can become less

				// Create downbutton
				self():"downbutton" = {
					"center": my("coord") + [
						my("width") + my("height") - 0.2,
						my("height")/2
					],
					"radius": my("height")/2
				};
				circ = my("downbutton");

				// Draw downbutton
				fillcircle(circ:"center",circ:"radius", color->DIVOBLUE);
				drawtext(
					circ:"center"-[circ:"radius",circ:"radius"]+[.54,.22],
					"-",
					color->MONTEGREY,
					size->screenresolution(),
					align->"center"
				);
			, // inner else
				self():"downbutton"={"center": [-10,-10], "radius": 0};;
			);
		);

		// Debug Draw
		if('debuglevel > 0,
			draw(my("shape"));
			draw(my("coord"));
		);
	);

	o:"click" := (
		if(dist(my("downbutton"):"center",mouse().xy) < my("downbutton"):"radius",
			self():"value" = my("value") - 1;
			my("parent"):"value" = my("parent"):"value"-10^(my("maxplaces")-1)
		);	
		if(dist(my("upbutton"):"center",mouse().xy) < my("upbutton"):"radius",
			self():"value" = my("value") + 1;
			my("parent"):"value" = my("parent"):"value"+10^(my("maxplaces")-1)
		);
	);

	o; // Return placecard.
);

// C.2 | Numbercard
new Numbercard (c,initialvalue, maxplaces, editable) := (
	regional (o);
	o = new VAMobject("numbercard");
	o:"coord" 			= c;
	o:"maxplaces" 	= maxplaces;
	o:"width" 			= maxplaces;
	o:"height" 			= 1;
	o:"editable"		= editable; // bool array of editable placecards
	o:"value" 			= initialvalue;
	o:"expanded" 		= false;
	o:"children" 		= [];
	o:"alpha" 			= 1;
	o:"offset"			= 1;
	o:"fadetime" 		= 3/5;
	o:"foldtime" 		= 5/5;
	o:"color" 			= MONTEGREY;
	o:"fadealpha"		= alpha;
	o:"ismoveable" 	= false;
	o:"montessori" 	= monte;
	o:"showtogglemonte" = showtogglemonte;

	o:"hitbox" := rectangle(
		my("coord") - 2*(1.4,0),
		2*1.4 + my("maxplaces"), 
		my("height")
	);

	o:"ishot" := or(
		inrectangle(my("hitbox"),	mouse().xy),
		listor(apply(my("children"),#:"ishot"));
	);

	o:"shape" := rectangle(
		my("coord"),
		my("width"),
		my("height")
	);

	o:"draw":= (
		regional(value, dodraw, ps);

		// Draw the card
		fillpoly(
			my("shape"),
			color->my("color"),
			alpha->my("alpha")
		);
		drawpoly(
			my("shape"),
			size->2,
			color->grey(0),
			alpha->my("alpha")
		);

		// Draw the value
		value = my("value");
		dodraw = true;
		ps = pixelsize(
			"0",
			size->screenresolution(),
			family->schulschrift
		);
		repeat(my("maxplaces"),
			if(dodraw,
				drawtext(
					my("coord") + (
						my("maxplaces") - # + .5 - 2*floor((#-1)/3)/ps_1,
						(ps_3)/4/screenresolution()
					),
					mod(value,10),
					align->"center",
					size->screenresolution(),
					family->schulschrift,
					alpha->my("alpha")
				);
				// Draw seperator
				if(mod(#,3) == 0 & # < my("maxplaces"),
					drawtext(
						my("coord") + (
							my("maxplaces") - # - .15, // adjust x
							(ps_3) / 4 / screenresolution() // adjust y
						),
						separator,
						align->"center",
						size->screenresolution(),
						family->schulschrift
					);
				);
			);
			value = floor(value/10);
			dodraw = (value>0);
		);

		// Unfold Button
		regional(rect, size, rectcol, barcol, offset);
		offset = (1.4,0);
		rect = roundedrectangle(self():"coord"-offset, 1, self():"height",.1);
		size = 2;
		rectcolor = DIVOBLUE;
		barcol = MONTEGREY;

		draw(rect, color->rectcolor, size->size);
		fill(rect, color->rectcolor);
		repeat(if(my("expanded"),1,4), // Draw burger-like lines to display "unfold"
			fillpoly(rectangle(
				(self():"coord")+(-offset_1-0.1+.2*#,-.05+.2*(5-#)),
				(5-#)*.2,.1
			), 
			color->barcol);
		);
		forall(my("children"), #:"draw");

		// Color Button
		if(my("showtogglemonte"),
			regional(rect, circ0, circ1, circ2);
			// Setup parts to be drawn
			rect = roundedrectangle(self():"coord"-2*offset, 1, self():"height",.1); // border
			circ0 = circle(self():"coord"-2*offset+[1,0], 2); // outer circle
			circ1 = circle(self():"coord"-2*offset+[1,0], 1); // middle circle
			circ2 = circle(self():"coord"-2*offset+[1,0], .5); // inner circle

			// Draw...
			if(!my("montessori"), // Colorful button
				fill(rect~~circ0, color->MONTEBLUE);
				fill(rect~~circ1, color->MONTERED);
				fill(rect~~circ2, color->MONTEGREEN);
			, // Grey button
				fill(rect~~circ0, color->grey(.9));
				fill(rect~~circ1, color->grey(.6));
				fill(rect~~circ2, color->grey(.3));
			);
			draw(rect, color->DIVOBLUE, size->size);
		);

		// DEBUG DRAW
		if('debuglevel > 0,
			drawpoly(my("hitbox"));
			draw(my("hitbox")_1,color->[1,0,0]);
			draw(my("coord"));
		);
	);

	o:"move" := if(self():"ismoveable", self():"coord" = coord);
	
	o:"active" := inrectangle( // If condition in self():"click"
		rectangle(
			my("coord") - (1.4,0), 
			2 + my("maxplaces"),
			my("height")
		), 
		mouse().xy
	);

	o:"colortoggle" := if(my("showtogglemonte"),
		regional(offset);
		offset = (1.4,0);
		inrectangle(
			rectangle(self():"coord"-2*offset, 1, self():"height"),
			mouse().xy
		);
	);

	o:"click" := (
		if(my("active"), // Fold / Unfold action
			regional(children,pc,offset,fadetime,foldtime);
			fadetime=my("fadetime");
			foldtime=my("foldtime");
			children=[];
			self():"expanded" =
				if(my("expanded"),
					forall(my("children"), child,
						child:"edit"=false;
						new animationobject(
							child,
							"coord",
							child:"coord",
							my("coord")+(my("maxplaces")-child:"maxplaces",0),
							foldtime,
							"accel"
						);
						new animationobjectwithdelay(
							child,
							"mix",
							1,
							1, // should be 0 for animation
							fadetime,
							"accel",
							foldtime
						);
					);
					false // set my("expanded")
				, // else to if(my("expanded"))
					regional(val);
					val = my("value");
					repeat(my("maxplaces"), place,
						if(true % val>0 % place==1, 
						// create a card every time to allow for null-slots
							offset = (
								my("maxplaces")-place,
								1.2*(place-my("offset")-my("maxplaces"))
							);
							pc = new Placecard(
								my("coord") + (my("maxplaces")-place,0),
								mod(val,10),place
							);
							pc:"parent" = self();
							pc:"color" = if(my("montessori"), // colorful
								MONTEPALETTE_(mod(place-1,3) + 1);
							, // else grey
								MONTEGREY
							);
							new animationobjectwithdelay(
								pc,
								"coord",
								my("coord")+(my("maxplaces")-place,0),
								my("coord")+offset,
								foldtime,
								"accel",
								fadetime
							);
							new animationobject(
								pc,
								"mix",
								1, // should be 0 for animation
								1, 
								fadetime,
								"accel"
							);
							setpropertylater(
								pc,
								"edit",
								my("editable")_place,
								foldtime+foldtime
							);
							children = [pc] ++ children
						); // end if
						val = floor(val/10);
					); // end repeat
			  	self():"children" = children;
					true; // set my("expanded")
				); // end if(my("expanded")) ~100 lines earlier.
			); // end "active"-if

			// Check if Color-Button has been clicked
			if(my("colortoggle"),
				// Toggle montessori flag
				self():"montessori" = !self():"montessori";
				// Change color attribute of children accordingly
				forall(my("children"),
					#:"color" = if(my("montessori"), // colorful
						MONTEPALETTE_(mod(#:"maxplaces"-1,3) + 1)
					, // else grey
						MONTEGREY
					);
				);
			);

			// handle click on children
			forall(my("children"), if(#:"ishot", #:"click"));

			// Send results/state to divomath
			divomathUpdateResults();
	);

	o:"getaction" := (
		action = if( // condition
			inrectangle(
				rectangle(
					my("coord")-(2,0),
					2+my("maxplaces"),
					my("height")
				), 
				mouse().xy;
			)
		, // if body
			"move"
		, // else body
			"adjust"
		); 
	);
	
	o; // Return numbercard.
);

// D | Initialization
// D.0 | SL Config
// ===============
if(!usedivomath,
	numofcards = if(!isundefined('urlparams:"cards"), parse('urlparams:"cards"), 1);
	xcoords = if(!isundefined('urlparams:"x"), parse('urlparams:"x"), apply(1..numofcards, 10*#-7));
	ycoords = if(!isundefined('urlparams:"y"), parse('urlparams:"y"), apply(1..numofcards, 16));
	values = if(!isundefined('urlparams:"value"), parse('urlparams:"value"), apply(1..numofcards, 1234));
	edit = if(!isundefined('urlparams:"edit"), parse('urlparams:"edit"), apply(1..numofcards,apply(1..length(text(values_#)),true)););
	unfold = if(!isundefined('urlparams:"unfold"), parse('urlparams:"unfold"), true);
	monte = if(!isundefined('urlparams:"color"), parse('urlparams:"color"), true);
	showmontetoggle = if(!isundefined('urlparams:"colortoggle"), parse('urlparams:"colortoggle"), true);
	alpha = if(!isundefined('urlparams:"alpha"), parse('urlparams:"alpha"), .2);
	separator = if(!isundefined('urlparams:"separator"), 'urlparams:"separator", "");
);

max = max(apply(edit,length(#))); // Get max length of digits for cards

// D.1 | Build card templates based on config
// ==========================================
cards = [];
repeat(numofcards,
	cards = cards :> {};
	cards_#:"c" = [xcoords_#, ycoords_#];
	cards_#:"val" = values_#;
	cards_#:"max" = max_#;
	cards_#:"edit" = edit_#;
	cards_#:"unfold" = unfold_#;
);

// D.1 | Init numbercards
// ======================
forall(cards, card,
	thing = new Numbercard( // Create card based on configured array.
		card:"c",
		card:"val",
		card:"max",
		card:"edit"
	);
	
	// Build Placecards for every card
	regional(val, offset);
	val = thing:"value";
	repeat(thing:"maxplaces", place,
		offset = if(card:"unfold",
			(thing:"maxplaces"-place, 1.2*(place-thing:"offset"-thing:"maxplaces")),
			(thing:"maxplaces"-place, 0)
		);
		pc = new Placecard( // least significant first
			thing:"coord" + (thing:"maxplaces"-place,0),
			mod(val,10),place
		);

		pc:"parent" = thing;
		pc:"color" = if(thing:"montessori", // colorful
			MONTEPALETTE_(mod(place-1,3)+1)
		, // else grey
			MONTEGREY
		);
		pc:"coord" = thing:"coord"+offset;
		pc:"mix" = 1;
		pc:"edit" = if(card:"unfold", thing:"editable"_place, false);
		children = [pc] ++ children;
		val = floor(val/10); // next value
	); // end repeat
	thing:"alpha" = alpha;
	thing:"fadealpha" = alpha;
	thing:"children" = children;
	thing:"expanded" = card:"unfold";
 
	obj = obj :> thing; // Add card to obj list.
);

); // End VAM-if

// v7
// recent changes:
// - fixed toggle button label not showing supplied unit
// - fixed "Eingabe P" textfield not displaying correct number
// - fixed different wrong calculations and interaction between the different text inputs
// - added position of bar as configurable
// - fixed arches not drawing properly
// - changed some looks and positioning
// - added handle for number of percentagebar to be displayed
// - changed behavior of UI to address only active percentagebar
// - added highlighting for active bar

// Prozentstreifen
if(vam == "percentagebar",

// A | Documentation
//'doctextpos = [9,15.5];
'doc = "
	...
";

// B | Divomath config
// ===================
regional(item);

// Configure precision of the bars drag action
barprecision = defaultstateto("barprecision", 1);
barprecision = barprecision / 100; // Adjust to not be expressed as y%

barposition = defaultstateto("barposition", [0,17]);
barwidth = defaultstateto("barwidth", 16); // initial width of bar
barheight = defaultstateto("barheight", 2); // height of bar

barvalue = defaultstateto("barvalue", 0); // initial bar value in [0,1]
basevalue = defaultstateto("basevalue", 1000); // bars initial base value

subdivisions = defaultstateto("subdivisions", 3); // initial number of subdivisions

unit = defaultstateto("unit", ""); // displayed unit for values

leftoutpercentages = defaultstateto("leftoutpercenteges", []);
leftoutvalues = defaultstateto("leftoutvalues", []);
custompercenteges = defaultstateto("custompercenteges", []);
customvalues = defaultstateto("customvalues", []);

// Configure look and feel of things
barcolor = defaultstateto("barcolor", DZLMCOLORGOLD); // Percentagebar
archcolor = defaultstateto("archcolor", DZLMCOLORGOLD); // Arches
fontfamily = defaultstateto("fontfamily", nada); // Font
isbardraggable = defaultstateto("isbardraggable", true);
alwaysdrawarches = defaultstateto("alwaysdrawarches", true);
snapbar = defaultstateto("snapbar", true);
decimalspercentage = defaultstateto("decimalspercentage", 2);
decimalsvalue = defaultstateto("decimalsvalue", 0);
numberofbars = defaultstateto("numberofbars", 1);

// Configure scaffolds
scaffoldvalue = defaultstateto("scaffoldvalue", false);
scaffoldpercentage = defaultstateto("scaffoldpercentage", false);
scaffoldbasevalue = defaultstateto("scaffoldbasevalue", false);

// Percentagebar
// Main functionality of a bar, that is draggable in a certain area. Provides labels for different values
new Percentagebar(coord, width, height, value, precision, divisions, baseval, unit) := (
	regional(o);
	o = new VAMobject("Percentagebar");
	
	// Look and feel
	o:"coord" = coord;
	o:"color" = barcolor;
	o:"width" = width;
	o:"height" = height;
	o:"margin" = .07; // margin of bar shape to surrounding box
	o:"precision" = precision; // precision of movement of bar (in [0,1])
	o:"fontsize" = 14;
	o:"fontfamily" = fontfamily; // set globally
	o:"labelpadding" = .2;
	o:"isclickable" = isbardraggable;
	o:"ismoveable" = isbardraggable;

	// Booleans for showing/hiding stuff, set manually after init
	o:"drawpercentagelabels" = nada;
	o:"drawvaluelabels" = nada;
	o:"drawbasevaluelabel" = nada;
	o:"drawcurrentpercentage" = nada;
	o:"drawcurrentvalue" = nada;
	o:"drawarches" = nada;
	o:"canoverflow" = nada;
	o:"scaffoldvalue" = scaffoldvalue;
	o:"scaffoldpercentage" = scaffoldpercentage;
	o:"scaffoldbasevalue" = scaffoldbasevalue;

	// Handles for interface (textfields, buttons, toggles)
	o:"toggles" = nada; // set at init
	o:"textfields" = nada; // set at init
	o:"buttons" = nada; // set at init

	// Values for Percentagebar
	o:"unit" = unit;
	o:"value" = value; // between 0 and 1
	o:"basevalue" = baseval;
	o:"divisions" = divisions; // determines ticks, gets updated via Textfield
	o:"ticks" := apply(1..my("divisions"), #/my("divisions"));
	o:"standardticks" = [0,1];
	
	// Shape & hitbox
	o:"box" = rectangle(coord-[o:"margin",o:"margin"], width+2*o:"margin", height+2*o:"margin");
	o:"shape" := roundedrectangle(my("coord"), my("value")*my("width"), my("height"), .1);
	o:"hitbox" := rectangle(my("coord"),my("width"),my("height"));

	o:"ishot" := inrectangle(my("hitbox"), mouse().xy);
	o:"isactive" = false; // for use with multiple bars. Controls which bar is targetted by toggle switch state changes (see "toggleactive")

	o:"draw" := (
		// Draw background box	
		fillpoly(my("box"), color->grey(.85));
		drawpoly(my("box"), color->grey(.2), size->if(my("isactive"),1.5,.5));

		// Draw actual draggable bar
		fill(my("shape"), color->my("color"), alpha->if(my("isactive"),1,.7));

		// Draw inbetween ticks
		regional(p1); // anchor point for vertical lines
		forall(my("ticks") -- [1],
			p1 = my("coord") + [#,0]*my("width"); // Set bottom point for tick
			draw( // draw vertical line segment
				p1, p1 + [0,my("height")],
				size->2,
				color->DZLMCOLORBLUE
			); 
		);

		// Draw standard ticks (left and right by default)
		forall(my("standardticks"),
			p1 = my("coord") + [#,0]*my("width"); // Set bottom point for tick
			draw( // draw vertical line segment
				p1, p1 + [0,my("height")],
				size->.1,
				color->grey(.1)
			); 
		);

		// Draw custompercenteges & customvalues
		forall(custompercenteges ++ customvalues,
			p1 = my("coord") + [#,0]*my("width"); // Set bottom point for tick
			draw( // draw vertical line segment
				p1, p1 + [0,my("height")],
				size->2,
				color->grey(.0)
			); 
		);

		// Draw labels for percentages and corresponding values
		regional(size, font, label, text, box, position, xoffset, yoffset);
		size = my("fontsize");
		family = my("fontfamily");
		
		// Draw percentage labels
		if(my("drawpercentagelabels"),
			yoffset = my("height")+my("labelpadding"); // move up by the height of the bar
			forall(my("ticks") ++ my("standardticks") -- leftoutpercentages,
				if(my("drawarches"),
					if(my("value") >= #,
						text = format(100*#, decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
						box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
						xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
						position = my("coord") + [xoffset, yoffset]; // actual position
			
						// Draw arches
						if(my("drawarches"), eval(my("drawpercentagearches"), yoffset->yoffset+box_4_2-box_1_2));
		
						// Draw labels
						drawtext(position, text, size->size, font->family, color->grey(.2));
					);
				,
					text = format(100*#, decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
					box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
					xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
					position = my("coord") + [xoffset, yoffset]; // actual position
	
					// Draw arches
					//if(my("drawarches"), eval(my("drawpercentagearches"), yoffset->yoffset+box_4_2-box_1_2));
	
					// Draw labels
					drawtext(position, text, size->size, font->family, color->grey(.2));
				);
			);
		);

		// Draw value labels
		if(my("drawvaluelabels"),
			forall(my("ticks") ++ my("standardticks") -- leftoutvalues,
				if(my("drawarches"),
					if(my("value") >= # ,
						text = format(#*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
						box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
						xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
						yoffset = -(box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
						position = my("coord") + [xoffset, yoffset]; // actual position

						// Draw arches
						if(my("drawarches"), eval(my("drawvaluearches"), yoffset->yoffset-my("labelpadding")));

						// Draw
						if(# != 1, // exclude drawing of base value label
							drawtext(position, text, size->size, font->family, color->grey(.2));
						);
					);
				,
					text = format(#*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
					box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
					xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
					yoffset = -(box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
					position = my("coord") + [xoffset, yoffset]; // actual position
	
					// Draw arches
					//if(my("drawarches"), eval(my("drawvaluearches"), yoffset->yoffset-my("labelpadding")));
	
					// Draw
					if(# != 1, // exclude drawing of base value label
						drawtext(position, text, size->size, font->family, color->grey(.2));
					);
				);
			);
		);

		// Draw arches
		if(my("drawarches"),
			regional(dy);
			dy = getboundingbox(A, [0,0], size, family)_3_2; // height of textboxes for offset
			eval(my("drawvaluearches"), yoffset->-dy-2*my("labelpadding"));
			eval(my("drawpercentagearches"), yoffset->my("height")+dy+my("labelpadding"));
		);


		// Draw basevalue label
		if(my("drawbasevaluelabel"),
			text = format(my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
			box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
			xoffset = my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
			yoffset = -(box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
			position = my("coord") + [xoffset, yoffset]; // actual position
			
			// Draw
			drawtext(position, text, size->size, font->family, color->grey(.2));

				// Draw scaffold overlay for base value
				if(my("scaffoldbasevalue"),
					regional(scaffoldbox);
					scaffoldbox = roundedrectangle(position, box_2_1-box_1_1, box_4_2-box_1_2, .05);
					draw(scaffoldbox, color -> grey(.5));
					fill(scaffoldbox, color -> grey(.9));
			);
		);

		// Draw labels for custom percenteges
		yoffset = my("height")+my("labelpadding"); // move up by the height of the bar
		forall(custompercenteges,
			text = format(100*#, decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
			box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
			xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
			position = my("coord") + [xoffset, yoffset]; // actual position
		
		// Draw labels
			drawtext(position, text, size->size, font->family, color->grey(.0));
		 
		);

		// Draw labels for custom values
		forall(customvalues,
			text = format(#*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
			box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
			xoffset = #*my("width") - .5*(box_2_1-box_1_1); // move to vertical line and adjust by half the texts length
			yoffset = - (box_3_2-box_2_2) - my("labelpadding"); // move down by the height of the text
			position = my("coord") + [xoffset, yoffset]; // actual position

			// Draw
			drawtext(position, text, size->size, font->family, color->grey(.0));
		
		);

		// Draw labels for current percentage
		if(my("drawcurrentpercentage"),
			text = format(100*my("value"), decimalspercentage) + " %"; // tick value in % rounded to given decimals with "%" sign
			box = getboundingbox(text, [0,0], size, family); // only width is used not actual position
			position = my("coord") + [ // actual position, start at bar coord
				my("value")*my("width") - .5*(box_2_1-box_1_1), // move to vertical line and adjust by half the texts length
				my("height")+my("labelpadding") // move up by the height of the bar
			];

			// Draw
			drawtextbox(position, text, size, family, grey(1), bold->true);

			// Draw scaffold overlay for percentage
			if(my("scaffoldpercentage"),
				regional(scaffoldbox);
				scaffoldbox = roundedrectangle(position, box_2_1-box_1_1, box_4_2-box_1_2, .05);
				draw(scaffoldbox, color -> grey(.5));
				fill(scaffoldbox, color -> grey(.9));
			);
		);

		// Draw current value
		if(my("drawcurrentvalue"),
			text = format(my("value")*my("basevalue"),decimalsvalue) + " " + my("unit"); // altered tick value with unit
			box = getboundingbox(text, [0,0], size, family); // only width and height are used not actual position
			position = my("coord") + [ // actual position, start at bar coord
				my("value")*my("width") - .5*(box_2_1-box_1_1), // move to vertical line and adjust by half the texts length
				- (box_3_2-box_2_2) - my("labelpadding") // move down by the height of the text
			];

			// Draw
			drawtextbox(position, text, size, family, grey(1), bold->true);

			// Draw scaffold overlay for percentage
			if(my("scaffoldvalue"),
				regional(scaffoldbox);
				scaffoldbox = roundedrectangle(position, box_2_1-box_1_1, box_4_2-box_1_2, .05);
				draw(scaffoldbox, color -> grey(.5));
				fill(scaffoldbox, color -> grey(.9));
			);

		);

		// Debug draw
		if('debuglevel > 0, drawtext(my("coord")+[0.3,0],my("value")));
		if('debuglevel > 0, draw(my("coord")));
		if('debuglevel > 1, drawpoly(my("hitbox"), color->[0,1,0]));
	);

	o:"drawpercentagearches" := ( // helper for drawing percentage arches (in "draw"), gets evaled with yoffset
		regional(ticks, width, height, todraw);

		if(isundefined(yoffset),yoffset=0);
		ticks = 0 <: my("ticks") :> 1; // ticks with start (0) and end value (1) added
		width = my("width") / my("divisions"); // ellipses width / major axis
		height = width / PHI; // ellipses height / minor axis

		// go through all ticks and draw arch if required
		forall(2..length(ticks)-1,
			todraw = my("value") >= ticks_#; //checks for current tick, if value is bigger
			if(todraw,
				connect(
					ellipse(my("coord") + [(#-1.5)*width, yoffset],	width/2, height/2, 0, PI),
					color->my("color")
				);
			);
		);
	);
	
	o:"drawvaluearches" := ( // helper for drawing value arches (in "draw"), gets evaled with yoffset
		regional(ticks, width, height, todraw);

		if(isundefined(yoffset),yoffset=0);
		ticks = 0 <: my("ticks") :> 1; // ticks with start (0) and end value (1) added
		width = my("width") / my("divisions"); // ellipses width / major axis
		height = width / PHI; // ellipses height / minor axis

		// go through all ticks and draw arch if required
		forall(2..length(ticks)-1,
			todraw = my("value") >= ticks_#; //checks for current tick, if value is bigger
			if(todraw,
				connect(
					ellipse(my("coord") + [(#-1.5)*width, yoffset],	width/2, height/2, PI, 2*PI),
					color->my("color")
				);
			);
		);
	);

	o:"toggleactive" := (
		// Deactivate all other bars
		regional(otherbars);
		otherbars = select(obj,#:"type"=="Percentagebar") -- [self()];
		forall(otherbars, #:"setinactive");
		
		// Set self to active
		my("setactive");
	);

	o:"setactive" := (
		if(toggles:"percentage":"state" != self():"drawcurrentpercentage", toggles:"percentage":"click");
		if(toggles:"part":"state" != self():"drawcurrentvalue", toggles:"part":"click");
		if(toggles:"basevalue":"state" != self():"drawbasevaluelabel", toggles:"basevalue":"click");
		if(toggles:"parts":"state" != self():"drawvaluelabels", toggles:"parts":"click");
		if(toggles:"percentages":"state" != self():"drawpercentagelabels", toggles:"percentages":"click");
		if(toggles:"arch":"state" != self():"drawarches", toggles:"arch":"click");
		if(toggles:"overflow":"state" != self():"canoverflow", toggles:"overflow":"click");
		
		self():"drawcurrentpercentage"	:= toggles:"percentage":"state";
		self():"drawcurrentvalue"				:= toggles:"part":"state";
		self():"drawbasevaluelabel"			:= toggles:"basevalue":"state";
		self():"drawvaluelabels"				:= toggles:"parts":"state";
		self():"drawpercentagelabels"		:= toggles:"percentages":"state";
		self():"drawarches"							:= toggles:"arch":"state" % alwaysdrawarches;
		self():"canoverflow"						:= toggles:"overflow":"state";

		textfields:"divisions":"value" = my("divisions") + "";
		textfields:"divisions-value":"value" =  my("basevalue")/my("divisions") + "";
		textfields:"divisions-percentage":"value" =  100/my("divisions") + "";
		textfields:"basevalue":"value" = my("basevalue") + "";
		textfields:"value":"value" = my("value") * my("basevalue")+ "";
		textfields:"percentage":"value" = my("value") + "";
		'generictextfieldhandle = self();
		
		self():"isactive" = true;
	);
	o:"setinactive" := (
		if(my("isactive"),
			self():"drawcurrentpercentage"	= toggles:"percentage":"state";
			self():"drawcurrentvalue"				= toggles:"part":"state";
			self():"drawbasevaluelabel"			= toggles:"basevalue":"state";
			self():"drawvaluelabels"				= toggles:"parts":"state";
			self():"drawpercentagelabels"		= toggles:"percentages":"state";
			self():"drawarches"							= toggles:"arch":"state" % alwaysdrawarches;
			self():"canoverflow"						= toggles:"overflow":"state";
		);
		
		self():"isactive" = false;
	);

	o:"move" := if(my("ismoveable"),
		// Set current bar to active and deactivate all other bars
		if(!my("isactive"), my("toggleactive"));

		my("setvalue");

		// Set percentage tf accordingly
		my("textfields"):"percentage":"value" = my("value") + "";

		// Set value tf accordingly
		my("textfields"):"value":"value" = my("basevalue") * my("value") + "";
	);

	o:"moveend" := if(my("ismoveable"),		
		// Set current bar to active and deactivate all other bars
		my("toggleactive");
		
		// Send updated value to SL
		postValue("percentagevalue", my("value"));
	);

	o:"click" := if(my("isclickable"),
		my("setvalue");
	);
	
	o:"setvalue" := (
		// Set value according to mouse coords
		self():"value" = (mouse().xy - my("coord"))_1 / my("width");
		
		// Cut of properly
		if(!my("canoverflow"), // cap at 100% and 0%
			self():"value" = min(max(my("value"),0),1);
		,	// else: cap only at 0%
			self():"value" = max(my("value"),0);
		);

		// Round according to given precision
		self():"value" = my("precision") * round(my("value")/my("precision"));
	);

	o:"setTicks" := if(false,
		regional(newTicks);
		newTicks=[];
		repeat(my("divisions")-1,i,
				newTicks = newTicks:>i/(my("divisions"));
		);
		self():"ticks" = newTicks;
	);

	o; // Return the object.
);

// D | Initialization
// D.0 | SL Config
// ===============
if(!usedivomath,
	barprecision = if(!isundefined('urlparams:"barprecision"), parse('urlparams:"barprecision"), .01);
	barposition = if(!isundefined('urlparams:"barposition"), parse('urlparams:"barposition"), [0,17]);
	barwidth = if(!isundefined('urlparams:"barwidth"), parse('urlparams:"barwidth"), 16);
	barheight = if(!isundefined('urlparams:"barheight"), parse('urlparams:"barheight"), 1.5);
	barvalue = if(!isundefined('urlparams:"barvalue"), parse('urlparams:"barvalue"), 0);
	basevalue = if(!isundefined('urlparams:"basevalue"), parse('urlparams:"basevalue"), 1000);
	subdivisions = if(!isundefined('urlparams:"subdivisions"), parse('urlparams:"subdivisions"), 1);
	unit = if(!isundefined('urlparams:"unit"), 'urlparams:"unit", "MB");
	barcolor = if(!isundefined('urlparams:"barcolor"), parse('urlparams:"barcolor"), DZLMCOLORGOLD);
	archcolor = if(!isundefined('urlparams:"archcolor"), parse('urlparams:"archcolor"), DZLMCOLORGOLD);
	fontfamily = if(!isundefined('urlparams:"fontfamily"), parse('urlparams:"fontfamily"), NADA);
	leftoutpercentages = if(!isundefined('urlparams:"leftoutpercentages"), parse('urlparams:"leftoutpercentages"), []);

	leftoutvalues = if(!isundefined('urlparams:"leftoutvalues"), parse('urlparams:"leftoutvalues"), []);
	custompercenteges = if(!isundefined('urlparams:"custompercenteges"), parse('urlparams:"custompercenteges"), []);
	customvalues = if(!isundefined('urlparams:"customvalues"), parse('urlparams:"customvalues"), []);
	scaffoldbasevalue = if(!isundefined('urlparams:"scaffoldbasevalue"), parse('urlparams:"scaffoldbasevalue"), false);
	scaffoldvalue = if(!isundefined('urlparams:"scaffoldvalue"), parse('urlparams:"scaffoldvalue"), false);
	scaffoldpercentage = if(!isundefined('urlparams:"scaffoldpercentage"), parse('urlparams:"scaffoldpercentage"), false);
	isbardraggable = if(!isundefined('urlparams:"isbardraggable"), parse('urlparams:"isbardraggable"), true);
	alwaysdrawarches = if(!isundefined('urlparams:"alwaysdrawarches"), parse('urlparams:"alwaysdrawarches"), true);
	snapbar = if(!isundefined('urlparams:"snapbar"), parse('urlparams:"snapbar"), false);
	decimalspercentage = if(!isundefined('urlparams:"decimalspercentage"), parse('urlparams:"decimalspercentage"), 2);
	decimalsvalue = if(!isundefined('urlparams:"decimalsvalue"), parse('urlparams:"decimalsvalue"), 2);
	numberofbars = if(!isundefined('urlparams:"numberofbars"), parse('urlparams:"numberofbars"), 3);
);

// D.1 | Init Toggle Switches
// new Toggle(coord,width,state,label,fontsize)
// ============================================
regional(screen, toggles, togglepad, marginy, togglesize);
screen = apply(screenbounds(), #.xy);
togglepad = .5;
togglesize = 2;
marginy = 2;
toggles = {
	"percentages" : new Toggle(screen_4 + [togglepad,togglepad+marginy], togglesize, false, "Prozente oben", 14),
	"parts"				:	new Toggle(screen_4 + [togglepad,togglepad+marginy+1*togglesize*.8], togglesize, false, "Werte unten", 14),
	"basevalue"		: new Toggle(screen_4 + [togglepad,togglepad+marginy+2*togglesize*.8], togglesize, false, "Ganzes", 14),
	"part"				: new Toggle(screen_4 + [togglepad,togglepad+marginy+3*togglesize*.8], togglesize, false, "Teil", 14),
	"percentage"	:	new Toggle(screen_4 + [togglepad,togglepad+marginy+4*togglesize*.8], togglesize, false, "Anteil", 14),
	"overflow"		: new Toggle(screen_4 + [togglepad+15,togglepad+marginy], togglesize, false, "Overflow", 14),

	"arch"									: new Toggle(screen_4 + [togglepad+6,togglepad+marginy+3*togglesize*1.2], togglesize, false, "Bögen", 14),
	"showtf-div"						: new Toggle(screen_4 + [togglepad+6,togglepad+marginy+2*togglesize*1.2], togglesize, false, "Anzahl der Schritte:", 14),
	"showtf-divpercentage"	: new Toggle(screen_4 + [togglepad+6,togglepad+marginy+0*togglesize*1.2], togglesize, false, "Größe des Schritts in %:", 14),
	"showtf-divvalue"				: new Toggle(screen_4 + [togglepad+6,togglepad+marginy+1*togglesize*1.2], togglesize, false, "Größe des Schritts", 14),
	
	"showtf-base"	: new Toggle(screen_4 + [togglepad+15,togglepad+marginy+1*togglesize*.8], togglesize, false, "Eingabe Ganzes", 14),
	"showtf-value": new Toggle(screen_4 + [togglepad+15,togglepad+marginy+2*togglesize*.8], togglesize, false, "Eingabe Teil", 14),
	"showtf-perc"	: new Toggle(screen_4 + [togglepad+15,togglepad+marginy+3*togglesize*.8], togglesize, false, "Eingabe Anteil", 14)
};

toggles:"showtf-divvalue":"label" = toggles:"showtf-divvalue":"label" + if(unit=="",":", " in " + unit + ":");

// D.2 | Init Text Inputs for (sub)divisions and base value
// ===================================================
regional(textfields, inputdiv, inputbaseval);

textfields = {
	"basevalue" 						: new TextInput(screen_4 + [togglepad+21.5,togglepad+marginy+1.7], "", "numeric"),
	"value" 								: new TextInput(screen_4 + [togglepad+21.5,togglepad+marginy+3.3], "", "numeric"),
	"percentage" 						: new TextInput(screen_4 + [togglepad+21.5,togglepad+marginy+4.9], "", "numeric"),
	"divisions"							:	new TextInput(screen_4 + [togglepad+8.5,togglepad+marginy+4], "", "numeric"),
	"divisions-percentage" 	: new TextInput(screen_4 + [togglepad+8.5,togglepad+marginy-1], "", "numeric"),
	"divisions-value" 			: new TextInput(screen_4 + [togglepad+8.5,togglepad+marginy+1.5], "", "numeric")
};

'generictextfieldhandle = bar;

// Config subdivisions tf
textfields:"divisions":"handle" := 'generictextfieldhandle; // Pointer to the bar to alter
textfields:"divisions":"value" =  subdivisions + ""; // Textinput value needs to be string
// Nur Numpad verschieben (Eingabefeld bleibt!)
textfields:"divisions":"keyboardcoord" = textfields:"divisions":"coord";
textfields:"divisions":"keyboardoffset" = [7, 2];  // Beispiel: weiter rechts + etwas runter/hoch
textfields:"divisions":"onupdate" := (
	my("handle"):"divisions" = parse(my("value"));
	obj = obj -- [my("keyboard")];
	self():"keyboard" = nada;
	// Update other relevant tfs
	textfields:"divisions-value":"value" = my("handle"):"basevalue"/parse(my("value")) + "";
	textfields:"divisions-percentage":"value" = 100/parse(my("value")) + "";
);

// Config percentage related subdivisions tf
textfields:"divisions-percentage":"handle" := textfields:"divisions":"handle"; // Pointer to the bar to alter
textfields:"divisions-percentage":"value" =  100/subdivisions + ""; // Textinput value needs to be string
// Nur Numpad verschieben (Eingabefeld bleibt!)
textfields:"divisions-percentage":"keyboardcoord" = textfields:"divisions-percentage":"coord";
textfields:"divisions-percentage":"keyboardoffset" = [7, 4];  // Beispiel: weiter rechts + etwas runter/hoch
textfields:"divisions-percentage":"onupdate" := (
	obj = obj -- [my("keyboard")];
	self():"keyboard" = nada;
	// Update other relevant tfs
	textfields:"divisions-value":"value" = bar:"basevalue" * parse(my("value"))/100 + "";
	textfields:"divisions":"value" = 100/parse(my("value")) + "";
	self():"handle":"divisions" = parse(textfields:"divisions":"value");
);

// Config value related subdivisions tf
textfields:"divisions-value":"handle" := textfields:"divisions":"handle"; // Pointer to the bar to alter
textfields:"divisions-value":"value" =  basevalue/subdivisions + ""; // Textinput value needs to be string
// Nur Numpad verschieben (Eingabefeld bleibt!)
textfields:"divisions-value":"keyboardcoord" = textfields:"divisions-value":"coord";
textfields:"divisions-value":"keyboardoffset" = [7, 3];  // Beispiel: weiter rechts + etwas runter/hoch
textfields:"divisions-value":"onupdate" := (
	obj = obj -- [my("keyboard")];
	self():"keyboard" = nada;
	// Update other relevant tfs
	textfields:"divisions-percentage":"value" = 100*parse(my("value"))/bar:"basevalue" + "";
	textfields:"divisions":"value" = bar:"basevalue"/parse(my("value")) + "";
	self():"handle":"divisions" = parse(textfields:"divisions":"value");
);

// Config base value tf
textfields:"basevalue":"handle" := textfields:"divisions":"handle"; // Pointer to the bar to alter
textfields:"basevalue":"value" =  basevalue + ""; // Textinput value needs to be string
// Nur Numpad verschieben (Eingabefeld bleibt!)
textfields:"basevalue":"keyboardcoord" = textfields:"basevalue":"coord";
textfields:"basevalue":"keyboardoffset" = [-4, 3];  // Beispiel: weiter rechts + etwas runter/hoch
// Numpad-Position für Grundwert verschieben
textfields:"basevalue":"onupdate" := (
	my("handle"):"basevalue" = parse(my("value"));
	textfields:"value":"value" = my("handle"):"basevalue" * my("handle"):"value";
	textfields:"divisions-value":"value" = bar:"basevalue"/bar:"divisions" + "";
	obj = obj -- [my("keyboard")];
	self():"keyboard" = nada;
);

// Config value tf
textfields:"value":"handle" := textfields:"divisions":"handle"; // Pointer to the bar to alter
textfields:"value":"value" =  basevalue * barvalue + ""; // Textinput value needs to be string
// Nur Numpad verschieben (Eingabefeld bleibt!)
textfields:"value":"keyboardcoord" = textfields:"value":"coord";
textfields:"value":"keyboardoffset" = [-4, 2];  // Beispiel: weiter rechts + etwas runter/hoch

textfields:"value":"onupdate" := (
	my("handle"):"value" = parse(my("value")) / my("handle"):"basevalue";
	textfields:"percentage":"value" = 100 * my("handle"):"value" + "";
	obj = obj -- [my("keyboard")];
	self():"keyboard" = nada;
);

// Config percentage tf
textfields:"percentage":"handle" := textfields:"divisions":"handle"; // Pointer to the bar to alter
textfields:"percentage":"value" =  barvalue * 100 + ""; // Textinput value needs to be string
// Nur Numpad verschieben (Eingabefeld bleibt!)
textfields:"percentage":"keyboardcoord" = textfields:"percentage":"coord";
textfields:"percentage":"keyboardoffset" = [-4, 2];  // Beispiel: weiter rechts + etwas runter/hoc
textfields:"percentage":"onupdate" := (
	my("handle"):"value" = parse(my("value")) / 100;
	textfields:"value":"value" = my("handle"):"value" *my("handle"):"basevalue" + "";
	obj = obj -- [my("keyboard")];
	self():"keyboard" = nada;
);

// Init +/- Buttons 
// ==================
// new Button(coord,width,height,label,fontsize)
regional(buttons);
buttons = {};
buttons:"minusbase" = new Button(textfields:"basevalue":"coord" + [textfields:"basevalue":"width" + .1, 0], .7, .7, "-", 20);
buttons:"plusbase" = new Button(buttons:"minusbase":"coord" + [buttons:"minusbase":"width" + .2, 0], .7, .7, "+", 20);
buttons:"minusvalue" = new Button(textfields:"value":"coord" + [textfields:"value":"width" + .1, 0], .7, .7, "-", 20);
buttons:"plusvalue" = new Button(buttons:"minusvalue":"coord" + [buttons:"minusvalue":"width" + .2, 0], .7, .7, "+", 20);
buttons:"minuspercentage" = new Button(textfields:"percentage":"coord" + [textfields:"percentage":"width" + .1, 0], .7, .7, "-", 20);
buttons:"pluspercentage" = new Button(buttons:"minuspercentage":"coord" + [buttons:"minuspercentage":"width" + .2, 0], .7, .7, "+", 20);
buttons:"minusdiv" = new Button(textfields:"divisions":"coord" + [textfields:"divisions":"width" + .1, 0], .7, .7, "-", 20);
buttons:"plusdiv" = new Button(buttons:"minusdiv":"coord" + [buttons:"minusdiv":"width" + .2, 0], .7, .7, "+", 20);
// @Todo: Config position
buttons:"minusdiv-percentage" = new Button(textfields:"divisions-percentage":"coord" + [textfields:"divisions-percentage":"width" + .1, 0], .7, .7, "-", 20);
buttons:"plusdiv-percentage" = new Button(buttons:"minusdiv-percentage":"coord" + [buttons:"minusdiv-percentage":"width" + .2, 0], .7, .7, "+", 20);
buttons:"minusdiv-value" = new Button(textfields:"divisions-value":"coord" + [textfields:"divisions-value":"width" + .1, 0], .7, .7, "-", 20);
buttons:"plusdiv-value" = new Button(buttons:"minusdiv-value":"coord" + [buttons:"minusdiv-value":"width" + .2, 0], .7, .7, "+", 20);

// Config buttons for subdividing
buttons:"minusdiv":"handle" = textfields:"divisions";
buttons:"minusdiv":"cornerradius" = .35;
buttons:"minusdiv":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(1,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusdiv":"handle" = textfields:"divisions";
buttons:"plusdiv":"cornerradius" = .35;
buttons:"plusdiv":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(100,val+1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for subdividing by percentage
buttons:"minusdiv-percentage":"handle" = textfields:"divisions-percentage";
buttons:"minusdiv-percentage":"cornerradius" = .35;
buttons:"minusdiv-percentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusdiv-percentage":"handle" = textfields:"divisions-percentage";
buttons:"plusdiv-percentage":"cornerradius" = .35;
buttons:"plusdiv-percentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(100,val+1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for subdividing by value
buttons:"minusdiv-value":"handle" = textfields:"divisions-value";
buttons:"minusdiv-value":"cornerradius" = .35;
buttons:"minusdiv-value":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusdiv-value":"handle" = textfields:"divisions-value";
buttons:"plusdiv-value":"cornerradius" = .35;
buttons:"plusdiv-value":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(bar:"basevalue",val+1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for base value
buttons:"minusbase":"handle" = textfields:"basevalue";
buttons:"minusbase":"cornerradius" = .35;
buttons:"minusbase":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(1,val-1);
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusbase":"handle" = textfields:"basevalue";
buttons:"plusbase":"cornerradius" = .35;
buttons:"plusbase":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = val + 1;
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for (current) value
buttons:"minusvalue":"handle" = textfields:"value";
buttons:"minusvalue":"cornerradius" = .35;
buttons:"minusvalue":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val - my("handle"):"handle":"basevalue" * my("handle"):"handle":"precision");
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"plusvalue":"handle" = textfields:"value";
buttons:"plusvalue":"cornerradius" = .35;
buttons:"plusvalue":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(my("handle"):"handle":"basevalue",val + my("handle"):"handle":"basevalue" * my("handle"):"handle":"precision");
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

// Config buttons for percentage
buttons:"minuspercentage":"handle" = textfields:"percentage";
buttons:"minuspercentage":"cornerradius" = .35;
buttons:"minuspercentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = max(0,val - 100 * my("handle"):"handle":"precision");
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);

buttons:"pluspercentage":"handle" = textfields:"percentage";
buttons:"pluspercentage":"cornerradius" = .35;
buttons:"pluspercentage":"script" := (
	regional(val);
	val = parse(my("handle"):"value");
	val = min(100,val + 100 * my("handle"):"handle":"precision");
	my("handle"):"value" = val + "";
	my("handle"):"onupdate";
);


// Configure Toggles corresponding to G,P,p textfields to toggle visibility
// ========================================================================
toggles:"showtf-base":"script" := if(my("state"),
	obj = obj ++ [textfields:"basevalue"];
	obj = obj ++ [buttons:"plusbase"];
	obj = obj ++ [buttons:"minusbase"];
,
	obj = obj -- [textfields:"basevalue"];
	obj = obj -- [buttons:"plusbase"];
	obj = obj -- [buttons:"minusbase"];
);

toggles:"showtf-value":"script" := if(my("state"),
	obj = obj ++ [textfields:"value"];
	obj = obj ++ [buttons:"plusvalue"];
	obj = obj ++ [buttons:"minusvalue"];
,
	obj = obj -- [textfields:"value"];
	obj = obj -- [buttons:"plusvalue"];
	obj = obj -- [buttons:"minusvalue"];
);

toggles:"showtf-perc":"script" := if(my("state"),
	obj = obj ++ [textfields:"percentage"];
	obj = obj ++ [buttons:"pluspercentage"];
	obj = obj ++ [buttons:"minuspercentage"];
,
	obj = obj -- [textfields:"percentage"];
	obj = obj -- [buttons:"pluspercentage"];
	obj = obj -- [buttons:"minuspercentage"];
);

toggles:"showtf-div":"script" := if(my("state"),
	obj = obj ++ [textfields:"divisions"];
	obj = obj ++ [buttons:"plusdiv"];
	obj = obj ++ [buttons:"minusdiv"];
,
	obj = obj -- [textfields:"divisions"];
	obj = obj -- [buttons:"plusdiv"];
	obj = obj -- [buttons:"minusdiv"];
);

toggles:"showtf-divpercentage":"script" := if(my("state"),
	obj = obj ++ [textfields:"divisions-percentage"];
	obj = obj ++ [buttons:"plusdiv-percentage"];
	obj = obj ++ [buttons:"minusdiv-percentage"];
,
	obj = obj -- [textfields:"divisions-percentage"];
	obj = obj -- [buttons:"plusdiv-percentage"];
	obj = obj -- [buttons:"minusdiv-percentage"];
);

toggles:"showtf-divvalue":"script" := if(my("state"),
	obj = obj ++ [textfields:"divisions-value"];
	obj = obj ++ [buttons:"plusdiv-value"];
	obj = obj ++ [buttons:"minusdiv-value"];
,
	obj = obj -- [textfields:"divisions-value"];
	obj = obj -- [buttons:"plusdiv-value"];
	obj = obj -- [buttons:"minusdiv-value"];
);

// Init Percentagebar
// new Percentagebar(coord, width, height, value, precision, divisions, baseval, unit)
// ==================================================================================
regional(bars);
bars = [];
if(numberofbars <= 1, // build one bar
	bar = new Percentagebar(barposition, barwidth, barheight, barvalue, barprecision, subdivisions, basevalue, unit);
	bars = bars :> bar;
, // ELSE: more than one bar
	regional(barpadding);
	barpadding = 1.5;
	barwidth = barwidth - (numberofbars-1) * barpadding;
	barwidth = barwidth / numberofbars;

	repeat(numberofbars,
		bar = new Percentagebar(barposition, barwidth, barheight, barvalue, barprecision, subdivisions, basevalue, unit);
		barposition = barposition + [barwidth+barpadding, 0];
		bars = bars :> bar;
	);
);

forall(bars, bar,
	bar:"drawpercentagelabels"	= toggles:"percentages":"state";
	bar:"drawvaluelabels"				= toggles:"parts":"state";
	bar:"drawbasevaluelabel"		= toggles:"basevalue":"state";
	bar:"drawcurrentpercentage"	= toggles:"percentage":"state";
	bar:"drawcurrentvalue"			= toggles:"part":"state";
	bar:"drawarches"						= toggles:"arch":"state" % alwaysdrawarches;
	bar:"canoverflow"						= toggles:"overflow":"state";
	bar:"standardTicks"	= 'standardTicks;
	
	// Add handles to bar for all the UI stuff
	bar:"toggles" = toggles;
	bar:"textfields" = textfields;
	bar:"buttons" = buttons;
);

// Update handles for textfields, since bar wasn't defined earlier
'generictextfieldhandle = bars_1;

if(snapbar, bar:"precision" := 1/bar:"divisions");

obj = obj ++ values(toggles) --  if(alwaysdrawarches, [toggles:"arch"]);
obj = obj ++ values(textfields) -- [
	textfields:"basevalue", textfields:"value", textfields:"percentage", 
	textfields:"divisions",	textfields:"divisions-percentage",	textfields:"divisions-value"
];
obj = obj ++ values(buttons) -- [
	buttons:"plusbase", buttons:"plusvalue",buttons:"pluspercentage",
	buttons:"minusbase", buttons:"minusvalue",buttons:"minuspercentage",
	buttons:"minusdiv", buttons:"plusdiv",
	buttons:"minusdiv-percentage",	buttons:"plusdiv-percentage",
	buttons:"minusdiv-value", buttons:"plusdiv-value"
];
obj = obj :> arch1;
obj = obj :> arch2;
obj = obj :> agg;
obj = obj ++ bars;

bars_1:"toggleactive";

// Call toggle scripts for G,P,p toggle to put in textfields approriately
toggles:"showtf-base":"script";
toggles:"showtf-value":"script";
toggles:"showtf-perc":"script";
toggles:"showtf-div":"script";
toggles:"showtf-divpercentage":"script";
toggles:"showtf-divvalue":"script";

); // end vam-if
// v44
// Recent changes:
// - fixed Scrollbar overlaying Reset Button
// - fixed Scrollbar not showing on start
// - changed displaying of triangle (smaller)
// - added configurable state for initial state of pattern container (patternstate)
// - added drawresetbutton as handle
// - added interactable as handle
// - changed Reset button not resizing with size attribute
// - fixed and refactored getting separator position with regards to parent container (and getting state string)
// - change separator hitbox/shape to scale with size attribute
// - added resetting to referenced state in reset button
// - Added configurable size attribute for Separators and Reset Button (sepsize)
// - Removed some debug output
// - Added bigger circle to (only) the hitbox of Separator for easier grabbing
// - Fix sepstate reporting position where initially dropped (even if there are no polys in this position)
// - Reorder drawing for RegPolys
// - Changed Reset Buttons Image to scale with sepsize
// - Fixed alignment to the right of container for Reset Button
// - Adjusted length of fixed size containers
// - changed layout of components in relation of what is drawn
// - removed animation of RegPolys on startup
// - added "buttonsize" as handle for the size of the reset button
// - fixed Button cornerradius wrongly using dynamic width and size attributes
// - fixed stray Polys remaining when dropping multi-row pattern container
// - @TODO: implement new handles as web controls

// Parkettierung / Bandornamente
if(vam == "strapwork",

// A | Documentation
//'doctextpos = [9,15.5];
'doc = "
>> Konfigurierbarer Zustand | VAM 'strapwork'
size: <float> # Größe der Elemente (Polygone, Container)
polys: <list> # Konfiguration der Polygone (siehe Doku)
polycolors: <list> # Farben der Polygone
rows: <int> # Anzahl der Streifen/Bänder
state: <list> # rows viele Strings, die Konfiguration des Containers vorgeben (siehe Doku)
limit: <list> # Max. Anzahl Polygone pro Band (siehe Doku)
borders: <bool> # Ränder der Polygone zeichnen?
drawseparator: <bool> # Marker zeichnen?
==========================================================
>> Results | VAM 'strapwork'
...siehe Doku
";

// shared local constants and vars
regional(shapemap, colormap, 'polyid, 'stripid);
SHAPEMAP = { // Maps shape names (use k+"gon" for k>8)
	"0":"circle", "3":"triangle", "4":"square", "5":"pentagon",
	"6":"hexagon", "7":"heptagon", "8":"octagon", "100": "circle"
};
COLORMAP = { // Maps color names
	"1":"blue", "2": "darkblue", "3":"red", "4":"green",
	"5":"violet", "6":"greyish", "7":"black"
};

'polyid = 0; // for identifying RegPolys (mainly for debugging)

// B | Divomath config
// ===================
// States
regional(size, vertices, colors, rows, state, limit, drawpatterncontainer, drawseparator, drawborders);

size = defaultstateto("size", 1); // Configure general size of Polys and Container
sepsize = defaultstateto("sepsize", 1); // Configure general size of Separators and Reset Button
vertices = defaultstateto("polys", [0,3,6]); // Configure number of RegPolys or list of number of vertices
colors = defaultstateto("polycolors", 1..100); // Configure colors of the RegPolys
rows = defaultstateto("rows", 1); // Configure number of rows/strips in Container
state = defaultstateto("state", apply(1..rows, "")); // Configure predefined RegPoly per strip
limit = defaultstateto("limit", apply(1..100, 10));// Configure limit of RegPolys per row/strip (-1 => no limit)
sepstate = defaultstateto("sepstate", ""); // Separator positions (i.e. number of polys left of Separator)
patternlimit = defaultstateto("patternlimit", 5); // Limit for PatternContainer
patternstate = defaultstateto("patternstate", apply(1..rows, "")); // Configure predefined RegPoly per strip
interactable = defaultstateto("interactable", "cps"); // Container is interactable (c=Container, p=Polys, s=Separators ... of Container)

// Configure look and feel
drawpolys = defaultstateto("drawpolys", true);// Draw base RegPolys
drawpatterncontainer = defaultstateto("drawpatterncontainer", true); // draw Pattern Container
drawseparator = defaultstateto("drawseparator", true); // Draw Separator
drawborders = defaultstateto("drawborders", true); // Draw borders of RegPolys
drawresetbutton = defaultstateto("drawresetbutton", true);// Draw reset button
polypadding = defaultstateto("polypadding", .5); // Draw padding between RegPolys
buttonsize = defaultstateto("buttonsize", 1); // Reset buttons size

// Configure reference container (rc)
rcrows = defaultstateto("rcrows", 1); // Configure number of rows/strips in reference ontainer
rcstate = defaultstateto("rcstate", apply(1..rows, "")); // Configure predefined RegPoly per strip
rclimit = defaultstateto("rclimit", apply(1..100, 10));// Configure limit of RegPolys per row/strip (-1 => no limit)
rcsepstate = defaultstateto("rcsepstate", ""); // Separator positions (i.e. number of polys left of Separator)
drawrccontainer = defaultstateto("drawrccontainer", false); // Draw reference container
drawrcseparator = defaultstateto("drawrcseparator", false); // Draw reference containers Separator
rcinteractable = defaultstateto("rcinteractable", ""); // reference containers can be used like a normal Container

// Configure result handling and setState.
// Overwrite divomath result updating function.
divomathUpdateResults() := if(usedivomath,
	divomathClearResult();
	if('debuglevel>6, println("===updateResults()=================================================="));
	regional(todivomath, strips, stripcounter, stripasstcring, polycounter, separators, sepisnext);
	stripcounter = 1;
	polycounter = 1;
	strips = reverse(container:"strips"); // all strips (top to bottom)
	
	separators = separator:"getstatestring"; // Get state string if Separator copies...
	if(isundefined(separators), separators = QUOTE+QUOTE); // cant be nada, because that breaks replace() in CindyJS
	separators = replace(separators,QUOTE,""); // ...strip leading quotes needed for divomath reporting...
	separators = parse("["+separators+"]"); // ...and parse as list.

	// Add divomath result for every Poly of every strip in the form
	// "<stripno>.<runningno>:<regpolyname>"
	forall(strips, strip, // Check every strip
		stripasstring = "";
		forall(strip, poly, // Check every Poly/Separator

			// Build string from poly-ids for clean row-wise reporting
			stripasstring = stripasstring + (poly:"original":"id"+1);

			// Get [key, ID of original]
			todivomath = [stripcounter + "." + polycounter, poly:"original":"id"+1];

			// Push Poly to divomath
			divomathPutResult(todivomath_1, todivomath_2);

			// if Separator is next, push a 0 to divomath
			if(contains(separators, polycounter),
				todivomath = [stripcounter + "." + polycounter, 0];
				divomathPutResult(todivomath_1, todivomath_2);
				stripasstring = stripasstring + "0";
			);

			polycounter = polycounter + 1;
		);

		// Report entire strip as string and reset
		divomathPutResult("row" + stripcounter, stripasstring);
		stripasstring = "";
		
		// Set counters
		stripcounter = stripcounter + 1;
		polycounter = 1;		
	);

	// Export state as results as well for forward referencing
	regional(dmstate);
	dmstate = divomathSetState();
	forall(keys(dmstate), #,
		divomathPutResult(#, dmstate:#); // breaks in divomath, when changed to PutResult(). Figure out or leave as is
		if('debuglevel>3, println("Added key: " +#+ ", val: " +dmstate:#));
	);

	divomathPostResult();
);

// Overwrite divomath setState()
divomathSetState() := (
	regional(state);
	state = {
		"size" : size,
		"polycolors" : colors,
		"rows" : rows,
		"limit" : limit,
		"sepstate" : if(!isundefined(separator), separator:"getstatestring", QUOTE+sepstate+QUOTE),
		"drawpolys" : drawpolys,
		"drawpatterncontainer" : drawpatterncontainer,
		"drawseparator" : drawseparator,
		"drawborders" : drawborders,
		"polypadding" : polypadding,
		"rcrows" : rcrows,
		"rclimit" : rclimit,
		"rcsepstate" : if(!isundefined(rcseparator), rcseparator:"getstatestring", QUOTE+rcsepstate+QUOTE),
		"drawrccontainer" : drawrccontainer,
		"drawrcseparator" : drawrcseparator
	};

	// Configure vertices to handle image-strings correctly
	regional(polys);
	polys = apply(vertices, # = if(isstring(#), QUOTE + # + QUOTE, #));

	state:"polys" = polys;
	
	// Configure "state" attribute
	// Get current state and built list compatible with config, i.e. ["3,6", "1,1,1", "1,2,3,1"] for 3 strips
	regional(currentstate);
	currentstate = []; 
		
	forall(container:"strips", stripspolys, // loop over every strip
		currentstate = currentstate :> QUOTE; // Set blank new state config string for a strip with a QUOTE (")
		
		forall(stripspolys, // loop over every poly
			currentstate_(-1) = currentstate_(-1) + (#:"original":"id" + 1); // append corresponding originals ID (+1) to state string
			currentstate_(-1) = currentstate_(-1) + ","; // separate by comma
		);

		if(length(currentstate_(-1)) > 1, 
			currentstate_(-1)_(-1) = QUOTE; // Replace last comma with closing quotation mark
		,
			currentstate_(-1) = QUOTE + QUOTE; // Add a quotation mark at the end
		);
	);
	state:"state" = currentstate; // Add state attribute to state

	// Configure current "patternstate"
	regional(currentpatternstate);
	currentpatternstate = [];

	forall(patterncontainer:"strips", stripspolys, // loop over every strip
		currentpatternstate = currentpatternstate :> QUOTE; // Set blank new state config string for a strip with a QUOTE (")
		
		forall(stripspolys, // loop over every poly
			currentpatternstate_(-1) = currentpatternstate_(-1) + (#:"original":"id" + 1); // append corresponding originals ID (+1) to state string
			currentpatternstate_(-1) = currentpatternstate_(-1) + ","; // separate by comma
		);

		if(length(currentpatternstate_(-1)) > 1, 
			currentpatternstate_(-1)_(-1) = QUOTE; // Replace last comma with closing quotation mark
		,
			currentpatternstate_(-1) = QUOTE + QUOTE; // Add a quotation mark at the end
		);
	);
	state:"patternstate" = currentpatternstate; // Add patternstate attribute to state

	// Configure current "rcstate"
	regional(currentrcstate);
	currentrcstate = [];

	forall(rccontainer:"strips", stripspolys, // loop over every strip
		currentrcstate = currentrcstate :> QUOTE; // Set blank new state config string for a strip with a QUOTE (")
		
		forall(stripspolys, // loop over every poly
			currentrcstate_(-1) = currentrcstate_(-1) + (#:"original":"id" + 1); // append corresponding originals ID (+1) to state string
			currentrcstate_(-1) = currentrcstate_(-1) + ","; // separate by comma
		);

		if(length(currentrcstate_(-1)) > 1, 
			currentrcstate_(-1)_(-1) = QUOTE; // Replace last comma with closing quotation mark
		,
			currentrcstate_(-1) = QUOTE + QUOTE; // Add a quotation mark at the end
		);
	);
	state:"rcstate" = currentrcstate; // Add rcstate attribute to state

	state; // Return
);

// CLASS RegPoly: Provides a means to render a regular polygon based on its center and the radius of the circumcircle* and
// having it interactable (i.e. being able to "move", "copy" and interact with a container on "moveend".
// Uses regularpolygon() function but scales and rotates the result depending on the parity of vertices
// (even: rotate by PI/4, scale up so that radius is edge to opposite edge, odd: no rotation, scale -> 2*radius = edge to opposite edge).
// *is not circumcircle in the resulting RegPoly
new RegPoly(center,radius,vertices,rotation,palettecolor):= ( 
	regional(regpoly);
	regpoly = new VAMobject("RegPoly");

	if(isstring(vertices), 
		regpoly:"image" = vertices;
		vertices = 0;
	); // Create circle, if RegPolys draws image

	regpoly:"inputradius"	= radius; // backup only, for copy creation
	regpoly:"inputrotation"= rotation; // backup only, for copy creation
	
	regpoly:"id" = 'polyid; 'polyid = 'polyid +1;
	regpoly:"name"				= ( // Name for posting to divomath
		if(vertices < 9 % vertices == 100, SHAPEMAP:vertices, vertices + "-gon") + // name of shape
		"_" + 
		COLORMAP:(mod(palettecolor-1,	length(DIVOPALETTE)) + 1); // generic name of color ("blue", "red", ...)
	);
	
	regpoly:"vertices"		= if(vertices < 3, 100, vertices); // if no vertices approximate a circle
	regpoly:"coord" 			= center;
	regpoly:"radius" 			= if(iseven(regpoly:"vertices"),
		radius / cos(PI/regpoly:"vertices"), // length edge to edge = 2 * radius
		radius * 2 / (1 + cos(PI/regpoly:"vertices")) // length corner to edge = 2 * radius
			* if(regpoly:"vertices" == 3, .9, 1); // squish only triangle to look better
	);
	regpoly:"center"			:= my("coord") - [ // coord adjusted so that all RegPolys are aligned at the bottom edge
		0, // deltax
		if(iseven(my("vertices")), 
			0, // even parity RegPolys are aligned. Base circle is inner circle.
			my("radius") * sin(PI / my("vertices")) * (1 - cos(PI / my("vertices"))) / (1 + cos(PI / my("vertices")))			// voodoo magic for odd parity
		);
	];
	regpoly:"rotation"		= rotation + if(iseven(regpoly:"vertices"),  // custom rotation AND...
		PI/regpoly:"vertices", // ...rotate even Polys, so they are not corner up
		0
	);
	regpoly:"ismoveable" 	= true;
	regpoly:"copyonmove"	= false;
	regpoly:"parent" 			= NADA; // Workbench or Container or similar
	regpoly:"colorkey"		= palettecolor;
	regpoly:"color" 			= DIVOPALETTE_(mod(palettecolor-1,	length(DIVOPALETTE)) + 1);

	regpoly:"shape" := regularpolygon(
				my("center"), // center
				my("radius"), // radius
				my("vertices"), // vertices, is 100 for a circle
				my("rotation") // rotation
	);
	regpoly:"hitbox" := my("shape");

	regpoly:"draw" := (
		fillpoly(my("shape"),color->if(isundefined(my("image")),my("color"),grey(1)));
		if(drawborders,drawpoly(my("shape"),color->grey(0),size->bordersize));

		// Draw image
		if(!isundefined(my("image")),
			drawimage(my("coord"),ICONS:(my("image")), scale->.28*my("radius"));
		);
		
		// Debug
		if('debuglevel > 0, 
			draw(my("center"));
			drawtext(my("center")+[.2,0], my("id"),color->apply(my("color"), abs(1-#)), bold->true);
			draw(my("coord"), color->grey(.9));
		);		
	);

	regpoly:"ishot" := inpoly(my("shape"),mouse().xy);

	regpoly:"copy" := (
		regional(polycopy);
		polycopy = new RegPoly(
			my("coord"),
			my("inputradius"),
			if(isundefined(my("image")),my("vertices"),my("image")),
			my("inputrotation"),
			my("colorkey")
		);

		// Check if Poly has original itself (so it is a copy in a PatternContainer)
		// If true, use it's original, otherwise just use self() (which will be the original)
		polycopy:"original" = if(isundefined(self():"original"), self(), self():"original"); // Reference to copyable RegPoly for divomath result adding

		polycopy; // Return copy of RegPoly
	);
	
	regpoly:"moveend" := if(my("ismoveable"), // Handle dropped RegPolys
		// Get Container the Poly is dropped on
		regional(polydroptarget);
		polydroptarget = select(obj, #:"type" == "Container" & #:"ishot"); // possibly multiple Containers
		polydroptarget = if(length(polydroptarget)>0, polydroptarget_1); // select first Container

		// Removes Poly from parent if dropped somewhere else
		if(my("parent") != droptarget,
			eval(my("parent"):"remove", poly->self());
			self():"parent"=NADA;
		);

		// Call drop-handler from Container
		eval(polydroptarget:"drop",dropobject->self());

		// Remove stray RegPolys from obj
		if(isundefined(my("parent")), obj = obj -- [self()]);
	);

	regpoly; // Return the RegPoly
);

new Separator(coord, height, parent) := (
	regional(sep);
	sep = new VAMobject("Separator");
	
	sep:"coord" = coord;
	sep:"parent" = parent; // should be a Container
	sep:"original" = NADA; // reference for copies of Separator
	sep:"timing" = parent:"timing";
	sep:"color" = grey(.3);
	sep:"ismoveable" = false;
	sep:"copyonmove" = true;
	sep:"width" = .4;
	sep:"copies" = [];

	sep:"shape" := ( // mutliple polys
		regional(shape, blobscale, barscale);
		blobscale = .6;
		shape = [];

		//hitbox = hitbox :> regularpolygon(my("coord")-[0,2*blobscale*my("width")], blobscale *2* my("width"), 100, PI/4); // bottom square
		shape = shape :> ellipse(my("coord")-[0,1.5*sepsize*blobscale*my("width")], sepsize*.6, sepsize*.3);
		barscale = sepsize*.2;
		shape = shape :> rectangle(my("coord") - barscale*[my("width"),2*my("width")], 2*barscale*my("width"), my("parent"):"height" + 2*barscale*my("width"));
	);
	sep:"hitbox" := (
		regional(hitbox, blobscale, barscale);
		hitbox = my("shape");

		// Add larger box to the bottom to make it easier to grab
		barscale = sepsize*.2;
		blobscale = .6;
		hitbox = hitbox :> ellipse(my("coord")-[0,3*sepsize*blobscale*my("width")], sepsize*.6, sepsize*.6);
	);
	sep:"ishot" := contains(apply(my("hitbox"), inpoly(#,mouse().xy)), true); // mouse in one the parts of the hitbox
	
	sep:"draw" := (
		// Draw all Polys
		forall(my("shape"), fillpoly(#, color->my("color")));

		// Debug draw
		if('debuglevel>3,
			forall(my("hitbox"), drawpoly(#, color->[1,0,0]));
		);
	);
	
	sep:"move" := if(my("ismoveable"),
		self():"coord" = my("coord") + [mousedelta_1, 0]; // move only along x-axis
		self():"coord"_1 = max(my("parent"):"coord"_1,my("coord")_1); // limit to the left
		self():"coord"_1 = min(my("parent"):"coord"_1+my("parent"):"width",my("coord")_1); // limit to the right
	);

	sep:"moveend" := if(my("ismoveable"),
		regional(x, strips, position, polyX);
		x = my("coord")_1; // own x-coord for proper alignment
		strips = my("parent"):"strips"; // strips of RegPolys to compare against

		// Get position where to insert Separator
		position = apply(strips, s, apply(s, #:"coord"_1 < x)); // [][] of true/false depending on, if RegPoly is left of dropped Separator
		position = apply(position, s, select(s, #)); // throw away all "false" (Polys right of dropped Separator)
		position = apply(position, s, length(s)); // count trues (number of Polys left of dropped Separator)
		position = max(position); // max number of trues (position of rightmost element still left of Separator, may be zero)

		// Get reference x-coordinate of RegPoly
		if(position > 0,
			polyX = select(strips, length(#) >= position)_1; // first strip with enough RegPolys for correct positioning
			polyX = polyX_position; // RegPoly at appropriate position of that strip
			polyX = polyX:"coord"_1; // its x-coord
		); // polyX NADA, if position is 0 (Separator dropped before first Poly or no Poly in Container)

		// Get xcoord where to insert and check if there already is a Separator at that position
		regional(sepxpos, sepalreadyexists);
		sepxpos = polyX + size + .5 * my("parent"):"polypadding";
		sepalreadyexists = contains(apply(my("original"):"copies", #:"coord"_1), sepxpos);
		if(isundefined(sepalreadyexists), sepalreadyexists = false);

		// Handle storage of dropped Separator
		if(isundefined(polyX) % sepalreadyexists, // if there is no useful place to insert Separator...
			// ...remove from 'copies' and obj
			self():"original":"copies" = my("original"):"copies" -- [self()];
			obj = obj -- [self()];

		, // else: Move into position, i.e. set x-coord of dropped Separator
			new animationobject(
				self(),
				"coord",
				my("coord"),
				[sepxpos, my("coord")_2],
				my("timing"),
				"accel"
			);
		);
		
		// Update divomath states/results
		divomathUpdateResults();
	);

	sep:"copy" := (
		regional(copy);
		copy = new Separator(my("coord"),my("height"), my("parent"));
		copy:"ismoveable" = true;
		copy:"copyonmove" = false;
		copy:"original" = self(); // thing i am copied from (different from parent => Container)
		copy:"color" = copy:"color";

		self():"copies" = my("copies") ++ [copy];

		copy;
	);

	sep:"popall" := (
		obj = obj -- my("copies");
		self():"copies" = [];
	);

	sep:"putchild" := ( // eval with position with the number of Polys left of Separator
		regional(refpoly, maxlength);

		// Get strip with most polys
		refpoly = apply(my("parent"):"strips", length(#)); // lengths of all strips of parent Container
		maxlength = max(refpoly);
		forall(1..length(refpoly), stripindex, // Get strip with most Polys
			if(refpoly_stripindex == maxlength, refpoly = my("parent"):"strips"_stripindex);
		);

		refpoly = refpoly_position; // get RegPoly in correct position

		// Create copy and place correctly
		regional(sepxpos, sepcopy);
		sepxpos = my("parent"):"coord"_1;
		sepxpos = sepxpos + my("parent"):"stripmargin"; // move to left border of first poly
		sepxpos = sepxpos + position * (2*size + my("parent"):"polypadding"); // move to left border of poly right of correct position
		sepxpos = sepxpos - .5 * my("parent"):"polypadding"; // move back to center between polys

		sepcopy = my("copy");
		sepcopy:"coord" = [sepxpos, my("coord")_2];

		obj = obj ++ [sepcopy];

	);

	// Get position in relation to parent container (i.e. max number of polys to the left of self())
	sep:"getcontainerposition" := (
		regional(refposition, position, distance);

		refposition = my("original"):"coord"_1 - (my("original"):"parent":"polypadding"/2-my("original"):"parent":"stripmargin"); // adjust original position
		position = my("coord")_1;
		distance = polypadding + 2*size; // should be distance between to separators
		round((position - refposition) / distance);
	);

	sep:"getstatestring" := (
		regional(statestring, position, maxpolycount);
		statestring = QUOTE; // Add leading quotation mark

		// Add positions separated by comma
		forall(my("copies"),
			position = #:"getcontainerposition";
			maxpolycount = max(apply(my("parent"):"strips", length(#)));
			position = min(position, maxpolycount);
			statestring = statestring + position + ",";
		);

		// Replace last comma with trailing quotation mark
		if(length(statestring)>1,
			statestring_(-1) = QUOTE;
		,
			statestring = statestring + QUOTE;
		);

		statestring; // Return string
	);

	sep; // Return
);

// Multiline Container to hold RegPolys
new Container(coord, numofstrips, limits) := (
	regional(cont);
	cont = new VAMobject("Container");

	cont:"stripmargin" = .3; // distance to left and right border, half the distance is used to next strip
	cont:"polypadding" = polypadding;
	cont:"polyoffset" = 2*size + cont:"polypadding"; // distance between center of two RegPolys in a strip

	cont:"coord" = coord;
	cont:"childseparator" = NADA; // gets set when initialising Separator
	cont:"#strips" = numofstrips; // int: number of strips
	cont:"strips" = ( // Stores RegPolys per strip
		regional(strips);
		strips = [];
		repeat(cont:"#strips", strips = strips :> []);
	);
	cont:"longeststripindex" := ( // Returns first stripindex with max number of Polys in it
		regional(maxlength, index);
		maxlength = apply(my("strips"), length(#));
		maxlength = max(maxlength);
		
		// Find first occurence of maxlength
		forall(1..length(my("strips")),
			if(isundefined(index) & length(my("strips")_#) == maxlength, index = #);
		);
		index; // Return
	);
	
	cont:"limits" = limits; // [] int: size limits of strips
	cont:"hardpolylimit" = ( // Calc how many Polys can at most be drawn in a line on screen
		regional(hasinfinite, hardpolylimit);
		hasinfinite = contains(apply(limits,# < 0), true); // flag wheter container has an infinite strip

		if(hasinfinite, // calc limit based on screen width
			hardpolylimit = screenbounds()_2_1 - coord_1; // width from left edge of container to right edge of screen
			hardpolylimit = hardpolylimit - 2 * cont:"stripmargin"; // subtract distance to left and right edge from assignable space
			hardpolylimit = hardpolylimit - size; // subtract a size as space to the right to place the next RegPoly
			hardpolylimit = hardpolylimit / (2*size+cont:"polypadding"); // see how often Poly+padding fits inside assignable space
			hardpolylimit = floor(hardpolylimit); // round down, since you won't fit a fraction of a RegPoly

		, // else: calc limit based on max limit from limits
			hardpolylimit = max(limits);
		);
	);

	cont:"refpoints" := ( // [] Point: reference points for strip beginnings
		regional(ref, dx, dy);
		ref = [];
		repeat(my("#strips"),
			dx = size + my("stripmargin");
			dy = (2*#-1) * (size + my("stripmargin")/2);
			ref = ref :> my("coord") + [dx, dy];
		);
		ref;
	);

	cont:"height" = (2*size + cont:"stripmargin") * cont:"#strips";
	cont:"stripheight" = cont:"height" / cont:"#strips";
	cont:"width" = (
		regional(width, isinfinite, spaces);
		isinfinite = min(limits) < 0;

		spaces = if(isinfinite,
			cont:"hardpolylimit";
		,
			max(limits);
		);

		width = 2*cont:"stripmargin"; // margin to the left and right
		width = width + 2*size * spaces; // space for all polys
		width = width + polypadding * spaces; // space for paddings
	);

	cont:"ismoveable" = false;
	cont:"isclickable" = false;
	cont:"bordersize" = 3;
	cont:"timing" = .2; // animation time

	cont:"hitbox" := my("shape");
	cont:"ishot" := inrectangle(my("hitbox"), mouse().xy);

	cont:"shape" := rectangle(my("coord"), my("width"),	my("height"));
	cont:"draw" := (
		// Loop over strips...
		repeat(my("#strips"),
			// ...and fill strip with some background color
			fillpoly(rectangle(
					my("coord") + (#-1) * [0,my("stripheight")],
					my("width"),
					my("stripheight")
				),
				color->if(isodd(#),grey(.94),grey(.98))	
			);

			// ...also draw indicators for infinte strips
			if(my("limits")_# < 0,
				fillpoly(
					regularpolygon(my("refpoints")_# + [my("width")-size-2.5*my("stripmargin"),0], size/4, 3, -30°),
					color->if(iseven(#),grey(0.94),grey(1))
				);
			);
		);

		// Draw border
		//drawpoly(my("shape"), color->grey(.3), size->my("bordersize"));

		// Debug draw
		if('debuglevel > 0,
			draw(my("coord"));
			repeat(length(my("refpoints")), // draw refpoints and an appropriatly sized circle around each
				draw(my("refpoints")_#);
				drawcircle(my("refpoints")_#,size, color->grey(.85));
				drawtext(my("refpoints")_#+[.2,0],my("limits")_#,color->grey(.7));
			);
		);
	);

// Eval Methods
// ============
	cont:"remove" := ( // Removes RegPoly from *any* strip, eval with "poly" as RegPoly
		self():"strips" = apply(my("strips"), # -- [poly]);
	
		// Realign Polys
		my("scrollbar"):"adjustedvalue" = round(my("scrollbar"):"value"); // update to animate correctly on removing
		my("movepolysintoplace");

		// Toggle scrollbar visibility (on overflowing strip)
		my("scrollbar"):"setvisibility";
	);

	cont:"appendtostrip" := ( // eval with RegPoly "poly" and strip index "index" as int
		self():"strips"_index = my("strips")_index :> poly;
		poly:"parent" = self();
	);

	cont:"drop" := ( // handles stuff getting dropped on a container --> eval with object as "dropobject"
		if(dropobject:"type" == "RegPoly", my("droppoly"),
		if(dropobject:"type" == "Container" & dropobject:"subtype" == "Pattern", my("dropcontainer"),
		if(dropobject:"type" == "Separator", my("dropseparator"), // not needed
		// else
		println("Dropped a " + dropobject:"type" + " ... nothing to do");
		)));
	);

	cont:"droppoly" := ( // eval with dropobject (from own "drop" method)
		// For safety, should not be needed
		if(!contains(obj,dropobject), obj = obj :> dropobject);

		// Get correct strip index to put poly in
		regional(stripindex);
		stripindex = 1+length(select(apply(apply(1..my("#strips"),my("coord")_2 + #*my("height")/my("#strips")),#<mouse().xy_2),#));

		// Put poly in makeshift container to call "dropcontainer" with
		regional(cont);
		cont = {};
		cont:"strips" = apply(1..my("#strips"), if(#==stripindex, [dropobject], []));
		cont:"#strips" = length(cont:"strips");

		// Call dropcontainer
		eval(my("dropcontainer"), dropobject->cont);

		// Reset dropcoord for next call
		dropcoord = NADA;
	);

	cont:"dropcontainer" := ( // eval with dropobject (from own "drop" method)
		// can also be evaled with dropcoord to use specific coord (defaults to mouse coords)
		if(isundefined(dropcoord), dropcoord = mouse().xy);

		regional(polys, hotstrip, position, len, lim, overflowcontent);



		repeat(dropobject:"#strips", stripindex,

			polys = dropobject:"strips"_stripindex; // Strip to put in Container
			hotstrip = my("strips")_stripindex; // VALUE COPY of strip, reassign later

			// Find position, where to insert dropobject
			position = select(hotstrip, dropcoord_1 > #:"coord"_1); // all Polys left of the mouse
			position = 1 + length(position); // count them, add one --> next position to insert

			// (Re)Set strip contents
			hotstrip = hotstrip_(1..position-1) ++ // Assemble Polys BEFORE the dropobject
				polys ++ // Append list of polys
				hotstrip_(position..length(hotstrip)); // Append Polys AFTER the dropobject

			// Set RegPolys parent to Container
			apply(polys, #:"parent" = self());

			// Reassign hotstrip to corresponding field
			self():"strips"_stripindex = hotstrip;

			// Remove overflowing elements at size limit of container
			hotstrip = my("strips")_stripindex;
			len = length(hotstrip);
			lim = my("limits")_stripindex;
		
			if(lim > -1 & length(hotstrip) > my("limits")_stripindex, // Check if overflowing
				overflowcontent = hotstrip_(1+min(len,lim)..len); // Get overflowing RegPolys
				obj = obj -- hotstrip_(1+min(len,lim)..len); //// Remove overflowing RegPolys from obj
				self():"strips"_stripindex = my("strips")_stripindex -- overflowcontent; // Remove overflowing RegPolys from strip
			);
		);

		// Animate RegPolys in ALL strips to new position
		my("scrollbar"):"adjustedvalue" = round(my("scrollbar"):"value"); // update to animate correctly on removing
		my("movepolysintoplace");

		// Toggle scrollbar visibility (on overflowing strip)
		my("scrollbar"):"setvisibility";

		// Reset dropcoord for next call
		dropcoord = NADA;
	);

// CONVENIENCE METHODS
// =====================

	cont:"movepolysintoplace" := ( // Animate Polygons to appropriate position for *all* strips
		regional(offset, strip, refpoint, poly);
		
		offset = my("scrollbar"):"adjustedvalue"; // value to shift all polys to the left by
		if(isundefined(offset), offset = 0); // if there is no scrollbar consider it to be 0

		// Handle which Polys are drawn (i.e. are put into and removed from obj)
		my("displaysubset");

		repeat(length(my("strips")), // Loop over every strip and refpoint
			strip = my("strips")_#;
			refpoint = my("refpoints")_#;

			repeat(length(strip), polyindex, // Loop over every RegPoly per strip
				poly = strip_polyindex;
				new animationobject(
					poly,
					"coord",
					poly:"coord",
					refpoint + (polyindex-1-offset) * [my("polyoffset"),0],
					my("timing"),
					"accel"
				);
			);
		);

		// Reposition Separators too
		my("childseparator"):"realignchildren";

		// Update divomath states/results
		divomathUpdateResults();
	);

	cont:"popall" := ( // Removes all contents from all strips (and obj) and returns as one list
		regional(polygons);
		polygons = [];

		forall(my("strips"), strip, // iterate over strips
			forall(strip, // inside strips iterate over RegPolys
				polygons = polygons :> #; // add Poly to list
				eval(my("remove"), poly->#); // Remove Poly from strip
			);
		);

		obj = obj -- polygons; // Remove all Polys from obj

		polygons; // Return
	);

	cont:"displaysubset" := ( // Displays only a subset of RegPolys (and Separators) (for scrolling)
		regional(offset, polystodisplay);

		offset = my("scrollbar"):"adjustedvalue"; // offset by which to select Polys by
		if(isundefined(offset), offset = 0); // if there is no scrollbar consider it to be 0

		// Handle displaying
		forall(my("strips"), polys, // loop over every strip
			// remove all polys
			obj = obj -- polys;
			
			// get all polys that are to be displayed
			polystodisplay = polys_(1+offset..min(length(polys),my("hardpolylimit")+offset));

			// Put chosen polys back into obj
			obj = obj ++ polystodisplay;
		);

		polystodisplay; // Return it (just cause)
	);

// Somewhat more elaborate fields (i.e. separate objects)
// ======================================================
	cont:"showscrollbar" := my("scrollbar"):"max" > 0; // flag to show bar, if there is need to be able to scroll

	cont:"scrollbar" = (
		regional(offset, bar);

		// Create bar
		offset = [1.2*cont:"stripmargin", .5*cont:"stripmargin" + cont:"height"];
		bar = new HorizontalScrollbar(cont:"coord"+offset, cont:"width"-offset_1);
		
		// Config bar
		bar:"parent" = cont;
		bar:"hasbuttons" = true;
		bar:"max" := max(0,max(apply(my("parent"):"strips",length(#))) - my("parent"):"hardpolylimit");

		bar:"precision" := 1/max(1,my("max"));


		bar:"adjustedvalue" = round(bar:"value"); // rounded value, reset in "script", to have an event fire on change
		bar:"setvisibility" := ( // sets if bar is visible (called from parent when removing or adding Poly)
			if(my("parent"):"showscrollbar",
				obj = select(obj, # != self()) :> self(), // put self() in obj EXACTLY once
				obj = select(obj, # != self()) // remove self() from obj
			);
		);

		bar:"hitbox" := (
			regional(offset, scalefactor);
			offset = (my("shape")_4 - my("shape")_1)_2;
			scalefactor = .25;			
			[
				my("shape")_1 + scalefactor * [-0,-offset],
				my("shape")_2 + scalefactor * [0,-offset],
				my("shape")_3 + scalefactor * [0,offset],
				my("shape")_4 + scalefactor * [-0,offset]
			];
		);

		bar:"bar":"hitbox" := (
			[
				[my("shape")_1_1, my("parent"):"hitbox"_1_2],
				[my("shape")_2_1, my("parent"):"hitbox"_2_2],
				[my("shape")_3_1, my("parent"):"hitbox"_3_2],
				[my("shape")_4_1, my("parent"):"hitbox"_4_2],
			];
		);

		// Create script to change position of all of parents polys and Separators
		bar:"script" := (
			regional(adjval, currval);
			adjval = my("adjustedvalue"); // Current adjusted value
			currval = my("value"); // Current value (executes "script" in the first place)

			// Change adjusted value and toggle WHICH RegPolys and Separators are drawn WHERE
			if(adjval != round(currval),
				self():"adjustedvalue" = round(currval);
			);

			divomathSetState();

			my("parent"):"movepolysintoplace";
		);
		
		// Display bar at the start
		if(cont:"showscrollbar", obj = obj :> bar);

		bar; // Return
	);

	cont; // Return
);

new PatternContainer(coord, rows, limit) := (
	regional(cont);
	cont = new Container(coord, rows, apply(1..rows, #=limit));

	// Inherited from Container, don't use
	obj = obj -- [cont:"scrollbar"];
	cont:"showscrollbar" = false; // don't ever show scrollbar, scrollbar can't be NADA without breaking errors though.

	// Fields
	cont:"subtype" = "Pattern";
	cont:"bordersize" = 0;
	cont:"ismoveable" = false;
	cont:"copyonmove" = true;
	cont:"width" := (
		regional(numofpolys);
		numofpolys = max(apply(my("strips"),length(#))); // max number of polys in strip
		numofpolys = max(1, numofpolys); // min 1

		numofpolys * 2*size + (numofpolys) * my("polypadding") + if(numofpolys<my("limits")_1,.5*size,0);
	);
	cont:"move" := if(my("ismoveable"),
		// Move self
		self():"coord" = my("coord") + mousedelta;

		// Move contents (RegPolys)
		forall(my("strips"), strip,
			apply(strip,#:"coord" = #:"coord" + mousedelta); // should only have exactly one strip
		);
	);

	cont:"moveend" := if(my("ismoveable"), // Handle dropped PatternContainer
		// Get Container the Poly is dropped on
		regional(droptarget);

		droptarget = select(obj, #:"type" == "Container" & isundefined(#:"subtype") & #:"ishot"); // possibly multiple Containers
		droptarget = if(length(droptarget)>0,droptarget_1); // select first Container

		// Call drop-handler from droptarget
		eval(droptarget:"drop", dropobject->self());

		// Remove copy of PatternContainer from obj
		obj = obj -- [self()];

		// Remove contents from obj too, if no droptarget was found
		if(isundefined(droptarget), 
			apply(my("strips"), strip, obj = obj -- strip);
		);
	);

	cont:"copy" := (
		regional(copy, polycopy);
		copy = new PatternContainer(my("coord"), my("#strips"), my("limits")_1);
		copy:"ismoveable" = true;
		copy:"copyonmove" = false;

		// Copy RegPolys of original and put in only strip
		repeat(my("#strips"), stripindex,
			copy:"strips"_stripindex = apply(1..length(my("strips")_stripindex), my("strips")_stripindex_#:"copy");
		);

		forall(copy:"strips", strip,
			obj = obj ++ strip; // Add copies to obj
		);
		copy;
	);

	cont; // Return
);

// D | Initialization
// ==================
// SL Config overwrite
if(!usedivomath,
	'debuglevel = 4;
	rows = 2;
	size = 1;
	limit = [-2,3];
	patternlimit = 4;
	patternstate = ["2,2,2", "3,1"];
	state = ["3,6,1,1,1,1,1,1,1,1,2,3,3,2,1,2", "3,1,3"];
	//sepstate = "1,2,1";
	vertices = [2,3,"snap",5,6,7];
	interactable = "spc";
	drawpatterncontainer = true;
	drawseparator = true;
	drawresetbutton = true;
	buttonsize = 1.5;
	drawpolys = false;
	polypadding = 1;
	rcrows = 2;
	//rcstate = ["1,1,2", "2,1,3"];
	//rclimit = [-1,5];
	//rcsepstate = "1";
	drawrccontainer = false;
	drawrcseparator = false;
	rcinteractable = "s";
	sepsize = 1;
);

// Local vars
regional('screenref, 'padding, 'marginleft, 'marginbottom);
'screenref = (screenbounds()_4).xy; // bottom left corner of screen
'marginleft = 1; // distance from left border
'marginbottom = .5; // distance from bottom border
'screenref = 'screenref + size * [1,1] + ['marginleft,'marginbottom];


// D.1 | Create Polygons
// =====================
regional(polys);
polys = []; // List of all initial RegPolys

// Create RegPolys and align at the bottom of the screen
repeat(length(vertices),
	polys = polys :> new RegPoly('screenref, size, vertices_#, 0, colors_#);
	polys_(-1):"copyonmove" = true;
	'screenref = 'screenref + (2*1.1*size+polypadding) * [1,0]; // next center to draw RegPoly
);

// Add bg highlight for polys
regional(bg);
bg = {
	"type" : "bg",
	"shape": [
	(screenbounds()_4) + ['marginleft/3,'marginbottom/3,0],
	(screenbounds()_3) - ['marginleft/3,-'marginbottom/3,0],
	(screenbounds()_3) + 2*('marginbottom+size) * [0,1,0] - ['marginleft/3,'marginbottom/3,0],
	(screenbounds()_4) + 2*('marginbottom+size) * [0,1,0] + ['marginleft/3,-'marginbottom/3,0]
	]
};
if(drawpolys,	bg:"draw" := drawpoly(my("shape"),	color-> grey(.1)));

// D.2 | Create PatternContainer
// =============================
// Align left above bar of RegPolys
if(drawpatterncontainer,
	regional(patterncontainer);
	patterncontainer = new PatternContainer([0,0], rows, patternlimit);
);
patterncontainer:"coord" = if(drawpolys,
	(bg:"shape"_4).xy;
,
	(bg:"shape"_1).xy;
);
patterncontainer:"coord" = patterncontainer:"coord" + ['marginleft,'marginbottom];

// Fill Patterncontainer with predefined RegPolys
counter = 1; // start at first strip

patternstate = apply(patternstate, tokenize(#,",")); // Create config from supplied strings from divomath

forall(patternstate, row, // iterate over config for every row
	forall(select(row, #!=""), polyid, // iterate over every polyid per row that is not an empty string
		polycopy = polys_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)

		eval(patterncontainer:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip

		// (!) Put copy in obj on obj build, so they get drawn on top (see below)
	);
	counter = counter + 1; // next cycle --> next strip
);

patterncontainer:"timing" = .000001;
patterncontainer:"movepolysintoplace";
patterncontainer:"timing" = .2;

// D.3 | Create and config Container
// =================================
// Align with coord of bg
regional(containercoord, coordoffset, container, polycopy, counter);
coordoffset = [0, .6+'marginbottom]; // .6 is axis length of Separators' ellipse

containercoord = if(drawpatterncontainer,
	// Align with pattern container
	patterncontainer:"coord" + coordoffset + [0,patterncontainer:"height"]
, 
	if(drawpolys,
		(bg:"shape"_4).xy + 2*coordoffset;
	,
		(screenbounds()_4).xy + coordoffset;
	)
);
containercoord = containercoord + ['marginleft,0];

container = new Container(containercoord,	rows,	limit); 

// Fill Container with predefined RegPolys
counter = 1; // start at first strip

state = apply(state, tokenize(#,",")); // Create config from supplied strings from divomath

container:"timing" = .000001;
forall(state, row, // iterate over config for every row
	forall(select(row, #!=""), polyid, // iterate over every polyid per row that is not an empty string
		polycopy = polys_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)

		eval(container:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip

		// (!) Put copy in obj on obj build, so they get drawn on top (see below)
	);
	counter = counter + 1; // next cycle --> next strip
);
container:"timing" = .2;

// D.4 | Create Separator
// ======================
regional(separator);
separator = new Separator(container:"coord", container:"height", container);

// Apply sepstate to initialize copies
sepstate = set(tokenize(sepstate,","));
forall(select(sepstate,#!=""), pos, eval(separator:"putchild", position->pos));

container:"childseparator" = separator;

// ...=============================================================
// Make Container and corresponding Polys/Separators non-interactable if required
// ...Container itself
if(indexOf(interactable, "c") + indexOf(interactable, "C") == 0,
	container:"ishot" = false; // Container
);

// ...Polys in Container
if(indexOf(interactable, "p") + indexOf(interactable, "P") == 0,
	apply(container:"strips",strip,apply(strip,poly, poly:"ishot"=false)); // Polys
);

// ...Separators of Container
if(indexOf(interactable, "s") + indexOf(interactable, "S") == 0,
	separator:"ishot" = false; // Separator
	apply(container:"childseparator":"copies",sep,sep:"ishot"=false); // child Separators
);

// D.5 | Reset Button
// ==================
regional(btn);
'screenref = (screenbounds()_2).xy; // top right corner of the screen
'screenref = 'screenref - ['marginleft, 'marginbottom]; // coord of Button

btn = new ImageButton(NADA, buttonsize*sepsize*2, buttonsize*sepsize*1, ICONS:"reset");
btn:"coord" := (container:"shape"_3).xy - [my("width"),-'marginbottom] + if(container:"showscrollbar", [0,container:"scrollbar":"height"], [0,0]);
btn:"imgscale" = min(.9,.9 * buttonsize * sepsize);
btn:"cornerradius" = max(btn:"width", btn:"height");
btn:"color" = DIVODARKBLUE;
btn:"bordercolor" = DIVODARKBLUE;
btn:"polysref" = polys; // reference for polys, since CindyJS does not access polys var properly
btn:"script" := ( // Resets state to editor default setting if used in divomath
	// Reassign relevant vars with appropriate values
	if(usedivomath,
		// default to divomath reference is exists or else default state
		state = divomathConfig:"__state";
		if(isundefined(state),
			state = defaultto('dmdefaultstate:"state", apply(1..rows, ""));
		);
		state = apply(state, tokenize(#,","));

		sepstate = divomathConfig:"__sepstate";
		if(isundefined(sepstate),
			sepstate = defaultto('dmdefaultstate:"sepstate", "");
		);
	,
		// non divomath reset
		sepstate = separator:"getstatestring";
		sepstate = replace(sepstate,QUOTE,""); // Remove QUOTEs for normal use of string
	);

	// Remove all RegPolys
	forall(select(obj, #:"type" == "Container" & isundefined(#:"subtype")), #:"popall");
	if(length(polys) > 0,
		'polyid = polys_(-1):"id" + 1; // Reset global polyid
	);
	
	// Remove all Separators
	forall(select(obj, #:"type" == "Separator" & isundefined(#:"original") & isundefined(#:"parent":"subtype")), #:"popall");

	// Reset original state, @TODO: Same as in container init. Refactor
	regional(polycopy, counter);				
	counter = 1; // start at first strip
	
	forall(state, row, // iterate over config for every row
		forall(select(row, #!=""), polyid, // iterate over every polyid per row that is an integer
	
			// Create new Polys
			polycopy = my("polysref")_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)
			eval(container:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip	
		);
		counter = counter + 1; // next cycle --> next strip
	);

	container:"movepolysintoplace"; // align polys

	// Apply sepstate to initialize copies
	sepstate = set(tokenize(sepstate,","));
	forall(select(sepstate,#!=""), pos, eval(separator:"putchild", position->pos));
);

// D.6 | Reference Container
// =========================
regional(rccontainer);

rccontainer = new Container([0,0],	rcrows,	rclimit);
rccontainer:"subtype" = "ReferenceContainer";
rccontainer:"coord" = [container:"coord"_1, container:"coord"_2 + container:"height" + container:"scrollbar":"height" + btn:"height" + 4*'marginbottom];
// Fill Container with predefined RegPolys
counter = 1; // start at first strip
rcstate = apply(rcstate, tokenize(#,",")); // Create config from supplied strings from divomath

rccontainer:"timing" = .000001;
forall(rcstate, row, // iterate over config for every row
	forall(select(row, #!=""), polyid, // iterate over every polyid per row that is not an empty string
		polycopy = polys_polyid:"copy"; // Copy poly from poly list (from RegPoly init) according to index (polyid)

		eval(rccontainer:"appendtostrip", poly->polycopy, index->counter);// Put copy in approriate strip

		// (!) Put copy in obj on obj build, so they get drawn on top (see below)
	);
	counter = counter + 1; // next cycle --> next strip
);
rccontainer:"timing" = .2;

rccontainer:"movepolysintoplace"; // align polys

// D.6 | Reference Containers Separator
// ====================================
regional(rcseparator);
rcseparator = new Separator(rccontainer:"coord", rccontainer:"height", rccontainer);

// Apply sepstate to initialize copies
rcsepstate = set(tokenize(rcsepstate,","));
forall(select(rcsepstate,#!=""), pos, eval(rcseparator:"putchild", position->pos));

rcseparator:"coord" := rccontainer:"coord";
rccontainer:"childseparator" = rcseparator;

// ...==================================================
// Make Container and Polys non-interactable if required
// rcinteractable is bool (for backwards compatibility)
if(isbool(rcinteractable),
	if(!rcinteractable,
		rccontainer:"ishot" = false;
		apply(rccontainer:"strips",strip,apply(strip,poly, poly:"ishot"=false));
		rcseparator:"ishot" = false; // Separator
		apply(rccontainer:"childseparator":"copies",sep,sep:"ishot"=false); // child Separators
	);
, // else: As string "cps" or subset
	// ...Container itself
	if(indexOf(rcinteractable, "c") + indexOf(rcinteractable, "C") == 0,
		rccontainer:"ishot" = false; // Container
	);
	
	// ...Polys in Container
	if(indexOf(rcinteractable, "p") + indexOf(rcinteractable, "P") == 0,
		apply(rccontainer:"strips",strip,apply(strip,poly, poly:"ishot"=false)); // Polys
	);
	
	// ...Separators of Container
	if(indexOf(rcinteractable, "s") + indexOf(rcinteractable, "S") == 0,
		rcseparator:"ishot" = false; // Separator
		apply(rccontainer:"childseparator":"copies",sep,sep:"ishot"=false); // child Separators
	);
);


// E | Build obj
// =============
obj = obj :> bg;
if(drawresetbutton, obj = obj :> btn); // Reset button
obj = obj :> container;
obj = obj :> patterncontainer;
if(drawpolys, obj = obj ++ polys);
obj = obj ++ flatten(container:"strips"); // Initial Polys of Container build at Container init
if(drawseparator,obj = obj :> separator);
if(drawrccontainer,obj = obj :> rccontainer);
if(drawrcseparator,obj = obj :> rcseparator);

// Order to draw (Separator last, so it is on top)
typeorder = ["bg", "Container", "RegPoly", "Separator"];

// Remove overflowing polys from view and show scrollbar (for some reason this only works properly here!?)
container:"dropcontainer";
);
`,

    keydown: 
`// v5
// Recent changes:
// - added call to divomathUpdateResults() on "S"-Key
// - added function to increment/decrement debuglevel with +/- keys

if(key() == "k" % key() == "K", // Debug print divomath details
	println("=============DIVOMATH SETTINGS=============");
	println("divomath base object: " + divomathConfig);
	println("Screenbounds: " + screenbounds());
	println("Config: " + 'dmconf);
	println("State: " + 'dmstate);
	println("Prev Answer: " + 'dmprevans);
	println("bgcolor: " + 'bgcolor);
	println("debuglevel: " + 'debuglevel);
	println("isVIEWER?: " + 'dmisviewer);
	println("-------------------------------------------");
	println("SetState overwrite: " + divomathSetState());
	println("==========================================="); 
);

if(key() == "s" % key() == "S", 
	divomathUpdateResults();
);

if(key() == "+" % key() == "_", 'debuglevel = 'debuglevel + 1; println("'debuglevel++: " + 'debuglevel));
if(key() == "-", 'debuglevel = 'debuglevel - 1; println("'debuglevel--: " + 'debuglevel));
`,

    mouseclick: 
`// v1
if(false,

// Der gesamte Code von Cklic wird jetzt bei release ausgeführt
// solange die Sensitiviät auf Klicks in CindyJS nicht verbessert ist

// Bei IPad und wird press, release UND cklick ausgelöst
// Will man mausklick, muss man press/release abfangen

// Teste alle Objekte, ob sie hot sind und sende ihnen gegebenfalls ein "click"
forall(obj,o,
		if(o:"ishot",
		if(isundefined(o:"deletecopyifnotmovedandsubstitutebyoriginal"), 
			o:"click"; 
			,
			obj=obj--[o]; // Kopie wieder löschen
			hot=o:"deletecopyifnotmovedandsubstitutebyoriginal"; //gemerktes Original wiederaktivieren
			//hot:"click";
			);
		//err("click:"+o:"name");
		);
);

if(!isundefined(oldaction),
  act(oldaction,action+"end",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
  oldaction=NADA;
);

// Alternative Formulierung (schöner?):
//forall(select(obj,#:"ishot"),#:"click");
);

`,

    mousedown: 
`// v2
// Recent changes:
// - set mousedown to true

mousedown = true;
mousepressedtime=seconds();

// Finde alle Elemente, die beweglich sind, wenn die Maus an der aktuellen Stelle ist (mouse().xy)
hotlist = select(obj,eval(#:"ishot",coord->mouse().xy));

// auch Typeorder fürs anklicken beachten
hotlist = flatten(apply(typeorder,to,select(hotlist,o,o:"type"==to)))
					++select(hotlist,o,not(contains(typeorder,o:"type")));

//err(sum(apply(hotlist,#:"name"+" ")));	

if(!isundefined(oldaction), 
	hotlist = [oldaction];
);

//err(apply(hotlist,#:"info"));

// Wenn es ein Element in der Hotlist gibt, dann finde die relative Distanz zwischen Referenzpunkt und Maus.
if(length(hotlist)>0,
	hot = hotlist_(length(hotlist));
	startmouse = mouse().xy;
	oldmouse = mouse().xy;
	//err("pressed:"+hot:"name");
	clickcopy = hot:"clickcopy";
	if(not(isundefined(clickcopy)),
		//clickcopy:"clickcopy"=NADA;
		obj = obj :> clickcopy;
		hot=clickcopy;
	);

	startcoord = hot:"coord";
	localcoord = startmouse - hot:"coord";

	action=eval(hot:"getaction",coord->startmouse, delta->localcoord, mouse -> mouse().xy);

	//err("pressed:"+action);//err(hot:"moveable");

	//obj = (obj -- [hot])++ [hot];
	// dieses Movetofront geht so nicht, zerstört andere Stellen, die 
	// mit globalem typeorder-Konzept arbeiten
	//if(ifdefined(hot:"movetofront",true),obj = (obj -- [hot])++ [hot]);
	//err(hot:"movetofront");

	//err(sum(apply(obj,#:"name"+" ")));

	// angefasste Elemente kommen nach vorn
	x=0; //verhindert das seltsame Verhalten, dass bei Drücken nicht gezeichnet wird
,
	hot = NADA; // explizit auf "undefiniert" setzen.
);

`,

    mousedrag: 
`// v1
// Falls ein Element bewegt wird (also hot definiert ist), aktualisiere seine Koordinate

if(!isundefined(hot),
 //err(action); // err(startmouse); err(startcoord); err(mouse().xy);

 if(not(isundefined(hot:"deletecopyifnotmovedandsubstitutebyoriginal")), 
			hot:"deletecopyifnotmovedandsubstitutebyoriginal"=NADA); 
		
 //err(dist(mouse().xy,startmouse) +" "+pinchsensitivity/10);
 act(hot,action,startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
 oldmouse = mouse().xy;
);

`,

    mousemove: 
`// v2
// Recent changes:
// - removed call to divomatUpdateResults(). Has to be called in VAM at the right time.

// Falls ein Element bewegt wird (also hot definiert ist), aktualisiere seine Koordinate

if(!isundefined(oldaction),
 //err(action); // err(startmouse); err(startcoord); err(mouse().xy);

 act(oldaction,action+"sticky",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
 oldmouse = mouse().xy;

 //err(oldaction);
 clrscr();
 forall(obj, #:"draw");
 forall(objpreview, eval(#:"draw",preview->true));
 repaint();

);

`,

    mouseup: 
`// v2
// Recent changes:
// - set mousedown to false

// Code für RELEASE
mousedown = false;

if(!isundefined(hot),
  //err("released:"+action);

	act(hot,action,startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);

  //Allgemeiner "drop on" event – entscheiden, ob der vor, nach oder vor und nach act(...) sein soll.
  if(!isundefined(action),
		forall(select(obj,o,eval(o:"ishot",coord->mouse())),droptarget, eval(droptarget:"dropevent", dropobject->hot);
	); 
	);

  if(isundefined(hot:"sticky"),
			act(hot,action+"end",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
	);
  if(!isundefined(hot:"sticky"),
			if(!(hot:"sticky"),
			act(hot,action+"end",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse),
			act(hot,action+"pause",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse)

  ););
);

if(hot:"sticky", oldaction = hot);


// Code für CLICK = Release when close

//err(dist(startmouse,mouse().xy)+" "+pinchsensitivity);

if(dist(startmouse,mouse().xy)<pinchsensitivity,
// then click

forall(obj,o,
		if(o:"ishot",
		if(isundefined(o:"deletecopyifnotmovedandsubstitutebyoriginal"), 
			o:"click"; 
			,
			obj=obj--[o]; // Kopie wieder löschen
			hot=o:"deletecopyifnotmovedandsubstitutebyoriginal"; //gemerktes Original wiederaktivieren
			//hot:"click";
			);
		//err("click:"+o:"name");
		);
);

if(!isundefined(oldaction),
  act(oldaction,action+"end",startmouse, startcoord, mouse().xy, mouse().xy-oldmouse);
  oldaction=NADA;
);

);

`,

    move: 
`
`,

    multidown: 
`
`,

    multidrag: 
`
`,

    multiup: 
`
`,

    tick: 
`// v1
animations = select(animations, a,
	regional(λ,γ,value,now);
  now=seconds();
  if(isundefined(a:"exec"),

  λ = min(1,(now-(a:"starttime"))/((a:"endtime")-(a:"starttime")));
 if(λ>0,
	if (a:"timeflow" == "linear",  
				//default  
	,
	if (a:"timeflow" == "accel",
			λ = 5/2*λ^3-3/2*λ^5;
	,
	if (a:"timeflow" == "jump",
			if(λ<1, λ=0);
	,
	)));
	if (a:"timeflow" == "set",
		(a:"object"):(a:"property") = if(λ<1, a:"startvalue",a:"endvalue"),
		if (isundefined(a:"movepath"), 
			  (a:"object"):(a:"property") = a:"endvalue"* λ + a:"startvalue" * (1 - λ)
				,
				(a:"object"):(a:"property")=eval((a:"movepath"):"f",start->a:"startvalue",end->a:"endvalue",α->λ)
		);
	);
);

  );
 	// forall(ANI u,a, call(a,"recalc:"));
	running = now < a:"endtime";
	if (!running & !isundefined(a:"command"), a:"object":(a:"command"));
	if (!running & a:"kill", obj = select(obj,# != a:"object"));
	running
);

if(length(animations)==0, stopanimation());

`,
